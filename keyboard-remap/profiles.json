{
  "version": 1,
  "global": {
    "enabledPresets": [
      "ctrl-caps-swap",
      "alt-win-swap"
    ]
  },
  "devices": {
    "logitech-usb-receiver": {
      "displayName": "logitech usb receiver",
      "hyprName": "logitech-usb-receiver",
      "keydId": "046d:c548",
      "enabled": true,
      "remaps": []
    },
    "minila-r-convertible-keyboard": {
      "displayName": "minila r convertible keyboard",
      "hyprName": "minila-r-convertible-keyboard",
      "keydId": "0a5c:8502",
      "enabled": true,
      "remaps": [
        {
          "from": "muhenkan",
          "to": "leftmeta"
        },
        {
          "from": "leftmeta",
          "to": "f13"
        },
        {
          "from": "rightalt",
          "to": "down"
        },
        {
          "from": "grave",
          "to": "escape"
        },
        {
          "from": "escape",
          "to": "grave"
        },
        {
          "from": "katakanahiragana",
          "to": "left"
        },
        {
          "from": "delete",
          "to": "right"
        },
        {
          "from": "rightcontrol",
          "to": "up"
        }
      ],
      "captures": {
        "grave": {
          "bind": "GRAVE",
          "gdkKeyname": "grave",
          "keydFrom": "grave",
          "keydTo": "escape",
          "note": "minila 全角/半角键在底层识别为 grave (`)"
        }
      }
    },
    "at-translated-set-2-keyboard": {
      "displayName": "at translated set 2 keyboard",
      "hyprName": "at-translated-set-2-keyboard",
      "keydId": "0001:0001",
      "enabled": true,
      "remaps": []
    }
  }
}