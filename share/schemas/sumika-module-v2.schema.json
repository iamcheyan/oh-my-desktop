{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sumika-shell.dev/schemas/sumika-module-v2.schema.json",
  "title": "Sumika Module Manifest v2",
  "description": "Registry v2 static manifest — single source of truth for a Sumika Shell module",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "kind"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "description": "Must be 2",
      "type": "integer",
      "enum": [2]
    },
    "id": {
      "description": "Globally unique module identifier — lowercase, dash-separated",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 64
    },
    "name": {
      "description": "Human-readable module name",
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "description": "Short module description",
      "type": "string",
      "maxLength": 512
    },
    "version": {
      "description": "Semantic version",
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+"
    },
    "kind": {
      "description": "Isolation type",
      "type": "string",
      "enum": ["application", "overlay", "qml-singleton", "service-provider", "shared"]
    },
    "entry": {
      "description": "Required for kind=application. Process launch spec.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {
          "description": "Argv array — MUST NOT use shell strings with spaces",
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "instance": {
          "description": "Process instance name — must match omd-[a-z][a-z0-9-]*",
          "type": "string",
          "pattern": "^omd-[a-z][a-z0-9-]*$"
        },
        "appId": {
          "description": "Hyprland app-id / Wayland app_id",
          "type": "string",
          "pattern": "^[a-zA-Z0-9._-]+$"
        },
        "readyTimeout": {
          "description": "Seconds before the process is considered failed",
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        }
      }
    },
    "contributes": {
      "description": "What this module registers into the shell",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "widgets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "slot"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "description": "Widget ID — unique within this module",
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9-]*$"
              },
              "name": { "type": "string" },
              "slot": {
                "description": "Bar extension point slot",
                "type": "string",
                "enum": ["left", "right", "center"]
              },
              "component": {
                "description": "QML file path relative to module root",
                "type": "string",
                "pattern": "^(?!\\.\\./)"
              },
              "descriptor": {
                "description": "JSON descriptor path relative to module root",
                "type": "string",
                "pattern": "^(?!\\.\\./)"
              },
              "order": { "type": "integer", "minimum": 0 },
              "moduleId": { "type": "string" },
              "alwaysShow": { "type": "boolean" }
            }
          }
        },
        "popupSections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "component"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string" },
              "name": { "type": "string" },
              "component": {
                "type": "string",
                "pattern": "^(?!\\.\\./)"
              },
              "moduleId": { "type": "string" },
              "order": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "settingsPages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "title": { "type": "string" },
              "icon": { "type": "string" },
              "component": {
                "type": "string",
                "pattern": "^(?!\\.\\./)"
              },
              "handler": { "type": "string" },
              "moduleId": { "type": "string" },
              "order": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "services": {
          "description": "List of service IDs this module provides",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9-]*$"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "description": "Globally unique action ID",
                "type": "string",
                "pattern": "^[a-z][a-z0-9.-]*$"
              },
              "name": { "type": "string" },
              "description": { "type": "string" },
              "handler": {
                "description": "Handler spec — ipc:<id>, action:<id>, process:<argv>",
                "type": "string",
                "pattern": "^(ipc:|action:)[a-zA-Z0-9._-]+$"
              }
            }
          }
        },
        "overviewProviders": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "component": { "type": "string" },
              "handler": {
                "type": "string",
                "pattern": "^(ipc:|action:)[a-zA-Z0-9._-]+$"
              },
              "order": { "type": "integer", "minimum": 0 },
              "moduleId": { "type": "string" }
            }
          }
        },
        "launchers": {
          "description": "Desktop application entries to install in ~/.local/share/applications/",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "exec"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "description": "Launcher ID — must start with 'sumika-'; becomes <id>.desktop",
                "type": "string",
                "pattern": "^sumika-[a-z][a-z0-9-]*$"
              },
              "name": { "type": "string", "minLength": 1 },
              "comment": { "type": "string" },
              "exec": {
                "description": "Command line to execute (may reference bin/ scripts which are on PATH)",
                "type": "string",
                "minLength": 1
              },
              "icon": {
                "description": "Icon path — relative to module root or absolute",
                "type": "string",
                "pattern": "^(?!\\.\\./)"
              },
              "categories": {
                "type": "array",
                "items": { "type": "string" }
              },
              "terminal": { "type": "boolean", "default": false },
              "startupWmClass": { "type": "string" },
              "noDisplay": { "type": "boolean", "default": false },
              "moduleId": { "type": "string" }
            }
          }
        }
      }
    },
    "trustedInProcess": {
      "description": "If true, the module's QML components run in the host process (trusted). Default false.",
      "type": "boolean",
      "default": false
    },
    "permissions": {
      "description": "White-listed permissions required by this module",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]*$"
      }
    },
    "config": {
      "description": "Config ownership declaration",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relativePath": {
          "description": "Config path relative to sumika-shell config dir",
          "type": "string",
          "pattern": "^(?!\\.\\./)"
        }
      }
    }
  }
}
