#!/usr/bin/env python3
# List keyboards visible to Hyprland with optional keyd vendor:product IDs.
# A device is considered a keyboard if its input handlers include "leds"
# (meaning the kernel recognizes it as a keyboard with LED indicators)
# AND it has a KEY capability bitmap with letter keys.

import json
import re
import subprocess
import sys

def normalize_slug(name):
    name = name.lower()
    name = re.sub(r'[^a-z0-9]+', '-', name)
    return name.strip('-')

def parse_input_devices():
    """Parse /proc/bus/input/devices into a list of device dicts."""
    devices = []
    current = {}
    try:
        with open('/proc/bus/input/devices', 'r') as f:
            for line in f:
                line = line.strip()
                if not line:
                    if current:
                        devices.append(current)
                        current = {}
                    continue

                prefix = line[:2]
                if prefix == 'I:':
                    vendor_match = re.search(r'Vendor=([0-9a-fA-F]+)', line)
                    product_match = re.search(r'Product=([0-9a-fA-F]+)', line)
                    if vendor_match:
                        current['vendor'] = vendor_match.group(1).lower()
                    if product_match:
                        current['product'] = product_match.group(1).lower()
                elif prefix == 'N:':
                    name_match = re.search(r'Name="([^"]+)"', line)
                    if name_match:
                        current['name'] = name_match.group(1)
                elif prefix == 'H:':
                    current['handlers'] = line
                elif prefix == 'B:' and 'KEY=' in line:
                    flat_hex = line.split('KEY=')[1].replace(' ', '')
                    try:
                        current['key_val'] = int(flat_hex, 16)
                    except ValueError:
                        pass
        if current:
            devices.append(current)
    except Exception:
        pass
    return devices

def is_real_keyboard(dev):
    """Determine if an input device is a real keyboard.

    Heuristics (all must pass):
    1. Handlers include "kbd" and "leds" (kernel sees it as a keyboard with LEDs)
    2. KEY bitmap includes letter keys (bit 30 = 'a') and ESC (bit 1)
    3. Does NOT have a mouse handler itself
    """
    handlers = dev.get('handlers', '')
    key_val = dev.get('key_val', 0)
    has_kbd = 'kbd' in handlers
    has_leds = 'leds' in handlers
    has_mouse = 'mouse' in handlers
    has_esc = bool(key_val & (1 << 1))
    has_letter = bool(key_val & (1 << 30))
    vp = f"{dev.get('vendor', '')}:{dev.get('product', '')}"
    return has_kbd and has_leds and not has_mouse and has_esc and has_letter

def lookup_keyd_id(hypr_slug, parsed_devices):
    """Match a Hyprland keyboard slug to a /proc/bus/input/devices entry
    by name similarity, returning the vendor:product ID."""
    best_vendor, best_product = '', ''
    best_score = 0

    for dev in parsed_devices:
        if not is_real_keyboard(dev):
            continue
        name = dev.get('name', '')
        vendor = dev.get('vendor', '')
        product = dev.get('product', '')
        if not (name and vendor and product):
            continue

        slug = normalize_slug(name)
        score = 0
        if slug == hypr_slug:
            score = 3
        elif slug in hypr_slug or hypr_slug in slug:
            score = 2

        if score > best_score:
            best_score = score
            best_vendor = vendor
            best_product = product

    if best_score > 0:
        return f"{best_vendor}:{best_product}"
    return ""

def is_probable_keyboard(name, main):
    """Pre-filter Hyprland's keyboard list to exclude obvious non-keyboards
    before doing the expensive /proc/bus/input/devices lookup."""
    slug = normalize_slug(name)

    negatives = [
        'audio', 'sound', 'headset', 'headphone', 'microphone', 'speaker',
        'mouse', 'pointer', 'trackpad', 'touchpad', 'consumer-control',
        'system-control', 'virtual-keyboard', 'fcitx',
        'video-bus', 'intel-hid', 'button-array', 'laptop-support',
        'power-button', 'sleep-button', 'wacom', 'tablet',
        'keyd-virtual',
    ]
    if any(neg in slug for neg in negatives):
        return False
    return True

def main():
    try:
        res = subprocess.run(['hyprctl', '-j', 'devices'], capture_output=True, text=True, timeout=5)
        data = json.loads(res.stdout)
        keyboards = data.get('keyboards', [])
    except Exception:
        print('[]')
        sys.exit(0)

    parsed_devices = parse_input_devices()

    results = []
    for kb in keyboards:
        name = kb.get('name')
        if not name:
            continue
        main_flag = kb.get('main', False)
        if not is_probable_keyboard(name, main_flag):
            continue

        slug = normalize_slug(name)
        keyd_id = lookup_keyd_id(slug, parsed_devices)

        # Skip devices without a keyd ID — they can't be remapped.
        # This filters out mouse-only receivers that Hyprland lists
        # under keyboards (for their media-key interface) but have no
        # real keyboard LED interface in /proc/bus/input/devices.
        if not keyd_id:
            continue

        display_name = name.strip('- ').replace('-', ' ')

        is_main = slug == 'at-translated-set-2-keyboard' or (
            main_flag and 'keyd-virtual' not in slug
        )

        results.append({
            'hyprName': slug,
            'rawName': name,
            'displayName': display_name,
            'keydId': keyd_id,
            'layout': kb.get('layout', ''),
            'main': is_main
        })

    print(json.dumps(results))

if __name__ == '__main__':
    main()
