#!/bin/bash
# List keyboards visible to Hyprland with optional keyd vendor:product IDs.
set -eu

normalize_slug() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g'
}

is_probable_keyboard() {
    local name="$1"
    local main="$2"
    local slug
    slug="$(normalize_slug "$name")"

    case "$slug" in
        *audio*|*sound*|*headset*|*headphone*|*microphone*|*speaker*)
            return 1
            ;;
        *mouse*|*pointer*|*trackpad*|*touchpad*)
            return 1
            ;;
        *consumer-control*|*system-control*|*virtual-keyboard*|*fcitx*)
            return 1
            ;;
    esac

    if [[ "$main" == "true" ]]; then
        return 0
    fi

    case "$slug" in
        *keyboard*|*keychron*|*k380*|*k860*|*ergodox*|*hhkb*|*realforce*|*ansi*|*iso*|*logitech*|*microsoft*|*apple*|*dell*|*hp-*|*lenovo*)
            return 0
            ;;
    esac

    return 1
}

# Collect all keyd-capable input devices (NAME + vendor:product) from /proc/bus/input/devices.
# A device block is considered keyboard-capable if its KEY capability bitmap contains
# typical letter scancodes (evdev 30='a' and evdev 1='esc') AND we have NAME + Vendor + Product.
lookup_keyd_id() {
    local hypr_slug="$1"
    local name="" vendor="" product="" has_key=0 has_letter=0 has_esc=0
    local slug

    # Track the best match: exact slug first, then contains-slug fallback.
    local best_vendor="" best_product="" best_score=0

    while IFS= read -r line || [[ -n "$line" ]]; do
        case "$line" in
            "")
                if [[ -n "$name" && -n "$vendor" && -n "$product" && "$has_letter" -eq 1 && "$has_esc" -eq 1 ]]; then
                    slug="$(normalize_slug "$name")"
                    local score=0
                    if [[ "$slug" == "$hypr_slug" ]]; then
                        score=3
                    elif [[ "$slug" == *"$hypr_slug"* || "$hypr_slug" == *"$slug"* ]]; then
                        score=2
                    fi
                    if (( score > best_score )); then
                        best_score=$score
                        best_vendor="$vendor"
                        best_product="$product"
                    fi
                fi
                name=""; vendor=""; product=""
                has_key=0; has_letter=0; has_esc=0
                ;;
            I:*)
                vendor="$(printf '%s' "$line" | sed -n 's/.*Vendor=\([0-9a-fA-F]*\).*/\1/p')"
                product="$(printf '%s' "$line" | sed -n 's/.*Product=\([0-9a-fA-F]*\).*/\1/p')"
                ;;
            N:*)
                name="${line#N: Name=\"}"
                name="${name%\"}"
                ;;
            B:*KEY=*)
                local bitmap
                bitmap="${line#B: KEY=}"
                # bitmap is a hex string with spaces; flatten to one big hex number.
                local flat
                flat="$(printf '%s' "$bitmap" | tr -d ' ')"
                # Use Python to test evdev bits 1 (esc) and 30 (a) to avoid huge bash arithmetic.
                if python3 - <<PY >/dev/null 2>&1
flat = "${flat}"
if not flat:
    raise SystemExit(1)
# normalize to int from hex
try:
    val = int(flat, 16)
except ValueError:
    # leading zeros may have spaces stripped; try as base 16 with no prefix
    val = int(flat.lstrip('0x') or '0', 16)
esc = bool(val & (1 << 1))
letter = bool(val & (1 << 30))
raise SystemExit(0 if (esc and letter) else 1)
PY
                then
                    has_esc=1
                    has_letter=1
                fi
                has_key=1
                ;;
        esac
    done < /proc/bus/input/devices

    if (( best_score > 0 )); then
        printf '%s:%s' "$best_vendor" "$best_product"
        return 0
    fi
    return 1
}

if ! command -v hyprctl >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
    echo '[]'
    exit 0
fi

mapfile -t rows < <(hyprctl -j devices 2>/dev/null | jq -c '.keyboards[]?' 2>/dev/null || true)

printf '['
first=1
for row in "${rows[@]}"; do
    [[ -z "$row" ]] && continue
    name="$(jq -r '.name // empty' <<<"$row")"
    main="$(jq -r '.main // false' <<<"$row")"
    layout="$(jq -r '.layout // empty' <<<"$row")"
    [[ -z "$name" ]] && continue
    is_probable_keyboard "$name" "$main" || continue

    slug="$(normalize_slug "$name")"
    keyd_id="$(lookup_keyd_id "$slug" || true)"
    display="${name//-/ }"

    if [[ "$first" -eq 1 ]]; then
        first=0
    else
        printf ','
    fi

    jq -nc \
        --arg hyprName "$slug" \
        --arg rawName "$name" \
        --arg displayName "$display" \
        --arg keydId "$keyd_id" \
        --arg layout "$layout" \
        --argjson main "$main" \
        '{hyprName: $hyprName, rawName: $rawName, displayName: $displayName, keydId: $keydId, layout: $layout, main: $main}'
done
printf ']\n'