#!/bin/bash

# omarchy:summary=Watch Hyprland monitor events and repair monitor and wallpaper state

SOCKET="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"
WALLPAPER_LOCK="${XDG_RUNTIME_DIR:-/tmp}/sumika-wallpaper-output-refresh.lock"
MONITOR_TOGGLE_DIR="${SUMIKA_SHELL_STATE_HOME:-$HOME/.local/state/sumika-shell}/toggles/hypr"
EXTENSIONS_DIR="${SUMIKA_SHELL_EXTENSIONS_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/sumika-shell/extensions}"
WALLPAPER_BIN="$EXTENSIONS_DIR/theme-settings/bin/sumika-wallpaper"

refresh_wallpaper_outputs() {
  # Output geometry is not stable at the instant Hyprland publishes the event.
  # Coalesce bursts from dock/undock and render once against the final topology.
  (
    flock -n 9 || exit 0
    sleep 0.45
    "$WALLPAPER_BIN" refresh-outputs >/dev/null 2>&1 || true
  ) 9>"$WALLPAPER_LOCK" &
}

recover_internal_monitor() {
  local changed=false

  # If no external connector remains, stale disable/mirror overrides can leave
  # the laptop panel unavailable. The vendored Omarchy recovery scripts depend
  # on toggle helpers that are not present in this repository, so repair the two
  # concrete state files directly and reload Hyprland once when needed.
  "${SUMIKA_SHELL_ROOT:?SUMIKA_SHELL_ROOT is required}/bin/sumika-hw-external-monitors" && return 0

  for toggle in internal-monitor-disable internal-monitor-mirror; do
    if [[ -e "$MONITOR_TOGGLE_DIR/$toggle.lua" ]]; then
      rm -f "$MONITOR_TOGGLE_DIR/$toggle.lua"
      changed=true
    fi
  done

  [[ "$changed" == false ]] || hyprctl reload >/dev/null 2>&1 || true
}

socat -U - "UNIX-CONNECT:$SOCKET" | while read -r event; do
  case "$event" in
    monitoradded\>\>*|monitoraddedv2\>\>*)
      refresh_wallpaper_outputs
      ;;
    monitorremoved\>\>*|monitorremovedv2\>\>*)
      recover_internal_monitor
      refresh_wallpaper_outputs
      ;;
  esac
done
