#!/bin/bash

# omarchy:summary=Enable, disable, or toggle the touchpad
# omarchy:args=[on|off|toggle]

STATE_FILE="${SUMIKA_SHELL_STATE_HOME:-$HOME/.local/state/sumika-shell}/toggles/hypr/touchpad-disabled.lua"

# Detect the touchpad device name without depending on `sumika-hw-touchpad`
# (removed from the repo). Parse /proc/bus/input/devices for a device whose
# handlers include a mouse (touchpads expose one) and whose name mentions a
# touchpad/trackpad.
hw_touchpad() {
  awk -v RS='' '/Handlers=.*mouse/ && /Touchpad|Trackpad|touchpad|trackpad/' \
    /proc/bus/input/devices 2>/dev/null \
    | sed -n 's/^N: Name="\(.*\)"$/\1/p' \
    | head -n1
}

device="$(hw_touchpad)"

if [[ -z $device ]]; then
  echo "No touchpad device found" >&2
  exit 1
fi

if pgrep -x labwc >/dev/null 2>&1; then
  # labwc has no runtime per-device enable/disable interface (libinput is
  # configured statically from rc.xml). Fail loudly instead of pretending.
  echo "Touchpad toggle is not supported on labwc (no runtime device control)" >&2
  exit 1
fi

enable() {
  hyprctl eval "hl.device({ name = \"$device\", enabled = true })" >/dev/null
  rm -f "$STATE_FILE"
  sumika-swayosd-client --custom-icon input-touchpad-symbolic --custom-message "Touchpad enabled"
}

disable() {
  hyprctl eval "hl.device({ name = \"$device\", enabled = false })" >/dev/null
  mkdir -p "$(dirname "$STATE_FILE")"
  printf 'hl.device({ name = "%s", enabled = false })\n' "$device" >"$STATE_FILE"
  sumika-swayosd-client --custom-icon touchpad-disabled-symbolic --custom-message "Touchpad disabled"
}

case "${1:-toggle}" in
  on) enable ;;
  off) disable ;;
  toggle) if [[ -f $STATE_FILE ]]; then enable; else disable; fi ;;
esac
