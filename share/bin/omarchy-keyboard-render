#!/usr/bin/env bash
# Render keyd config from OMD keyboard-remap profiles.
set -eu

OMD_ROOT="${HOME}/.config/omd"
PROFILES="${OMD_ROOT}/keyboard-remap/profiles.json"

if [[ ! -f "$PROFILES" ]]; then
    echo '{"version":1,"devices":{}}' >"$PROFILES"
fi

if ! command -v jq >/dev/null 2>&1; then
    echo "ERROR: jq is required" >&2
    exit 1
fi

{
    echo "# Generated by OMD keyboard-remap — do not edit manually"
    echo "# Source: ~/.config/omd/keyboard-remap/profiles.json"
    echo

    jq -r '
        def preset_remaps($id; $overrides):
          # Get base remaps, then apply per-device overrides for remap-type presets
          (
            if $id == "alt-win-swap" then
              [
                {"from":"leftalt","to":"leftmeta"},
                {"from":"leftmeta","to":"leftalt"},
                {"from":"rightalt","to":"rightmeta"},
                {"from":"rightmeta","to":"rightalt"}
              ]
            elif $id == "ctrl-caps-swap" then
              [
                {"from":"leftcontrol","to":"capslock"},
                {"from":"capslock","to":"leftcontrol"}
              ]
            elif $id == "grave-esc-swap" then
              [
                {"from":"grave","to":"escape"},
                {"from":"escape","to":"grave"}
              ]
            elif $id == "caps-esc" then
              [{"from":"capslock","to":"escape"}]
            elif $id == "muhenkan-meta" then
              [{"from":"muhenkan","to":"leftmeta"}]
            elif $id == "meta-f13" then
              [{"from":"leftmeta","to":"f13"}]
            elif $id == "kana-left" then
              [{"from":"katakanahiragana","to":"left"}]
            elif $id == "rightalt-down" then
              [{"from":"rightalt","to":"down"}]
            elif $id == "delete-right" then
              [{"from":"delete","to":"right"}]
            elif $id == "rightctrl-up" then
              [{"from":"rightcontrol","to":"up"}]
            else
              []
            end
          ) | map(
            if (["caps-esc", "muhenkan-meta", "meta-f13", "kana-left", "rightalt-down", "delete-right", "rightctrl-up"] | index($id))
               and (($overrides[$id] // "") | length > 0) then
              . + {"to": $overrides[$id]}
            else . end
          );

        def clean_remaps($rows):
          reduce (($rows // []) | map(select(.from and .to))[]) as $row
            ({}; .[$row.from] = $row.to)
          | to_entries
          | map({"from": .key, "to": .value});

        def preset_rows($ids; $overrides):
          ($ids // []) | map(preset_remaps(.; $overrides)) | add // [];

        .devices
        | to_entries[]
        | select(.value.enabled != false)
        | . as $dev
        | ($dev.value.enabledPresets // []) as $deviceEnabled
        | ($dev.value.presetOverrides // {}) as $overrides
        | preset_rows($deviceEnabled; $overrides) as $deviceRemaps
        | clean_remaps($deviceRemaps) as $remaps
        | select($remaps | length > 0)
        | ($dev.value.keydId // "") as $id
        | if ($id | length) > 0 then
            "[ids]\nk:" + $id + "\n\n[main]\n"
            + ($remaps
                | map(.from + " = " + .to)
                | join("\n"))
            + "\n"
          else
            "## WARN: device \($dev.key) has presets but no keydId — skipped\n"
          end
    ' "$PROFILES"
} | perl -0pe 's/\n+\z/\n/'
