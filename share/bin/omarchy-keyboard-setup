#!/bin/bash
# Check or install keyd for OMD keyboard remapping.
set -eu

KEYD_SRC="${HOME}/.cache/omd-keyd-src"
KEYD_REPO="https://github.com/rvaiya/keyd.git"

start_keyd() {
    if command -v systemctl >/dev/null 2>&1; then
        if command -v pkexec >/dev/null 2>&1; then
            pkexec systemctl enable --now keyd 2>/dev/null || sudo systemctl enable --now keyd
        else
            sudo systemctl enable --now keyd
        fi
    else
        sudo pkill -x keyd 2>/dev/null || true
        sudo keyd &
    fi
}

install_polkit_rule() {
    local src="${HOME}/.local/share/omarchy/polkit-1/rules.d/50-omd-keyboard.rules"
    local dest="/etc/polkit-1/rules.d/50-omd-keyboard.rules"
    if [[ ! -f "$src" ]]; then
        return 0
    fi
    if [[ -f "$dest" ]] && cmp -s "$src" "$dest" 2>/dev/null; then
        return 0
    fi
    if command -v pkexec >/dev/null 2>&1; then
        pkexec install -Dm 0644 "$src" "$dest" 2>/dev/null || sudo install -Dm 0644 "$src" "$dest" 2>/dev/null || true
    else
        sudo install -Dm 0644 "$src" "$dest" 2>/dev/null || true
    fi
    # Best-effort: reload polkit so the new rule takes effect immediately.
    if command -v systemctl >/dev/null 2>&1; then
        systemctl reload polkit 2>/dev/null || true
    fi
}

if command -v keyd >/dev/null 2>&1; then
    if ! systemctl is-active keyd >/dev/null 2>&1; then
        start_keyd
    fi
    if systemctl is-active keyd >/dev/null 2>&1 || pgrep -x keyd >/dev/null 2>&1; then
        echo "keyd-ready"
        exit 0
    fi
fi

for dep in gcc git make; do
    if ! command -v "$dep" >/dev/null 2>&1; then
        echo "ERROR: missing build dependency: $dep" >&2
        exit 1
    fi
done

mkdir -p "$(dirname "$KEYD_SRC")"
if [[ ! -d "$KEYD_SRC/.git" ]]; then
    git clone --depth 1 "$KEYD_REPO" "$KEYD_SRC"
fi

make -C "$KEYD_SRC" -j"$(nproc)"
if command -v pkexec >/dev/null 2>&1; then
    pkexec make -C "$KEYD_SRC" install
else
    sudo make -C "$KEYD_SRC" install
fi

start_keyd

install_polkit_rule

# Help libinput treat keyd virtual keyboard as internal (MINILA convertible etc.)
LIBINPUT_QUIRKS="/etc/libinput/local-overrides.quirks"
if [[ ! -f "$LIBINPUT_QUIRKS" ]] || ! grep -q 'MatchName=keyd\*keyboard' "$LIBINPUT_QUIRKS" 2>/dev/null; then
    if command -v pkexec >/dev/null 2>&1; then
        pkexec bash -c "cat > '$LIBINPUT_QUIRKS'" <<'EOF' 2>/dev/null || true
[Serial Keyboards]
MatchUdevType=keyboard
MatchName=keyd*keyboard
AttrKeyboardIntegration=internal
EOF
    else
        sudo tee "$LIBINPUT_QUIRKS" >/dev/null <<'EOF' 2>/dev/null || true
[Serial Keyboards]
MatchUdevType=keyboard
MatchName=keyd*keyboard
AttrKeyboardIntegration=internal
EOF
    fi
fi

if command -v keyd >/dev/null 2>&1 && systemctl is-active keyd >/dev/null 2>&1; then
    echo "keyd-ready"
    if [[ ! -f /etc/polkit-1/rules.d/50-omd-keyboard.rules ]]; then
        echo "NOTE: polkit rule not installed — Apply will prompt for password. Re-run setup to install." >&2
    fi
    exit 0
fi

echo "ERROR: keyd install finished but service is not running" >&2
exit 1