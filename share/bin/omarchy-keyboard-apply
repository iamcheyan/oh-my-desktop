#!/bin/bash
# Generate keyd config from OMD profiles and install via pkexec.
set -eu

OMD_ROOT="${HOME}/.config/omd"
PROFILES="${OMD_ROOT}/keyboard-remap/profiles.json"
GENERATED="${OMD_ROOT}/keyboard-remap/keyd.generated.conf"
KEYD_DEST="/etc/keyd/omd.conf"

mkdir -p "$(dirname "$PROFILES")"

if [[ ! -f "$PROFILES" ]]; then
    echo '{"version":1,"devices":{}}' >"$PROFILES"
fi

if ! command -v jq >/dev/null 2>&1; then
    echo "ERROR: jq is required" >&2
    exit 1
fi

{
    echo "# Generated by OMD keyboard-remap — do not edit manually"
    echo "# Source: ~/.config/omd/keyboard-remap/profiles.json"
    echo
    echo "[ids]"
    echo "*"
    echo
    echo "[main]"
    echo

    jq -r '
        .devices
        | to_entries[]
        | select(.value.enabled != false)
        | select(
            ((.value.remaps // []) | length > 0)
            or ((.value.layers // {}) | length > 0)
          )
        | . as $dev
        | ($dev.value.keydId // "") as $id
        | if ($id | length) > 0 then
            "[ids]\nk:" + $id + "\n\n[main]\n"
            + (($dev.value.remaps // [])
                | map(select(.from and .to))
                | map(.from + " = " + .to)
                | join("\n"))
            + (
                ($dev.value.layers // {})
                | to_entries
                | map(
                    "\n\n[" + .key + "]\n"
                    + (.value
                        | map(select(.from and .to))
                        | map(.from + " = " + .to)
                        | join("\n"))
                  )
                | join("")
              )
            + "\n"
          else
            empty
          end
    ' "$PROFILES"
} >"$GENERATED"

if ! command -v keyd >/dev/null 2>&1; then
    echo "ERROR: keyd is not installed. Run omarchy-keyboard-setup first." >&2
    exit 2
fi

if ! command -v pkexec >/dev/null 2>&1; then
    echo "ERROR: pkexec is required to install keyd config under /etc/keyd" >&2
    exit 3
fi

pkexec bash -c "
    set -eu
    mkdir -p /etc/keyd
    install -m 0644 '$GENERATED' '$KEYD_DEST'
    if command -v systemctl >/dev/null 2>&1; then
        systemctl enable keyd >/dev/null 2>&1 || true
        systemctl restart keyd
    else
        pkill -x keyd 2>/dev/null || true
        keyd &
    fi
"

echo "applied"