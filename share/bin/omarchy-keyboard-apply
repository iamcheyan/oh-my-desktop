#!/bin/bash
# Generate keyd config from OMD profiles and install via pkexec.
set -eu

OMD_ROOT="${HOME}/.config/omd"
PROFILES="${OMD_ROOT}/keyboard-remap/profiles.json"
GENERATED="${OMD_ROOT}/keyboard-remap/keyd.generated.conf"
KEYD_DEST="/etc/keyd/omd.conf"
RENDER="${OMD_ROOT}/share/bin/omarchy-keyboard-render"

mkdir -p "$(dirname "$PROFILES")"

if [[ ! -f "$PROFILES" ]]; then
    echo '{"version":1,"devices":{}}' >"$PROFILES"
fi

if ! command -v jq >/dev/null 2>&1; then
    echo "ERROR: jq is required" >&2
    exit 1
fi

"$RENDER" >"$GENERATED"

# Surface empty-id warnings on stderr (UI picks up ERROR: lines; this is a softer WARN).
if grep -q '^## WARN' "$GENERATED"; then
    echo "WARN: one or more profiles skipped because keydId is missing" >&2
fi

if ! command -v keyd >/dev/null 2>&1; then
    echo "ERROR: keyd is not installed. Run omarchy-keyboard-setup first." >&2
    exit 2
fi

if ! command -v pkexec >/dev/null 2>&1; then
    echo "ERROR: pkexec is required to install keyd config under /etc/keyd" >&2
    exit 3
fi

pkexec bash -c "
    set -eu
    mkdir -p /etc/keyd
    install -m 0644 '$GENERATED' '$KEYD_DEST'
    if command -v systemctl >/dev/null 2>&1; then
        systemctl enable keyd >/dev/null 2>&1 || true
        systemctl restart keyd
    else
        pkill -x keyd 2>/dev/null || true
        keyd &
    fi
"

echo "applied"
