#!/usr/bin/env bash
# Generate keyd config from OMD profiles and install with an available
# privilege helper.
set -eu

# Resolve the true OMD_ROOT directory even if executed under sudo
REAL_HOME="${HOME}"
if [[ "${USER:-}" == "root" && -n "${SUDO_USER:-}" ]]; then
    REAL_HOME=$(getent passwd "$SUDO_USER" | cut -d: -f6)
fi

OMD_ROOT="${OMD_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/../.." && pwd)}"
# Sumika Shell paths (user config + generated state)
SUMIKA_CONFIG="${SUMIKA_SHELL_CONFIG_HOME:-${XDG_CONFIG_HOME:-$REAL_HOME/.config}/sumika-shell}"
SUMIKA_STATE="${SUMIKA_SHELL_STATE_HOME:-${XDG_STATE_HOME:-$REAL_HOME/.local/state}/sumika-shell}"
# profiles.json: user-authored config (new path with legacy fallback for reads)
PROFILES="${SUMIKA_CONFIG}/keyboard-remap/profiles.json"
PROFILES_LEGACY="${OMD_ROOT}/keyboard-remap/profiles.json"
# keyd.generated.conf: generated state (always write to new path)
GENERATED="${SUMIKA_STATE}/keyboard-remap/keyd.generated.conf"
KEYD_DEST="/etc/keyd/omd.conf"
RENDER="${OMD_ROOT}/share/bin/omarchy-keyboard-render"

mkdir -p "$(dirname "$PROFILES")" "$(dirname "$GENERATED")"

# Fall back to legacy path if new profiles don't exist yet
if [[ ! -f "$PROFILES" && -f "$PROFILES_LEGACY" ]]; then
    cp "$PROFILES_LEGACY" "$PROFILES"
fi

if [[ ! -f "$PROFILES" ]]; then
    echo '{"version":1,"devices":{}}' >"$PROFILES"
fi

if ! command -v jq >/dev/null 2>&1; then
    echo "ERROR: jq is required" >&2
    exit 1
fi

"$RENDER" >"$GENERATED"

# Surface empty-id warnings on stderr (UI picks up ERROR: lines; this is a softer WARN).
if grep -q '^## WARN' "$GENERATED"; then
    echo "WARN: one or more profiles skipped because keydId is missing" >&2
fi

if ! command -v keyd >/dev/null 2>&1; then
    echo "ERROR: keyd is not installed. Run omd-keyboard-setup first." >&2
    exit 2
fi

install_payload="
    set -eu
    mkdir -p /etc/keyd
    install -m 0644 '$GENERATED' '$KEYD_DEST'
    if command -v systemctl >/dev/null 2>&1; then
        systemctl enable keyd >/dev/null 2>&1 || true
        systemctl restart keyd
    else
        pkill -x keyd 2>/dev/null || true
        keyd &
    fi
"

apply_as_root() {
    if command -v pkexec >/dev/null 2>&1 && pkexec bash -c "$install_payload"; then
        return 0
    fi

    if command -v run0 >/dev/null 2>&1 && run0 --pipe bash -c "$install_payload"; then
        return 0
    fi

    if command -v sudo >/dev/null 2>&1 && sudo -n bash -c "$install_payload"; then
        return 0
    fi

    return 1
}

if ! apply_as_root; then
    echo "ERROR: failed to install keyd config. pkexec/run0/sudo could not elevate privileges." >&2
    exit 3
fi

echo "applied"
