#!/bin/bash

# OMD compatibility implementation for omd-lock.

if ! pidof hyprlock >/dev/null; then
  (
    hyprlock --config ~/.config/omd/hypr/hyprlock.conf
    omd-wake
  ) &
fi

# Set keyboard layout to default (first layout)
hyprctl switchxkblayout all 0 > /dev/null 2>&1

# Ensure 1password is locked
if pgrep -x "1password" >/dev/null; then
  1password --lock &
fi

# Avoid running screensaver when locked
pkill -f org.omd.screensaver

if [[ ${OMD_LOCK_ONLY:-false} != "true" ]]; then
  (
    sleep 3
    pidof hyprlock >/dev/null || exit 0
    omd-brightness-keyboard off
    omd-brightness-display off
  ) &
fi
