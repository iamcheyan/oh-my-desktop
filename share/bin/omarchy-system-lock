#!/bin/bash

# Sumika Shell lock implementation.

# Set keyboard layout to default (first layout)
hyprctl switchxkblayout all 0 > /dev/null 2>&1

# Ensure 1password is locked
if pgrep -x "1password" >/dev/null; then
  1password --lock &
fi

# Avoid running screensaver when locked
pkill -f io.github.iamcheyan.sumika.screensaver

if [[ ${SUMIKA_LOCK_ONLY:-false} != "true" ]]; then
  (
    sleep 3
    # Wait for lock screen to be active
    sleep 2
    # Brightness gamma module not available in single-repo architecture
    true
  ) &
fi
