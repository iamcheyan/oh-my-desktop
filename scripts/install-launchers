#!/usr/bin/env bash
# Install custom OMD desktop launchers into the user applications directory.
#
# Source entries live in <repo>/launchers/*.desktop and reference assets via
# $HOME/.config/omd/... paths. This script expands $HOME to the real home
# directory and copies each entry (and its icons) into
# ~/.local/share/applications, where the app launcher cache picks them up.
#
# Usage:
#   scripts/install-launchers          install all entries
#   scripts/install-launchers --dry    print what would be installed

set -euo pipefail

REPO="${OMD_REPO:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
SRC_DIR="$REPO/launchers"
APP_DIR="$HOME/.local/share/applications"
ICON_SRC_DIR="$SRC_DIR/icons"
ICON_DST_DIR="$APP_DIR/icons"

DRY=0
[[ "${1:-}" == "--dry" ]] && DRY=1

info() { echo "[install-launchers] $*"; }
err()  { echo "[install-launchers] ERROR: $*" >&2; }

expand_home() {
  # Replace leading $HOME or ${HOME} with the real home directory.
  local s="$1"
  s="${s//\$\{HOME\}/$HOME}"
  s="${s//\$HOME/$HOME}"
  printf '%s' "$s"
}

if [[ ! -d "$SRC_DIR" ]]; then
  err "source directory not found: $SRC_DIR"
  exit 1
fi

shopt -s nullglob
entries=("$SRC_DIR"/*.desktop)
shopt -u nullglob

if (( ${#entries[@]} == 0 )); then
  info "no .desktop entries found in $SRC_DIR"
  exit 0
fi

if (( DRY == 0 )); then
  mkdir -p "$APP_DIR" "$ICON_DST_DIR"
fi

for src in "${entries[@]}"; do
  name="$(basename "$src")"
  dst="$APP_DIR/$name"

  # Expand $HOME in the file contents so the launcher cache resolves paths.
  if (( DRY == 1 )); then
    info "would install: $src -> $dst"
  else
    sed "s|\$HOME|$HOME|g; s|\${HOME}|$HOME|g" "$src" > "$dst.tmp"
    mv "$dst.tmp" "$dst"
    info "installed: $dst"
  fi
done

# Copy icons alongside the entries.
if [[ -d "$ICON_SRC_DIR" ]]; then
  shopt -s nullglob
  icons=("$ICON_SRC_DIR"/*)
  shopt -u nullglob
  for icon in "${icons[@]}"; do
    base="$(basename "$icon")"
    if (( DRY == 1 )); then
      info "would copy icon: $icon -> $ICON_DST_DIR/$base"
    else
      cp "$icon" "$ICON_DST_DIR/$base"
      info "copied icon: $ICON_DST_DIR/$base"
    fi
  done
fi

if (( DRY == 0 )); then
  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database "$APP_DIR" 2>/dev/null || true
  fi
  info "done. Restart the app launcher (or it refreshes on next open) to see new entries."
fi
