#!/usr/bin/env python3
"""Read the last key capture from state file or clipboard; emit JSON for Quickshell."""

import json
import os
import subprocess
import sys

SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, SCRIPT_DIR)

from key_capture_clipboard import parse_clipboard_text  # noqa: E402
from key_evdev_names import gtk_keycode_to_keyd  # noqa: E402
from keyremap_keymap import hypr_to_keyd  # noqa: E402

STATE_FILE = os.path.expanduser("~/.local/state/omd/key-capture.json")


def read_state() -> dict | None:
    if not os.path.isfile(STATE_FILE):
        return None
    try:
        with open(STATE_FILE, "r", encoding="utf-8") as handle:
            data = json.load(handle)
        if isinstance(data, dict) and data.get("raw"):
            return data
    except Exception:
        return None
    return None


def read_clipboard() -> str:
    try:
        res = subprocess.run(["wl-paste"], capture_output=True, text=True, check=False)
        return (res.stdout or "").strip()
    except Exception:
        return ""


def resolve_keyd(
    raw: str,
    keyname: str = "",
    keycode: int | None = None,
    keyd_hint: str = "",
) -> str | None:
    if keyd_hint:
        return keyd_hint
    if keycode is not None:
        keyd = gtk_keycode_to_keyd(keycode)
        if keyd:
            return keyd
    keyd = hypr_to_keyd(raw)
    if keyd:
        return keyd
    if keyname:
        keyd = hypr_to_keyd(keyname.upper().replace("-", "_"))
        if keyd:
            return keyd
        keyd = hypr_to_keyd(keyname)
        if keyd:
            return keyd
    return None


def main() -> int:
    state = read_state() or {}
    clipboard = parse_clipboard_text(read_clipboard()) if not state.get("raw") else {}
    raw = (state.get("raw") or clipboard.get("bind") or "").strip()
    keyname = state.get("keyname") or clipboard.get("keyname") or ""
    keyval = state.get("keyval") if state.get("keyval") is not None else clipboard.get("keyval")
    keycode = state.get("keycode") if state.get("keycode") is not None else clipboard.get("keycode")
    keyd_hint = state.get("keyd") or clipboard.get("keyd") or ""
    evdev = state.get("evdev") if state.get("evdev") is not None else clipboard.get("evdev")
    keyd = resolve_keyd(raw, keyname, keycode, keyd_hint)

    payload = {
        "raw": raw,
        "keyname": keyname,
        "keyval": keyval,
        "keycode": keycode,
        "evdev": evdev,
        "keyd": keyd or "",
        "ok": bool(raw) and bool(keyd),
    }

    if not raw:
        payload["error"] = "no key captured — press a key in the capture window first"
    elif not keyd:
        if " + " in raw:
            payload["error"] = "combo keys are not supported — press a single key"
        elif raw.lower().startswith("code:"):
            payload["error"] = f"hardware key {raw} has no keyd mapping yet"
        else:
            payload["error"] = f"unknown key '{raw}'"

    print(json.dumps(payload, ensure_ascii=False))
    return 0 if payload.get("ok") else 1


if __name__ == "__main__":
    sys.exit(main())