#!/usr/bin/env python3
"""
OMD Advanced Key Capture — GTK4 Edition
原生 Wayland 窗口，可捕获包括 Globe/Fn 在内的所有硬件按键与组合键，
并自动格式化为 OMD 绑定字符串写入系统剪贴板。
"""

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Gtk, Gdk, Gio, Adw, GLib
import json
import os
import subprocess
import sys
import atexit

SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, SCRIPT_DIR)
from key_capture_clipboard import build_clipboard_text  # noqa: E402
from key_evdev_names import gtk_keycode_to_evdev, gtk_keycode_to_keyd  # noqa: E402

CAPTURE_STATE = os.path.expanduser("~/.local/state/omd/key-capture.json")
CAPTURE_LOCK = os.path.expanduser("~/.local/state/omd/key-capture.lock")
KEYD_BYPASSED_FOR_CAPTURE = False

# ── 自动还原热键 ──
def restore_hotkeys():
    subprocess.run(["hyprctl", "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

atexit.register(restore_hotkeys)
# Note: per-window restore is handled in on_destroy / on_is_active_changed.

def _run_quiet(*command):
    return subprocess.run(
        list(command),
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    ).returncode

def keyd_is_active():
    return _run_quiet("systemctl", "is-active", "--quiet", "keyd") == 0

def bypass_keyd_for_capture():
    """Temporarily stop keyd so remap capture sees physical keys, not remapped output."""
    global KEYD_BYPASSED_FOR_CAPTURE
    if not keyd_is_active():
        return False
    if _run_quiet("sudo", "-n", "systemctl", "stop", "keyd") == 0:
        KEYD_BYPASSED_FOR_CAPTURE = True
        return True
    if _run_quiet("pkexec", "systemctl", "stop", "keyd") == 0:
        KEYD_BYPASSED_FOR_CAPTURE = True
        return True
    return False

def restore_keyd_after_capture():
    global KEYD_BYPASSED_FOR_CAPTURE
    if not KEYD_BYPASSED_FOR_CAPTURE:
        return
    if _run_quiet("sudo", "-n", "systemctl", "start", "keyd") != 0:
        _run_quiet("pkexec", "systemctl", "start", "keyd")
    KEYD_BYPASSED_FOR_CAPTURE = False

atexit.register(restore_keyd_after_capture)

# ── 运行锁文件 ──
def write_lock():
    try:
        os.makedirs(os.path.dirname(CAPTURE_LOCK), exist_ok=True)
        with open(CAPTURE_LOCK, "w") as f:
            f.write(str(os.getpid()))
        return True
    except Exception:
        return False

def remove_lock():
    try:
        if os.path.exists(CAPTURE_LOCK):
            os.unlink(CAPTURE_LOCK)
    except Exception:
        pass

def clear_capture_state():
    try:
        if os.path.exists(CAPTURE_STATE):
            os.unlink(CAPTURE_STATE)
    except Exception:
        pass

atexit.register(remove_lock)

import signal
def _signal_handler(signum, frame):
    remove_lock()
    restore_keyd_after_capture()
    restore_hotkeys()
    raise SystemExit(0)

signal.signal(signal.SIGTERM, _signal_handler)
signal.signal(signal.SIGINT, _signal_handler)

# ── 写入 remap 捕捉状态 ──
def write_capture_state(raw, keycode, keyval, keyname, keyd_name="", evdev_code=None):
    try:
        if not keyd_name:
            keyd_name = gtk_keycode_to_keyd(keycode) or ""
        if evdev_code is None:
            evdev_code = gtk_keycode_to_evdev(keycode)
        os.makedirs(os.path.dirname(CAPTURE_STATE), exist_ok=True)
        with open(CAPTURE_STATE, "w", encoding="utf-8") as handle:
            json.dump({
                "raw": raw,
                "keycode": keycode,
                "keyval": keyval,
                "keyname": keyname or "",
                "keyd": keyd_name,
                "evdev": evdev_code,
            }, handle)
        return True
    except Exception:
        return False

# ── 复制到剪贴板 ──
def copy_to_clipboard(text):
    try:
        process = subprocess.Popen(['wl-copy'], stdin=subprocess.PIPE)
        process.communicate(input=text.encode('utf-8'))
        return True
    except Exception:
        return False

# ── 主窗口 ──
