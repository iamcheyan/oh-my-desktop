        self.val_bind = add_row(details_grid, 5, "Hypr bind")
        self.val_clipboard = add_row(details_grid, 6, "Clipboard")
        self.detail_values = (
            self.val_keyd, self.val_evdev, self.val_name, self.val_val,
            self.val_code, self.val_bind, self.val_clipboard,
