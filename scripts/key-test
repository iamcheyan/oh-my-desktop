        # spacer
        spacer = Gtk.Box()
        spacer.set_vexpand(True)
        content_card.append(spacer)

        # quit button
        quit_btn = Gtk.Button(label="Exit (Q)")
        quit_btn.add_css_class("quit-btn")
        quit_btn.set_halign(Gtk.Align.CENTER)
        quit_btn.connect("clicked", lambda _: app.quit())
        content_card.append(quit_btn)

        # ── key events ──
        key_ctrl = Gtk.EventControllerKey()
        key_ctrl.connect("key-pressed", self.on_key_pressed)
        self.add_controller(key_ctrl)
        self.update_mode_text()

    def is_original_mode(self):
        return self.capture_mode == "original"

    def update_mode_text(self):
        if self.is_original_mode():
            self.hint.set_label(
                "Raw Source — keyd is paused · shows the physical key as sent by hardware"
            )
            self.info_lbl.set_label(
                "  \u2022  Large text is the raw keyd physical key name — use as remap source.\n"
                "  \u2022  keyd is paused so existing remaps won't affect capture.\n"
                "  \u2022  Escape and Q are also capturable — use Ctrl+W or button to exit."
            )
        else:
            self.hint.set_label(
                "Current Key — keyd is running · shows what apps actually receive"
            )
            self.info_lbl.set_label(
                "  \u2022  Large text shows the current keyd-mapped value, not the raw key.\n"
                "  \u2022  Hypr bind is the key name used by Hyprland and applications.\n"
                "  \u2022  Press Q, Escape or the exit button to close."
            )

    def reset_capture_display(self):
        clear_capture_state()
        self.key_display.set_label("( waiting for input )")
        self.keyd_display.set_label("")
        self.bind_display.set_label("")
        self.status_label.set_label("")
        for value in self.detail_values:
            value.set_label("\u2014")

    def on_mode_toggled(self, button, mode):
        if self._updating_mode or not button.get_active() or mode == self.capture_mode:
            return

        if mode == "original" and not bypass_keyd_for_capture() and keyd_is_active():
            self._updating_mode = True
            self.current_mode_btn.set_active(True)
            self._updating_mode = False
            self.status_label.set_label("\u2717 cannot pause keyd, using current key values")
            return

        if mode == "current":
            restore_keyd_after_capture()

        self.capture_mode = mode
        self.reset_capture_display()
        self.update_mode_text()

    def can_export_capture(self):
        return not self.mode_locked or self.capture_mode == self.initial_mode

    # ── window callbacks ──
    def on_realize(self, widget):
        surface = widget.get_surface()
        if surface and hasattr(surface, "inhibit_system_shortcuts"):
            surface.inhibit_system_shortcuts(None)

    def on_is_active_changed(self, window, param):
        if window.get_property("is-active"):
            # window gained focus: unbind Hyprland binds so events reach us
            # uses hyprctl binds to list all binds, then unbinds each
            self.unbind_all_hypr_binds()
        else:
            # window lost focus: restore global shortcuts
            self.restore_hypr_binds()

    def on_destroy(self, window):
        # window closed: restore binds, keyd, remove lock
        self.restore_hypr_binds()
        restore_keyd_after_capture()
        remove_lock()

    def unbind_all_hypr_binds(self):
        """List all Hyprland binds and unbind each, so capture is not stolen by any hotkey."""
        try:
            res = subprocess.run(
                ["hyprctl", "-j", "binds"],
                capture_output=True, text=True, check=False, timeout=2,
            )
            if res.returncode != 0 or not res.stdout:
                return
            import json as _json
            binds = _json.loads(res.stdout or "[]")
            cmds = []
            for entry in binds:
                # entry has keys: key, modmask, keycode, catchall, etc.
                key = entry.get("key") or ""
                modmask = entry.get("modmask") or 0
                if not key:
                    continue
                # Reconstruct the bind string. key is already the symbol (e.g. "ALT + A", "code:472").
                # hyprctl eval unbind expects the same string used in the bind.
                cmds.append(f'hl.unbind("{key}");')
            if cmds:
                subprocess.run(
                    ["hyprctl", "eval", " ".join(cmds)],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2,
                )
        except Exception:
            pass

    def restore_hypr_binds(self):
        """Reload Hyprland config to restore all global binds."""
        subprocess.run(["hyprctl", "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # ── key capture ──
    def preferred_bind_name(self, keyname, keycode):
        xf86_short_names = {
            "Tools": "XF86Tools",
        }
        if not self.is_original_mode() and keyname in xf86_short_names:
            return xf86_short_names[keyname]
        if keyname:
            mapped_name = keyname.upper()
            if mapped_name in ("RETURN", "KP_ENTER"):
                return "RETURN"
            return mapped_name
        return f"code:{keycode}"

    def on_key_pressed(self, ctrl, keyval, keycode, state):
        keyname = Gdk.keyval_name(keyval) or ""
        
        # exclude solitary modifier presses
        is_modifier = keyval in (
            Gdk.KEY_Control_L, Gdk.KEY_Control_R,
            Gdk.KEY_Alt_L, Gdk.KEY_Alt_R,
            Gdk.KEY_Super_L, Gdk.KEY_Super_R,
            Gdk.KEY_Shift_L, Gdk.KEY_Shift_R,
            Gdk.KEY_Meta_L, Gdk.KEY_Meta_R
        )

        # Q/ESC exits only in the generic key-test mode. Remap mode must be able
        # to capture those keys as valid remap sources.
        if not self.is_original_mode() and not is_modifier and keyname in ("q", "Q", "Escape"):
            self.get_application().quit()
            return True

        # parse modifiers
        mods = []
        if state & Gdk.ModifierType.SUPER_MASK:
            mods.append("SUPER")
        if state & Gdk.ModifierType.CONTROL_MASK:
            mods.append("CTRL")
        if state & Gdk.ModifierType.ALT_MASK:
            mods.append("ALT")
        if state & Gdk.ModifierType.SHIFT_MASK:
            # only add SHIFT when other mods or key is non-alpha (avoid 'SHIFT + A')
            if mods or len(keyname) > 1:
                mods.append("SHIFT")

        def finalize_capture(final_key):
            keyd_name = gtk_keycode_to_keyd(keycode) or ""
            evdev_code = gtk_keycode_to_evdev(keycode)
            if keyd_name:
                self.key_display.set_label(keyd_name)
                self.keyd_display.set_label(
                    "original keyd physical key name"
                    if self.is_original_mode()
                    else "keyd-mapped current key value"
                )
            else:
                self.key_display.set_label(f"[ {final_key} ]")
                self.keyd_display.set_label("unrecognized physical key")
            self.bind_display.set_label(
                f"Hypr/GDK: {final_key}" if final_key else ""
            )
            clipboard_text = build_clipboard_text(
                final_key, keyval, keycode, keyname, keyd_name, evdev_code
            )
            self.val_clipboard.set_label(clipboard_text.replace("\n", " / "))
            if not self.can_export_capture():
                expected = "Raw Source" if self.initial_mode == "original" else "Current Key"
                self.status_label.set_label(
                    f"\u25b7 Monitor only: switch to {expected} mode and capture to export"
                )
                return
            if copy_to_clipboard(clipboard_text):
                write_capture_state(
                    final_key, keycode, keyval, keyname, keyd_name, evdev_code
                )
                if self.auto_return:
                    if keyd_name:
                        self.status_label.set_label(
                            f"\u2713 keyd-name:{keyd_name} (evdev {evdev_code}) captured, returning"
                        )
                    else:
                        self.status_label.set_label(
                            f"\u2713 captured, no keyd mapping (XKB {keycode}), returning"
                        )
                    GLib.timeout_add(180, lambda: (self.get_application().quit(), False)[1])
                else:
                    self.status_label.set_label(
                        f"\u2713 copied keyd-name:{keyd_name or final_key}"
                    )
            else:
                self.status_label.set_label("\u2717 copy failed (check clipboard service)")

        # format output key name
        if is_modifier and not self.is_original_mode():
            # solitary modifier: show only, don't copy
            display_name = " + ".join(mods) or keyname.upper()
            keyd_name = gtk_keycode_to_keyd(keycode) or ""
            self.key_display.set_label(keyd_name or f"[ {display_name} ]")
            self.keyd_display.set_label(
                "keyd-mapped current key value" if keyd_name else ""
            )
            self.bind_display.set_label(
                f"Hypr/GDK: {display_name}" if display_name else ""
            )
            self.status_label.set_label("")
        elif is_modifier and self.is_original_mode():
            final_key = self.preferred_bind_name(keyname, keycode)
            finalize_capture(final_key)
        else:
            mapped_name = self.preferred_bind_name(keyname, keycode)
            final_key = " + ".join(mods) + (" + " + mapped_name if mods else mapped_name)

            finalize_capture(final_key)

        # update detail panel
        keyd_name = gtk_keycode_to_keyd(keycode) or "\u2014"
        evdev_code = gtk_keycode_to_evdev(keycode)
        self.val_keyd.set_label(keyd_name)
        self.val_evdev.set_label(str(evdev_code) if evdev_code is not None else "\u2014")
        self.val_name.set_label(keyname or "unknown")
        self.val_val.set_label(f"0x{keyval:08x} ({keyval})")
        self.val_code.set_label(str(keycode))
        if is_modifier and not self.is_original_mode():
            self.val_bind.set_label("\u2014")
        else:
            mapped_name = self.preferred_bind_name(keyname, keycode)
            bind_label = " + ".join(mods) + (" + " + mapped_name if mods else mapped_name)
            self.val_bind.set_label(bind_label or "\u2014")

        return True


class KeyTestApp(Adw.Application):
    def __init__(self, initial_mode="current", mode_locked=False):
        super().__init__(application_id="org.omarchy.key-test", flags=Gio.ApplicationFlags.NON_UNIQUE)
        self.initial_mode = initial_mode
        self.mode_locked = mode_locked

    def do_activate(self):
        win = KeyTestWindow(
            self,
            initial_mode=self.initial_mode,
            mode_locked=self.mode_locked,
        )
        win.present()


if __name__ == "__main__":
    # Capture modes:
    #   --remap-source / --remap: bypass keyd and capture the physical source key.
    #   --hotkey / no flag: keep keyd active and capture the final key seen by apps.
    remap_flags = {"--remap", "--remap-source"}
    hotkey_flags = {"--hotkey"}
    remap_mode = any(arg in remap_flags for arg in sys.argv)
    hotkey_mode = any(arg in hotkey_flags for arg in sys.argv)
    mode_locked = remap_mode or hotkey_mode
    initial_mode = "original" if remap_mode else "current"
    custom_flags = remap_flags | hotkey_flags
    # Strip our custom flags before GTK/Adw sees sys.argv, otherwise
    # Adw.Application rejects them as "unknown option".
    sys.argv = [a for a in sys.argv if a not in custom_flags]
    if remap_mode:
        clear_capture_state()
        bypass_keyd_for_capture()
    write_lock()
    app = KeyTestApp(initial_mode=initial_mode, mode_locked=mode_locked)
    sys.exit(app.run(sys.argv))
