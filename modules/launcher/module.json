{
  "schemaVersion": 2,
  "id": "launcher",
  "name": "Application Launcher",
  "description": "Application launcher with search and keyboard navigation",
  "version": "2.0.0",
  "kind": "application",
  "entry": {
    "command": ["omd-applauncher", "toggle"],
    "instance": "omd-applauncher",
    "readyTimeout": 10,
    "appId": "org.omd.launcher"
  },
  "contributes": {
    "actions": [
      {"id": "app-launcher.toggle", "name": "Toggle launcher", "description": "Open or close the application launcher"},
      {"id": "app-launcher.open", "name": "Open launcher", "description": "Open the application launcher"},
      {"id": "app-launcher.close", "name": "Close launcher", "description": "Close the application launcher"}
    ]
  }
}
