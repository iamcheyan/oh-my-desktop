{
  "schemaVersion": 2,
  "id": "screenshot",
  "name": "Screenshot Tool",
  "description": "Screenshot capture with region selection, area text extraction, and recording",
  "version": "2.0.0",
  "kind": "application",
  "entry": {
    "command": ["omd-screenshot", "gui"],
    "instance": "omd-screenshot",
    "readyTimeout": 15,
    "appId": "org.omd.screenshot"
  },
  "contributes": {
    "actions": [
      {"id": "screenshot.gui", "name": "Screenshot GUI", "description": "Open screenshot region selection"},
      {"id": "screenshot.full", "name": "Screenshot fullscreen", "description": "Capture full screen"},
      {"id": "screenshot.window", "name": "Screenshot window", "description": "Capture active window"}
    ]
  }
}
