{
  "schemaVersion": 2,
  "id": "notification",
  "name": "Notification Popup",
  "description": "Notification popup manager and history viewer",
  "version": "2.0.0",
  "kind": "application",
  "entry": {
    "command": ["${OMD_ROOT}/bin/omd-notification"],
    "instance": "omd-notification",
    "readyTimeout": 10,
    "appId": "org.omd.notification"
  },
  "contributes": {
    "actions": [
      {"id": "notification.toggle", "name": "Toggle notifications", "description": "Open or close the notification center"},
      {"id": "notification.dismiss-all", "name": "Dismiss all", "description": "Dismiss all visible notifications"}
    ]
  }
}
