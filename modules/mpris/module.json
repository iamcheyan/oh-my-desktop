{
  "schemaVersion": 2,
  "id": "mpris",
  "name": "MPRIS Media Controller",
  "description": "MPRIS media player integration and track art resolution",
  "version": "2.0.0",
  "kind": "shared",
  "contributes": {
    "popupSections": [
      {
        "type": "audio",
        "name": "Now Playing",
        "component": "popup/MprisPopup.qml"
      }
    ],
    "actions": [
      {"id": "mpris.play-pause", "name": "Play / Pause", "handler": "process:omd-swayosd-client --playerctl play-pause"},
      {"id": "mpris.next", "name": "Next track", "handler": "process:omd-swayosd-client --playerctl next"},
      {"id": "mpris.previous", "name": "Previous track", "handler": "process:omd-swayosd-client --playerctl previous"}
    ],
    "services": ["mpris-controller", "track-art"]
  }
}
