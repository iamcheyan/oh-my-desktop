.migration-backups/
*.bak
*.bak.*
*.backup
*.backup-*
quickshell/.state/
quickshell/.cache/
apps/*/.state/
quickshell/*.conf
__pycache__/
*.pyc

# Remote desktop credentials (contains secrets)
scripts/remote-desktop.conf

# Runtime data generated by backup TUI (File Share Backup)
/file-share-backup/

# AI tool artifacts
/.pi-subagents/
/.agents/
/.codex/
/.mimocode/

# Runtime theme/wallpaper state — personal, generated by theme switching.
# The theme library lives in share/themes/; current/ is the active snapshot.
/current/

# Generated keyd config (runtime state, not source)
keyboard-remap/keyd.generated.conf
# Generated symlink for external lock module
/quickshell/modules/lock

# Runtime module state (pinned apps, config caches — generated, not source)
modules/**/.state/
json
