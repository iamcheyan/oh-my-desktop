#!/usr/bin/env python3
"""File Share / Backup settings TUI — Python curses program.

Two-column layout matching voice/theme TUIs. Manages SMB backup config,
tests connections, and runs manual backups.
"""

import curses
import json
import os
import subprocess
import sys
import threading
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import omd_tui_shared as S

_OLD_CONFIG_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "omd", "backup")
CONFIG_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "omd", "file-share-backup")
_OLD_STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "omd", "backup")
STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "omd", "file-share-backup")

import shutil
if os.path.exists(_OLD_CONFIG_DIR) and not os.path.exists(CONFIG_DIR):
    try:
        shutil.move(_OLD_CONFIG_DIR, CONFIG_DIR)
    except Exception:
        pass
if os.path.exists(_OLD_STATE_DIR) and not os.path.exists(STATE_DIR):
    try:
        shutil.move(_OLD_STATE_DIR, STATE_DIR)
    except Exception:
        pass

CONFIG_FILE = os.path.join(CONFIG_DIR, "config.json")

DEFAULT_CONFIG = {
    "address": "",
    "share": "",
    "user": "",
    "password": "",
    "remotePath": "",
    "localPath": [],
    "includeExt": "",
    "excludeExt": "",
    "scheduleType": "manual",
    "scheduleValue": "",
}

SCHEDULE_TYPES = ["manual", "every_h", "every_d", "at_time"]

FIELD_KEYS = ["address", "share", "user", "password", "remotePath", "localPath", "includeExt", "excludeExt"]
FIELD_LABELS = {
    "address": "Address",
    "share": "Share",
    "user": "User",
    "password": "Password",
    "remotePath": "Remote path",
    "localPath": "Local paths",
    "includeExt": "Include ext",
    "excludeExt": "Exclude ext",
}


class Model:
    def __init__(self):
        self.width = 0
        self.height = 0
        self.config = dict(DEFAULT_CONFIG)
        self.logs = []
        self.has_config = False
        self.busy = False
        self.message = ""
        self.dirty = True
        self.scroll_offset = 0
        self.focus_area = 0  # 0=left (schedule+fields), 1=right (table+log)
        self.selected_left = 0  # 0-3 schedule, 4-11 fields
        self.test_result = None  # None / "ok" / "error"
        self.test_error = ""
        self.last_sync_ok = None
        self.last_sync_time = ""
        self.compare_result = None  # dict from last-compare.json
        self.item_rows = []  # list of {path, type, exists, last_backup}
        self.editing_field = False
        self.edit_buffer = ""
        self.edit_field_key = ""
        self.load_config()
        self._refresh_item_rows()

    def load_config(self):
        try:
            with open(CONFIG_FILE) as f:
                data = json.load(f)
            # Keep all keys from file, fill missing with defaults
            for k in DEFAULT_CONFIG:
                if k in data:
                    self.config[k] = data.get(k, DEFAULT_CONFIG[k])
                elif k not in self.config:
                    self.config[k] = DEFAULT_CONFIG[k]
            for k in data:
                if k not in self.config:
                    self.config[k] = data[k]
            # Migrate string localPath to array
            if isinstance(self.config.get("localPath"), str):
                val = self.config["localPath"].strip()
                self.config["localPath"] = [val] if val else []
            self.logs = ["Config loaded from file."]
        except (FileNotFoundError, json.JSONDecodeError):
            self.logs = [
                "Welcome to File Share / Backup.",
                "",
                "To get started:",
                "  1. Tab to the right panel",
                "  2. Press Enter on a field to edit it",
                "  3. Fill in Address, Share, User, Password",
                "  4. Set Local path and Remote path",
                "  5. Press t to test the connection",
                "  6. Press b to run a backup",
                "",
                "Press e to edit config file directly in vi.",
            ]
        # Load last compare result from cache
        try:
            with open(os.path.join(STATE_DIR, "last-compare.json")) as f:
                self.compare_result = json.load(f)
        except (FileNotFoundError, json.JSONDecodeError):
            self.compare_result = None

        self.has_config = bool(self.config.get("address"))
        self._refresh_item_rows()
        # Auto-connect on startup instead of auto-compare
        self.test_connection()

    def save_config(self):
        os.makedirs(CONFIG_DIR, exist_ok=True)
        with open(CONFIG_FILE, "w") as f:
            json.dump(self.config, f, indent=2)
        self.has_config = bool(self.config.get("address"))
        self._refresh_item_rows()
        self.append_log("Config saved", "ok")
        self.message = "Config saved"

    def append_log(self, text, tag=None):
        entry = (tag, text) if tag else text
        self.logs.append(entry)
        if len(self.logs) > 200:
            self.logs = self.logs[-200:]
        self.scroll_offset = 0
        self.dirty = True

    def run_backend(self, action, *args):
        cmd = [os.path.join(S.OMD_ROOT, "bin", "omd-backup"), action] + list(args)
        try:
            res = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
            lines = res.stdout.strip().split("\n") if res.stdout.strip() else []
            err = res.stderr.strip() if res.stderr.strip() else ""
            if res.returncode != 0 and not err:
                err = f"exit {res.returncode}"
            return lines, err
        except subprocess.TimeoutExpired:
            return [], "Timeout"
        except FileNotFoundError as e:
            return [], str(e)

    def _parse_json_line(self, lines):
        """Find and parse the last JSON line from output lines."""
        for l in reversed(lines):
            l = l.strip()
            if l.startswith("{"):
                try:
                    return json.loads(l), l
                except json.JSONDecodeError:
                    pass
        return None, None

    def test_connection(self):
        if self.busy:
            return
        self.busy = True
        self.message = "Testing\u2026"
        self.dirty = True
        self.append_log("$ test connection", "primary")
        self._save_temp_config()

        def _cb():
            lines, err = self.run_backend("test")
            self.busy = False
            if err:
                self.test_result = "error"
                self.test_error = err
                self.message = "Test failed"
                self.append_log(f"  error: {err}", "danger")
            elif lines:
                for l in lines:
                    l = l.strip()
                    if l and not l.startswith("{"):
                        if "Connected" in l or "mounted" in l or "Already" in l:
                            self.append_log(f"  {l}", "ok")
                        elif "error" in l.lower() or "fail" in l.lower() or "SKIP" in l or "cannot" in l.lower():
                            self.append_log(f"  {l}", "danger")
                        elif "Attempting" in l or "Testing" in l or "Target" in l or "Mount" in l or "Credential" in l:
                            self.append_log(f"  {l}", "muted")
                        else:
                            self.append_log(f"  {l}")
                data, _ = self._parse_json_line(lines)
                if data and data.get("ok"):
                    self.test_result = "ok"
                    self.test_error = ""
                    self.message = "Connection OK"
                else:
                    self.test_result = "error"
                    self.test_error = (data or {}).get("error", "unknown")
                    self.message = "Connection failed"
                    self.append_log(f"  error: {self.test_error}", "danger")
            self.dirty = True

        threading.Thread(target=_cb, daemon=True).start()

    def run_backup(self, delete_remote=False):
        if self.busy:
            return
        if not self.config.get("address") or not self.config.get("localPath"):
            self.message = "Configure address and local path first"
            self.dirty = True
            return
        self.busy = True
        label = "Full sync" if delete_remote else "Incremental sync"
        self.message = f"{label}…"
        self.dirty = True
        self.append_log(f"$ {label} started", "primary")
        self._save_temp_config()

        def _cb():
            args = ["backup"]
            if delete_remote:
                args.append("--delete")
            lines, err = self.run_backend(*args)
            self.busy = False
            self.last_sync_time = time.strftime("%H:%M")
            if err:
                self.last_sync_ok = False
                self.message = "Backup failed"
                self.append_log(f"  error: {err}", "danger")
            else:
                for l in lines:
                    l = l.strip()
                    if l and not l.startswith("{"):
                        if "Backup complete" in l or "Backup done" in l:
                            self.append_log(f"  {l}", "ok")
                        elif "FAILED" in l or "error" in l.lower() or "fail" in l.lower() or "SKIP" in l:
                            self.append_log(f"  {l}", "danger")
                        elif "sync" in l or "Starting" in l or "Full sync" in l:
                            self.append_log(f"  {l}", "muted")
                        else:
                            self.append_log(f"  {l}")
                data, _ = self._parse_json_line(lines)
                if data and data.get("ok"):
                    self.last_sync_ok = True
                    elapsed = data.get("elapsed", 0)
                    self.message = f"Backup done ({elapsed}s)"
                else:
                    self.last_sync_ok = False
                    err_msg = (data or {}).get("error", "unknown")
                    self.message = "Backup failed"
                    self.append_log(f"  error: {err_msg}", "danger")
            self._refresh_item_rows()
            self._run_compare()

        threading.Thread(target=_cb, daemon=True).start()

    def _save_temp_config(self):
        try:
            os.makedirs(CONFIG_DIR, exist_ok=True)
            with open(CONFIG_FILE, "w") as f:
                json.dump(self.config, f, indent=2)
        except OSError:
            pass

    def _refresh_item_rows(self):
        """Rebuild item_rows from config localPath + state items.json + disk check."""
        paths = self.config.get("localPath", [])
        if isinstance(paths, str):
            paths = [p.strip() for p in paths.split(",") if p.strip()]
        # Load per-item backup times from state
        item_times = {}
        try:
            with open(os.path.join(STATE_DIR, "items.json")) as f:
                for entry in json.load(f):
                    item_times[entry.get("path", "")] = entry.get("last_backup", "")
        except (FileNotFoundError, json.JSONDecodeError):
            pass
        rows = []
        # Load per-path compare stats from last-compare.json
        path_stats = {}
        try:
            with open(os.path.join(STATE_DIR, "last-compare.json")) as f:
                cdata = json.load(f)
            for pdata in cdata.get("paths", []):
                path_stats[pdata["path"]] = pdata
        except (FileNotFoundError, json.JSONDecodeError, KeyError):
            pass

        for p in paths:
            if not p:
                continue
            exists = os.path.exists(p)
            if os.path.isdir(p):
                typ = "dir"
            elif os.path.isfile(p):
                typ = "file"
            else:
                typ = "—"
            stat = path_stats.get(p, {})
            rows.append({
                "path": p,
                "name": os.path.basename(p) or p,
                "type": typ,
                "exists": exists,
                "last_backup": item_times.get(p, ""),
                "total_files": stat.get("total", 0),
                "new_files": stat.get("new", 0),
                "modified_files": stat.get("modified", 0),
            })
        self.item_rows = rows
        self.dirty = True

    def _run_compare(self):
        """Run omd-backup compare in a background thread and update logs + item_rows."""
        if self.busy:
            return

        def _cb():
            lines, err = self.run_backend("compare")
            if err:
                self.append_log(f"  error: {err}", "danger")
                self.dirty = True
                return
            # Append human-readable lines (all except last JSON line)
            if lines:
                for l in lines[:-1]:
                    l = l.strip()
                    if l:
                        if "→ All files up to date" in l:
                            self.append_log(f"  {l}", "ok")
                        elif "→" in l or "need backup" in l:
                            self.append_log(f"  {l}", "warn")
                        elif "Summary" in l:
                            self.append_log(f"  {l}", "text")
                        else:
                            self.append_log(f"  {l}")
                # Parse last line as JSON
                try:
                    data = json.loads(lines[-1])
                    if data.get("ok"):
                        self.compare_result = data
                        self._refresh_item_rows()
                        ns = data.get("needs_sync", 0)
                        if ns > 0:
                            self.append_log(f"→ {ns} file(s) need backup — press b to sync", "warn")
                            self.message = f"{ns} file(s) changed"
                        else:
                            self.append_log("→ All files up to date ✓", "ok")
                            self.message = "All up to date"
                except (json.JSONDecodeError, IndexError):
                    pass
            self.dirty = True

        threading.Thread(target=_cb, daemon=True).start()

    def _run_compare_verbose(self):
        """Run omd-backup compare --verbose for per-file colored diffs."""
        if self.busy:
            return

        def _cb():
            lines, err = self.run_backend("compare", "--verbose")
            if err:
                self.append_log(f"  error: {err}", "danger")
                self.dirty = True
                return
            if lines:
                # Map prefix to tag (color)
                tag_map = {"+ ": "ok", "~ ": "warn", "- ": "danger", "= ": "muted"}
                summary_lines = []
                for l in lines:
                    if l.startswith("{"):
                        continue  # skip JSON result line
                    prefix = l[:2] if len(l) >= 2 else ""
                    tag = tag_map.get(prefix)
                    if tag:
                        self.logs.append((tag, l[2:].strip()))
                    else:
                        self.logs.append(l)
                    summary_lines.append(l)
                # Parse JSON for item_rows update
                data, _ = self._parse_json_line(lines)
                if data and data.get("ok"):
                    self.compare_result = data
                    self._refresh_item_rows()
            self.logs = S.clip_lines(self.logs, 200)
            self.dirty = True

        threading.Thread(target=_cb, daemon=True).start()


def view_remote_files(model):
    """Open a terminal window showing the remote backup directory listing."""
    backup_script = os.path.join(S.OMD_ROOT, "bin", "omd-backup")
    if not os.path.exists(backup_script):
        model.message = "Backend script not found"
        model.dirty = True
        return
    # Keep terminal open after listing: append a pause prompt
    inner_cmd = backup_script + ' list; echo ""; read -p "Press Enter to close..."'
    cmd = (
        'if command -v xdg-terminal-exec >/dev/null 2>&1; then '
        'exec xdg-terminal-exec --app-id=org.omd.list-file-share-backup --title="Remote Backup Files" -- bash -c ' + repr(inner_cmd) + '; '
        'elif command -v foot >/dev/null 2>&1; then '
        'exec foot --app-id=org.omd.list-file-share-backup --title="Remote Backup Files" -e bash -c ' + repr(inner_cmd) + '; '
        'else exec kitty --class=org.omd.list-file-share-backup --title="Remote Backup Files" -- bash -c ' + repr(inner_cmd) + '; fi'
    )
    try:
        subprocess.Popen(
            ["bash", "-c", cmd],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True
        )
        model.message = "Opened terminal — press Enter to close"
    except Exception as e:
        model.message = f"Failed to open terminal: {e}"
    model.dirty = True


def load_model():
    return Model()


def hero_info(model):
    subtitle_parts = []
    if not model.has_config:
        subtitle = "Set up your SMB server to begin"
        tone = "muted"
    else:
        if model.config.get("address"):
            subtitle_parts.append(model.config["address"])
        if model.test_result == "ok":
            subtitle_parts.append("connected")
        elif model.test_result == "error":
            subtitle_parts.append("disconnected")
        else:
            subtitle_parts.append("not tested")
        if model.last_sync_ok is True:
            subtitle_parts.append(f"last sync {model.last_sync_time}")
        subtitle = " · ".join(subtitle_parts) if subtitle_parts else "File share backup"
        tone = "muted"

    status_text = ""
    # Sync status has precedence for top-right status indicator and overall tone
    if not model.has_config:
        status_text = ""
        tone = "muted"
    elif model.busy:
        status_text = "Syncing..."
        tone = "warn"
    elif model.compare_result:
        ns = model.compare_result.get("needs_sync", 0)
        if ns > 0:
            status_text = "Needs sync"
            tone = "warn"
        else:
            status_text = "Synced"
            tone = "ok"
    else:
        # Fallback to test connection result
        if model.test_result == "ok":
            status_text = "Connected"
            tone = "ok"
        elif model.test_result == "error":
            status_text = "Disconnected"
            tone = "danger"
        else:
            status_text = "Not checked"
            tone = "muted"

    msg = ""
    if model.busy:
        msg = "working…"
    elif model.message:
        msg = model.message
    return S.hero_line("File Share / Backup", subtitle, tone, model.busy, msg, status_text)


def help_items(model):
    if model.editing_field:
        items = [("enter", "confirm"), ("esc", "cancel")]
        if model.edit_field_key == "localPath":
            items.append(("comma", "separate paths"))
    else:
        items = [
            ("enter", "edit config"),
            ("t", "test conn"),
            ("r", "compare"),
            ("e", "edit file"),
            ("l", "remote browse"),
        ]
        # Only show sync keys when changes are detected
        if model.compare_result:
            ns = model.compare_result.get("needs_sync", 0)
            if ns > 0:
                items.append(("s", "sync inc"))
                items.append(("S", "sync full"))
        items.append(("c", "detail diff"))
    return items


# ── render helpers ──

def config_value_display(model, key):
    val = model.config.get(key, "")
    if key == "password" and val:
        return "*" * len(val)
    if key == "localPath" and isinstance(val, list):
        if not val:
            return "—"
        if len(val) == 1:
            return val[0]
        return f"{len(val)} paths"
    return val if val else "—"


def render_field_list(model, width):
    lines = []
    sel_field = model.selected_left - 4 if model.selected_left >= 4 else 0
    for i, key in enumerate(FIELD_KEYS):
        label = FIELD_LABELS.get(key, key)
        val = config_value_display(model, key)
        focused = model.focus_area == 0 and sel_field == i
        if focused and model.editing_field and model.edit_field_key == key:
            display = model.edit_buffer if key != "password" else "*" * len(model.edit_buffer)
            lines.append(("focus", f"  {label}: {display}█"))
        elif focused:
            lines.append(("focus", f"  {label}: {S.truncate(val, width - len(label) - 5)}"))
        else:
            lines.append(("text", f"  {label}: {S.truncate(val, width - len(label) - 5)}"))
    return lines


def render_connection_status(model, width):
    lines = []
    if not model.has_config:
        lines.append(("primary", "→ Configure server below"))
        lines.append(("muted", "  Tab to right panel"))
        lines.append(("muted", "  Enter to edit fields"))
        lines.append(("muted", "  t to test connection"))
        return lines
    if model.test_result == "ok":
        lines.append(("ok", "  ● Connected"))
    elif model.test_result == "error":
        lines.append(("danger", f"  ✗ {S.truncate(model.test_error, width - 4)}"))
    else:
        lines.append(("muted", "  ○ Not tested"))
    addr = model.config.get("address", "")
    share = model.config.get("share", "")
    if addr and share:
        lines.append(("muted", f"  //{addr}/{share}"))
    elif addr:
        lines.append(("muted", f"  {addr}"))
    # Last sync status
    if model.last_sync_ok is True:
        lines.append(("ok", f"  Last sync: {model.last_sync_time}  ✅"))
    elif model.last_sync_ok is False:
        lines.append(("danger", "  Last sync: failed"))
    else:
        lines.append(("muted", "  No sync yet"))
    return lines


def render_schedule(model, width):
    lines = []
    sel_sched = model.selected_left if model.selected_left < 4 else model.selected_left  # persist
    for i, st in enumerate(SCHEDULE_TYPES):
        focused = model.focus_area == 0 and model.selected_left == i
        label = {"manual": "Manual only", "every_h": "Every N hours",
                 "every_d": "Every N days", "at_time": "At specific time"}.get(st, st)
        sel = model.config.get("scheduleType", "manual") == st
        prefix = "▸" if sel else " "
        box = "[X]" if sel else "[ ]"
        val = model.config.get("scheduleValue", "")
        trail = f" ({val})" if val and sel else ""
        if focused:
            lines.append(("focus", f"  {box} {label}{trail}"))
        elif sel:
            lines.append(("ok", f"  {box} {label}{trail}"))
        else:
            lines.append(("muted", f"  {box} {label}{trail}"))
    return lines


def render_actions(model):
    lines = []
    enabled = not model.busy
    has_config = bool(model.config.get("address") and model.config.get("localPath"))
    lines.append(S.action_line("t", "Test connection", enabled))
    lines.append(S.action_line("r", "Compare quick", enabled and has_config))
    lines.append(S.action_line("c", "Compare detail", enabled and has_config))
    # Sync keys are always available even if only shown conditionally in help bar
    lines.append(S.action_line("s", "Sync inc", enabled and has_config))
    lines.append(S.action_line("S", "Sync full --delete", enabled and has_config))
    lines.append(S.action_line("e", "Edit config file", enabled))
    lines.append(S.action_line("l", "View remote files", enabled and has_config))
    return lines


def render_item_table(model, width):
    """Render the managed items table: name | type | files | changes | backed | status."""
    rows = model.item_rows
    if not rows:
        return [("muted", "  (no items configured)")]
    
    # Column widths
    avail = width - 8  # padding and spacing
    name_w = max(12, avail - 5 - 6 - 7 - 8 - 10)  # Type(5) + Files(6) + Changes(7) + Backed(8) + margin
    if name_w < 10:
        name_w = 10
        
    def format_col_left(text, col_w):
        text = str(text)
        w = S.text_width(text)
        if w > col_w:
            return S.truncate(text, col_w)
        return text + " " * (col_w - w)

    def format_col_right(text, col_w):
        text = str(text)
        w = S.text_width(text)
        if w > col_w:
            return S.truncate(text, col_w)
        return " " * (col_w - w) + text

    lines = []
    # Header — align type, files, changes, backed, status
    hdr_name = format_col_left("Name", name_w)
    hdr_type = format_col_left("Type", 5)
    hdr_files = format_col_right("Files", 6)
    hdr_changes = format_col_right("Changes", 7)
    hdr_backed = format_col_left("Backed", 8)
    hdr = f"  {hdr_name} {hdr_type} {hdr_files} {hdr_changes} {hdr_backed} Status"
    lines.append(("muted", hdr))
    lines.append(("muted", "  " + "─" * (S.text_width(hdr.strip()))))

    for row in rows:
        name = format_col_left(row["name"], name_w)
        typ = format_col_left(row["type"], 5)
        
        # Files and changes counts
        total_f = row.get("total_files", 0)
        new_f = row.get("new_files", 0)
        mod_f = row.get("modified_files", 0)
        changes = new_f + mod_f
        
        files_str = str(total_f) if total_f > 0 else "—"
        if changes > 0:
            ch_str = f"+{changes}"
        else:
            ch_str = "✓" if total_f > 0 else "—"
            
        files_col = format_col_right(files_str, 6)
        changes_col = format_col_right(ch_str, 7)
        
        backed_time = row["last_backup"] if row["last_backup"] else "—"
        backed_col = format_col_left(backed_time, 8)
        
        # Status
        if not row["exists"]:
            status = "⚠ Missing"
            st_tag = "danger"
        elif changes > 0:
            status = f"🔄 {changes} pending"
            st_tag = "warn"
        elif backed_time != "—":
            status = "✅ Synced"
            st_tag = "ok"
        else:
            status = "○ Pending"
            st_tag = "muted"
            
        line = f"  {name} {typ} {files_col} {changes_col} {backed_col} {status}"
        lines.append((st_tag, line))
    return lines


# ── view ──

def view(stdscr, model):
    h, w = stdscr.getmaxyx()
    model.width = w
    model.height = h

    if not S.require_terminal_size(stdscr, 72, 20):
        return

    stdscr.erase()

    S.draw_hero(stdscr, hero_info(model))

    # geometry
    pad_x, pad_y, hero_h, help_h = 2, 2, 2, 1
    content_w = w - pad_x
    avail_h = h - pad_y - hero_h - help_h

    left_w, right_w = S.two_column_widths(content_w, left_w=34, right_min=28)
    content_h = avail_h

    left_focused = (model.focus_area == 0)
    right_focused = (model.focus_area == 1)

    # Left: Status + Schedule + Connection (config) + Actions
    conn_lines = render_connection_status(model, left_w - 4)
    conn_box_h = min(content_h, len(conn_lines) + 3)
    if conn_box_h >= 3:
        S.draw_focus_border(stdscr, left_focused, hero_h, 0, conn_box_h, left_w, "Status")
        S.draw_lines_in_area(stdscr, hero_h, 0, conn_box_h, left_w, conn_lines)
    else:
        conn_box_h = 0

    schedule_y = hero_h + conn_box_h
    sched_lines = render_schedule(model, left_w - 4)
    sched_box_h = min(content_h - conn_box_h, len(sched_lines) + 3)
    if sched_box_h >= 3:
        S.draw_focus_border(stdscr, left_focused, schedule_y, 0, sched_box_h, left_w, "Schedule")
        S.draw_lines_in_area(stdscr, schedule_y, 0, sched_box_h, left_w, sched_lines)
    else:
        sched_box_h = 0

    field_y = schedule_y + sched_box_h
    field_lines = render_field_list(model, left_w - 4)
    field_box_h = min(content_h - field_y + hero_h, len(field_lines) + 3)
    if field_box_h >= 3:
        S.draw_focus_border(stdscr, left_focused, field_y, 0, field_box_h, left_w, "Connection")
        S.draw_lines_in_area(stdscr, field_y, 0, field_box_h, left_w, field_lines)
    else:
        field_box_h = 0

    actions_y = field_y + field_box_h
    actions_h = hero_h + content_h - actions_y
    if actions_h >= 4:
        S.draw_focus_border(stdscr, left_focused, actions_y, 0, actions_h, left_w, "Actions")
        S.draw_lines_in_area(stdscr, actions_y, 0, actions_h, left_w, render_actions(model))

    # Right: Managed Items table + Activity log
    table_lines = render_item_table(model, right_w - 4)
    table_h = len(table_lines) + 3 if table_lines else 0
    if table_h < 3:
        table_h = 0
    # Table takes as much as it needs, activity fills the rest
    avail_right = content_h
    act_min = 4
    table_box_h = min(table_h, avail_right - act_min)
    if table_box_h < 3:
        table_box_h = 0
    if table_box_h >= 3:
        S.draw_focus_border(stdscr, right_focused, hero_h, left_w, table_box_h, right_w, "Managed Items")
        S.draw_lines_in_area(stdscr, hero_h, left_w, table_box_h, right_w, table_lines)
    # Activity log below table
    act_y = hero_h + table_box_h
    act_h = hero_h + content_h - act_y
    if act_h >= 4:
        S.draw_focus_border(stdscr, right_focused, act_y, left_w, act_h, right_w, "Activity")
        S.draw_log_in_area(stdscr, act_y, left_w, act_h, right_w, model.logs, model.scroll_offset,
                           empty_text="(no activity)")

    S.draw_help_bar(stdscr, help_items(model))
    S.finish_frame(stdscr)


# ── input handling ──

def handle_key(stdscr, model, key):
    if key == ord('q') or key == 27:
        if model.editing_field:
            model.editing_field = False
            model.dirty = True
            return True
        return False

    if model.editing_field:
        return handle_edit_key(model, key)

    if model.busy and key not in (ord('q'),):
        return True

    if key == curses.KEY_MOUSE:
        me = S.get_mouse_event()
        if me:
            wheel = S.mouse_wheel_delta(me)
            if wheel is not None:
                model.scroll_offset = max(0, model.scroll_offset + wheel)
                model.dirty = True
                return True
        return True

    # Navigation
    if key == ord('\t') or key == 9:
        model.focus_area = 1 if model.focus_area == 0 else 0
        model.dirty = True
        return True

    if key == curses.KEY_UP or key == ord('k'):
        if model.focus_area == 0:
            # Left: move through schedule (0-3) then fields (4-11)
            if model.selected_left > 11:
                model.selected_left = 11
            elif model.selected_left > 0:
                model.selected_left -= 1
        else:
            # Right: scroll activity log
            if model.scroll_offset < model.logs.count and len(model.logs) > 0:
                model.scroll_offset += 1
                model.dirty = True
        model.dirty = True
        return True

    if key == curses.KEY_DOWN or key == ord('j'):
        if model.focus_area == 0:
            if model.selected_left >= 11:
                pass  # already at bottom
            else:
                model.selected_left += 1
        else:
            if model.scroll_offset > 0:
                model.scroll_offset -= 1
                model.dirty = True
        model.dirty = True
        return True

    if key == ord('\n') or key == 10:
        if model.focus_area == 0:
            if model.selected_left < len(SCHEDULE_TYPES):
                model.config["scheduleType"] = SCHEDULE_TYPES[model.selected_left]
                model.save_config()
                model.dirty = True
            else:
                start_edit(model)
        return True

    if key == ord(' '):
        if model.focus_area == 0:
            if model.selected_left < len(SCHEDULE_TYPES):
                model.config["scheduleType"] = SCHEDULE_TYPES[model.selected_left]
                model.save_config()
                model.dirty = True
            else:
                start_edit(model)
        return True

    # Action keys
    if key in (ord('t'), ord('T')):
        model.test_connection()
        return True
    if key == ord('s') or key == ord('b'):
        model.run_backup(delete_remote=False)
        return True
    if key == ord('S') or key == ord('B'):
        model.run_backup(delete_remote=True)
        return True
    if key in (ord('c'), ord('C')):
        model.message = ""
        model.append_log("$ compare — per-file diff", "primary")
        model._run_compare_verbose()
        return True
    if key in (ord('l'), ord('L')):
        view_remote_files(model)
        return True
    if key in (ord('r'), ord('R')):
        model.message = ""
        model._run_compare()
        model.dirty = True
        return True
    if key in (ord('e'), ord('E')):
        model.save_config()
        # Open vi in a new terminal window with specific app-id/class to trigger floating rules
        cmd = (
            'if command -v xdg-terminal-exec >/dev/null 2>&1; then '
            'exec xdg-terminal-exec --app-id=org.omd.edit-file-share-backup --title="Edit File Share & Backup Config" -- vi "$1"; '
            'elif command -v foot >/dev/null 2>&1; then '
            'exec foot --app-id=org.omd.edit-file-share-backup --title="Edit File Share & Backup Config" -e vi "$1"; '
            'else exec kitty --class=org.omd.edit-file-share-backup --title="Edit File Share & Backup Config" -- vi "$1"; fi'
        )
        subprocess.Popen(
            ["bash", "-c", cmd, "omd-file-share-backup-editor", CONFIG_FILE],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True
        )
        # Don't reload immediately — wait for user to finish editing
        model.message = "Opened in terminal — press r to reload after editing"
        model.dirty = True
        return True

    # Scroll
    if key == curses.KEY_PPAGE:
        model.scroll_offset += 3
        model.dirty = True
        return True
    if key == curses.KEY_NPAGE:
        model.scroll_offset = max(0, model.scroll_offset - 3)
        model.dirty = True
        return True
    if key == curses.KEY_HOME:
        model.scroll_offset = 9999
        model.dirty = True
        return True
    if key == curses.KEY_END:
        model.scroll_offset = 0
        model.dirty = True
        return True

    return True


def start_edit(model):
    if model.focus_area != 0 or model.selected_left < len(SCHEDULE_TYPES):
        return
    sel_field = model.selected_left - len(SCHEDULE_TYPES)
    if sel_field >= len(FIELD_KEYS):
        return
    key = FIELD_KEYS[sel_field]
    model.editing_field = True
    model.edit_field_key = key
    val = model.config.get(key, "")
    if key == "localPath" and isinstance(val, list):
        model.edit_buffer = ",".join(val)
    else:
        model.edit_buffer = str(val) if val is not None else ""
    model.dirty = True


def handle_edit_key(model, key):
    if key == ord('\n') or key == 10:
        if model.edit_field_key == "localPath":
            model.config[model.edit_field_key] = [p.strip() for p in model.edit_buffer.split(",") if p.strip()]
        else:
            model.config[model.edit_field_key] = model.edit_buffer
        model.save_config()
        model.editing_field = False
        model.message = f"{FIELD_LABELS.get(model.edit_field_key, model.edit_field_key)} updated & saved"
        model.dirty = True
        model._run_compare()
        return True
    if key == 27:  # esc
        model.editing_field = False
        model.dirty = True
        return True
    if key == 127 or key == curses.KEY_BACKSPACE or key == 8:
        model.edit_buffer = model.edit_buffer[:-1]
        model.dirty = True
        return True
    if 32 <= key <= 126:
        model.edit_buffer += chr(key)
        model.dirty = True
        return True
    return True


# ── main ──

def main(stdscr):
    S.run_tui_loop(stdscr, load_model(), view, handle_key, poll_timeout=200)


if __name__ == "__main__":
    curses.wrapper(main)
