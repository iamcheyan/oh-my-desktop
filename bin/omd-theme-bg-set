#!/usr/bin/env bash
set -euo pipefail

if [[ -z "${1:-}" ]]; then
  echo "Usage: omd-theme-bg-set <path-to-image>" >&2
  exit 1
fi

background="$(realpath "$1")"
current_background="${OMD_ROOT:-$HOME/.config/omd}/current/background"

if [[ ! -f "$background" ]]; then
  echo "File does not exist: $background" >&2
  exit 1
fi

mkdir -p "$(dirname "$current_background")"
ln -nsf "$background" "$current_background"

quickshell_config="$HOME/.config/quickshell/config.json"
if [[ -f "$quickshell_config" ]] && command -v jq >/dev/null 2>&1; then
  tmp="$(mktemp)"
  jq --arg path "$background" '.background.wallpaperPath = $path | .background.thumbnailPath = ""' "$quickshell_config" >"$tmp" &&
    mv "$tmp" "$quickshell_config"
  rm -f "$tmp"
fi

pkill -x swaybg >/dev/null 2>&1 || true
setsid uwsm-app -- swaybg -i "$current_background" -m fill >/dev/null 2>&1 &
