#!/usr/bin/env bash
set -euo pipefail

if [[ -z "${1:-}" ]]; then
  echo "Usage: omd-theme-bg-set <path-to-image>" >&2
  exit 1
fi

background="$(realpath "$1")"
omd_root="${OMD_ROOT:-$HOME/.config/omd}"
current_dir="$omd_root/current"
managed_background="$current_dir/wallpaper"
current_background="$current_dir/background"

if [[ ! -f "$background" ]]; then
  echo "File does not exist: $background" >&2
  exit 1
fi

mkdir -p "$current_dir"

# Keep the active wallpaper independent from the imported source. A relative
# link makes the runtime path stable even when the repository is moved.
if [[ "$(realpath -m "$background")" != "$(realpath -m "$managed_background")" ]]; then
  tmp_background="$(mktemp "$current_dir/.wallpaper.XXXXXX")"
  trap 'rm -f "${tmp_background:-}"' EXIT
  cp -- "$background" "$tmp_background"
  chmod 0644 "$tmp_background"
  mv -f -- "$tmp_background" "$managed_background"
  tmp_background=""
fi
ln -nsf "wallpaper" "$current_background"

# The managed path stays constant across folder rotations. Publish an ignored
# runtime revision so long-running Quickshell processes invalidate their cache.
date +%s%N >"$current_dir/wallpaper.revision"
_sumika_cfg="${SUMIKA_SHELL_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/sumika-shell}"
sumika_config_file="$_sumika_cfg/quickshell/config.json"
# Legacy fallback: use old path if new doesn't exist yet (Phase 7: remove)
[ -f "$sumika_config_file" ] || sumika_config_file="$HOME/.config/quickshell/config.json"
quickshell_config="$sumika_config_file"
if [[ -f "$quickshell_config" ]] && command -v jq >/dev/null 2>&1; then
  tmp="$(mktemp)"
  jq --arg path '~/.config/omd/current/background' \
    '.background.wallpaperPath = $path | .background.thumbnailPath = ""' \
    "$quickshell_config" >"$tmp" &&
    mv "$tmp" "$quickshell_config"
  rm -f "$tmp"
fi

"$(dirname "$0")/omd-wallpaper" render-image "$current_background"
