#!/usr/bin/env python3

import os
import random
import re
import select
import subprocess
import sys
import time


ADDR = sys.argv[1] if len(sys.argv) > 1 else ""
ACTION = sys.argv[2] if len(sys.argv) > 2 else "connect"
TIMEOUT = int(os.environ.get("OMD_BT_TIMEOUT", "90"))
ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]")


def emit(kind, value=""):
    print(f"OMD_BT\t{kind}\t{value}", flush=True)


def clean_text(text):
    return ANSI_RE.sub("", text).replace("\r", "")


def run_plain(args):
    proc = subprocess.run(args, text=True, capture_output=True)
    output = (proc.stdout or "") + (proc.stderr or "")
    for line in output.splitlines():
        emit("log", line)
    return proc.returncode, output


def info_contains(needle):
    proc = subprocess.run(["bluetoothctl", "info", ADDR], text=True, capture_output=True)
    return needle in ((proc.stdout or "") + (proc.stderr or ""))


def send(fd, command):
    os.write(fd, (command + "\n").encode())


def parse_passkey(text):
    patterns = [
        r"\[agent\]\s*PIN code:\s*([0-9]{4,6})",
        r"\[agent\]\s*Passkey:\s*([0-9]{4,6})",
        r"Confirm passkey[^0-9]*([0-9]{4,6})",
        r"passkey[^0-9]*([0-9]{6})",
    ]
    for pattern in patterns:
        match = re.search(pattern, text, re.IGNORECASE)
        if match:
            return match.group(1).zfill(6)
    return ""


def pair_interactive():
    emit("status", "pairing")
    emit("instruction", "If a code appears, type it on the Bluetooth keyboard and press Enter.")

    pid, fd = pty_spawn(["bluetoothctl", "--agent", "KeyboardDisplay"])
    started = time.monotonic()
    recent = ""
    line_buffer = ""
    sent_pair = False
    sent_pin = False
    last_passkey = ""
    paired = False
    error = ""
    target_seen = False
    target_token = ADDR.upper()

    try:
        send(fd, "power on")
        send(fd, "pairable on")
        send(fd, "agent KeyboardDisplay")
        send(fd, "default-agent")
        send(fd, f"remove {ADDR}")
        send(fd, "scan on")

        while time.monotonic() - started < TIMEOUT:
            if not sent_pair and target_seen:
                send(fd, "scan off")
                send(fd, f"pair {ADDR}")
                sent_pair = True

            readable, _, _ = select.select([fd], [], [], 0.2)
            if not readable:
                continue

            try:
                chunk = os.read(fd, 4096).decode(errors="replace")
            except OSError:
                break

            if not chunk:
                continue

            clean_chunk = clean_text(chunk)
            recent = (recent + clean_chunk)[-4000:]
            line_buffer += clean_chunk
            target_event = re.search(
                r"\[(NEW|CHG)\]\s+DEVICE\s+" + re.escape(target_token),
                clean_chunk.upper(),
            )
            if target_event:
                target_seen = True
                emit("status", "found")
            while "\n" in line_buffer:
                line, line_buffer = line_buffer.split("\n", 1)
                if line.strip():
                    emit("log", line)

            passkey = parse_passkey(recent)
            if passkey and passkey != last_passkey:
                last_passkey = passkey
                emit("passkey", passkey)

            lower = recent.lower()
            if ("confirm passkey" in lower or "(yes/no)" in lower or "yes/no" in lower) and "agent" in lower:
                send(fd, "yes")

            if ("enter pin code" in lower or "request pin code" in lower) and not sent_pin:
                pin = str(random.randint(0, 999999)).zfill(6)
                sent_pin = True
                last_passkey = pin
                emit("passkey", pin)
                send(fd, pin)

            if "pairing successful" in lower or "paired: yes" in lower:
                paired = True
                emit("status", "paired")
                break

            fail_match = re.search(r"Failed to pair:[^\r\n]*", recent)
            if fail_match:
                error = fail_match.group(0)
                break

            if "authenticationfailed" in lower or "authenticationtimeout" in lower or "authenticationcanceled" in lower:
                error = "Bluetooth authentication failed or timed out."
                break
    finally:
        try:
            send(fd, "quit")
        except OSError:
            pass
        try:
            os.close(fd)
        except OSError:
            pass
        try:
            os.waitpid(pid, 0)
        except ChildProcessError:
            pass

    if not paired and info_contains("Paired: yes"):
        paired = True
        emit("status", "paired")

    if not paired:
        if not target_seen:
            emit("error", "Device was not rediscovered. Put it in Bluetooth pairing mode and try again.")
        else:
            emit("error", error or "Pairing timed out. Put the device in pairing mode and try again.")
        return False

    return True


def pty_spawn(argv):
    pid, fd = os.forkpty()
    if pid == 0:
        try:
            os.execvp(argv[0], argv)
        except Exception as exc:
            print(exc, file=sys.stderr)
            os._exit(127)
    return pid, fd


def main():
    if not ADDR:
        emit("error", "Missing Bluetooth device address")
        return 2

    if ACTION == "disconnect":
        emit("status", "disconnecting")
        code, _ = run_plain(["bluetoothctl", "disconnect", ADDR])
        return code

    if ACTION in ("forget", "remove"):
        emit("status", "removing")
        code, _ = run_plain(["bluetoothctl", "remove", ADDR])
        return code

    if ACTION not in ("connect", "pair-connect"):
        emit("error", f"Unknown action: {ACTION}")
        return 2

    emit("status", "powering")
    subprocess.run(["rfkill", "unblock", "bluetooth"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["bluetoothctl", "power", "on"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["bluetoothctl", "pairable", "on"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    paired = info_contains("Paired: yes")
    if ACTION == "pair-connect" or not paired:
        if not pair_interactive():
            return 1

    emit("status", "trusting")
    run_plain(["bluetoothctl", "trust", ADDR])

    # On asahi Linux, the Bluetooth controller rejects wake-flags during
    # pairing, causing the device to disconnect immediately after bonding.
    # Wait a moment for the link to settle, then retry the connection.
    max_attempts = 3
    for attempt in range(1, max_attempts + 1):
        emit("status", f"connecting{f' (attempt {attempt}/{max_attempts})' if attempt > 1 else ''}")
        code, output = run_plain(["bluetoothctl", "--timeout", "25", "connect", ADDR])
        if code == 0 and re.search(r"successful|Connection successful", output, re.IGNORECASE):
            emit("status", "connected")
            return 0
        if info_contains("Connected: yes"):
            emit("status", "connected")
            return 0
        if attempt < max_attempts:
            emit("log", f"Connection attempt {attempt} failed, retrying in 2s...")
            time.sleep(2)

    emit("error", output.strip() or "Connection failed")
    return 1


if __name__ == "__main__":
    sys.exit(main())
