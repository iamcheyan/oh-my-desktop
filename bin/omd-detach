#!/bin/sh
set -eu

# Start a command outside the caller's cgroup. This keeps apps launched from
# Quickshell out of omd-bar/omd-applauncher transient services.

cwd=""
if [ "${1:-}" = "--cwd" ]; then
    cwd="${2:-}"
    shift 2
fi

if [ "$#" -eq 0 ]; then
    echo "Usage: omd-detach [--cwd DIR] COMMAND [ARGS...]" >&2
    exit 2
fi

unit="omd-launched-$(date +%s%N)-$$"

if command -v systemd-run >/dev/null 2>&1 && systemctl --user is-active default.target >/dev/null 2>&1; then
    if [ -n "$cwd" ]; then
        exec systemd-run --user --unit="$unit" --collect --quiet \
            --property=KillMode=process \
            --working-directory="$cwd" \
            --setenv=PATH="$PATH" \
            "$@"
    fi
    exec systemd-run --user --unit="$unit" --collect --quiet \
        --property=KillMode=process \
        --setenv=PATH="$PATH" \
        "$@"
fi

if [ -n "$cwd" ]; then
    cd "$cwd"
fi
setsid "$@" >/dev/null 2>&1 < /dev/null &
