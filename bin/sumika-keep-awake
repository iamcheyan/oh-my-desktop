#!/usr/bin/env bash
# sumika-keep-awake — Keep the machine running with the lid closed (long tasks).
#
# Registers a block-mode systemd inhibitor for handle-lid-switch and sleep so
# closing the lid (or any automatic suspend request) does not freeze running
# work. The inhibitor only guards *automatic* suspend triggers (lid close,
# hypridle); manual Sleep/Hibernate from the power UI must bypass it — those
# go through the `suspend`/`hibernate` subcommands below, which lift the
# inhibitor for the request and re-arm it after resume.
#
# State is persisted in $SUMIKA_SHELL_STATE_HOME/keep-awake{,.pid} so the mode
# survives bar reloads and is re-asserted on session start (hypr/autostart.lua
# runs `sumika-keep-awake ensure`).
#
# Usage: sumika-keep-awake <on|off|status|ensure|suspend|hibernate>

set -u

state_home="${SUMIKA_SHELL_STATE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}/sumika-shell}"
state_file="$state_home/keep-awake"
pid_file="$state_home/keep-awake.pid"

mkdir -p "$state_home" 2>/dev/null

inhibitor_alive() {
    [[ -f "$pid_file" ]] || return 1
    local pid
    pid="$(cat "$pid_file" 2>/dev/null)" || return 1
    [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

start_inhibitor() {
    if inhibitor_alive; then
        echo "on (already running, pid $(cat "$pid_file"))"
        return 0
    fi
    nohup systemd-inhibit --what=handle-lid-switch:sleep --mode=block \
        --who=sumika-keep-awake \
        --why="Keep Awake: lid-close suspend disabled" \
        sleep infinity >/dev/null 2>&1 &
    echo $! > "$pid_file"
    sleep 0.3
    if inhibitor_alive; then
        echo "on" > "$state_file"
        echo "on"
    else
        rm -f "$pid_file"
        echo "failed to start systemd-inhibit" >&2
        return 1
    fi
}

stop_inhibitor() {
    if [[ -f "$pid_file" ]]; then
        kill "$(cat "$pid_file")" 2>/dev/null
        rm -f "$pid_file"
    fi
    rm -f "$state_file"
    echo "off"
}

release_inhibitor() {
    # Temporarily drop the block lock so logind accepts the manual request.
    if inhibitor_alive; then
        kill "$(cat "$pid_file")" 2>/dev/null || true
        rm -f "$pid_file"
        # Wait until logind has actually released the lock (usually instant).
        local i
        for ((i = 0; i < 30; i++)); do
            systemd-inhibit --list --mode=block 2>/dev/null | grep -q "sumika-keep-awake" || return 0
            sleep 0.1
        done
    fi
}

do_suspend()   { systemctl suspend   || loginctl suspend; }
do_hibernate() { systemctl hibernate || loginctl hibernate; }

# Manual power action: bypass Keep Awake, run the request, then re-arm the
# inhibitor if the mode is still on. `systemctl hibernate|suspend` returns
# before the machine freezes, so an inline re-arm races logind's sleep
# transaction and can fail silently. The scheduled `ensure` closes that gap:
# systemd --user timers run on CLOCK_MONOTONIC, which pauses while the
# machine sleeps, so the re-assert lands ~1 min after resume in every path
# (successful sleep, refused sleep, or crash of the inline attempt).
power_action() {
    release_inhibitor
    "$@"
    local rc=$?
    if [[ -f "$state_file" ]]; then
        start_inhibitor >/dev/null 2>&1
        systemd-run --user --unit=sumika-keep-awake-reassert --on-active=1min \
            --collect "${BASH_SOURCE[0]}" ensure >/dev/null 2>&1 || true
    fi
    return $rc
}

cmd="${1:-status}"
case "$cmd" in
    on)     start_inhibitor ;;
    off)    stop_inhibitor ;;
    ensure)
        if [[ -f "$state_file" ]]; then
            start_inhibitor
        else
            stop_inhibitor
        fi
        ;;
    status)
        if inhibitor_alive; then echo "on"; else echo "off"; fi
        ;;
    suspend)   power_action do_suspend ;;
    hibernate) power_action do_hibernate ;;
    *)
        echo "usage: sumika-keep-awake <on|off|status|ensure|suspend|hibernate>" >&2
        exit 2
        ;;
esac
