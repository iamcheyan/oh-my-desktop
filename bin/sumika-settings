#!/bin/sh
set -eu

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
. "$repo_root/lib/paths.sh"

# Determine app_dir: core settings module or apps/sumika-settings
app_dir=""
if [ -d "$repo_root/apps/sumika-settings" ]; then
    app_dir="$repo_root/apps/sumika-settings"
elif [ -d "$repo_root/quickshell/modules/settings" ]; then
    app_dir="$repo_root/quickshell/modules/settings"
fi

if [ -z "$app_dir" ] || [ ! -d "$app_dir" ]; then
    printf 'sumika-settings: settings app not found\n' >&2
    exit 1
fi

if [ -x "$app_dir/bin/sumika-settings" ]; then
    exec "$app_dir/bin/sumika-settings" "$@"
fi

cmd="${1:-open}"
page="${2:-display}"

is_running() {
    pgrep -af "(quickshell|qs).* -p ${app_dir}( |$)" >/dev/null 2>&1
}

ipc_call() {
    "${SUMIKA_QS_BIN:-qs}" -p "$app_dir" ipc call settings "$1" "$2" 2>/dev/null || true
}

launch_direct() {
    export SUMIKA_SETTINGS_PAGE="$page"
    export SUMIKA_SETTINGS_ON_DEMAND=1
    exec "$SUMIKA_SHELL_ROOT/quickshell/scripts/quickshell" "$app_dir"
}

case "$cmd" in
    open)
        if is_running; then
            ipc_call open "$page"
        else
            launch_direct
        fi
        ;;
    toggle)
        if is_running; then
            ipc_call toggle "$page"
        else
            launch_direct
        fi
        ;;
    close)
        if is_running; then
            ipc_call close ""
        fi
        ;;
    *)
        if is_running; then
            ipc_call open "$page"
        else
            launch_direct
        fi
        ;;
esac
