#!/usr/bin/env bash
# Light connectivity check: gateway RTT + 1.1.1.1 RTT (ms or fail/n/a).
set -euo pipefail
export LANG=C LC_ALL=C

dev=$(nmcli -t -f DEVICE,TYPE,STATE device status | awk -F: '
  $2=="wifi" && $3=="connected" { print $1; exit }
')
if [[ -z "$dev" ]]; then
  dev=$(nmcli -t -f DEVICE,TYPE,STATE device status | awk -F: '
    $2=="ethernet" && $3=="connected" { print $1; exit }
  ')
fi

gw=""
if [[ -n "$dev" ]]; then
  gw=$(nmcli -t -f IP4.GATEWAY device show "$dev" 2>/dev/null | awk -F: 'NF>1 && $2!="" && $2!="--"{print $2; exit}')
fi
if [[ -z "$gw" ]]; then
  gw=$(nmcli -t -f IP4.GATEWAY device show 2>/dev/null | awk -F: 'NF>1 && $2!="" && $2!="--"{print $2; exit}')
fi

if [[ -n "$gw" ]]; then
  out=$(ping -n -c 1 -W 2 "$gw" 2>/dev/null | awk -F'time=' '/time=/{gsub(/ ms/,"",$2); print $2; exit}') || true
  gw_ms=${out:-fail}
else
  gw_ms=n/a
fi

out=$(ping -n -c 1 -W 2 1.1.1.1 2>/dev/null | awk -F'time=' '/time=/{gsub(/ ms/,"",$2); print $2; exit}') || true
ext_ms=${out:-fail}

printf 'gateway_ms=%s\nexternal_ms=%s\n' "$gw_ms" "$ext_ms"
