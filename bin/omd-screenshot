#!/bin/sh
set -eu

# On-demand Screenshot / Region Selector process.
# Usage:
#   omd-screenshot              # fast region screenshot (slurp + grim)
#   omd-screenshot screenshot   # same as above
#   omd-screenshot edit         # frozen screenshot & edit
#   omd-screenshot search       # search with Google Lens
#   omd-screenshot ocr          # OCR text recognition
#   omd-screenshot record       # record region
#   omd-screenshot toggle       # open if closed, cancel if already open
#
# Starts a Quickshell process that auto-opens the region selector
# and quits when the selection is complete or cancelled.
# Re-invoking while open cancels the current selection (toggle).

app_dir="$HOME/.config/omd/apps/omd-screenshot"
log_file="${OMD_SCREENSHOT_LOG:-/tmp/omd-screenshot.log}"
action="${1:-screenshot}"
lock_file="${XDG_RUNTIME_DIR:-/tmp}/omd-screenshot.lock"
fast_pid_file="${XDG_RUNTIME_DIR:-/tmp}/omd-screenshot-fast.pid"

# Hyprland binds can run with a minimal environment.
if [ -n "${PATH:-}" ]; then
    export PATH="$PATH:/usr/bin:/usr/local/bin:${HOME}/.local/bin"
else
    export PATH="/usr/bin:/usr/local/bin:${HOME}/.local/bin"
fi

# Normalize legacy aliases.
case "$action" in
    toggle|"")
        action="screenshot"
        toggle_mode=1
        ;;
    *)
        toggle_mode=0
        ;;
esac

is_running() {
    # Same pattern as omd-clipboard / omd-settings: match qs -p <app_dir>
    pgrep -af "(quickshell|qs).* -p ${app_dir}( |$)" >/dev/null 2>&1
}

list_running_pids() {
    # pgrep -f prints "PID cmdline"; take only the PID column.
    pgrep -f "(quickshell|qs).* -p ${app_dir}( |$)" 2>/dev/null || true
}

kill_running() {
    pids=$(list_running_pids)
    if [ -z "${pids:-}" ]; then
        return 0
    fi
    # shellcheck disable=SC2086
    kill $pids 2>/dev/null || true
    i=0
    while is_running && [ "$i" -lt 20 ]; do
        sleep 0.05
        i=$((i + 1))
    done
    if is_running; then
        pids=$(list_running_pids)
        # shellcheck disable=SC2086
        [ -n "${pids:-}" ] && kill -9 $pids 2>/dev/null || true
    fi
}

wait_until_not_running() {
    i=0
    while is_running && [ "$i" -lt 30 ]; do
        sleep 0.05
        i=$((i + 1))
    done
}

wait_until_running_or_failed() {
    i=0
    while [ "$i" -lt 20 ]; do
        if is_running; then
            return 0
        fi
        sleep 0.05
        i=$((i + 1))
    done
    return 1
}

focused_monitor() {
    command -v hyprctl >/dev/null 2>&1 || return 0
    hyprctl monitors -j 2>/dev/null \
        | jq -r '.[] | select(.focused) | .name' 2>/dev/null \
        | head -n 1
}

hide_cursor() {
    if command -v hyprctl >/dev/null 2>&1; then
        hyprctl cursor move -999 -999 2>/dev/null || true
    fi
}

restore_cursor() {
    if command -v hyprctl >/dev/null 2>&1; then
        eval "$(hyprctl monitors -j 2>/dev/null | jq -r '
            .[] | select(.focused) |
            "cx=\(.x + .width / 2 | floor); cy=\(.y + .height / 2 | floor)"
        ' 2>/dev/null || true)"
        hyprctl cursor move "${cx:-960}" "${cy:-540}" 2>/dev/null || true
    fi
}

cancel_fast_capture() {
    [ -f "$fast_pid_file" ] || return 1
    fast_pid="$(cat "$fast_pid_file" 2>/dev/null || true)"
    if [ -n "$fast_pid" ] && kill -0 "$fast_pid" 2>/dev/null; then
        kill "$fast_pid" 2>/dev/null || true
        rm -f "$fast_pid_file"
        return 0
    fi
    rm -f "$fast_pid_file"
    return 1
}

fast_capture() {
    # Repeating the shortcut cancels the active slurp selection.
    if cancel_fast_capture; then
        exit 0
    fi

    if ! command -v slurp >/dev/null 2>&1 || ! command -v grim >/dev/null 2>&1 || ! command -v wl-copy >/dev/null 2>&1; then
        notify-send -u critical "Screenshot" "grim, slurp and wl-copy are required" 2>/dev/null || true
        exit 127
    fi

    target_monitor="$(focused_monitor)"
    selection_file="$(mktemp /tmp/omd-slurp.XXXXXX)"
    # %W/%H crop the drag geometry to the output containing its top-left
    # corner, so a selection cannot spill into an adjacent monitor.
    slurp -d -f '%x,%y %Wx%H|%o' \
        -b '#00000066' -c '#f4f4f4ff' -s '#ffffff22' -w 2 \
        > "$selection_file" 2>/dev/null &
    slurp_pid=$!
    printf '%s\n' "$slurp_pid" > "$fast_pid_file"
    trap 'kill "$slurp_pid" 2>/dev/null || true; rm -f "$fast_pid_file" "$selection_file"' EXIT INT TERM
    wait "$slurp_pid" 2>/dev/null || true
    rm -f "$fast_pid_file"
    trap 'rm -f "$fast_pid_file" "$selection_file"' EXIT INT TERM
    selection="$(cat "$selection_file" 2>/dev/null || true)"
    rm -f "$selection_file"
    [ -n "$selection" ] || exit 0

    geometry="${selection%|*}"
    selected_monitor="${selection##*|}"
    if [ -n "$target_monitor" ] && [ "$selected_monitor" != "$target_monitor" ]; then
        notify-send "Screenshot cancelled" "Select a region on the focused display ($target_monitor)" 2>/dev/null || true
        exit 0
    fi

    tmp_file="$(mktemp /tmp/omd-screenshot.XXXXXX.png)"
    trap 'rm -f "$fast_pid_file" "$tmp_file"' EXIT INT TERM
    hide_cursor
    grim -g "$geometry" "$tmp_file"
    restore_cursor

    save_dir=""
    if command -v jq >/dev/null 2>&1 && [ -r "$HOME/.config/quickshell/config.json" ]; then
        save_dir="$(jq -r '.screenSnip.savePath // empty' "$HOME/.config/quickshell/config.json" 2>/dev/null || true)"
    fi
    if [ -n "$save_dir" ]; then
        mkdir -p "$save_dir"
        save_path="$save_dir/screenshot-$(date '+%Y-%m-%d_%H.%M.%S').png"
        cp "$tmp_file" "$save_path"
    fi
    wl-copy --type image/png < "$tmp_file"
    notify-send -i camera-photo "Screenshot" "Region copied to clipboard" 2>/dev/null || true
}

# Serialize the critical "kill + relaunch" section so rapid clicks do not
# race each other. The lock is held ONLY for this section, then released before
# launching Quickshell, so wl-copy/grim/hyprpicker never inherit it.
exec 9>"$lock_file"
flock -w 1 9 || exit 0

# Re-press while open = cancel (same mental model as slurp toggle).
if is_running; then
    kill_running
    wait_until_not_running
    rm -f /tmp/omd-screenshot-active
    qs -p "$app_dir/../omd-bar" ipc call screenshot end >/dev/null 2>&1 || true
    # Explicit cancel request: do not relaunch.
    if [ "$toggle_mode" -eq 1 ] || [ "${1:-}" = "toggle" ]; then
        exec 9>&-
        exit 0
    fi
    # Explicit actions from the bar/keybind should be reliable wake requests:
    # clear stale or half-visible instances, then launch a fresh selector.
    sleep 0.1
fi
exec 9>&-

launch_direct() {
    cancel_fast_capture || true

    qs_bin="${OMD_QS_BIN:-}"
    if [ -z "$qs_bin" ]; then
        if [ -x /usr/bin/qs ]; then
            qs_bin=/usr/bin/qs
        elif [ -x /usr/bin/quickshell ]; then
            qs_bin=/usr/bin/quickshell
        elif [ -x "$HOME/.local/bin/qs" ]; then
            qs_bin="$HOME/.local/bin/qs"
        elif [ -x "$HOME/.local/bin/quickshell" ]; then
            qs_bin="$HOME/.local/bin/quickshell"
        fi
    fi
    if [ -z "$qs_bin" ]; then
        echo "Quickshell executable not found" >&2
        exit 127
    fi

    repo_root="${OMD_REPO_ROOT:-$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)}"
    export OMD_REPO_ROOT="$repo_root"
    export OMD_QUICKSHELL_DIR="$repo_root/quickshell"
    export QS_CONFIG_DIR="$app_dir"
    export QS_COMPOSITOR=hyprland
    export OMD_APP_DIR="$app_dir"
    export OMD_SCREENSHOT_ACTION="$action"

    runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

    # Prefer the live Hyprland instance (correct WAYLAND_DISPLAY + signature).
    if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || [ -z "${WAYLAND_DISPLAY:-}" ]; then
        for candidate in "$runtime_dir"/hypr/*/hyprland.lock; do
            [ -f "$candidate" ] || continue
            pid="$(sed -n '1p' "$candidate" 2>/dev/null || true)"
            display="$(sed -n '2p' "$candidate" 2>/dev/null || true)"
            [ -n "$pid" ] || continue
            kill -0 "$pid" 2>/dev/null || continue
            export HYPRLAND_INSTANCE_SIGNATURE="$(basename "$(dirname "$candidate")")"
            [ -n "$display" ] && export WAYLAND_DISPLAY="$display"
            break
        done
    fi

    if [ -z "${WAYLAND_DISPLAY:-}" ] || [ ! -S "$runtime_dir/${WAYLAND_DISPLAY:-}" ]; then
        for socket in "$runtime_dir"/wayland-*; do
            if [ -S "$socket" ]; then
                export WAYLAND_DISPLAY="$(basename "$socket")"
                break
            fi
        done
    fi

    if [ -z "${WAYLAND_DISPLAY:-}" ]; then
        echo "No Wayland display socket found. Start this from inside Hyprland." >&2
        exit 1
    fi

    target_monitor="$(focused_monitor)"
    if [ -n "$target_monitor" ]; then
        export OMD_SCREENSHOT_MONITOR="$target_monitor"
    fi

    # Keep the wake request short-lived. Hyprland binds and bar clicks should
    # fire-and-forget instead of inheriting the selector process lifetime.
    # The flock fd was already closed before entering launch_direct(), so
    # Quickshell and its children (grim, wl-copy, hyprpicker, ...) never
    # inherit the advisory lock.

    # ── Snapshot-first approach ─────────────────────────────────────────────
    # The fundamental problem: when the screenshot QS process creates its
    # Overlay+Exclusive layer-shell surface, Hyprland moves focus away from
    # the bar's popup/menu, triggering GlobalFocusGrab.onCleared which
    # dismisses any visible overlay — *before* grim can capture it.
    #
    # Solution: run grim HERE (in the shell, before any QS process exists)
    # so popups are still on screen. The snapshot files are passed to the
    # QS process via OMD_SNAPSHOT_DIR; RegionSelection.qml skips its own
    # grim call and loads the pre-captured images directly.
    touch /tmp/omd-screenshot-active
    qs -p "$app_dir/../omd-bar" ipc call screenshot begin > /dev/null 2>&1 || true

    snapshot_dir="/tmp/quickshell/media/screenshot"
    mkdir -p "$snapshot_dir"
    export OMD_SNAPSHOT_DIR="$snapshot_dir"

    # For recording actions, don't pre-capture (record captures live output).
    # For all screenshot/edit/search/ocr actions, capture now while overlays
    # are still visible.
    if [ "$action" != "record" ] && [ "$action" != "recordWithSound" ]; then
        # Advanced/frozen selection only needs the focused output. Avoid
        # capturing and decoding a full-resolution PNG for every monitor.
        snapshot_ts="$(date +%s%3N)"
        if [ -n "$target_monitor" ]; then
            snap_path="${snapshot_dir}/snapshot-${target_monitor}-${snapshot_ts}.png"
            hide_cursor
            if grim -o "$target_monitor" "$snap_path" > /dev/null 2>&1; then
                mon_env="$(printf '%s' "$target_monitor" | sed 's/[-.]/_/g')"
                export "OMD_SNAPSHOT_PATH_${mon_env}=${snap_path}"
            fi
            restore_cursor
        fi

        # If pre-capture fails, RegionSelection falls back to capturing its
        # single target output after startup. Do not load a combined desktop
        # image into a monitor-sized selector.
    fi

    nohup "$qs_bin" -p "$app_dir" >> "$log_file" 2>&1 &
    wait_until_running_or_failed || true
}

case "$action" in
    screenshot)
        fast_capture
        ;;
    edit|search|ocr|record|recordWithSound)
        launch_direct
        ;;
    *)
        echo "usage: omd-screenshot [screenshot|edit|search|ocr|record|recordWithSound|toggle]" >&2
        exit 2
        ;;
esac
