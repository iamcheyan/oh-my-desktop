#!/usr/bin/env bash
set -euo pipefail

OMD_ROOT="${OMD_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
export OMD_ROOT

BINDINGS_FILE="$HOME/.config/voice_bindings.txt"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omd-voice"
VENV_DIR="${OMD_VOICE_VENV:-$CACHE_DIR/venv}"
MODEL_DIR="$CACHE_DIR/sense-voice-small-int8"
SOCKET="/tmp/omd-voice.sock"
REC_PID_PATH="${OMD_VOICE_REC_PID:-/tmp/omd-voice-rec.pid}"
LAUNCH_TUI="$OMD_ROOT/bin/omd-launch-tui"
KEY_CAPTURE="$OMD_ROOT/scripts/key-test-launcher"
VOICE_BIND_TUI="$OMD_ROOT/scripts/voice-bind-tui"
VOICE_EDIT_BINDINGS="$OMD_ROOT/bin/omd-edit-voice-bindings"
VOICE_DIAGNOSE="$OMD_ROOT/scripts/voice-diagnose"
VOICE_TEST_TUI="$OMD_ROOT/scripts/voice-test-tui"
VOICE_SETUP="$OMD_ROOT/share/bin/omarchy-voice-setup"
VOICE_DOWNLOAD="$OMD_ROOT/share/bin/omarchy-voice-download"

# Runtime state directory. Holds state.json (ephemeral phase + progress) and
# recent.json (last N transcription results). The TUI polls `status` to read.
STATE_DIR="${SUMIKA_SHELL_STATE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}/sumika-shell}/voice"
STATE_FILE="$STATE_DIR/state.json"
RECENT_FILE="$STATE_DIR/recent.json"
MODEL_BYTES_TOTAL=240000000  # ~229 MB SenseVoice Small INT8, used for progress estimate

kv() {
  local key="$1" value="${2:-}"
  value="${value//$'\n'/ }"
  value="${value//$'\n'/ }"
  printf '%s=%s\n' "$key" "$value"
}

have() {
  command -v "$1" >/dev/null 2>&1
}

bool() {
  if "$@" >/dev/null 2>&1; then printf true; else printf false; fi
}

model_size_mb() {
  if model_ready; then
    du -sm "$MODEL_DIR" 2>/dev/null | awk '{print $1}'
  else
    printf '0'
  fi
}

model_ready() {
  [[ -f "$MODEL_DIR/model.int8.onnx" && -f "$MODEL_DIR/tokens.txt" ]]
}

venv_ready() {
  [[ -x "$VENV_DIR/bin/python3" ]] && "$VENV_DIR/bin/python3" -c 'import sherpa_onnx, numpy' >/dev/null 2>&1
}

daemon_running() {
  [[ -S "$SOCKET" ]] && ss -x src "$SOCKET" 2>/dev/null | grep -q LISTEN
}

recording_active() {
  local pid
  pid="$(cat "$REC_PID_PATH" 2>/dev/null || true)"
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

ensure_state_dir() {
  mkdir -p "$STATE_DIR"
}

# write_state <json-object>
write_state() {
  ensure_state_dir
  local tmp="$STATE_FILE.tmp"
  printf '%s\n' "$1" >"$tmp"
  mv "$tmp" "$STATE_FILE"
}

clear_state() {
  rm -f "$STATE_FILE"
}

# state_json prints the current state.json content (or {} if missing).
state_json() {
  if [[ -f "$STATE_FILE" ]]; then
    cat "$STATE_FILE"
  else
    printf '{}'
  fi
}

# push_recent <text> keeps the last 8 transcription results in recent.json.
push_recent() {
  local text="$1"
  ensure_state_dir
  python3 - "$RECENT_FILE" "$text" <<'PY'
import json, os, sys
path, text = sys.argv[1], sys.argv[2]
items = []
try:
    with open(path, encoding="utf-8") as f:
        items = json.load(f)
except Exception:
    items = []
items.insert(0, {"text": text, "ts": int(__import__("time").time())})
items = items[:8]
tmp = path + ".tmp"
with open(tmp, "w", encoding="utf-8") as f:
    json.dump(items, f, ensure_ascii=False, indent=2)
    f.write("\n")
os.replace(tmp, path)
PY
}

health_state() {
  if recording_active; then
    printf 'recording'
    return
  fi
  if download_in_progress; then
    printf 'downloading'
    return
  fi
  if ! model_ready || ! venv_ready; then
    printf 'nomodel'
    return
  fi
  printf 'idle'
}

# download_in_progress returns true when a download state.json exists and its
# phase is "downloading" with a non-stale heartbeat (updated within 30s).
download_in_progress() {
  [[ -f "$STATE_FILE" ]] || return 1
  python3 - "$STATE_FILE" <<'PY'
import json, os, sys, time
try:
    with open(sys.argv[1], encoding="utf-8") as f:
        s = json.load(f)
except Exception:
    sys.exit(1)
if s.get("phase") != "downloading":
    sys.exit(1)
hb = s.get("heartbeat", 0)
if time.time() - hb > 30:
    sys.exit(1)
sys.exit(0)
PY
}

friendly_binding() {
  local key="$1"
  case "$key" in
    "ALT + A") printf 'Alt + A' ;;
    "code:472") printf 'Globe (Fn)' ;;
    "XF86Tools"|"TOOLS") printf 'F13 / Tools' ;;
    "escape"|"ESCAPE") printf 'Esc' ;;
    *) printf '%s' "$key" ;;
  esac
}

list_bindings() {
  if [[ ! -f "$BINDINGS_FILE" ]]; then
    return
  fi
  while IFS= read -r line; do
    line="$(printf '%s' "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
    [[ -z "$line" || "$line" == \#* ]] && continue
    printf 'binding=%s\n' "$line"
  done < "$BINDINGS_FILE"
}

status() {
  local size state
  size="$(model_size_mb)"
  state="$(health_state)"
  kv state "$state"
  kv modelSizeMB "$size"
  kv modelReady "$(bool model_ready)"
  kv venvReady "$(bool venv_ready)"
  kv modelDir "$MODEL_DIR"
  kv venvDir "$VENV_DIR"
  kv cacheDir "$CACHE_DIR"
  kv socket "$SOCKET"
  kv daemonRunning "$(bool daemon_running)"
  kv recording "$(bool recording_active)"
  kv micLevel "$(mic_level)"
  kv bindingsFile "$BINDINGS_FILE"
  kv defaultTrigger "ALT + A"
  kv defaultsApply "true"
  kv modelBytesTotal "$MODEL_BYTES_TOTAL"
  # Download progress fields (empty unless a download is in flight)
  if download_in_progress; then
    python3 - "$STATE_FILE" <<'PY'
import json, os, sys
try:
    with open(sys.argv[1], encoding="utf-8") as f:
        s = json.load(f)
except Exception:
    s = {}
def emit(k, v):
    print(f"{k}={v}")
emit("download.phase", s.get("phase", "downloading"))
emit("download.bytes", s.get("bytes", 0))
emit("download.percent", s.get("percent", 0))
emit("download.speedBps", s.get("speedBps", 0))
emit("download.etaSec", s.get("etaSec", 0))
emit("download.label", s.get("label", ""))
PY
  else
    kv download.phase ""
    kv download.bytes ""
    kv download.percent ""
    kv download.speedBps ""
    kv download.etaSec ""
    kv download.label ""
  fi
  # Recent transcription results (JSON array, newest first)
  if [[ -f "$RECENT_FILE" ]]; then
    kv recent "$(cat "$RECENT_FILE" | tr '\n' ' ' | sed 's/  */ /g')"
  else
    kv recent "[]"
  fi
  list_bindings
}

setup() {
  # Non-blocking: kick off venv + model download in the background, write
  # progress to state.json, and return immediately. The TUI polls `status`
  # to render the downloading view. A stale heartbeat (>30s) is treated as
  # a failed/cancelled download.
  ensure_state_dir
  if model_ready && venv_ready; then
    clear_state
    kv result "already-ready"
    return
  fi

  local log_file="$STATE_DIR/install.log"
  echo "=== Voice Input Setup Log ===" >"$log_file"
  echo "Starting virtual environment setup..." >>"$log_file"

  # Mark downloading immediately so the UI can flip state before the first
  # curl progress line arrives.
  write_state '{"phase":"downloading","bytes":0,"percent":0,"speedBps":0,"etaSec":0,"label":"Starting…","heartbeat":'$(date +%s)'}'

  (
    # venv first
    if [[ -x "$VOICE_SETUP" ]]; then
      echo "Setting up Python virtual environment (this may take a minute)..." >>"$log_file"
      "$VOICE_SETUP" >>"$log_file" 2>&1
    fi
    # then model download with progress tracking
    if ! model_ready && [[ -x "$VOICE_DOWNLOAD" ]]; then
      echo "Downloading speech model files (~229 MB)..." >>"$log_file"
      download_with_progress >>"$log_file" 2>&1
    fi
    if model_ready && venv_ready; then
      echo "Setup completed successfully! Daemon is ready to run." >>"$log_file"
      clear_state
    else
      echo "Setup failed. Please review errors above." >>"$log_file"
      # leave state.json so the UI can show an error; clear phase so it's
      # not treated as an in-flight download.
      python3 - "$STATE_FILE" <<'PY'
import json, os, sys
path = sys.argv[1]
try:
    with open(path, encoding="utf-8") as f:
        s = json.load(f)
except Exception:
    s = {}
s["phase"] = "failed"
s["label"] = "Setup failed — retry"
s["heartbeat"] = int(__import__("time").time())
with open(path, "w", encoding="utf-8") as f:
    json.dump(s, f)
    f.write("\n")
PY
    fi
  ) &
  kv result "setup-started"
}

# download_with_progress wraps omarchy-voice-download, parsing curl progress
# and updating state.json with bytes/percent/speed/eta.
download_with_progress() {
  local model_url="https://huggingface.co/csukuangfj/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-2024-07-17/resolve/main/model.int8.onnx"
  local tokens_url="https://huggingface.co/csukuangfj/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-2024-07-17/resolve/main/tokens.txt"
  mkdir -p "$MODEL_DIR"

  download_one "$model_url" "$MODEL_DIR/model.int8.onnx" "model.int8.onnx"
  download_one "$tokens_url" "$MODEL_DIR/tokens.txt" "tokens.txt"
}

download_one() {
  local url="$1" dest="$2" name="$3"
  if [[ -f "$dest" ]]; then return 0; fi
  # curl --progress-bar writes \r-delimited progress to stderr. We parse the
  # percentage and derive bytes from MODEL_BYTES_TOTAL. Speed/eta come from
  # curl's own estimate text.
  local progress
  curl -L --progress-bar -o "${dest}.part" "$url" 2>&1 | while IFS= read -r progress; do
    update_download_state "$name" "$progress"
  done
  mv "${dest}.part" "$dest"
}

update_download_state() {
  local name="$1" raw="$2"
  # curl progress-bar lines look like: "###   12.3%  18.0 MB/s  00:11 ETA"
  # or just "######..." We extract percent and speed/eta when present.
  local percent=0 speed_bps=0 eta=0 bytes=0
  local pct_match
  if pct_match="$(printf '%s' "$raw" | grep -oE '[0-9]+(\.[0-9]+)?%' | head -1)"; then
    percent="${pct_match%\%}"
  fi
  bytes="$(python3 -c "print(int($MODEL_BYTES_TOTAL * ($percent / 100.0)))" 2>/dev/null || printf 0)"
  local speed_match
  if speed_match="$(printf '%s' "$raw" | grep -oE '[0-9]+(\.[0-9]+)?\s*[KM]B/s' | head -1)"; then
    local num unit
    num="$(printf '%s' "$speed_match" | grep -oE '^[0-9]+(\.[0-9]+)?')"
    unit="$(printf '%s' "$speed_match" | grep -oE '[KM]B/s')"
    case "$unit" in
      MB/s) speed_bps="$(python3 -c "print(int($num * 1024 * 1024))" 2>/dev/null || printf 0)";;
      KB/s) speed_bps="$(python3 -c "print(int($num * 1024))" 2>/dev/null || printf 0)";;
    esac
  fi
  local eta_match
  if eta_match="$(printf '%s' "$raw" | grep -oE '[0-9]{2}:[0-9]{2}:[0-9]{2}|[0-9]{2}:[0-9]{2}' | head -1)"; then
    eta="$(python3 -c "
parts='$eta_match'.split(':')
print(int(parts[0])*3600 + int(parts[1])*60 + (int(parts[2]) if len(parts)>2 else 0))
" 2>/dev/null || printf 0)"
  fi
  python3 - "$STATE_FILE" "$percent" "$bytes" "$speed_bps" "$eta" "$name" <<'PY'
import json, os, sys, time
path, percent, bytes_, speed, eta, name = sys.argv[1:7]
try:
    with open(path, encoding="utf-8") as f:
        s = json.load(f)
except Exception:
    s = {}
s["phase"] = "downloading"
s["percent"] = int(float(percent))
s["bytes"] = int(bytes_)
s["speedBps"] = int(speed)
s["etaSec"] = int(eta)
s["label"] = name
s["heartbeat"] = int(time.time())
tmp = path + ".tmp"
with open(tmp, "w", encoding="utf-8") as f:
    json.dump(s, f)
    f.write("\n")
os.replace(tmp, path)
PY
}

cancel_setup() {
  # Kill in-flight curl processes and clear the download state.
  pkill -f "curl.*sense-voice" 2>/dev/null || true
  pkill -f "omarchy-voice-setup" 2>/dev/null || true
  clear_state
  kv result "cancelled"
}

add_binding() {
  local raw="${1:-}"
  [[ -n "$raw" ]] || { echo "usage: omd-settings-voice add <key>" >&2; exit 2; }
  mkdir -p "$(dirname "$BINDINGS_FILE")"
  if [[ ! -f "$BINDINGS_FILE" ]]; then
    printf '# OMD Voice Input Keybindings\n# One key combination per line. Format e.g., '"'"'ALT + A'"'"' or '"'"'code:472'"'"'\n\n' >"$BINDINGS_FILE"
  fi
  while IFS= read -r line; do
    line="$(printf '%s' "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
    [[ "$line" == "$raw" ]] && { echo "already-bound"; kv result "noop"; return; }
  done < "$BINDINGS_FILE" 2>/dev/null || true
  printf '%s\n' "$raw" >>"$BINDINGS_FILE"
  hyprctl reload >/dev/null 2>&1 || true
  kv result "added"
}

remove_binding() {
  local raw="${1:-}"
  [[ -n "$raw" ]] || { echo "usage: omd-settings-voice remove <key>" >&2; exit 2; }
  [[ -f "$BINDINGS_FILE" ]] || { echo "no-bindings"; kv result "noop"; return; }
  local tmp
  tmp="$(mktemp)"
  while IFS= read -r line; do
    orig="$line"
    line="$(printf '%s' "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
    [[ "$line" == "$raw" ]] && continue
    printf '%s\n' "$orig" >>"$tmp"
  done < "$BINDINGS_FILE"
  mv "$tmp" "$BINDINGS_FILE"
  hyprctl reload >/dev/null 2>&1 || true
  kv result "removed"
}

record() {
  launch_tui "$VOICE_TEST_TUI"
  kv result "test-opened"
}

launch_tui() {
  local target="$1"
  [[ -x "$target" ]] || { echo "ERROR: tool missing: $target" >&2; exit 1; }
  if [[ -x "$LAUNCH_TUI" ]]; then
    "$LAUNCH_TUI" "$target" >/dev/null 2>&1 &
  else
    "$target" >/dev/null 2>&1 &
  fi
}

launch_gui() {
  local target="$1"
  shift
  [[ -x "$target" ]] || { echo "ERROR: tool missing: $target" >&2; exit 1; }
  ensure_state_dir
  local log="$STATE_DIR/$(basename "$target").log"
  if uwsm_app="$(command -v uwsm-app 2>/dev/null)"; then
    "$uwsm_app" -- "$target" "$@" >"$log" 2>&1 &
  else
    setsid "$target" "$@" >"$log" 2>&1 &
  fi
}

read_capture() {
  local since="${1:-0}"
  local state_home="${SUMIKA_SHELL_STATE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}/sumika-shell}"
  python3 - "$since" "$state_home" <<'PY'
import json, os, sys
raw = ""
since = float(sys.argv[1] or 0)
state = os.path.join(sys.argv[2], "key-capture.json")
try:
    if since > 0 and os.path.getmtime(state) < since:
        raise RuntimeError("stale capture")
    with open(state, encoding="utf-8") as f:
        data = json.load(f)
    raw = (data.get("raw") or "").strip()
except Exception:
    pass
if raw == "TOOLS":
    raw = "XF86Tools"
print(raw)
PY
}

capture_binding() {
  [[ -x "$KEY_CAPTURE" ]] || { echo "ERROR: key capture tool missing" >&2; exit 1; }
  local state_file="${SUMIKA_SHELL_STATE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}/sumika-shell}/key-capture.json"
  local started_at
  started_at="$(python3 - <<'PY'
import time
print(time.time())
PY
)"
  rm -f "$state_file"
  "$KEY_CAPTURE" --hotkey >/dev/null 2>&1 || true
  local raw
  raw="$(read_capture "$started_at")"
  [[ -n "$raw" ]] || { kv result "no-capture"; exit 1; }
  add_binding "$raw"
  kv captured "$raw"
}

edit_bindings() {
  launch_tui "$VOICE_EDIT_BINDINGS"
  kv result "editor-opened"
}

bind_tui() {
  launch_tui "$VOICE_BIND_TUI"
  kv result "binding-tool-opened"
}

key_test() {
  if [[ ! -e /nix/store ]]; then
    python3 - <<'PY'
import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Gtk, Adw  # noqa: F401
PY
  fi
  launch_gui "$KEY_CAPTURE" --hotkey
  kv result "key-test-opened"
}

diagnose() {
  echo "Starting system status diagnosis..."
  echo "==================================="

  # 1. venv check
  if [[ -x "$VENV_DIR/bin/python3" ]]; then
    echo "[Venv]   OK - Python virtual environment is ready."
  else
    echo "[Venv]   FAIL - Virtual environment missing at $VENV_DIR"
  fi

  # 2. deps check
  if [[ -x "$VENV_DIR/bin/python3" ]]; then
    if "$VENV_DIR/bin/python3" -c 'import sherpa_onnx, numpy' >/dev/null 2>&1; then
      echo "[Deps]   OK - Python dependencies (sherpa-onnx, numpy) loaded successfully."
    else
      echo "[Deps]   FAIL - sherpa-onnx or numpy missing in venv."
    fi
  else
    echo "[Deps]   FAIL - Skipped (Venv not ready)."
  fi

  # 3. model check
  if model_ready; then
    local sz
    sz=$(du -sm "$MODEL_DIR" 2>/dev/null | awk '{print $1}')
    echo "[Model]  OK - Model files present (~$sz MB)."
  else
    echo "[Model]  FAIL - Model files missing at $MODEL_DIR"
  fi

  # 4. daemon check
  if daemon_running; then
    echo "[Daemon] OK - Voice background daemon is active."
  else
    echo "[Daemon] WARN - Daemon is idle (will auto-launch on first recording)."
  fi

  # 5. recording tool check
  if command -v parecord >/dev/null 2>&1; then
    echo "[Record] OK - parecord utility is available."
  else
    echo "[Record] FAIL - parecord missing (install pulseaudio or pipewire-pulse)."
  fi

  # 6. ffmpeg check
  if command -v ffmpeg >/dev/null 2>&1; then
    echo "[ffmpeg] OK - ffmpeg utility is available."
  else
    echo "[ffmpeg] WARN - ffmpeg missing (audio normalization disabled)."
  fi

  # 7. auto-paste check
  local has_wlcopy=false
  command -v wl-copy >/dev/null 2>&1 && has_wlcopy=true
  local backends=()
  command -v hyprctl >/dev/null 2>&1 && backends+=("hyprctl")
  command -v wtype >/dev/null 2>&1 && backends+=("wtype")
  command -v ydotool >/dev/null 2>&1 && backends+=("ydotool")

  if $has_wlcopy && [[ ${#backends[@]} -gt 0 ]]; then
    echo "[Paste]  OK - wl-copy + paste backend is ready (${backends[*]})."
  else
    echo "[Paste]  FAIL - Missing wl-copy or any paste backend (hyprctl/wtype/ydotool)."
  fi

  echo "==================================="
  echo "Diagnosis completed."
  kv result "diagnose-done"
}

test_tui() {
  echo "Starting a 3-second recording test..."
  local test_wav="/tmp/omd-voice-test.wav"
  rm -f "$test_wav"

  if command -v parecord >/dev/null 2>&1; then
    echo "Speak now (recording for 3s)..."
    parecord --channels=1 --rate=16000 --format=s16le "$test_wav" &
    local rpid=$!
    sleep 3
    kill "$rpid" >/dev/null 2>&1 || true
    wait "$rpid" >/dev/null 2>&1 || true
    echo "Recording completed. Transcribing..."
    if [[ -f "$test_wav" ]]; then
      local text
      text="$("$OMD_ROOT/share/bin/omarchy-voice-transcribe" "$test_wav" 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("text",""))' 2>/dev/null || true)"
      if [[ -n "$text" ]]; then
        echo "Transcription result: \"$text\""
      else
        echo "Transcription completed: No speech detected."
      fi
    else
      echo "ERROR: test WAV file was not created."
    fi
  else
    echo "ERROR: parecord not found."
  fi
  kv result "test-done"
}

# mic_level samples the active recording WAV and returns a 0–100 peak-ish
# level so the TUI can show live feedback while the user speaks. Returns 0
# when not recording or when the file is still too short to analyze.
mic_level() {
  if ! recording_active; then
    printf '0'
    return
  fi
  local wav="/tmp/omd-voice-rec.wav"
  if [[ ! -f "$wav" ]]; then
    printf '0'
    return
  fi
  python3 - "$wav" <<'PY' 2>/dev/null || printf '0'
import struct, sys, os
path = sys.argv[1]
try:
    size = os.path.getsize(path)
    if size < 44 + 3200:  # need ~0.1s of 16kHz s16le mono
        print(0)
        raise SystemExit
    # Read last ~0.2s of PCM samples (6400 bytes) after the 44-byte header.
    with open(path, "rb") as f:
        f.seek(0, os.SEEK_END)
        end = f.tell()
        nbytes = min(6400, max(0, end - 44))
        nbytes -= nbytes % 2
        f.seek(end - nbytes)
        raw = f.read(nbytes)
    if len(raw) < 2:
        print(0)
        raise SystemExit
    n = len(raw) // 2
    peak = 0
    # Subsample for speed
    step = max(1, n // 400)
    for i in range(0, n, step):
        v = abs(struct.unpack_from("<h", raw, i * 2)[0])
        if v > peak:
            peak = v
    # Map 16-bit peak to 0–100 with a soft speech threshold.
    level = int(min(100, peak * 100 / 12000))
    print(level)
except Exception:
    print(0)
PY
}

# record-start / record-stop let the TUI drive a recording session directly
# (rather than launching the external test TUI). The omarchy-voice-record
# script manages the parecord PID at REC_PID_PATH, which recording_active()
# reads to render the recording state.
record_start() {
  "$OMD_ROOT/share/bin/omarchy-voice-record" start >/dev/null 2>&1 &
  kv result "record-started"
}

record_stop() {
  "$OMD_ROOT/share/bin/omarchy-voice-record" stop >/dev/null 2>&1 || true
  # Transcribe the captured wav and always push a recent entry (empty text
  # means no speech detected) so the TUI can leave the "transcribing" phase.
  local wav="/tmp/omd-voice-rec.wav"
  local text=""
  if [[ -f "$wav" ]]; then
    text="$("$OMD_ROOT/share/bin/omarchy-voice-transcribe" "$wav" 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("text",""))' 2>/dev/null || true)"
  fi
  push_recent "$text"
  kv text "$text"
  kv result "record-stopped"
}

# record-cancel stops the recorder without transcription (Esc/Q on the trial).
record_cancel() {
  "$OMD_ROOT/share/bin/omarchy-voice-record" stop >/dev/null 2>&1 || true
  kv result "record-cancelled"
}

case "${1:-status}" in
  status) status ;;
  setup) setup ;;
  cancel) cancel_setup ;;
  add) shift; add_binding "${1:-}" ;;
  remove) shift; remove_binding "${1:-}" ;;
  capture) capture_binding ;;
  key-test) key_test ;;
  edit) edit_bindings ;;
  bind-tui) bind_tui ;;
  diagnose) diagnose ;;
  test) test_tui ;;
  delete-model)
    rm -rf "$MODEL_DIR"
    rm -rf "$VENV_DIR"
    clear_state
    kv result "model-deleted"
    ;;
  logs)
    if [[ -f "$STATE_DIR/install.log" ]]; then
      cat "$STATE_DIR/install.log"
    else
      echo "No installation logs available."
    fi
    ;;
  record) record ;;                       # legacy: launches test TUI
  record-start) record_start ;;
  record-stop) record_stop ;;
  record-cancel) record_cancel ;;
  recent)
    if [[ -f "$RECENT_FILE" ]]; then cat "$RECENT_FILE"; else printf '[]\n'; fi
    ;;
  recent-clear) rm -f "$RECENT_FILE"; kv result "recent-cleared" ;;
  *)
    echo "usage: omd-settings-voice status|setup|cancel|add <key>|remove <key>|capture|key-test|edit|bind-tui|diagnose|test|delete-model|logs|record|record-start|record-stop|record-cancel|recent|recent-clear" >&2
    exit 2
    ;;
esac
