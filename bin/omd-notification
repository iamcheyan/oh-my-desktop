#!/bin/sh
set -eu

_omd_root=$(cd "$(dirname "$0")/.." && pwd)
. "$_omd_root/scripts/omd-path.sh"

# Prefer repo default modules, fallback to SUMIKA_MODULES_HOME
app_dir="$_omd_root/modules/notification"
if [ ! -d "$app_dir" ]; then
    app_dir="${SUMIKA_MODULES_HOME:-$HOME/development/sumika-modules}/notification"
fi
exec "$_omd_root/quickshell/scripts/quickshell" "$app_dir"
