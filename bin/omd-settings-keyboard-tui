GLOBAL_PRESETS = [
    ("alt-win-swap",   "Swap Left Alt / Win", "swap", ""),
    ("ctrl-caps-swap", "Swap Ctrl / Caps", "swap", ""),
    ("grave-esc-swap", "Swap Grave / Esc", "swap", ""),
    ("caps-esc",       "Caps to Esc", "remap", "escape"),
    ("muhenkan-meta",  "Muhenkan → Custom", "remap", "leftmeta"),
    ("kana-left",      "Katakana/Hiragana to Left", "remap", "left"),
    ("rightalt-down",  "Right Alt to Down", "remap", "down"),
    ("rightmeta-down", "Right Win to Down", "remap", "down"),
    ("delete-right",   "Delete to Right", "remap", "right"),
    ("rightctrl-up",   "Right Ctrl to Up", "remap", "up"),
]

FN_MODES = ["media", "function", "auto"]


# ── key code mapping for visual tester ──────────────────────────────────
_KEYCODE_TO_LAYOUT = {
    curses.KEY_UP: "up",
    curses.KEY_DOWN: "down",
    curses.KEY_LEFT: "left",
    curses.KEY_RIGHT: "right",
    curses.KEY_PPAGE: "pageup",
    curses.KEY_NPAGE: "pagedown",
    curses.KEY_HOME: "home",
    curses.KEY_END: "end",
    curses.KEY_BACKSPACE: "backspace",
    curses.KEY_IC: "insert",
    curses.KEY_DC: "delete",
    curses.KEY_PRINT: "sysrq",
    curses.KEY_BTAB: "tab",
    ord(' '): "space",
    ord('\t'): "tab",
    ord('\n'): "enter",
}
for _i in range(1, 25):
    _KEYCODE_TO_LAYOUT[getattr(curses, f"KEY_F{_i}")] = f"f{_i}"


def _curses_key_to_code(key):
    """Map a curses key code to a KEYBOARD_ROWS key code string."""
    if key in _KEYCODE_TO_LAYOUT:
        return _KEYCODE_TO_LAYOUT[key]
    if 32 <= key <= 126:
        ch = chr(key)
        if 'A' <= ch <= 'Z':
            return ch.lower()
        return ch
    return None


# ── data model ───────────────────────────────────────────────────────────
class Model(S.StatusModel):
    def __init__(self):
        super().__init__()
        self.logs[:] = [
            "Keyboard Remap ready.",
            "Toggle presets, then Apply (a) to write /etc/keyd/omd.conf.",
        ]
        self.devices = []
        self.selected_preset = 0
        self.focus_area = 0  # 0=devices, 1=right panel
        self.pending_changes = False
        self.last_apply_ok = None  # True/False/None
        self.fnmode_available = False
        self.fnmode = "media"
        self.fnmode_value = 0
        # Key picker state
        self.show_picker = False
        self.picker_preset_id = ""
        self.picker_row = 0
        self.picker_col = 0
        # Visual key tester state
        self.show_tester = False
        self.tester_highlight = ""
        self.tester_last_key = ""
        # Profile management
        self.profiles = {"version": 1, "devices": {}}
        self.load_profiles()
        self.profiles_snapshot = copy.deepcopy(self.profiles)
        self.refresh()

    def load_profiles(self):
        profiles_path = os.path.join(S.OMD_ROOT, "keyboard-remap", "profiles.json")
        try:
            with open(profiles_path) as f:
                self.profiles = json.load(f)
        except (FileNotFoundError, json.JSONDecodeError):
            self.profiles = {"version": 1, "devices": {}}
        if "devices" not in self.profiles:
            self.profiles["devices"] = {}

    def save_profiles(self):
        profiles_path = os.path.join(S.OMD_ROOT, "keyboard-remap", "profiles.json")
        os.makedirs(os.path.dirname(profiles_path), exist_ok=True)
        with open(profiles_path, "w") as f:
            json.dump(self.profiles, f, indent=2)

    def device_identity(self, name):
        identity = name.lower().strip()
        suffix = "-keyboard"
        return identity[:-len(suffix)] if identity.endswith(suffix) else identity

    def profile_for_device(self, dev):
        identity = self.device_identity(dev.get("hyprName", ""))
        best_key = None
        best = None
        best_weight = -1
        for key, prof in self.profiles["devices"].items():
            if prof is None:
                continue
            if self.device_identity(prof.get("hyprName", "")) != identity:
                continue
            weight = len(prof.get("enabledPresets", [])) * 10 + len(prof.get("presetOverrides", {}))
            if best is None or weight > best_weight or (weight == best_weight and key == dev.get("hyprName", "")):
                best_key = key
                best = prof
                best_weight = weight
        return best_key, best

    def merge_devices(self, connected):
        self.devices = []
        connected_map = set()
        for dev in connected:
            dev["connected"] = True
            self.devices.append(dev)
            connected_map.add(self.device_identity(dev.get("hyprName", "")))
        for name, prof in self.profiles["devices"].items():
            if prof is None:
                continue
            if self.device_identity(prof.get("hyprName", "")) in connected_map:
                continue
            self.devices.append({
                "hyprName": prof.get("hyprName", name),
                "rawName": prof.get("hyprName", name),
                "displayName": prof.get("displayName", prof.get("hyprName", name)),
                "keydId": prof.get("keydId", ""),
                "connected": False,
            })
        self.devices.sort(key=lambda d: (not d.get("connected", False), d.get("displayName", "")))

    def refresh(self):
        if self.refreshing:
            return
        self.refreshing = True
        self.dirty = True
        pending = [3]
        def complete():
            pending[0] -= 1
            if pending[0] == 0:
                self.refreshing = False
            self.dirty = True
        def on_status(lines, err):
            if not err:
                self.status = S.parse_kv(lines)
            else:
                self.append_log(f"status failed: {err}")
            complete()
        def on_devices(lines, err):
            try:
                connected = json.loads("\n".join(lines)) if lines and not err else []
                self.merge_devices(connected)
            except Exception:
                pass
            complete()
        def on_fnmode(lines, err):
            try:
                data = json.loads("\n".join(lines)) if lines and not err else {}
                self.fnmode_available = data.get("available", False)
                self.fnmode = data.get("mode", "media")
                self.fnmode_value = data.get("value", 0)
            except Exception:
                self.fnmode_available = False
            complete()
        S.run_cmd_bg("omd-settings-keyboard", "status", callback=on_status)
        S.run_cmd_bg(os.path.join(S.OMD_ROOT, "share", "bin", "omarchy-keyboard-list"), callback=on_devices)
        S.run_cmd_bg("omd-settings-keyboard", "fnmode-status", callback=on_fnmode)
        self.append_log("$ refresh")

    def run_action(self, action):
        self.busy = True
        self.message = f"{action}…"
        self.dirty = True
        self.append_log(f"$ {action}")
        def _cb(lines, err):
            for l in lines:
                self.append_log(f"{l}")
            self.busy = False
            if err:
                self.message = "action failed"
                if action == "apply":
                    self.last_apply_ok = False
            else:
                self.message = action_message(action)
                if action == "apply":
                    self.last_apply_ok = True
                elif action == "fnmode-set":
                    self.append_log("fn mode updated")
            self.dirty = True
            self.refresh()
        S.run_cmd_bg("omd-settings-keyboard", action, callback=_cb)

    def set_fnmode(self, mode):
        """Cycle fn key mode by calling omd-settings-keyboard fnmode-set <mode>."""
        self.busy = True
        self.message = f"fnmode-set {mode}…"
        self.dirty = True
        self.append_log(f"$ fnmode-set {mode}")
        def _cb(lines, err):
            for l in lines:
                self.append_log(f"{l}")
            self.busy = False
            if err:
                self.message = "fnmode-set failed"
            else:
                self.message = "Fn key mode updated"
                self.append_log("fn mode updated")
                # Re-fetch fnmode status to update self.fnmode
                def on_fnmode(flines, ferr):
                    try:
                        data = json.loads("\n".join(flines)) if flines else {}
                        self.fnmode_available = data.get("available", False)
                        self.fnmode = data.get("mode", "media")
                        self.fnmode_value = data.get("value", 0)
                    except Exception:
                        pass
                    self.dirty = True
                S.run_cmd_bg("omd-settings-keyboard", "fnmode-status", callback=on_fnmode)
            self.dirty = True
        S.run_cmd_bg("omd-settings-keyboard", "fnmode-set", mode, callback=_cb)

    def cycle_fnmode(self):
        next_mode = "media"
        if self.fnmode == "media":
            next_mode = "function"
        elif self.fnmode == "function":
            next_mode = "auto"
        self.busy = True
        self.set_fnmode(next_mode)


    def toggle_profile_enabled(self):
        if not self.devices or self.selected >= len(self.devices):
            return
        dev = self.devices[self.selected]
        key, prof = self.profile_for_device(dev)
        if prof is None:
            prof = {
                "displayName": dev.get("displayName", ""),
                "hyprName": dev.get("hyprName", ""),
                "keydId": dev.get("keydId", ""),
                "enabled": True,
                "enabledPresets": [],
                "presetOverrides": {},
            }
            self.profiles["devices"][dev.get("hyprName", "")] = prof
            self.pending_changes = True
            self.append_log(f"created profile for {dev.get('displayName', '?')} (enabled)")
            return
        prof["enabled"] = not prof.get("enabled", True)
        self.pending_changes = True
        state = "enabled" if prof["enabled"] else "disabled"
        self.append_log(f"profile {dev.get('displayName', '?')} {state}")

    def toggle_preset(self):
        if not self.devices or self.selected >= len(self.devices):
            return
        dev = self.devices[self.selected]
        key, prof = self.profile_for_device(dev)
        if prof is None:
            prof = {
                "displayName": dev.get("displayName", ""),
                "hyprName": dev.get("hyprName", ""),
                "keydId": dev.get("keydId", ""),
                "enabled": True,
                "enabledPresets": [],
                "presetOverrides": {},
            }
            self.profiles["devices"][dev.get("hyprName", "")] = prof

        preset_idx = self.selected_preset - 1
        if self.fnmode_available:
            preset_idx = self.selected_preset - 2
        if preset_idx < 0 or preset_idx >= len(GLOBAL_PRESETS):
            return
        preset_id = GLOBAL_PRESETS[preset_idx][0]
        enabled = prof.get("enabledPresets", [])
        if preset_id in enabled:
            enabled.remove(preset_id)
            self.append_log(f"preset off: {preset_id}")
        else:
            enabled.append(preset_id)
            self.append_log(f"preset on: {preset_id}")
        prof["enabledPresets"] = enabled
        self.pending_changes = True

    def trigger_override_picker(self):
        if not self.devices or self.selected >= len(self.devices):
            return
        preset_idx = self.selected_preset - 1
        if self.fnmode_available:
            preset_idx = self.selected_preset - 2
        if preset_idx < 0 or preset_idx >= len(GLOBAL_PRESETS):
            return
        preset = GLOBAL_PRESETS[preset_idx]
        if preset[2] != "remap":
            return
        self.picker_preset_id = preset[0]
        self.show_picker = True
        self.picker_row = 0
        self.picker_col = 0

    def confirm_picker_selection(self):
        if self.selected >= len(self.devices):
            self.show_picker = False
            return
        dev = self.devices[self.selected]
        key, prof = self.profile_for_device(dev)
        if prof is None:
            self.show_picker = False
            return
        target_key = KEYBOARD_ROWS[self.picker_row][self.picker_col][1]
        if target_key:
            if "presetOverrides" not in prof:
                prof["presetOverrides"] = {}
            prof["presetOverrides"][self.picker_preset_id] = target_key
            self.pending_changes = True
        self.show_picker = False

    def get_key_x(self, row_idx, col_idx):
        x = 0
        for i in range(col_idx):
            x += KEYBOARD_ROWS[row_idx][i][2]
        x += KEYBOARD_ROWS[row_idx][col_idx][2] / 2.0
        return x

    def move_picker(self, dr, dc):
        r, c = self.picker_row, self.picker_col
        if dc != 0:
            while True:
                c += dc
                if c < 0 or c >= len(KEYBOARD_ROWS[r]):
                    break
                if KEYBOARD_ROWS[r][c][1] != "":
                    self.picker_col = c
                    break
        elif dr != 0:
            curr_x = self.get_key_x(r, c)
            while True:
                r += dr
                if r < 0 or r >= len(KEYBOARD_ROWS):
                    break
                best_col = None
                min_dist = 99999.0
                for col_idx, key in enumerate(KEYBOARD_ROWS[r]):
                    if key[1] == "":
                        continue
                    kx = self.get_key_x(r, col_idx)
                    dist = abs(kx - curr_x)
                    if dist < min_dist:
                        min_dist = dist
                        best_col = col_idx
                if best_col is not None:
                    self.picker_row = r
                    self.picker_col = best_col
                    break

    def find_copy_source(self):
        if self.selected >= len(self.devices):
            return None
        dev = self.devices[self.selected]
        key, prof = self.profile_for_device(dev)
        if prof and len(prof.get("enabledPresets", [])) > 0:
            return None
        for name, other in self.profiles["devices"].items():
            if other and self.device_identity(other.get("hyprName", "")) != self.device_identity(dev.get("hyprName", "")) and len(other.get("enabledPresets", [])) > 0:
                return name
        return None

    def copy_profile_from(self, source_name):
        if self.selected >= len(self.devices) or not source_name:
            return
        dev = self.devices[self.selected]
        source = self.profiles["devices"].get(source_name)
        if not source:
            return
        dest_key, dest = self.profile_for_device(dev)
        if dest is None:
            dest_key = dev.get("hyprName", "")
            dest = {
                "displayName": dev.get("displayName", ""),
                "hyprName": dev.get("hyprName", ""),
                "keydId": dev.get("keydId", ""),
                "enabled": True,
                "enabledPresets": [],
                "presetOverrides": {},
            }
            self.profiles["devices"][dest_key] = dest
        dest["enabledPresets"] = list(source.get("enabledPresets", []))
        dest["presetOverrides"] = dict(source.get("presetOverrides", {}))
        self.pending_changes = True
        self.message = f"Copied presets from {source.get('displayName', '?')}"

    def apply_remaps(self):
        self.save_profiles()
        self.busy = True
        self.message = "apply…"
        self.dirty = True
        self.append_log("$ apply")
        def _cb(lines, err):
            for l in lines or []:
                self.append_log(f"{l}")
            self.busy = False
            if err:
                self.message = "action failed"
                self.last_apply_ok = False
            else:
                self.message = "Key remaps applied successfully"
                self.last_apply_ok = True
                self.profiles_snapshot = copy.deepcopy(self.profiles)
                self.pending_changes = False
            self.dirty = True
            self.refresh()
        S.run_cmd_bg("omd-settings-keyboard", "apply", callback=_cb)

    def cancel_changes(self):
        "Revert all changes to the last applied snapshot."
        self.profiles = copy.deepcopy(self.profiles_snapshot)
        self.save_profiles()
        self.pending_changes = False
        self.message = "Changes cancelled, reverted to last applied state"
        self.append_log("changes cancelled (reverted to last applied state)")
        self.dirty = True

    def start_tester(self):
        """Open the visual key tester overlay."""
        self.show_picker = False
        self.show_tester = True
        self.tester_highlight = ""
        self.tester_last_key = ""
        self.dirty = True

    def setup_keyd(self):
        self.run_action("setup")

    def key_tester(self):
        self.run_action("key-test")

    def online_count(self):
        return sum(1 for d in self.devices if d.get("connected"))

    def selected_preset_count(self):
        if self.selected >= len(self.devices):
            return 0
        dev = self.devices[self.selected]
        key, prof = self.profile_for_device(dev)
        if prof is None or not prof.get("enabled", True):
            return 0
        return len(prof.get("enabledPresets", []))

    def right_col_rows(self):
        rows = 1 + len(GLOBAL_PRESETS)  # profile toggle + presets
        if self.fnmode_available:
            rows += 1  # fn mode row
        return rows


def action_message(action):
    mapping = {
        "setup": "keyd setup completed",
        "apply": "Key remaps applied successfully",
        "key-test": "Key tester finished",
    }
    return mapping.get(action, "Done")


# ── rendering ────────────────────────────────────────────────────────────
def render_key_cap(k):
    label, code, w = k
    if code == "":
        return " " * w
    cap_w = w - 1
    if cap_w < 1:
        cap_w = 1
    content = label[:cap_w] if len(label) > cap_w else label
    left_pad = (cap_w - len(content)) // 2
    right_pad = cap_w - len(content) - left_pad
    padded = " " * left_pad + content + " " * right_pad
    return padded


def render_picker_view(model, stdscr):
    h, w = stdscr.getmaxyx()
    # Calculate picker dimensions (with 1 empty line between rows)
    picker_h = len(KEYBOARD_ROWS) * 2 - 1 + 4  # 7 rows -> 17 height
    picker_w = min(w - 4, 104)
    start_y = max(0, (h - picker_h) // 2)
    start_x = max(0, (w - picker_w) // 2)

    # Draw picker box
    S.draw_thick_border(stdscr, start_y, start_x, picker_h, picker_w, "Select Target Key Override")

    inner_y = start_y + 1
    inner_x = start_x + 2

    for row_idx, row in enumerate(KEYBOARD_ROWS):
        line = "  "
        y_pos = inner_y + row_idx * 2
        for col_idx, key in enumerate(row):
            is_sel = model.picker_row == row_idx and model.picker_col == col_idx
            
            if key[1] == "":
                # Gap (just spaces drawn with standard background)
                rendered = " " * key[2]
                S.safe_addstr(stdscr, y_pos, inner_x + len(line), rendered, S.ATTR_TEXT)
                line += rendered
            else:
                # Keycap (colored block of width w - 1, followed by 1 black space)
                rendered_cap = render_key_cap(key)
                if is_sel:
                    # Active/focused key: Reverse video with Accent color (accent background, dark text)
                    attr = curses.A_REVERSE | S.ATTR_ACCENT_BOLD | curses.A_BOLD
                else:
                    # Inactive key: Reverse video with Subtle color (gray background, dark text)
                    attr = curses.A_REVERSE | S.ATTR_SUBTLE
                
                # Draw keycap block
                S.safe_addstr(stdscr, y_pos, inner_x + len(line), rendered_cap, attr)
                # Draw 1-space gap
                S.safe_addstr(stdscr, y_pos, inner_x + len(line) + len(rendered_cap), " ", S.ATTR_TEXT)
                line += rendered_cap + " "

    help_y = start_y + picker_h - 2
    S.safe_addstr(stdscr, help_y, inner_x,
                  "arrows: navigate  |  Enter/Space: select  |  Esc: cancel",
                  S.ATTR_MUTED)


def render_tester_view(model, stdscr):
    """Render the visual key tester overlay."""
    h, w = stdscr.getmaxyx()
    picker_h = len(KEYBOARD_ROWS) * 2 - 1 + 5
    picker_w = min(w - 4, 104)
    start_y = max(0, (h - picker_h) // 2)
    start_x = max(0, (w - picker_w) // 2)

    S.draw_thick_border(stdscr, start_y, start_x, picker_h, picker_w,
                        "Key Tester \u2014 Press any key (Ctrl+W to exit)")

    inner_y = start_y + 2
    inner_x = start_x + 2

    for row_idx, row in enumerate(KEYBOARD_ROWS):
        line = "  "
        y_pos = inner_y + row_idx * 2
        for col_idx, key in enumerate(row):
            if key[1] == "":
                rendered = " " * key[2]
                S.safe_addstr(stdscr, y_pos, inner_x + len(line), rendered, S.ATTR_TEXT)
                line += rendered
            else:
                rendered_cap = render_key_cap(key)
                if key[1] == model.tester_highlight:
                    attr = curses.A_REVERSE | S.ATTR_OK | curses.A_BOLD
                else:
                    attr = curses.A_REVERSE | S.ATTR_SUBTLE
                S.safe_addstr(stdscr, y_pos, inner_x + len(line), rendered_cap, attr)
                S.safe_addstr(stdscr, y_pos, inner_x + len(line) + len(rendered_cap), " ", S.ATTR_TEXT)
                line += rendered_cap + " "

    help_y = start_y + picker_h - 2
    if model.tester_last_key:
        last_display = model.tester_highlight or model.tester_last_key
        S.safe_addstr(stdscr, help_y, inner_x,
                      f"Last key: {last_display}  |  Ctrl+W: exit",
                      S.ATTR_MUTED)
    else:
        S.safe_addstr(stdscr, help_y, inner_x,
                      "Press any key to test  |  Ctrl+W: exit",
                      S.ATTR_MUTED)


def render_device_list(model, width):
    lines = []
    online = model.online_count()
    offline = len(model.devices) - online
    lines.append(("section", f"Keyboards  {online} online · {offline} offline"))
    for i, dev in enumerate(model.devices):
        name = dev.get("displayName", dev.get("hyprName", "?"))
        connected = dev.get("connected", False)
        did = dev.get("keydId", "") or "no id"
        if i > 0:
            lines.append(("subtle", " " + "─" * max(2, width - 2)))
        if i == model.selected and model.focus_area == 0:
            lines.append(("focus", f"● {S.truncate(name, width - 2)}"))
        elif connected:
            lines.append(("ok", f"● {S.truncate(name, width - 2)}"))
        else:
            lines.append(("muted", f"○ {S.truncate(name, width - 2)}"))
        status = "online" if connected else "saved, offline"
        lines.append(("subtle", f"{status}  ·  {did}"))
    if not model.devices:
        lines.append(("muted", "No keyboards detected"))
    return lines


def render_health(model, width):
    lines = []
    lines.append(("section", "Health"))
    keyd_status = "inactive"
    keyd_tone = "danger"
    if model.boo("keydRunning"):
        keyd_status = "active"
        keyd_tone = "ok"
    elif model.boo("keydInstalled"):
        keyd_status = "installed"
        keyd_tone = "warn"
    lines.append((keyd_tone, f"keyd      {keyd_status}"))
    lines.append(("muted",  f"conf      omd.conf"))
    apply_status = "—"
    if model.last_apply_ok is True:
        apply_status = "ok"
    elif model.last_apply_ok is False:
        apply_status = "error"
    elif model.pending_changes:
        apply_status = "pending"
    lines.append(("muted",  f"apply     {apply_status}"))
    if model.pending_changes:
        lines.append(("warn", "draft differs from installed"))
    return lines


def render_actions(model):
    lines = []
    lines.append(("section", "Actions"))
    enabled = not model.busy
    lines.append(S.action_line("s", "Setup keyd", enabled))
    lines.append(S.action_line("t", "Key Tester", enabled))
    can_apply = enabled and model.pending_changes
    lines.append(S.action_line("a", "Apply remaps", can_apply))
    lines.append(S.action_line("r", "Refresh", enabled))
    return lines


def render_profile(model, width):
    lines = []
    if not model.devices or model.selected >= len(model.devices):
        lines.append(("muted", "Select a keyboard device to configure…"))
        return lines
    dev = model.devices[model.selected]
    key, prof = model.profile_for_device(dev)
    exists = prof is not None
    is_enabled = exists and prof.get("enabled", True)
    name = dev.get("displayName", dev.get("hyprName", "?"))

    lines.append(("section", f"Profile · {S.truncate(name, width-12)}"))
    lines.append(("text",   f"Device    {name}"))
    did = dev.get("keydId") or "—"
    lines.append(("muted",  f"ID        {did}"))
    lines.append(S.profile_enabled_line(is_enabled, model.focus_area == 1 and model.selected_preset == 0))
    lines.append(("text", ""))

    # Fn mode
    if model.fnmode_available:
        lines.append(("section", "Function Row"))
        lines.append(S.cycle_line("Fn Row Mode", model.fnmode, "f", model.focus_area == 1 and model.selected_preset == 1))
        lines.append(("text", ""))

    # Presets
    on_count = 0
    if is_enabled and exists:
        on_count = len(prof.get("enabledPresets", []))
    lines.append(("section", f"Presets  {on_count} on"))
    for i, (pid, plabel, ptype, pdefault) in enumerate(GLOBAL_PRESETS):
        active = False
        if is_enabled and exists:
            active = pid in prof.get("enabledPresets", [])
        preset_row = i + 1
        if model.fnmode_available:
            preset_row += 1
        focused = model.focus_area == 1 and model.selected_preset == preset_row
        trailing = ""
        if ptype == "remap":
            target = pdefault
            if exists and prof.get("presetOverrides"):
                target = prof["presetOverrides"].get(pid, pdefault)
            trailing = target
        lines.append(S.toggle_line(active, plabel, focused, not is_enabled, trailing))
    return lines


def render_log(model, width):
    lines = []
    lines.append(("section", "Activity"))
    if not model.logs:
        lines.append(("muted", "(no activity yet)"))
        return lines
    inner_h = 30
    total = len(model.logs)
    start = max(0, total - inner_h - model.scroll_offset)
    end = min(total, start + inner_h)
    for l in model.logs[start:end]:
        lines.append(("muted", f"{S.truncate(l, width-4)}"))
    return lines


def _can_edit_selected(model):
    """True when the selected device exists and is currently connected."""
    return (model.devices and model.selected < len(model.devices)
            and model.devices[model.selected].get("connected", False))


def hero_info(model):
    keyd = "keyd inactive"
    if model.boo("keydRunning"):
        keyd = "keyd active"
    parts = [keyd, f"{len(model.devices)} devices", f"{model.selected_preset_count()} presets on"]
    if model.pending_changes:
        parts.append("pending")
    if _can_edit_selected(model):
        parts.append("editing")
    else:
        parts.append("viewing")
    subtitle = " · ".join(parts)
    tone = "ok" if model.boo("keydRunning") else "danger"
    status_text = "keyd active" if model.boo("keydRunning") else "keyd inactive"
    msg = ""
    if model.busy:
        msg = "working…"
    elif model.message:
        msg = model.message
    return S.hero_line("Keyboard Remap", subtitle, tone, model.busy, msg, status_text)


def help_items(model):
    if model.show_picker:
        return ([("arrows", "navigate"), ("enter/space", "select"), ("esc", "cancel")], [])
    generic = [
        ("arrows", "navigate"),
        ("tab", "column"),
        ("pgup/pgdn", "logs"),
        ("q", "quit"),
    ]
    can_edit = _can_edit_selected(model)
    tool = [("space", "toggle")]
    if can_edit:
        tool.append(("enter", "edit key"))
    tool += [("a", "apply"), ("u", "undo"), ("s", "setup"), ("t", "test"), ("T", "debug")]
    return (generic, tool)


# ── view ─────────────────────────────────────────────────────────────────
def view(stdscr, model):
    h, w = stdscr.getmaxyx()
    model.width = w
    model.height = h

    if not S.require_terminal_size(stdscr, 72, 20):
        return

    if model.show_picker:
        stdscr.erase()
        render_picker_view(model, stdscr)
        S.finish_frame(stdscr)
        return

    if model.show_tester:
        stdscr.erase()
        render_tester_view(model, stdscr)
        S.finish_frame(stdscr)
        return

    stdscr.erase()

    S.draw_hero(stdscr, hero_info(model))

    # ── geometry ──
    pad_x, pad_y, hero_h, help_h = 2, 2, 2, 0
    margin = 1
    pending_h = 1 if model.pending_changes else 0
    content_w = w - pad_x
    avail_h = h - pad_y - hero_h - help_h - pending_h

    left_w, right_w = S.two_column_widths(content_w, left_w=34, right_min=28)
    content_h = avail_h

    # Focusable areas – Tab cycles 0 (Keyboards) → 1 (Profile) → 2 (Presets) → 0
    on_keyboards = model.focus_area == 0
    on_profile    = model.focus_area == 1
    # Presets only focusable when the master toggle (profile enabled) is on
    _prof_enabled = False
    if model.devices and model.selected < len(model.devices):
        _dev = model.devices[model.selected]
        _key, _prof = model.profile_for_device(_dev)
        _prof_enabled = _prof is not None and _prof.get("enabled", True)
    on_presets = model.focus_area == 2 and _prof_enabled

    # ── Left: three stacked boxes ──
    # Box 1: Keyboards (focusable)
    device_lines = render_device_list(model, left_w - 4)
    device_box_h = min(content_h, len(device_lines) + 3)
    if device_box_h >= 3:
        S.draw_focus_border(stdscr, on_keyboards, hero_h, margin, device_box_h, left_w, "Keyboards")
        S.draw_lines_in_area(stdscr, hero_h, margin, device_box_h, left_w, device_lines)
    else:
        device_box_h = 0

    # Box 2: Health
    health_y = hero_h + device_box_h
    health_lines = render_health(model, left_w - 4)
    health_box_h = min(content_h - device_box_h, len(health_lines) + 3)
    if health_box_h >= 3 and len(health_lines) > 0:
        S.draw_focus_border(stdscr, False, health_y, margin, health_box_h, left_w, "")
        S.draw_lines_in_area(stdscr, health_y, margin, health_box_h, left_w, health_lines)
    else:
        health_box_h = 0

    # Box 3: Actions (fills remaining)
    actions_y = health_y + health_box_h
    actions_h = content_h - actions_y + hero_h
    if actions_h >= 4:
        S.draw_focus_border(stdscr, False, actions_y, margin, actions_h, left_w, "")
        S.draw_lines_in_area(stdscr, actions_y, margin, actions_h, left_w, render_actions(model))

    # ── Right: Profile (with Fn Row) + Presets + Activity (stacked boxes) ──
    view_only = not _can_edit_selected(model)
    # Box 1: Profile & Function Row (merged)
    profile_lines = []
    if model.devices and model.selected < len(model.devices):
        dev = model.devices[model.selected]
        key, prof = model.profile_for_device(dev)
        exists = prof is not None
        is_enabled = exists and prof.get("enabled", True)
        did = dev.get("keydId") or "—"
        profile_lines.append(("text",   f"Device    {dev.get('displayName', dev.get('hyprName', '?'))}"))
        profile_lines.append(("muted",  f"ID        {did}"))
        profile_lines.append(S.profile_enabled_line(is_enabled and not view_only, model.focus_area == 1 and model.selected_preset == 0))
        if model.fnmode_available and not view_only:
            profile_lines.append(("", ""))
            profile_lines.append(S.cycle_line("Fn Row Mode", model.fnmode, "f", model.focus_area == 1 and model.selected_preset == (1 if model.fnmode_available else 0)))
    else:
        profile_lines.append(("muted", "Select a device…"))
    if view_only and len([l for l in profile_lines if l[0] != ""]) == 3:
        profile_lines.append(("muted", "(view only — connect to edit)"))
    profile_box_h = min(content_h, len(profile_lines) + 3)
    if profile_box_h >= 3:
        S.draw_focus_border(stdscr, on_profile, hero_h, margin + left_w, profile_box_h, right_w, "Profile")
        S.draw_lines_in_area(stdscr, hero_h, margin + left_w, profile_box_h, right_w, profile_lines)
    else:
        profile_box_h = 0

    # Box 2: Presets
    presets_y = hero_h + profile_box_h
    presets_lines = []
    if model.devices and model.selected < len(model.devices):
        dev = model.devices[model.selected]
        key, prof = model.profile_for_device(dev)
        exists = prof is not None
        is_enabled = exists and prof.get("enabled", True)
        for i, (pid, plabel, ptype, pdefault) in enumerate(GLOBAL_PRESETS):
            active = False
            if is_enabled and exists:
                active = pid in prof.get("enabledPresets", [])
            preset_row = i + 1
            if model.fnmode_available and not view_only:
                preset_row += 1
            focused = model.focus_area == 2 and model.selected_preset == preset_row
            trailing = ""
            if ptype == "remap" and not view_only:
                target = pdefault
                if exists and prof.get("presetOverrides"):
                    target = prof["presetOverrides"].get(pid, pdefault)
                trailing = target
            presets_lines.append(S.toggle_line(active, plabel, focused, view_only or not is_enabled, trailing))
    on_count = sum(1 for l in presets_lines if l[1].startswith("[X]"))
    presets_title = f"Presets  {on_count} on"
    presets_box_h = min(content_h - presets_y + hero_h, len(presets_lines) + 3)
    if presets_box_h >= 3 and len(presets_lines) > 0:
        S.draw_focus_border(stdscr, on_presets, presets_y, margin + left_w, presets_box_h, right_w, presets_title)
        S.draw_lines_in_area(stdscr, presets_y, margin + left_w, presets_box_h, right_w, presets_lines)
    else:
        presets_box_h = 0

    # Box 4: Activity (fills remaining)
    act_y = presets_y + presets_box_h
    act_h = content_h - act_y + hero_h
    if act_h >= 4:
        S.draw_focus_border(stdscr, False, act_y, margin + left_w, act_h, right_w, "Activity")
        S.draw_log_in_area(stdscr, act_y, margin + left_w, act_h, right_w, model.logs, model.scroll_offset)

    # ── help bar (shifted up when a pending-changes bar is showing) ──
    gen, tool = help_items(model)
    if pending_h:
        help_y = h - 3
    else:
        help_y = h - 2
    if gen:
        S.safe_addstr(stdscr, help_y, 2, S.help_text(gen), S.ATTR_SUBTLE)
    if tool:
        S.safe_addstr(stdscr, help_y + 1, 2, S.help_text(tool), S.ATTR_SUBTLE)

    # ── pending bar ──
    if model.pending_changes:
        S.safe_addstr(stdscr, h - 1, 2,
                     "Pending changes · Apply (a) · Discard (r)",
                     S.ATTR_OK_BOLD)

    S.finish_frame(stdscr)


# ── input handling ───────────────────────────────────────────────────────
def handle_key(stdscr, model, key):
    # Tester mode: intercept all keys for visual feedback
    if model.show_tester:
        if key == 23:  # Ctrl+W → exit tester
            model.show_tester = False
            model.tester_highlight = ""
            model.tester_last_key = ""
            model.dirty = True
            return True
        code = _curses_key_to_code(key)
        model.tester_highlight = code or ""
        model.tester_last_key = code or f"code:{key}"
        model.dirty = True
        return True

    if key == ord('q') or key == 27:  # q or Esc
        if model.show_picker:
            model.show_picker = False
            model.dirty = True
            return True
        return False

    # Key picker mode — only if selected device is still connected
    if model.show_picker:
        if not _can_edit_selected(model):
            model.show_picker = False
            model.dirty = True
            return True
        if key == curses.KEY_UP or key == ord('k'):
            model.move_picker(-1, 0)
        elif key == curses.KEY_DOWN or key == ord('j'):
            model.move_picker(1, 0)
        elif key == curses.KEY_LEFT or key == ord('h'):
            model.move_picker(0, -1)
        elif key == curses.KEY_RIGHT or key == ord('l'):
            model.move_picker(0, 1)
        elif key == ord('\n') or key == ord(' '):
            model.confirm_picker_selection()
        model.dirty = True
        return True

    if model.busy and key not in (ord('r'), ord('q')):
        return True

    # Mouse handling
    if key == curses.KEY_MOUSE:
        me = S.get_mouse_event()
        if me:
            wheel = S.mouse_wheel_delta(me)
            if wheel is not None:
                model.scroll_offset = max(0, model.scroll_offset + wheel)
                model.dirty = True
                return True
            mx, my, button, kind = me
            if kind in ("click", "release", "press") or button == "left":
                # Get plain text lines for hit testing
                plain = S.get_plain_lines(stdscr)
                # Check device list clicks
                for i, dev in enumerate(model.devices):
                    name = dev.get("displayName", "")
                    if S.hit_test(plain, mx, my, name):
                        model.selected = i
                        model.focus_area = 0
                        model.dirty = True
                        return True
                # Check preset clicks
                for i, (pid, plabel, ptype, _) in enumerate(GLOBAL_PRESETS):
                    if S.hit_test(plain, mx, my, plabel):
                        preset_row = i + 1
                        if model.fnmode_available:
                            preset_row += 1
                        model.selected_preset = preset_row
                        model.focus_area = 2
                        if _can_edit_selected(model):
                            if ptype == "remap":
                                # Check if click is past the label (on trailing target)
                                label_end = plain[my].find(plabel) + len(plabel) if my < len(plain) else 0
                                if mx >= label_end:
                                    model.trigger_override_picker()
                                else:
                                    model.toggle_preset()
                            else:
                                model.toggle_preset()
                        model.dirty = True
                        return True
                # Check action buttons
                actions = [
                    ("Setup keyd", "s"), ("Key Tester", "t"),
                    ("Apply remaps", "a"), ("Refresh", "r"),
                ]
                for label, k in actions:
                    if S.hit_test(plain, mx, my, label):
                        return handle_key(stdscr, model, ord(k))
                # Check profile toggle (view-only if device offline)
                if S.hit_test(plain, mx, my, "Profile:"):
                    model.selected_preset = 0
                    model.focus_area = 1
                    if _can_edit_selected(model):
                        model.toggle_profile_enabled()
                    model.dirty = True
                    return True
        return True

    pf_rows = 2 if model.fnmode_available else 1
    _prof_enabled = False
    if model.devices and model.selected < len(model.devices):
        _dev = model.devices[model.selected]
        _key, _prof = model.profile_for_device(_dev)
        _prof_enabled = _prof is not None and _prof.get("enabled", True)
    if model.focus_area == 0:  # device list
        if key == curses.KEY_UP or key == ord('k'):
            model.selected = max(0, model.selected - 1)
        elif key == curses.KEY_DOWN or key == ord('j'):
            model.selected = min(max(0, len(model.devices) - 1), model.selected + 1)
        elif key == curses.KEY_BTAB:  # Shift+Tab → Presets (only if master toggle on)
            if _prof_enabled and model.right_col_rows() > pf_rows:
                model.focus_area = 2
                model.selected_preset = pf_rows
            else:
                model.focus_area = 0
        elif key == ord('\t') or key == 9:  # Tab → Profile
            model.focus_area = 1
            model.selected_preset = 0
        elif key == ord(' '):
            model.toggle_profile_enabled()
        elif key == ord('s'):
            model.setup_keyd()
        elif key == ord('T'):
            model.key_tester()
        elif key == ord('t'):
            model.start_tester()
        elif key == ord('a') and model.pending_changes:
            model.apply_remaps()
        elif key == ord('r'):
            model.refresh()
        elif key == ord('c'):
            if _can_edit_selected(model):
                src = model.find_copy_source()
                if src:
                    model.copy_profile_from(src)
        elif key == ord('\n') or key == 10:  # Enter → Profile
            model.focus_area = 1
            model.selected_preset = 0
    elif model.focus_area == 1:  # Profile (top right)
        if key == curses.KEY_UP or key == ord('k'):
            model.selected_preset = max(0, model.selected_preset - 1)
        elif key == curses.KEY_DOWN or key == ord('j'):
            model.selected_preset = min(pf_rows - 1, model.selected_preset + 1)
        elif key == curses.KEY_BTAB:  # Shift+Tab → Keyboards
            model.focus_area = 0
        elif key == ord('\t') or key == 9:  # Tab → Presets (only if master toggle on)
            if _prof_enabled and model.right_col_rows() > pf_rows:
                model.focus_area = 2
                model.selected_preset = pf_rows
            else:
                model.focus_area = 0
        elif key == ord('\n') or key == 10:
            if model.selected_preset == 0:
                model.toggle_profile_enabled()
            elif model.fnmode_available and model.selected_preset == 1:
                model.busy = True
                model.cycle_fnmode()
        elif key == ord(' '):
            if model.selected_preset == 0:
                model.toggle_profile_enabled()
            elif model.fnmode_available and model.selected_preset == 1:
                model.busy = True
                model.cycle_fnmode()
    elif model.focus_area == 2:  # Presets (bottom right)
        if key == curses.KEY_UP or key == ord('k'):
            model.selected_preset = max(pf_rows, model.selected_preset - 1)
        elif key == curses.KEY_DOWN or key == ord('j'):
            model.selected_preset = min(model.right_col_rows() - 1, model.selected_preset + 1)
        elif key == curses.KEY_BTAB:  # Shift+Tab → Profile
            model.focus_area = 1
            model.selected_preset = pf_rows - 1
        elif key == ord('\t') or key == 9:  # Tab → back to left
            model.focus_area = 0
        elif key == ord('\n') or key == 10:
            if model.selected_preset == 0:
                model.toggle_profile_enabled()
            elif model.fnmode_available and model.selected_preset == 1:
                model.busy = True
                model.cycle_fnmode()
            else:
                model.trigger_override_picker()
        elif key == ord(' '):
            if model.selected_preset == 0:
                model.toggle_profile_enabled()
            elif model.fnmode_available and model.selected_preset == 1:
                model.busy = True
                model.cycle_fnmode()
            else:
                model.toggle_preset()
        elif key == ord('s'):
            model.setup_keyd()
        elif key == ord('T'):
            model.key_tester()
        elif key == ord('t'):
            model.start_tester()
        elif key == ord('a') and model.pending_changes:
            model.apply_remaps()
        elif key == ord('r'):
            model.refresh()
        elif key == ord('f') and model.fnmode_available:
            model.busy = True
            model.cycle_fnmode()
        elif key == ord('c'):
            if _can_edit_selected(model):
                src = model.find_copy_source()
                if src:
                    model.copy_profile_from(src)

    # Cancel / undo: revert to last applied snapshot
    if key == ord('u') and model.pending_changes:
        model.cancel_changes()

    # Global scroll keys
    if key == curses.KEY_PPAGE:
        model.scroll_offset += 3
    elif key == curses.KEY_NPAGE:
        model.scroll_offset = max(0, model.scroll_offset - 3)
    elif key == curses.KEY_HOME:
        model.scroll_offset = 9999
    elif key == curses.KEY_END:
        model.scroll_offset = 0

    model.dirty = True
    return True


# ── main ─────────────────────────────────────────────────────────────────
def main(stdscr):
    S.run_tui_loop(stdscr, Model(), view, handle_key, poll_timeout=200)

if __name__ == "__main__":
    curses.wrapper(main)
