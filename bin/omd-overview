#!/bin/sh
set -eu

_omd_root=$(cd "$(dirname "$0")/.." && pwd)
. "$_omd_root/lib/paths.sh"
. "$_omd_root/scripts/omd-path.sh"
unset _omd_root

# Prefer repo default modules, fallback to SUMIKA_MODULES_HOME
app_dir="$OMD_ROOT/modules/overview"
if [ ! -d "$app_dir" ]; then
    app_dir="${SUMIKA_MODULES_HOME:-$HOME/development/sumika-modules}/overview"
fi

exec "$OMD_ROOT/quickshell/scripts/quickshell" "$app_dir"