#!/usr/bin/env bash
# Route settings TUI pages — only routes with core binaries are active.
set -euo pipefail

OMD_ROOT="${OMD_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
export OMD_ROOT

route="${1:-help}"

case "$route" in
  -h|--help|help)
    cat <<'EOF'
Usage: omd-settings-tui [page]

Pages:
  wallpaper  Wallpaper settings (picker, rotation, color)
EOF
    exit 0
    ;;
  wallpaper)
    exec python3 "$OMD_ROOT/quickshell/modules/settings/bin/omd-settings-wallpaper-tui"
    ;;
  *)
    echo "omd-settings-tui: unknown page '$route' (only 'wallpaper' available)" >&2
    exit 2
    ;;
esac
