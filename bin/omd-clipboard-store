#!/bin/bash
set -eu

_omd_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
. "$_omd_root/lib/paths.sh"
unset _omd_root
. "$OMD_ROOT/scripts/omd-path.sh"

# wl-paste --watch only fires for the default MIME type (text/plain).
# Images use image/png etc, so we need a separate watcher for each type.
# Run text watcher in foreground, image watcher in background.

wl-paste --watch bash -c '
    data=$(cat)
    # Reject visually empty text, including Unicode zero-width/format chars.
    if ! printf %s "$data" | grep -Pq "[^\\s\\p{Cf}\\p{Cc}]"; then
        exit 0
    fi
    # Check if it contains /tmp/omd-clip-
    if [[ "$data" == *"/tmp/omd-clip-"* ]]; then
        exit 0
    fi
    # Store it
    echo -n "$data" | cliphist store
    qs -p "$OMD_ROOT/modules/clipboard" ipc call cliphistService update 2>/dev/null || true
' &

wl-paste -t image/png --watch sh -c '
    tmp=$(mktemp)
    trap '\''rm -f "$tmp"'\'' EXIT
    cat > "$tmp"
    [ -s "$tmp" ] || exit 0
    file -b --mime-type "$tmp" | grep -q "^image/" || exit 0
    cliphist store < "$tmp"
    qs -p "$OMD_ROOT/modules/clipboard" ipc call cliphistService update 2>/dev/null || true
'

wait