#!/bin/sh
set -eu

# Resolve repo root from this script's location (works without ~/.config/omd symlink).
_omd_root=$(cd "$(dirname "$0")/.." && pwd)
. "$_omd_root/lib/paths.sh"
unset _omd_root

# shellcheck source=../scripts/omd-path.sh
. "$OMD_ROOT/scripts/omd-path.sh"
# shellcheck source=../scripts/omd-quickshell-stop.sh
. "$OMD_ROOT/scripts/omd-quickshell-stop.sh"

# Skip stop if already called by caller (e.g. reload-quickshell) to avoid
# double-stop race that kills freshly started processes.
if [ "${OMD_SKIP_STOP:-0}" != "1" ]; then
    omd_stop_quickshell
fi

start_app() {
    app="$1"
    executable="${2:-$OMD_ROOT/bin/$app}"

    if [ ! -x "$executable" ]; then
        printf 'Skipping %s: executable not found at %s\n' "$app" "$executable" >&2
        return 0
    fi

    if command -v systemd-run >/dev/null 2>&1 && systemctl --user is-active default.target >/dev/null 2>&1; then
        systemd-run --user --unit="$app" --collect \
            --property=KillMode=process \
            --setenv=PATH="$PATH" \
            --setenv=OMD_ROOT="$OMD_ROOT" \
            --setenv=SUMIKA_SHELL_ROOT="$SUMIKA_SHELL_ROOT" \
            --setenv=SUMIKA_SHELL_CONFIG_HOME="$SUMIKA_SHELL_CONFIG_HOME" \
            --setenv=SUMIKA_SHELL_STATE_HOME="$SUMIKA_SHELL_STATE_HOME" \
            /bin/sh -c 'exec "$1" >"$2" 2>&1' sh "$executable" "/tmp/$app.log" >/dev/null
    else
        setsid "$executable" >"/tmp/$app.log" 2>&1 < /dev/null &
    fi
}

# Resolve the runtime registry path.
_registry_file="${SUMIKA_MODULE_REGISTRY:-${SUMIKA_SHELL_RUNTIME_DIR:-/run/user/$(id -u)/sumika-shell}/modules.json}"

# ── Core host processes (always required) ──────────────────────────────────
# omd-bar and omd-polkit are Core host processes, not discovered modules.
start_app omd-bar
start_app omd-polkit

# ── Registry-driven application modules ────────────────────────────────────
# Every module with kind=application and an entry block contributes a process.
if command -v jq >/dev/null 2>&1 && [ -f "$_registry_file" ]; then
    jq -r '
      .modules[] |
      select(.kind == "application" and (.entry | length > 0)) |
      "\(.entry.instance // .id)\t\(.entry.command[0] // "")"
    ' "$_registry_file" 2>/dev/null | while IFS="	" read -r instance first_cmd; do
        [ -z "$instance" ] && continue

        # Resolve ${OMD_ROOT} in the command path via sed.
        resolved_cmd=$(echo "$first_cmd" | sed "s|\${OMD_ROOT}|$OMD_ROOT|g")

        # If the result is empty or a relative path not found, fallback to bin/.
        if [ -z "$resolved_cmd" ]; then
            resolved_cmd="$OMD_ROOT/bin/$instance"
        elif echo "$first_cmd" | grep -qv '^/' && [ ! -x "$resolved_cmd" ]; then
            resolved_cmd="$OMD_ROOT/bin/$instance"
        fi

        # Check SUMIKA_MODULES_HOME fallback for external modules.
        if [ ! -x "$resolved_cmd" ] && [ -n "${SUMIKA_MODULES_HOME:-}" ]; then
            _fallback="$SUMIKA_MODULES_HOME/$instance/bin/$instance"
            if [ -x "$_fallback" ]; then
                resolved_cmd="$_fallback"
            fi
        fi

        start_app "$instance" "$resolved_cmd"
    done
elif [ -f "$_registry_file" ]; then
    echo "[omd-restart] WARNING: jq not available — cannot parse registry for application modules" >&2
    echo "[omd-restart] Only Core processes (omd-bar, omd-polkit) were started." >&2
else
    echo "[omd-restart] WARNING: registry not found at $_registry_file" >&2
    echo "[omd-restart] Starting Core processes only." >&2
fi

# ── Compatibility shim: clipboard-store ────────────────────────────────────
# Clipboard module (sumika-modules/clipboard/) is kind:shared with no entry
# block, so the registry-driven section above skips it.  Once clipboard declares
# kind=application + entry, this shim can be removed (Phase J).
_clipboard_store="$OMD_ROOT/bin/omd-clipboard-store"
if [ ! -x "$_clipboard_store" ] && [ -n "${SUMIKA_MODULES_HOME:-}" ]; then
    _clipboard_store="$SUMIKA_MODULES_HOME/clipboard/bin/omd-clipboard-store"
fi
if [ -x "$_clipboard_store" ]; then
    start_app omd-clipboard-store "$_clipboard_store"
fi
