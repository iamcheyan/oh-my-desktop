#!/bin/sh
set -eu

# Resolve repo root from this script's location (works without ~/.config/omd symlink).
_omd_root=$(cd "$(dirname "$0")/.." && pwd)
. "$_omd_root/lib/paths.sh"
unset _omd_root

# shellcheck source=../scripts/omd-path.sh
. "$OMD_ROOT/scripts/omd-path.sh"
# shellcheck source=../scripts/omd-quickshell-stop.sh
. "$OMD_ROOT/scripts/omd-quickshell-stop.sh"

# Skip stop if already called by caller (e.g. reload-quickshell) to avoid
# double-stop race that kills freshly started processes.
if [ "${OMD_SKIP_STOP:-0}" != "1" ]; then
    omd_stop_quickshell
fi

start_app() {
    app="$1"
    executable="${2:-$OMD_ROOT/bin/$app}"

    if [ ! -x "$executable" ]; then
        printf 'Skipping %s: executable not found at %s\n' "$app" "$executable" >&2
        return 0
    fi

    if command -v systemd-run >/dev/null 2>&1 && systemctl --user is-active default.target >/dev/null 2>&1; then
        # KillMode=process: only kill the unit main process, NOT the whole cgroup.
        # Apps launched from omd-applauncher (foot, tmux, browsers) stay in this
        # cgroup — never use `systemctl stop` here; see omd-quickshell-stop.sh.
        systemd-run --user --unit="$app" --collect \
            --property=KillMode=process \
            --setenv=PATH="$PATH" \
            --setenv=OMD_ROOT="$OMD_ROOT" \
            --setenv=SUMIKA_SHELL_ROOT="$SUMIKA_SHELL_ROOT" \
            --setenv=SUMIKA_SHELL_CONFIG_HOME="$SUMIKA_SHELL_CONFIG_HOME" \
            --setenv=SUMIKA_SHELL_STATE_HOME="$SUMIKA_SHELL_STATE_HOME" \
            /bin/sh -c 'exec "$1" >"$2" 2>&1' sh "$executable" "/tmp/$app.log" >/dev/null
    else
        setsid "$executable" >"/tmp/$app.log" 2>&1 < /dev/null &
    fi
}

start_app omd-bar
start_app omd-overview
start_app omd-polkit

clipboard_store="$OMD_ROOT/bin/omd-clipboard-store"
if [ ! -x "$clipboard_store" ] && [ -n "${SUMIKA_MODULES_HOME:-}" ]; then
    clipboard_store="$SUMIKA_MODULES_HOME/clipboard/bin/omd-clipboard-store"
fi
start_app omd-clipboard-store "$clipboard_store"
