#!/bin/sh
set -eu

# omd-restart — Restart Quickshell processes (bar, polkit, overview, etc.)
#
# Usage: omd-restart [--quickshell-only]
#
# Callers: power-popup reload button, launcher, overview, settings,
#          hypr/autostart.lua, and direct terminal use.

_omd_root=$(cd "$(dirname "$0")/.." && pwd)
. "$_omd_root/lib/paths.sh"
unset _omd_root

# ── Lockscreen guard ──────────────────────────────────────────────────────
if pgrep -f "wl-session-lock\|WlSessionLock" >/dev/null 2>&1; then
    printf 'Screen is locked — refusing to reload.\n' >&2
    exit 1
fi

# ── Argument parsing ──────────────────────────────────────────────────────
quickshell_only=0
case "${1:-}" in
    --quickshell-only) quickshell_only=1 ;;
    "") ;;
    *) printf 'Usage: %s [--quickshell-only]\n' "$0" >&2; exit 2 ;;
esac

# ── Kill old quickshell processes ─────────────────────────────────────────
# pkill targets only quickshell binaries by command line.
# Do NOT use `systemctl stop` — it destroys the unit cgroup, killing user
# apps (terminals, Firefox) that inherited the bar's cgroup.
pkill -f "/usr/bin/quickshell -p ${OMD_ROOT}/" 2>/dev/null || true
sleep 0.3
pkill -9 -f "/usr/bin/quickshell -p ${OMD_ROOT}/" 2>/dev/null || true
sleep 0.2

# ── Watcher cleanup (nmcli, cliphist, etc.) ───────────────────────────────
_registry_file="${SUMIKA_MODULE_REGISTRY:-${SUMIKA_SHELL_RUNTIME_DIR:-/run/user/$(id -u)/sumika-shell}/modules.json}"
if command -v jq >/dev/null 2>&1 && [ -f "$_registry_file" ]; then
    while IFS="" read -r watcher; do
        [ -z "$watcher" ] && continue
        pkill -f "$watcher" 2>/dev/null || true
    done <<WATCHERS
$(jq -r '
  .modules[] |
  select(.contributes.watchers? // [] | length > 0) |
  .contributes.watchers[]
' "$_registry_file" 2>/dev/null || true)
WATCHERS
else
    pkill -f "(^|/)nmcli monitor$" 2>/dev/null || true
fi

# Clipboard daemon has its own stop subcommand
_clipboard_module=""
if command -v jq >/dev/null 2>&1 && [ -f "$_registry_file" ]; then
    _clipboard_module=$(jq -r '.modules[] | select(.id == "clipboard") | .path // empty' "$_registry_file" 2>/dev/null || true)
fi
if [ -n "$_clipboard_module" ] && [ -x "$_clipboard_module/bin/omd-clipboard-store" ]; then
    "$_clipboard_module/bin/omd-clipboard-store" stop >/dev/null 2>&1 || true
fi

# ── Reset stale systemd unit state ─────────────────────────────────────────
_runtime_dir="/run/user/$(id -u)"
for unit in omd-bar omd-polkit omd-overview omd-applauncher; do
    systemctl --user reset-failed "$unit.service" >/dev/null 2>&1 || true
    rm -f "$_runtime_dir/systemd/transient/$unit.service" 2>/dev/null || true
done
systemctl --user daemon-reload >/dev/null 2>&1 || true

# Kill waybar if present
pkill -x waybar 2>/dev/null || true

# ── Start app helper ──────────────────────────────────────────────────────
start_app() {
    app="$1"
    executable="${2:-$OMD_ROOT/bin/$app}"

    if [ ! -x "$executable" ]; then
        printf 'Skipping %s: executable not found at %s\n' "$app" "$executable" >&2
        return 0
    fi

    if command -v systemd-run >/dev/null 2>&1 && systemctl --user is-active default.target >/dev/null 2>&1; then
        systemd-run --user --unit="$app" --collect \
            --property=KillMode=mixed \
            --property=Restart=on-failure \
            --property=RestartSec=2 \
            --setenv=PATH="$PATH" \
            --setenv=OMD_ROOT="$OMD_ROOT" \
            --setenv=SUMIKA_SHELL_ROOT="$SUMIKA_SHELL_ROOT" \
            --setenv=SUMIKA_SHELL_CONFIG_HOME="$SUMIKA_SHELL_CONFIG_HOME" \
            --setenv=SUMIKA_SHELL_STATE_HOME="$SUMIKA_SHELL_STATE_HOME" \
            /bin/sh -c 'exec "$1" >"$2" 2>&1' sh "$executable" "/tmp/$app.log" >/dev/null
    else
        setsid "$executable" >"/tmp/$app.log" 2>&1 < /dev/null &
    fi
}

# ── Module enablement rules ───────────────────────────────────────────────
_PRODUCT_FLOOR="launcher clock notification-popup workspaces overview systray wifi audio power-indicator display"

_sumika_config="${SUMIKA_SHELL_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/sumika-shell}/sumika.json"
_modules_master=true
_modules_disabled=""
_modules_required="$_PRODUCT_FLOOR"

if command -v jq >/dev/null 2>&1 && [ -f "$_sumika_config" ]; then
    _modules_master=$(jq -r '
        try (
            if (.modules | type) == "object" and (.modules | has("enabled"))
            then .modules.enabled
            else true
            end
        )
    ' "$_sumika_config" 2>/dev/null || echo true)
    _modules_disabled=$(jq -r '(.modules.disabled // []) | map(tostring) | join(" ")' "$_sumika_config" 2>/dev/null || true)
    _extra_required=$(jq -r '(.modules.required // []) | map(tostring) | join(" ")' "$_sumika_config" 2>/dev/null || true)
    if [ -n "$_extra_required" ]; then
        _modules_required="$_PRODUCT_FLOOR $_extra_required"
    fi
fi

module_is_required() {
    id="$1"
    for r in $_modules_required; do
        [ "$r" = "$id" ] && return 0
    done
    return 1
}

module_is_enabled() {
    id="$1"
    if module_is_required "$id"; then
        return 0
    fi
    case "$_modules_master" in
        false|False|0) return 1 ;;
    esac
    for d in $_modules_disabled; do
        [ "$d" = "$id" ] && return 1
    done
    return 0
}

# ── Start core processes ──────────────────────────────────────────────────
start_app omd-bar
start_app omd-polkit

# ── Start registry-driven application modules ─────────────────────────────
if command -v jq >/dev/null 2>&1 && [ -f "$_registry_file" ]; then
      jq -r '
        .modules[] |
        select(.kind == "application" and (.entry | length > 0)) |
        [
          .path,
          .id,
          (.entry.instance // .id),
          (.entry.command[0] // ""),
          (if (.entry | has("autostart")) then (.entry.autostart | tostring) else "true" end)
        ] | @tsv
      ' "$_registry_file" 2>/dev/null | while IFS="	" read -r module_path module_id instance first_cmd autostart; do
        [ -z "$instance" ] && continue
        [ -z "$module_id" ] && module_id="$instance"

        if ! module_is_enabled "$module_id"; then
            printf 'Skipping application module %s (disabled / outside minimum desktop)\n' "$module_id" >&2
            continue
        fi

        case "$autostart" in
            false|False|0)
                printf 'Skipping application module %s (entry.autostart=false, on-demand)\n' "$module_id" >&2
                continue
                ;;
        esac

        resolved_cmd=$(echo "$first_cmd" | sed "s|\${OMD_ROOT}|$OMD_ROOT|g")

        if [ -n "${module_path:-}" ] && echo "$first_cmd" | grep -qv '^/' && ! echo "$first_cmd" | grep -qF '${OMD_ROOT}'; then
            resolved_cmd="$module_path/$first_cmd"
        fi
        if [ -z "$resolved_cmd" ]; then
            resolved_cmd="$OMD_ROOT/bin/$instance"
        elif echo "$first_cmd" | grep -qv '^/' && [ ! -x "$resolved_cmd" ]; then
            resolved_cmd="$OMD_ROOT/bin/$instance"
        fi
        start_app "$instance" "$resolved_cmd"
    done
elif [ -f "$_registry_file" ]; then
    echo "[omd-restart] WARNING: jq not available — cannot parse registry" >&2
else
    echo "[omd-restart] WARNING: registry not found at $_registry_file" >&2
fi

# ── Hyprland reload ───────────────────────────────────────────────────────
if [ "$quickshell_only" -eq 0 ]; then
    if command -v hyprctl >/dev/null 2>&1 && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
        hyprctl reload >/dev/null
        errors=$(hyprctl configerrors 2>/dev/null || true)
        if [ -n "$errors" ]; then
            printf 'Hyprland configuration still has errors:\n%s\n' "$errors" >&2
        fi
    fi
fi

# ── Terminal reload ───────────────────────────────────────────────────────
if [ -x "$OMD_ROOT/scripts/reload-terminals" ]; then
    OMD_ROOT="$OMD_ROOT" "$OMD_ROOT/scripts/reload-terminals" >/dev/null 2>&1 || true
fi