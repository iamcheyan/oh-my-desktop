#!/usr/bin/env python3
"""
omd-bluetooth-tui — Guided Bluetooth pairing & connection TUI.

A full-screen curses interface for scanning, pairing, trusting, and
connecting Bluetooth devices. Handles both Legacy Pairing (PIN entry)
and Secure Simple Pairing (passkey confirmation) by spawning
``bluetoothctl`` with a full agent underneath.

Controls
  j / ↓      Move selection down
  k / ↑      Move selection up
  Tab / l    Next section
  S-Tab / h  Previous section
  Enter      Pair + trust + connect / disconnect
  d          Disconnect
  f          Forget (remove)
  s          Scan on/off
  u          Unpair
  t          Trust/Untrust
  q / Esc    Quit
"""

import curses
import locale
import os
import re
import select
import subprocess
import sys
import time
from shutil import which

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import omd_tui_shared as S

# English output from bluetoothctl across locales
_SUBPROC_ENV = {
    **os.environ,
    "LC_ALL": "C.UTF-8",
    "LANG": "C.UTF-8",
    "LANGUAGE": "C",
}

# ── helpers ───────────────────────────────────────────────────────────

ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]")
ADDR_RE = re.compile(r"([0-9A-Fa-f]{2}[:]){5}[0-9A-Fa-f]{2}")
DEVICE_RE = re.compile(
    r"\[(?:NEW|CHG)\]\s+Device\s+([0-9A-Fa-f:]{17})\s+(.*)"
)
NEW_DEVICE_RE = re.compile(
    r"\[NEW\]\s+Device\s+([0-9A-Fa-f:]{17})\s+(.*)"
)
PIN_RE = re.compile(r"\[agent\]\s*PIN code:\s*([0-9]{4,6})", re.IGNORECASE)
PASSKEY_RE = re.compile(r"\[agent\]\s*Passkey:\s*([0-9]{4,6})", re.IGNORECASE)
CONFIRM_RE = re.compile(r"Confirm passkey[^0-9]*([0-9]{4,6})", re.IGNORECASE)
PAIRED_RE = re.compile(r"Pairing successful|Paired:\s*yes", re.IGNORECASE)
CONNECTED_RE = re.compile(r"Connection successful", re.IGNORECASE)
CONNECTED_CHG_RE = re.compile(r"Connected:\s*yes", re.IGNORECASE)


def clean(text: str) -> str:
    return ANSI_RE.sub("", text).replace("\r", "")


ICON_MAP = {
    "input-keyboard":      "\uf11c",  # fa-keyboard
    "input-mouse":         "\uefba",  # fa-computer-mouse
    "input-tablet":        "\uf10a",  # fa-tablet
    "input-gaming":        "\uf11b",  # fa-gamepad
    "audio-headset":       "\uf025",  # fa-headphones
    "audio-card":          "\uf025",  # fa-headphones (internal audio)
    "audio-speaker":       "\uf028",  # fa-volume-up
    "audio-input-microphone": "\uf130",  # fa-microphone
    "video-display":       "\uf108",  # fa-desktop
    "video-camera":        "\uf030",  # fa-camera
    "camera":              "\uf030",  # fa-camera
    "computer":            "\uf108",  # fa-desktop (laptop/desktop)
    "phone":               "\uf10b",  # fa-mobile
    "printer":             "\uf02f",  # fa-print
    "scanner":             "\uf030",  # fa-camera (scanner)
    "network-wireless":    "\uf1eb",  # fa-wifi
    "multimedia-player":   "\uf025",  # fa-headphones (media playback)
    "wearable":            "\uf2f1",  # fa-clock (smartwatch)
}
ICON_UNKNOWN = "\uf059"  # fa-question-circle

# Name keyword → ICON_MAP key fallback for devices without an Icon field.
NAME_GUESS_MAP = {
    "keyboard":     "input-keyboard",
    "mouse":        "input-mouse",
    "headphone":    "audio-headset",
    "headset":      "audio-headset",
    "earbud":       "audio-headset",
    "airpods":      "audio-headset",
    "soundlink":    "audio-speaker",
    "speaker":      "audio-speaker",
    "loudspeaker":  "audio-speaker",
    "soundcore":    "audio-speaker",
    "controller":   "input-gaming",
    "gamepad":      "input-gaming",
    "watch":        "wearable",
    "smartwatch":   "wearable",
    "desktop":      "computer",
    "laptop":       "computer",
    "printer":      "printer",
    "scanner":      "scanner",
    "camera":       "camera",
    "tablet":       "input-tablet",
    "iphone":       "phone",
    "galaxy":       "phone",
    "pixel":        "phone",
    "fitbit":       "wearable",
    "band":         "wearable",
    "dual":         "input-gaming",
    "xbox":         "input-gaming",
    "playstation":  "input-gaming",
}


def _icon_from_appearance(appearance: int) -> str | None:
    """Map a BLE GAP Appearance value to an ICON_MAP key.
    category = appearance >> 6, subcategory = appearance & 0x3F."""
    cat = appearance >> 6
    sub = appearance & 0x3F
    if cat == 0x01:
        return "phone"
    if cat == 0x02:
        return "computer"
    if cat == 0x03:
        return "wearable"           # Watch
    if cat == 0x05:
        return "video-display"      # Display
    if cat == 0x0A:
        return "multimedia-player"  # Media Player
    if cat == 0x0B:
        return "scanner"            # Barcode Scanner
    if cat == 0x0F:                 # HID
        if sub == 0x01:
            return "input-keyboard"
        if sub == 0x02:
            return "input-mouse"
        if sub in (0x03, 0x04):
            return "input-gaming"
        if sub == 0x05:
            return "input-tablet"
        if sub == 0x08:
            return "scanner"
        return None                 # Generic HID
    if cat == 0x21:                 # Audio Sink
        return "audio-speaker"
    if cat == 0x25:                 # Wearable Audio
        if sub in (0x01, 0x02, 0x04):
            return "audio-headset"  # Earbud, Headset, Neck Band
        if sub == 0x03:
            return "audio-headset"  # Headphones
        return "audio-speaker"
    if cat == 0x29:
        return "audio-headset"      # Hearing Aid
    return None


# Bluetooth Class of Device — major class (bits 8-12)
_COD_MAJOR = {
    0x01: "computer",
    0x02: "phone",
    0x04: "audio",       # Audio/Video — resolved via minor below
    0x05: "peripheral",  # resolved via minor below
    0x07: "wearable",
    0x08: "toy",
}

_COD_AV_MINOR = {
    0x01: "audio-headset",
    0x02: "audio-headset",
    0x04: "audio-input-microphone",
    0x05: "audio-speaker",
    0x06: "audio-headset",
    0x07: "audio-speaker",
}

_COD_PERIPH_MINOR = {
    0x01: "input-keyboard",
    0x02: "input-mouse",
    0x03: "input-keyboard",
}

_COD_WEARABLE_MINOR = {
    0x00: "wearable",
}


def _icon_from_class(cod: int) -> str | None:
    major = (cod >> 8) & 0x1F
    minor_raw = cod & 0xFF
    mc = _COD_MAJOR.get(major)
    if mc is None:
        return None
    if mc == "peripheral":
        sub = (minor_raw >> 6) & 0x03
        return _COD_PERIPH_MINOR.get(sub)
    if mc == "audio":
        sub = (minor_raw >> 2) & 0x3F
        return _COD_AV_MINOR.get(sub)
    if mc == "wearable":
        sub = (minor_raw >> 2) & 0x3F
        return _COD_WEARABLE_MINOR.get(sub, "wearable")
    return mc


def device_icon(info_text: str, name: str = "") -> str:
    """Return Nerd Font glyph for a device from ``bluetoothctl info`` output.

    Precedence (matching gnome-bluetooth):
      1. BLE Appearance characteristic
      2. Bluetooth Class of Device
      3. BlueZ Icon property
      4. Device-name keyword heuristic
    """
    m = re.search(r"^\s*Appearance:\s*0x([0-9a-fA-F]+)", info_text, re.MULTILINE)
    if m:
        key = _icon_from_appearance(int(m.group(1), 16))
        if key:
            return ICON_MAP.get(key, ICON_UNKNOWN)
    m = re.search(r"^\s*Class:\s*0x([0-9a-fA-F]+)", info_text, re.MULTILINE)
    if m:
        key = _icon_from_class(int(m.group(1), 16))
        if key:
            return ICON_MAP.get(key, ICON_UNKNOWN)
    m = re.search(r"^\s*Icon:\s*(\S+)", info_text, re.MULTILINE)
    if m:
        return ICON_MAP.get(m.group(1), ICON_UNKNOWN)
    if name:
        n = name.lower()
        for keyword, icon_key in NAME_GUESS_MAP.items():
            if keyword in n:
                return ICON_MAP.get(icon_key, ICON_UNKNOWN)
    return ICON_UNKNOWN


# ── device type label (human-readable, from same sources as icon) ──

TYPE_LABELS = {
    "input-keyboard": "Keyboard",
    "input-mouse": "Mouse",
    "input-tablet": "Tablet",
    "input-gaming": "Controller",
    "audio-headset": "Headset",
    "audio-card": "Audio",
    "audio-speaker": "Speaker",
    "audio-input-microphone": "Mic",
    "video-display": "Display",
    "video-camera": "Camera",
    "camera": "Camera",
    "computer": "Computer",
    "phone": "Phone",
    "printer": "Printer",
    "scanner": "Scanner",
    "network-wireless": "Network",
    "multimedia-player": "Media",
    "wearable": "Wearable",
}


def device_type_label(info_text: str, name: str = "") -> str:
    """Return human-readable device type label from bluetoothctl info."""
    m = re.search(r"^\s*Appearance:\s*0x([0-9a-fA-F]+)", info_text, re.MULTILINE)
    if m:
        key = _icon_from_appearance(int(m.group(1), 16))
        if key:
            return TYPE_LABELS.get(key, "")
    m = re.search(r"^\s*Class:\s*0x([0-9a-fA-F]+)", info_text, re.MULTILINE)
    if m:
        key = _icon_from_class(int(m.group(1), 16))
        if key:
            return TYPE_LABELS.get(key, "")
    m = re.search(r"^\s*Icon:\s*(\S+)", info_text, re.MULTILINE)
    if m:
        return TYPE_LABELS.get(m.group(1), "")
    if name:
        n = name.lower()
        for keyword, icon_key in NAME_GUESS_MAP.items():
            if keyword in n:
                return TYPE_LABELS.get(icon_key, "")
    return ""


def pty_spawn(argv):
    pid, fd = os.forkpty()
    if pid == 0:
        try:
            os.environ.update({
                "LC_ALL": "C.UTF-8",
                "LANG": "C.UTF-8",
                "LANGUAGE": "C",
            })
            os.execvp(argv[0], argv)
        except Exception as exc:
            print(exc, file=sys.stderr)
            os._exit(127)
    return pid, fd


def send(fd, command: str):
    try:
        os.write(fd, (command + "\n").encode())
    except OSError:
        pass


def require_python() -> tuple[bool, str]:
    if sys.version_info < (3, 10):
        return False, f"Python 3.10+ required (found {sys.version.split()[0]})"
    return True, ""


def ensure_bluetoothctl() -> tuple[bool, str]:
    """Return (ok, error_message). Requires bluez bluetoothctl + a controller."""
    if which("bluetoothctl") is None:
        return False, (
            "bluetoothctl not found. omd-bluetooth-tui needs BlueZ.\n"
            "  Debian/Ubuntu:  sudo apt install bluez\n"
            "  Fedora:         sudo dnf install bluez\n"
            "  Arch:           sudo pacman -S bluez bluez-utils\n"
            "Then: sudo systemctl enable --now bluetooth"
        )
    try:
        proc = subprocess.run(
            ["bluetoothctl", "show"],
            text=True, capture_output=True, timeout=5, env=_SUBPROC_ENV,
        )
        out = (proc.stdout or "") + (proc.stderr or "")
        if "No default controller" in out or "No controller" in out:
            return False, (
                "No Bluetooth controller found.\n"
                "Check the adapter is present and: sudo systemctl start bluetooth"
            )
        if proc.returncode != 0 and "Controller" not in out:
            return False, f"bluetoothctl failed:\n{out.strip()[:200]}"
    except (OSError, subprocess.TimeoutExpired) as e:
        return False, f"Failed to run bluetoothctl: {e}"
    return True, ""


def prepare_bluetooth() -> None:
    """Best-effort: unblock rfkill, power on, pairable on."""
    try:
        subprocess.run(
            ["rfkill", "unblock", "bluetooth"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            timeout=3, env=_SUBPROC_ENV,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
        pass
    btctl_simple("power", "on", timeout=5)
    btctl_simple("pairable", "on", timeout=5)


def btctl_simple(*args, timeout: int = 10) -> tuple[int, str]:
    cmd = ["bluetoothctl", *args]
    try:
        proc = subprocess.run(
            cmd, text=True, capture_output=True, timeout=timeout, env=_SUBPROC_ENV,
        )
        out = (proc.stdout or "") + (proc.stderr or "")
        return proc.returncode, out
    except FileNotFoundError:
        return 127, "bluetoothctl not found"
    except subprocess.TimeoutExpired as e:
        out = ""
        if e.stdout:
            out += e.stdout if isinstance(e.stdout, str) else e.stdout.decode(errors="replace")
        if e.stderr:
            out += e.stderr if isinstance(e.stderr, str) else e.stderr.decode(errors="replace")
        return 1, out


def parse_battery_pct(info: str) -> int | None:
    """Extract battery percentage as int, or None."""
    m = re.search(r"Battery Percentage:\s*(?:0x[0-9a-fA-F]+\s*)?\((\d+)\)", info)
    if m:
        return int(m.group(1))
    return None


def format_battery(pct: int | None) -> str:
    """Format battery like bluetui: ``25% 󰤿`` with Nerd Font icon."""
    if pct is None:
        return ""
    # Match bluetui's nf-md battery glyphs by percentage band.
    if pct >= 90:
        icon = "\U000f0948"  # 󰥈
    elif pct >= 80:
        icon = "\U000f0945"  # 󰥅
    elif pct >= 70:
        icon = "\U000f0944"  # 󰥄
    elif pct >= 60:
        icon = "\U000f0943"  # 󰥃
    elif pct >= 50:
        icon = "\U000f0942"  # 󰥂
    elif pct >= 40:
        icon = "\U000f0941"  # 󰥁
    elif pct >= 30:
        icon = "\U000f0940"  # 󰥀
    elif pct >= 20:
        icon = "\U000f093f"  # 󰤿
    else:
        icon = "\U000f093e"  # 󰤾
    return f"{pct}% {icon}"


def get_hci_name() -> str:
    """Return the primary HCI interface name (e.g. hci0), matching bluetui."""
    try:
        names = sorted(
            n for n in os.listdir("/sys/class/bluetooth")
            if n.startswith("hci") and ":" not in n
        )
        if names:
            return names[0]
    except OSError:
        pass
    return "hci0"


def yesno_bool(val: str) -> bool:
    return val.strip().lower() in ("yes", "true", "on", "1")


def get_devices_info() -> list[dict]:
    """Return list of device dicts: addr, name, status, icon, trusted, battery."""
    _, out = btctl_simple("devices")
    # Also merge explicitly paired list (some bluez builds omit unpaired from `devices`)
    _, paired_out = btctl_simple("devices", "Paired")
    lines = list(out.splitlines()) + list(paired_out.splitlines())
    seen_addrs: set[str] = set()
    result = []
    for line in lines:
        m = re.match(r"Device\s+([0-9A-Fa-f:]{17})\s+(.*)", line)
        if not m:
            continue
        addr, name = m.group(1), m.group(2).strip()
        key = addr.upper()
        if key in seen_addrs:
            continue
        seen_addrs.add(key)
        try:
            _, info = btctl_simple("info", addr, timeout=3)
        except Exception:
            info = ""
        if not info:
            info = ""
        icon = device_icon(info, name)
        # bluez may print yes/no in any case
        paired = bool(re.search(r"Paired:\s*yes", info, re.I))
        connected = bool(re.search(r"Connected:\s*yes", info, re.I))
        trusted = bool(re.search(r"Trusted:\s*yes", info, re.I))
        blocked_raw = re.search(r"Blocked:\s*(yes|no)", info, re.I)
        blocked = blocked_raw.group(1) if blocked_raw else ""
        rssi_m = re.search(r"RSSI:\s*(-?\d+)", info, re.I)
        rssi = f"{rssi_m.group(1)} dBm" if rssi_m else ""
        adapter_m = re.search(r"Adapter:.*?hci(\d+)", info, re.I)
        adapter = f"hci{adapter_m.group(1)}" if adapter_m else ""
        type_label = device_type_label(info, name)
        battery_pct = parse_battery_pct(info)
        if connected:
            status = "connected"
        elif paired:
            status = "paired"
        else:
            status = "available"
        result.append({
            "addr": addr,
            "name": name or addr,
            "status": status,
            "icon": icon,
            "trusted": trusted,
            "blocked": blocked,
            "rssi": rssi,
            "adapter": adapter,
            "type_label": type_label,
            "battery": format_battery(battery_pct),
            "battery_pct": battery_pct,
            "favorite": False,
        })
    order = {"connected": 0, "paired": 1, "available": 2}
    result.sort(key=lambda d: order.get(d["status"], 3))
    return result


def get_adapter_info() -> dict | None:
    """Return adapter info dict, formatted like bluetui (hci name, On/Off, true/false)."""
    _, out = btctl_simple("show")
    m = re.search(r"Controller\s+([0-9A-Fa-f:]+)", out)
    if not m:
        return None

    def g(key: str) -> str:
        mm = re.search(rf"^\s*{key}:\s*(.+)", out, re.MULTILINE)
        return mm.group(1).strip() if mm else "?"

    powered = yesno_bool(g("Powered"))
    pairable = yesno_bool(g("Pairable"))
    discoverable = yesno_bool(g("Discoverable"))
    return {
        "name": get_hci_name(),
        "alias": g("Alias"),
        "powered": "On" if powered else "Off",
        "pairable": "true" if pairable else "false",
        "discoverable": "true" if discoverable else "false",
    }


# ── curses app ────────────────────────────────────────────────────────

# Focus section indices
F_PAIRED = 0
F_DISCOVERED = 1
F_ADAPTER = 2


class BluetoothTUI:
    def __init__(self, stdscr: curses.window):
        self.stdscr = stdscr
        self.devices: list[dict] = []
        self.adapter_info: dict | None = None
        self.focus = F_PAIRED
        self.selected = 0          # index into self.devices
        self.scanning = False
        self.busy = False
        self.status_msg = "Press s to scan, Enter to pair"
        self.log_lines: list[str] = []
        self.pin_prompt = None
        self.confirm_prompt = None
        self._scan_proc = None
        self._pair_proc = None
        self._pair_addr = None
        self._pair_state = ""
        self._recent = ""
        self._line_buf = ""
        self._sent_yes = False
        self._quit = False
        self._pair_started_at = 0
        self._connect_started_at = 0
        self._tick = 0             # frame counter for spinner

    # ── lifecycle ──

    def run(self):
        self._init_curses()
        prepare_bluetooth()
        self.refresh_devices()
        self.refresh_adapter()
        while not self._quit:
            self._draw()
            self._poll()
            self._handle_input()
            self._tick += 1
        self._cleanup()

    def _init_curses(self):
        try:
            curses.curs_set(0)
        except curses.error:
            pass
        curses.noecho()
        curses.cbreak()
        self.stdscr.keypad(True)
        S.init_colors()
        self.stdscr.timeout(200)

    def _cleanup(self):
        self._stop_scan()
        self._stop_pair()

    def _hero_info(self):
        subtitle_parts = []
        if self.adapter_info:
            a = self.adapter_info
            if a.get("alias") and a["alias"] != "?":
                subtitle_parts.append(a["alias"])
            subtitle_parts.append(f"powered {a.get('powered', '?').lower()}")
        paired = [d for d in self.devices if d["status"] != "available"]
        subtitle = " · ".join(subtitle_parts) if subtitle_parts else "Bluetooth"
        # Append status message to subtitle
        extra = ""
        if self.busy:
            extra = "working…"
        elif self.status_msg and not self.status_msg.startswith("Press"):
            extra = self.status_msg.strip()
        if extra:
            subtitle = subtitle + (" · " + extra if subtitle else extra)
        status_text = ""
        tone = "muted"
        if self.busy:
            status_text = "Working…"
            tone = "warn"
        elif self.scanning:
            status_text = "Scanning"
            tone = "warn"
        elif paired:
            status_text = f"{len(paired)} paired"
            tone = "ok"
        elif self.adapter_info and self.adapter_info.get("powered") == "Off":
            status_text = "Off"
            tone = "muted"
        else:
            status_text = "No devices"
            tone = "muted"
        msg = ""
        if self.busy:
            msg = "working…"
        return S.hero_line("Bluetooth", subtitle, tone, self.busy, msg, status_text)

    # ── data ──

    def refresh_devices(self):
        self.devices = get_devices_info()
        if self.selected >= len(self.devices):
            self.selected = max(0, len(self.devices) - 1)
        # Clamp focus to valid section
        if self.focus == F_DISCOVERED and not self._has_discovered():
            self.focus = F_PAIRED

    def refresh_adapter(self):
        self.adapter_info = get_adapter_info()

    def _has_discovered(self) -> bool:
        # bluetui only shows the New Devices panel while scanning
        return self.scanning

    def _paired_devices(self) -> list[dict]:
        return [d for d in self.devices if d["status"] != "available"]

    def _discovered_devices(self) -> list[dict]:
        return [d for d in self.devices if d["status"] == "available"]

    def _focused_devices(self) -> list[dict]:
        if self.focus == F_DISCOVERED:
            return self._discovered_devices()
        return self._paired_devices()

    # ── scanning ──

    def start_scan(self):
        if self.scanning or self.busy:
            return
        self._stop_scan()
        try:
            subprocess.run(
                ["rfkill", "unblock", "bluetooth"],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3,
            )
        except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
            pass
        subprocess.run(
            ["bluetoothctl", "power", "on"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5,
        )
        subprocess.run(
            ["bluetoothctl", "pairable", "on"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5,
        )
        pid, fd = pty_spawn(["bluetoothctl"])
        self._scan_proc = (pid, fd)
        self.scanning = True
        self.status_msg = "Scanning... (press s to stop)"
        self.log_lines.append("[scan] started")
        send(fd, "scan on")

    def _stop_scan(self):
        if self._scan_proc:
            pid, fd = self._scan_proc
            send(fd, "scan off")
            send(fd, "quit")
            try:
                os.close(fd)
            except OSError:
                pass
            try:
                os.waitpid(pid, os.WNOHANG)
            except ChildProcessError:
                pass
            self._scan_proc = None
        self.scanning = False

    def _poll_scan(self):
        if not self._scan_proc:
            return
        _, fd = self._scan_proc
        readable, _, _ = select.select([fd], [], [], 0)
        if not readable:
            return
        try:
            chunk = os.read(fd, 4096).decode(errors="replace")
        except OSError:
            self.scanning = False
            return
        if not chunk:
            return
        c = clean(chunk)
        for line in c.splitlines():
            m = NEW_DEVICE_RE.search(line)
            if m:
                addr = m.group(1)
                name = m.group(2).strip()
                _, info = btctl_simple("info", addr, timeout=1)
                icon = device_icon(info, name) if info else ICON_UNKNOWN
                self._merge_device(addr, name, icon)
            else:
                m = DEVICE_RE.search(line)
                if m:
                    addr = m.group(1)
                    self._merge_device(addr, "")

    def _merge_device(self, addr, name, icon=ICON_UNKNOWN):
        for i, d in enumerate(self.devices):
            if d["addr"].upper() == addr.upper():
                if name and name != d["name"]:
                    d["name"] = name
                if icon != ICON_UNKNOWN and d["icon"] == ICON_UNKNOWN:
                    d["icon"] = icon
                return
        self.devices.append({
            "addr": addr,
            "name": name,
            "status": "available",
            "icon": icon,
            "trusted": False,
            "battery": "",
            "battery_pct": None,
            "favorite": False,
        })

    # ── pairing ──

    def start_pair(self, addr: str, name: str):
        if self.busy:
            return
        self._stop_scan()
        self.busy = True
        self._pair_addr = addr
        self._pair_state = "connecting"
        self.pin_prompt = None
        self.confirm_prompt = None
        self._sent_yes = False
        self._recent = ""
        self._line_buf = ""
        self.status_msg = f"Pairing with {name}..."
        self.log_lines.append(f"[pair] starting pair+connect for {addr}")
        self._pair_started_at = time.monotonic()
        pid, fd = pty_spawn(["bluetoothctl"])
        self._pair_proc = (pid, fd)
        send(fd, "power on")
        send(fd, "agent on")
        send(fd, "default-agent")
        send(fd, "pairable on")
        time.sleep(0.3)
        send(fd, f"pair {addr}")

    def _poll_pair(self):
        if not self._pair_proc:
            return
        _, fd = self._pair_proc
        readable, _, _ = select.select([fd], [], [], 0)
        if not readable:
            return
        try:
            chunk = os.read(fd, 4096).decode(errors="replace")
        except OSError:
            return
        if not chunk:
            return
        c = clean(chunk)
        self._recent = (self._recent + c)[-4000:]
        self._line_buf += c
        while "\n" in self._line_buf:
            line, self._line_buf = self._line_buf.split("\n", 1)
            line = line.strip()
            if line:
                self.log_lines.append(line)
        m = PIN_RE.search(self._recent)
        if m and not self.pin_prompt:
            self.pin_prompt = m.group(1)
            self._pair_state = "pin"
            self.log_lines.append(f"[pair] PIN code: {self.pin_prompt}")
        m = PASSKEY_RE.search(self._recent)
        if m and not self.confirm_prompt:
            self.confirm_prompt = m.group(1)
            self._pair_state = "confirm"
            self.log_lines.append(f"[pair] Passkey: {self.confirm_prompt}")
        m = CONFIRM_RE.search(self._recent)
        if m and not self._sent_yes:
            self.confirm_prompt = m.group(1)
            self._pair_state = "confirm"
            send(fd, "yes")
            self._sent_yes = True
            self.log_lines.append(f"[pair] Auto-confirmed passkey {m.group(1)}")
        if PAIRED_RE.search(self._recent) and self._pair_state != "paired":
            self._pair_state = "paired"
            self.log_lines.append("[pair] Paired! Trusting + connecting...")
            self._do_trust_connect()
        if self._pair_state == "connecting" and \
                (CONNECTED_RE.search(self._recent) or CONNECTED_CHG_RE.search(self._recent)):
            self.log_lines.append("[pair] Connected!")
            self.status_msg = f"OK Paired + connected to {self._pair_addr}"
            self._stop_pair()
        if self._pair_state == "connecting" and \
                re.search(r"Failed to connect|br-connection", self._recent, re.IGNORECASE):
            self.log_lines.append("[pair] Connect failed (OK if paired)")
            _, info = btctl_simple("info", self._pair_addr or "")
            if "Paired: yes" in info:
                self.status_msg = "OK Paired. Press Enter to connect."
            else:
                self.status_msg = "Pairing may have failed."
            self._stop_pair()
        if re.search(r"Failed to pair|authentication\s*failed|authentication\s*timeout",
                      self._recent, re.IGNORECASE):
            self._pair_state = "error"
            self.status_msg = "Pairing failed. Try again."
            self.log_lines.append("[pair] FAILED")
            self._stop_pair()
        if self._pair_started_at and time.monotonic() - self._pair_started_at > 60:
            self.log_lines.append("[pair] Timeout")
            _, info = btctl_simple("info", self._pair_addr or "")
            if "Paired: yes" in info:
                self.status_msg = "OK Paired (timeout). Press Enter to connect."
            else:
                self.status_msg = "Pairing timed out. Try again."
            self._stop_pair()
        if self._pair_state == "connecting" and self._connect_started_at and \
                time.monotonic() - self._connect_started_at > 20:
            self.log_lines.append("[pair] Connect timeout")
            _, info = btctl_simple("info", self._pair_addr or "")
            if "Paired: yes" in info:
                self.status_msg = "OK Paired. Press Enter to connect."
            else:
                self.status_msg = "Connect timed out. Try again."
            self._stop_pair()

    def _do_trust_connect(self):
        addr = self._pair_addr
        if not addr:
            return
        self.pin_prompt = None
        self.confirm_prompt = None
        self._recent = ""
        self._line_buf = ""
        _, fd = self._pair_proc or (0, None)
        if fd:
            send(fd, f"trust {addr}")
            send(fd, f"connect {addr}")
        self._pair_state = "connecting"
        self._connect_started_at = time.monotonic()
        self.status_msg = "Trusting + connecting..."

    def _stop_pair(self):
        if self._pair_proc:
            pid, fd = self._pair_proc
            send(fd, "quit")
            try:
                os.close(fd)
            except OSError:
                pass
            try:
                os.waitpid(pid, os.WNOHANG)
            except ChildProcessError:
                pass
            self._pair_proc = None
        if self.busy:
            if self._pair_addr:
                _, info = btctl_simple("info", self._pair_addr)
                if "Connected: yes" in info:
                    self.status_msg = f"OK Connected to {self._pair_addr}"
                elif "Paired: yes" in info:
                    self.status_msg = "Paired but not connected. Press Enter to connect."
                else:
                    self.status_msg = "Not paired."
            self.busy = False
        self._pair_addr = None
        self.pin_prompt = None
        self.confirm_prompt = None
        self.refresh_devices()
        self.refresh_adapter()

    # ── disconnect / forget / untrust ──

    def do_disconnect(self, addr: str):
        self.status_msg = "Disconnecting..."
        btctl_simple("disconnect", addr, timeout=15)
        self.refresh_devices()
        self.refresh_adapter()
        self.status_msg = "Disconnected."

    def do_forget(self, addr: str):
        self.status_msg = "Removing..."
        btctl_simple("remove", addr, timeout=10)
        self.refresh_devices()
        self.refresh_adapter()
        self.status_msg = "Device removed."

    def do_connect_only(self, addr: str):
        self.status_msg = "Connecting..."
        code, _ = btctl_simple("connect", addr, timeout=20)
        self.refresh_devices()
        self.refresh_adapter()
        _, info = btctl_simple("info", addr)
        if "Connected: yes" in info:
            self.status_msg = "OK Connected."
        else:
            self.status_msg = "Connection failed."

    def do_toggle_trust(self, addr: str):
        _, info = btctl_simple("info", addr)
        if "Trusted: yes" in info:
            btctl_simple("untrust", addr, timeout=5)
            self.status_msg = "Untrusted."
        else:
            btctl_simple("trust", addr, timeout=5)
            self.status_msg = "Trusted."
        self.refresh_devices()

    # ── input ──

    def _handle_input(self):
        key = self.stdscr.getch()
        if key == -1:
            return
        if key in (ord("q"), 27):
            self._quit = True
        elif key == ord("s"):
            if self.scanning:
                self._stop_scan()
                self.refresh_devices()
                self.refresh_adapter()
                self.status_msg = "Scan stopped."
            else:
                self.start_scan()
        elif key in (ord("j"), curses.KEY_DOWN):
            self._move_sel(1)
        elif key in (ord("k"), curses.KEY_UP):
            self._move_sel(-1)
        elif key == ord("\t"):           # Tab
            self._focus_next()
        elif key == curses.KEY_BTAB:     # Shift+Tab
            self._focus_prev()
        elif key == ord("l"):
            self._focus_next()
        elif key == ord("h"):
            self._focus_prev()
        elif key == ord("\n") or key == curses.KEY_ENTER:
            self._action_enter()
        elif key == ord("d"):
            self._action_disconnect()
        elif key == ord("f"):
            self._action_forget()
        elif key == ord("u"):
            self._action_unpair()
        elif key == ord("t"):
            self._action_toggle_trust()

    def _move_sel(self, delta: int):
        if self.focus == F_ADAPTER:
            return
        if self.focus == F_PAIRED:
            total = len(self._paired_devices())
        elif self.focus == F_DISCOVERED:
            total = len(self._discovered_devices())
        else:
            return
        if total <= 0:
            return
        # self.selected is always a local index within the focused section
        self.selected = max(0, min(self.selected + delta, total - 1))

    def _focus_next(self):
        sections = [F_PAIRED]
        if self._has_discovered():
            sections.append(F_DISCOVERED)
        sections.append(F_ADAPTER)
        if self.focus not in sections:
            self.focus = F_PAIRED
        i = sections.index(self.focus)
        self.focus = sections[(i + 1) % len(sections)]
        self.selected = 0

    def _focus_prev(self):
        sections = [F_PAIRED]
        if self._has_discovered():
            sections.append(F_DISCOVERED)
        sections.append(F_ADAPTER)
        if self.focus not in sections:
            self.focus = F_PAIRED
        i = sections.index(self.focus)
        self.focus = sections[(i - 1) % len(sections)]
        self.selected = 0

    def _focused_global_selected(self) -> int:
        """Return the global devices index for the currently selected item."""
        if self.focus == F_PAIRED:
            return self.selected
        if self.focus == F_DISCOVERED:
            return len(self._paired_devices()) + self.selected
        return 0

    def _action_enter(self):
        if self.focus == F_ADAPTER:
            return
        devs = self._focused_devices()
        if not devs or self.busy:
            return
        idx = self._focused_global_selected()
        d = self.devices[idx]
        if d["status"] == "connected":
            self.do_disconnect(d["addr"])
        elif d["status"] == "paired":
            self.do_connect_only(d["addr"])
        else:
            self.start_pair(d["addr"], d["name"])

    def _action_disconnect(self):
        if self.focus == F_ADAPTER:
            return
        idx = self._focused_global_selected()
        if idx >= len(self.devices) or self.busy:
            return
        d = self.devices[idx]
        if d["status"] == "connected":
            self.do_disconnect(d["addr"])

    def _action_forget(self):
        if self.focus == F_ADAPTER:
            return
        idx = self._focused_global_selected()
        if idx >= len(self.devices) or self.busy:
            return
        self.do_forget(self.devices[idx]["addr"])

    def _action_unpair(self):
        if self.focus == F_ADAPTER:
            return
        idx = self._focused_global_selected()
        if idx >= len(self.devices) or self.busy:
            return
        d = self.devices[idx]
        if d["status"] != "available":
            self.do_forget(d["addr"])

    def _action_toggle_trust(self):
        if self.focus == F_ADAPTER:
            return
        if self.focus != F_PAIRED:
            return
        idx = self._focused_global_selected()
        if idx >= len(self.devices) or self.busy:
            return
        d = self.devices[idx]
        if d["status"] != "available":
            self.do_toggle_trust(d["addr"])

    # ── poll ──

    def _poll(self):
        self._poll_scan()
        self._poll_pair()

    # ── drawing (layout mirrors bluetui / ratatui) ──

    def _draw(self):
        h, w = self.stdscr.getmaxyx()
        self.stdscr.erase()
        if h < 12 or w < 40:
            try:
                self.stdscr.addnstr(0, 0, "Terminal too small (min 40x12)", w)
            except curses.error:
                pass
            self.stdscr.refresh()
            return
        margin = 1
        hero_h = 2

        paired = self._paired_devices()
        discovered = self._discovered_devices()
        # bluetui only shows the new-devices panel while scanning
        has_disc = self.scanning

        # Heights match bluetui: adapters = len+4, paired = len+4 when scanning else Fill
        adapter_h = 1 + 4  # one adapter row + header/margin/borders ≈ controllers.len + 4
        help_h = 0
        usable = h - hero_h - margin * 2 + 1

        if has_disc:
            paired_raw = min(len(paired) + 4, max(4, usable // 3))
            paired_h = max(4, paired_raw - 1)
            remaining = usable - paired_raw - adapter_h - help_h
            disc_h = max(4, remaining)
        else:
            disc_h = 0
            paired_h = max(4, usable - adapter_h - help_h - 1)

        # Clamp so nothing overflows
        total = paired_h + disc_h + adapter_h + help_h
        if total > usable:
            overflow = total - usable
            if disc_h > 4:
                cut = min(overflow, disc_h - 4)
                disc_h -= cut
                overflow -= cut
            if overflow > 0 and paired_h > 4:
                paired_h = max(4, paired_h - overflow)

        y = margin + hero_h - 1
        box_w = w - margin * 2

        # ── Hero ──
        S.draw_hero(self.stdscr, self._hero_info())

        # ── Paired Devices (fills most of the screen when not scanning) ──
        S.draw_focus_border(self.stdscr, self.focus == F_PAIRED, y, margin, paired_h, box_w, "Paired Devices")
        self._draw_paired_table(y + 1, margin + 1, paired_h - 2, box_w - 2, paired)
        y += paired_h

        # ── Discovered / Scanning ──
        if has_disc and disc_h >= 4:
            spin = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"[self._tick % 10]
            title = f"Scanning {spin}" if self.scanning else "Discovered devices"
            S.draw_focus_border(self.stdscr, self.focus == F_DISCOVERED, y, margin, disc_h, box_w, title)
            self._draw_discovered_table(y + 1, margin + 1, disc_h - 2, box_w - 2, discovered)
            y += disc_h

        # ── Adapter (fixed at bottom, above help) ──
        S.draw_focus_border(self.stdscr, self.focus == F_ADAPTER, y, margin, adapter_h, box_w, "Adapter")
        self._draw_adapter_table(y + 1, margin + 1, adapter_h - 2, box_w - 2)
        y += adapter_h

        # ── Help bar ──
        if self.focus == F_PAIRED:
            gen = [("arrows", "navigate"), ("tab", "section"), ("q", "quit"), ("r", "refresh")]
            tool = [("enter", "dis/connect"), ("s", "scan on/off"), ("u", "unpair"), ("t", "un/trust"), ("f", "forget")]
        elif self.focus == F_DISCOVERED:
            gen = [("arrows", "navigate"), ("tab", "section"), ("q", "quit"), ("r", "refresh")]
            tool = [("enter", "pair"), ("s", "scan on/off")]
        else:
            gen = [("arrows", "navigate"), ("tab", "section"), ("q", "quit"), ("r", "refresh")]
            tool = [("s", "scan on/off")]
        S.draw_help_bar(self.stdscr, gen, tool)

        # ── PIN / confirm overlay ──
        if self.pin_prompt or self.confirm_prompt:
            self._draw_prompt(h, w)



        self.stdscr.refresh()




    def _draw_paired_table(self, y, x, h, w, paired: list[dict]):
        """Render Paired Devices table (10 cols: fav | name | addr | trusted | conn | batt | type | blocked | rssi | hci)."""
        if h < 1 or w < 8:
            return
        # Balanced column distribution: base widths that work well together
        star_w = 1
        name_base = 10
        addr_base = 13      # truncated MAC still unique
        trusted_w = 7
        connected_w = 8
        battery_w = 7
        type_base = 9
        blocked_w = 7
        rssi_w = 7
        adapter_w = 5
        base_total = (star_w + name_base + addr_base + trusted_w + connected_w
                      + battery_w + type_base + blocked_w + rssi_w + adapter_w)  # 74

        extra = w - base_total
        if extra >= 0:
            # Distribute proportionally: name 50%, address 30%, type 20%
            add_name = extra * 5 // 10
            add_addr = extra * 3 // 10
            add_type = extra - add_name - add_addr
            widths = [star_w, name_base + add_name, addr_base + add_addr,
                      trusted_w, connected_w, battery_w, type_base + add_type,
                      blocked_w, rssi_w, adapter_w]
            # Adjust rounding: add/subtract leftover from name
            diff = w - sum(widths)
            if diff:
                widths[1] += diff
        else:
            # Shrink from base on narrow terminals
            widths = [star_w, name_base, addr_base, trusted_w, connected_w,
                      battery_w, type_base, blocked_w, rssi_w, adapter_w]
            while sum(widths) > w:
                if widths[1] > 6:         # Name
                    widths[1] -= 1
                elif widths[6] > 5:       # Type
                    widths[6] -= 1
                elif widths[2] > 8:       # Address
                    widths[2] -= 1
                elif widths[4] > 5:       # Connected
                    widths[4] -= 1
                elif widths[5] > 4:       # Battery
                    widths[5] -= 1
                elif widths[7] > 4:       # Blocked
                    widths[7] -= 1
                elif widths[8] > 4:       # RSSI
                    widths[8] -= 1
                elif widths[3] > 4:       # Trusted
                    widths[3] -= 1
                elif widths[9] > 3:       # HCI
                    widths[9] -= 1
                else:
                    break

        headers = ["", "Name", "Address", "Trustd", "Conn.", "Batt.", "Type", "Blockd", "RSSI", "HCI"]
        total_w = sum(widths)
        margin = (w - total_w) // 2
        offsets = [margin]
        for cw in widths[:-1]:
            offsets.append(offsets[-1] + cw)

        focused = self.focus == F_PAIRED
        S.draw_row(self.stdscr, y, x, w, headers, widths, offsets, S.header_attr(focused))
        row_start = y + 2 if h >= 3 else y + 1
        max_rows = max(0, (y + h) - row_start)

        for i, d in enumerate(paired[:max_rows]):
            is_sel = focused and i == self.selected
            attr = S.sel_attr(is_sel, focused)
            fav = "★" if d.get("favorite") else ""
            name = f"{d.get('icon', ICON_UNKNOWN)} {d['name']}"
            cells = [
                fav,
                name,
                d["addr"],
                "true" if d.get("trusted") else "false",
                "true" if d["status"] == "connected" else "false",
                d.get("battery", ""),
                d.get("type_label", ""),
                d.get("blocked", ""),
                d.get("rssi", ""),
                d.get("adapter", ""),
            ]
            S.draw_row(self.stdscr, row_start + i, x, w, cells, widths, offsets, attr)

    def _draw_discovered_table(self, y, x, h, w, discovered: list[dict]):
        if h < 1 or w < 8:
            return
        headers = ["Address", "Name"]
        widths = [20, min(20, max(10, w - 24))]
        while sum(widths) > w and widths[1] > 8:
            widths[1] -= 1

        focused = self.focus == F_DISCOVERED
        S.put_row_cells(self.stdscr, y, x, w, headers, widths, S.header_attr(focused))
        row_start = y + 2 if h >= 3 else y + 1
        max_rows = max(0, (y + h) - row_start)

        for i, d in enumerate(discovered[:max_rows]):
            is_sel = focused and i == self.selected
            attr = S.sel_attr(is_sel, focused)
            name = f"{d.get('icon', ICON_UNKNOWN)} {d['name']}"
            S.put_row_cells(self.stdscr, row_start + i, x, w, [d["addr"], name], widths, attr)

    def _draw_adapter_table(self, y, x, h, w):
        if h < 1 or w < 8:
            return
        # bluetui widths: 10, 10, 5, 8, 12
        headers = ["Name", "Alias", "Power", "Pairable", "Discoverable"]
        widths = [10, 10, 5, 8, 12]
        while sum(widths) > w and widths[1] > 4:
            widths[1] -= 1

        focused = self.focus == F_ADAPTER
        S.put_row_cells(self.stdscr, y, x, w, headers, widths, S.header_attr(focused))
        if h < 3:
            return
        # blank line under header (bottom_margin 1)
        if self.adapter_info:
            a = self.adapter_info
            cells = [
                a.get("name", ""),
                a.get("alias", ""),
                a.get("powered", ""),
                a.get("pairable", ""),
                a.get("discoverable", ""),
            ]
            attr = S.sel_attr(True, focused) if focused else curses.A_NORMAL
            S.put_row_cells(self.stdscr, y + 2, x, w, cells, widths, attr)


    def _draw_prompt(self, h: int, w: int):
        if self.pin_prompt:
            lines = [
                "┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓",
                "┃       PIN Code from device       ┃",
                f"┃         {self.pin_prompt:>10}          ┃",
                "┃ Type this on your keyboard + Enter┃",
                "┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛",
            ]
        else:
            lines = [
                "┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓",
                "┃        Confirm Passkey           ┃",
                f"┃         {self.confirm_prompt:>10}          ┃",
                "┃     Auto-confirming...           ┃",
                "┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛",
            ]
        S.draw_dialog(self.stdscr, lines)


# ── main ──────────────────────────────────────────────────────────────

def _force_narrow_ambiguous_locale():
    """Must run before curses.initscr(). Delegates to shared setup."""
    S.setup_locale()


def main():
    ok, err = require_python()
    if not ok:
        print(err, file=sys.stderr)
        return 1
    # Stable tool output + single-cell box glyphs on CJK systems
    os.environ.setdefault("LC_ALL", "C.UTF-8")
    os.environ.setdefault("LANG", "C.UTF-8")
    _force_narrow_ambiguous_locale()
    ok, err = ensure_bluetoothctl()
    if not ok:
        print(err, file=sys.stderr)
        return 1
    prepare_bluetooth()
    try:
        return curses.wrapper(lambda stdscr: BluetoothTUI(stdscr).run())
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    sys.exit(main())
