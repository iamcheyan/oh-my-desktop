#!/usr/bin/env bash
set -euo pipefail

cmd="$(basename "$0")"
repo="${OMD_ROOT:-$HOME/.config/omd}"
# Legacy Omarchy scripts call one another by their original omarchy-* names.
# Keep both the OMD wrappers and the vendored legacy command directory visible
# so transitive calls work in Hyprland/systemd environments with a minimal PATH.
export PATH="$repo/bin:$repo/share/bin:$PATH"
if [[ -r "$repo/scripts/omd-path.sh" ]]; then
  # shellcheck source=/dev/null
  . "$repo/scripts/omd-path.sh"
fi

case "$cmd" in
  omd-keyboard-*) legacy="omarchy-${cmd#omd-}" ;;
  omd-voice-*) legacy="omarchy-${cmd#omd-}" ;;
  omd-theme-*) legacy="omarchy-${cmd#omd-}" ;;
  omd-paste-at-cursor) legacy="omarchy-paste-at-cursor" ;;
  omd-launch-tui) legacy="omarchy-launch-tui" ;;
  omd-launch-floating-terminal-with-presentation) legacy="omarchy-launch-floating-terminal-with-presentation" ;;
  omd-launch-screensaver) legacy="omarchy-launch-screensaver" ;;
  omd-lock) legacy="omarchy-system-lock" ;;
  omd-logout) legacy="omarchy-system-logout" ;;
  omd-reboot) legacy="omarchy-system-reboot" ;;
  omd-shutdown) legacy="omarchy-system-shutdown" ;;
  omd-wake) legacy="omarchy-system-wake" ;;
  omd-font-current) legacy="omarchy-font-current" ;;
  omd-windows-vm) legacy="omarchy-windows-vm" ;;
  omd-*) legacy="omarchy-${cmd#omd-}" ;;
  *) echo "No legacy mapping for $cmd" >&2; exit 127 ;;
esac

target="$repo/share/bin/$legacy"

if [[ "$cmd" == omd-voice-* ]]; then
  for lib_name in libstdc++.so.6 libz.so.1; do
    lib_dir="$(find /nix/store -path "*/lib/$lib_name" -print -quit 2>/dev/null | xargs -r dirname || true)"
    if [[ -n "${lib_dir:-}" ]]; then
      case ":${LD_LIBRARY_PATH:-}:" in
        *:"$lib_dir":*) ;;
        *) export LD_LIBRARY_PATH="$lib_dir${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" ;;
      esac
    fi
  done
fi

if [[ "$cmd" == "omd-voice-transcribe" ]]; then
  venv_python="${OMD_VOICE_VENV:-$HOME/.cache/omd-voice/venv}/bin/python3"
  if [[ ! -x "$venv_python" ]]; then
    echo "voice venv missing: run omd-voice-setup" >&2
    exit 1
  fi
  exec "$venv_python" "$target" "$@"
fi

case "$(head -n 1 "$target" 2>/dev/null || true)" in
  "#!/bin/bash"|*"env bash"*)
    exec bash "$target" "$@"
    ;;
  *)
    exec "$target" "$@"
    ;;
esac
