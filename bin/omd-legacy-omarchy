#!/usr/bin/env bash
set -euo pipefail

cmd="$(basename "$0")"
repo="${OMD_ROOT:-$HOME/.config/omd}"
export PATH="$repo/bin:$PATH"

case "$cmd" in
  omd-keyboard-*) legacy="omarchy-${cmd#omd-}" ;;
  omd-voice-*) legacy="omarchy-${cmd#omd-}" ;;
  omd-theme-*) legacy="omarchy-${cmd#omd-}" ;;
  omd-paste-at-cursor) legacy="omarchy-paste-at-cursor" ;;
  omd-launch-tui) legacy="omarchy-launch-tui" ;;
  omd-launch-floating-terminal-with-presentation) legacy="omarchy-launch-floating-terminal-with-presentation" ;;
  omd-launch-screensaver) legacy="omarchy-launch-screensaver" ;;
  omd-lock) legacy="omarchy-system-lock" ;;
  omd-logout) legacy="omarchy-system-logout" ;;
  omd-reboot) legacy="omarchy-system-reboot" ;;
  omd-shutdown) legacy="omarchy-system-shutdown" ;;
  omd-wake) legacy="omarchy-system-wake" ;;
  omd-font-current) legacy="omarchy-font-current" ;;
  omd-windows-vm) legacy="omarchy-windows-vm" ;;
  omd-*) legacy="omarchy-${cmd#omd-}" ;;
  *) echo "No legacy mapping for $cmd" >&2; exit 127 ;;
esac

exec "$repo/share/bin/$legacy" "$@"
