#!/usr/bin/env bash
# OMD Backup backend — mount.cifs + rsync
# Mounts SMB share locally, then uses rsync for fast incremental sync.
set -euo pipefail

OMD_ROOT="${OMD_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
. "$OMD_ROOT/lib/paths.sh"

# Canonical paths (Sumika Shell)
CONFIG_DIR="${SUMIKA_SHELL_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/sumika-shell}/file-share-backup"
STATE_DIR="${SUMIKA_SHELL_STATE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}/sumika-shell}/file-share-backup"

# Legacy fallback paths for reads (removed in Phase 7)
_LEGACY_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omd/file-share-backup"
_LEGACY_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omd/file-share-backup"

# Copy legacy data to the canonical location if central migration has not run.
# Keep the source intact until the explicit migration cleanup phase.
if [[ -d "$_LEGACY_CONFIG_DIR" && ! -d "$CONFIG_DIR" ]]; then
  mkdir -p "$(dirname "$CONFIG_DIR")"
  cp -a "$_LEGACY_CONFIG_DIR" "$CONFIG_DIR" 2>/dev/null || true
fi
if [[ -d "$_LEGACY_STATE_DIR" && ! -d "$STATE_DIR" ]]; then
  mkdir -p "$(dirname "$STATE_DIR")"
  cp -a "$_LEGACY_STATE_DIR" "$STATE_DIR" 2>/dev/null || true
fi

CONFIG_FILE="$CONFIG_DIR/config.json"
CREDS_FILE="$STATE_DIR/.smbcreds"

mkdir -p "$CONFIG_DIR" "$STATE_DIR"
find "$CONFIG_DIR" -type d -exec chmod 755 {} +
find "$STATE_DIR" -type d -exec chmod 700 {} +

usage() {
  cat >&2 <<'EOF'
Usage: omd-backup {mount|unmount|test|backup|compare|list|status|save-config|load-config}

  mount       Mount SMB share (keeps mounted for browsing/sync)
  unmount     Unmount the share
  test        Test connection + mount share
  backup      Rsync local files to mounted share
  compare     Rsync --dry-run to show pending changes
  list        Browse mounted files in terminal
  status      Show mount/config status
  save-config Write config from stdin
  load-config Print current config JSON
EOF
  exit 2
}

cmd="${1:-}"; shift || true

# ── helpers ────────────────────────────────────────────────────────────

load_config() {
  # Read from sumika.json first, then overlay old config.json
  local sumika_json="${SUMIKA_SHELL_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/sumika-shell}/sumika.json"
  local merged="{}"
  if [[ -f "$sumika_json" ]] && command -v jq >/dev/null 2>&1; then
    merged=$(jq '.backup | {address,share,user,remotePath,localPaths,includeExt,excludeExt,scheduleType,scheduleValue} | .localPath = (.localPaths // []) | del(.localPaths)' "$sumika_json" 2>/dev/null || echo "{}")
  fi
  # Overlay with old config.json if it exists (takes precedence for migration)
  if [[ -f "$CONFIG_FILE" ]]; then
    merged=$(echo "$merged" | jq -c ". * $(cat "$CONFIG_FILE")" 2>/dev/null || cat "$CONFIG_FILE")
  elif [[ -f "$_LEGACY_CONFIG_DIR/config.json" ]]; then
    merged=$(echo "$merged" | jq -c ". * $(cat "$_LEGACY_CONFIG_DIR/config.json")" 2>/dev/null || cat "$_LEGACY_CONFIG_DIR/config.json")
  fi
  echo "$merged"
}

save_config() {
  cat > "$CONFIG_FILE"
  echo "Config saved"
}

have() { command -v "$1" >/dev/null 2>&1; }

mount_point() {
  local share
  share=$(echo "$1" | jq -r '.share // "smb"')
  echo "$HOME/$share"
}

write_creds() {
  local user="$1" pass="$2"
  cat > "$CREDS_FILE" <<EOF
username=$user
password=$pass
domain=WORKGROUP
EOF
  chmod 600 "$CREDS_FILE"
}

# ── mount / unmount ───────────────────────────────────────────────────

do_mount() {
  local data="$1"
  local addr share remote_path mnt
  addr=$(echo "$data" | jq -r '.address // ""')
  share=$(echo "$data" | jq -r '.share // ""')
  remote_path=$(echo "$data" | jq -r '.remotePath // "Backups"')
  mnt=$(mount_point "$data")

  if [[ -z "$addr" || -z "$share" ]]; then
    echo '{"ok":false,"error":"Server address or share not configured"}'
    return 1
  fi

  # Already mounted?
  if mountpoint -q "$mnt" 2>/dev/null; then
    echo "MOUNT_OK:$mnt"
    echo "$mnt"
    return 0
  fi

  # Write credentials
  local user pass
  user=$(echo "$data" | jq -r '.user // ""')
  pass=$(echo "$data" | jq -r '.password // ""')
  write_creds "$user" "$pass"

  mkdir -p "$mnt"

  # Check prerequisites
  if ! have mount.cifs; then
    echo "MOUNT_NEED_INSTALL"
    echo ""
    echo "  mount.cifs not found — install cifs-utils:"
    echo "    Arch:    sudo pacman -S cifs-utils"
    echo "    Debian:  sudo apt install cifs-utils"
    echo "    Fedora:  sudo dnf install cifs-utils"
    return 1
  fi

  # Try direct mount first (may work if user has cap_sys_admin or FUSE cifs)
  local err
  err=$(mount.cifs "//$addr/$share" "$mnt" \
    -o "credentials=$CREDS_FILE,uid=$(id -u),gid=$(id -g),vers=3.0,mfsymlinks,nounix,serverino,noperm" 2>&1) || true

  if mountpoint -q "$mnt" 2>/dev/null; then
    echo "MOUNT_OK:$mnt"
    echo "$mnt"
    return 0
  fi

  # Permission denied → try pkexec (polkit popup)
  if echo "$err" | grep -qiE "permission denied|operation not permitted|not authorized|not installed setuid"; then
    if have pkexec; then
      echo "MOUNT_NEED_POLKIT"
      echo "  Requesting administrator privileges to mount SMB share…"
      local pk_err rc
      pk_err=$(pkexec bash -c "
        mkdir -p '$mnt'
        mount.cifs '//$addr/$share' '$mnt' \
          -o 'credentials=$CREDS_FILE,uid=$(id -u),gid=$(id -g),vers=3.0,mfsymlinks,nounix,serverino,noperm'
      " 2>&1) && rc=0 || rc=$?
      if mountpoint -q "$mnt" 2>/dev/null; then
        echo "MOUNT_OK:$mnt"
        echo "$mnt"
        return 0
      else
        if [[ $rc -eq 126 || $rc -eq 127 ]]; then
          echo '{"ok":false,"error":"Polkit authorization failed or cancelled"}'
        else
          local clean_err
          clean_err=$(echo "$pk_err" | grep -v "pam_systemd" | head -1 | tr -d '\n\r')
          echo "{\"ok\":false,\"error\":\"Mount failed: ${clean_err:-unknown error}\"}"
        fi
        return 1
      fi
    else
      echo "MOUNT_NEED_INSTALL"
      echo ""
      echo "  mount.cifs needs root privileges."
      echo ""
      echo "  Option 1 — Install polkit for auto-elevation:"
      echo "    Arch:    sudo pacman -S polkit"
      echo "    Debian:  sudo apt install policykit-1"
      echo "    Fedora:  sudo dnf install polkit"
      echo "    (Then connect via TUI — polkit will pop up a password dialog)"
      echo ""
      echo "  Option 2 — Grant setcap capability (one-time, no dialog):"
      echo "    sudo setcap cap_sys_admin+ep /sbin/mount.cifs"
      echo "    (This allows mount.cifs to run directly without elevation)"
      echo ""
      echo "  Option 3 — Mount once with sudo:"
      echo "    sudo mount.cifs //$addr/$share $mnt -o credentials=$CREDS_FILE,uid=$(id -u),gid=$(id -g)"
      return 1
    fi
  fi

  # Other errors
  echo "MOUNT_FAILED:$err"
  if echo "$err" | grep -qi "NT_STATUS_LOGON_FAILURE"; then
    echo '{"ok":false,"error":"Login failed — check username/password"}'
  elif echo "$err" | grep -qi "NT_STATUS_CONNECTION_REFUSED\|No route to host\|Connection timed out"; then
    echo '{"ok":false,"error":"Cannot reach server — check address"}'
  elif echo "$err" | grep -qi "NT_STATUS_HOST_UNREACHABLE\|host unreachable"; then
    echo '{"ok":false,"error":"Host unreachable"}'
  else
    echo "{\"ok\":false,\"error\":\"$(echo "$err" | head -1 | tr -d '\n\r')\"}"
  fi
  return 1
}

do_unmount() {
  local data="$1"
  local mnt
  mnt=$(mount_point "$data")
  if mountpoint -q "$mnt" 2>/dev/null; then
    umount "$mnt" 2>/dev/null || true
    rmdir "$mnt" 2>/dev/null || true
    echo "Unmounted $mnt"
  else
    echo "Not mounted"
  fi
}

# ── main ───────────────────────────────────────────────────────────────
get_mount_line() {
  local out="$1"
  if echo "$out" | grep -q "^MOUNT_OK"; then
    echo "$out" | grep "^MOUNT_OK" | head -1
  else
    echo "$out" | grep "^MOUNT_" | head -1
  fi
}

case "$cmd" in
  mount)
    data=$(load_config)
    output=$(do_mount "$data") || true
    mount_line=$(get_mount_line "$output")
    if echo "$mount_line" | grep -q "^MOUNT_OK"; then
      mnt=$(echo "$mount_line" | sed 's/^MOUNT_OK://')
      echo "Mounted at $mnt"
    elif echo "$mount_line" | grep -q "^MOUNT_NEED_POLKIT"; then
      echo "Authorization requested — check polkit dialog"
    elif echo "$mount_line" | grep -q "^MOUNT_NEED_INSTALL"; then
      echo "$output" | grep -v "^MOUNT_"
    elif echo "$mount_line" | grep -q "^MOUNT_FAILED"; then
      echo "$output" | grep -v "^MOUNT_" | head -1
    else
      echo "Mount failed"
    fi
    ;;

  unmount)
    data=$(load_config)
    do_unmount "$data"
    ;;

  test)
    data=$(load_config)
    addr=$(echo "$data" | jq -r '.address // ""')
    share=$(echo "$data" | jq -r '.share // ""')
    if [[ -z "$addr" || -z "$share" ]]; then
      echo '{"ok":false,"error":"Server not configured"}'
      exit 0
    fi

    echo "Testing connection to $addr/$share..."
    mnt=$(mount_point "$data")
    echo "  Target share: //$addr/$share"
    echo "  Mount point:  $mnt"
    if mountpoint -q "$mnt" 2>/dev/null; then
      echo "  Already mounted ✓"
    else
      echo "  Attempting to mount..."
    fi
    if [[ -f "$CREDS_FILE" ]]; then
      echo "  Credentials:  saved"
    fi
    echo ""
    output=$(do_mount "$data") || true
    mount_line=$(get_mount_line "$output")

    if echo "$mount_line" | grep -q "^MOUNT_OK"; then
      mnt=$(echo "$mount_line" | sed 's/^MOUNT_OK://')
      echo "  Connected ✓ — mounted at $mnt"
      echo "{\"ok\":true,\"mount\":\"$mnt\"}"
    elif echo "$mount_line" | grep -q "^MOUNT_NEED_POLKIT"; then
      echo "  Authorization requested via polkit…"
      # do_mount already ran pkexec; check result again
      # mount_line is from do_mount — already handled
      # Check actual result
      final_line=$(echo "$output" | tail -1)
      if echo "$final_line" | grep -q '"ok":true'; then
        echo "$final_line"
      else
        echo "$final_line"
      fi
    elif echo "$mount_line" | grep -q "^MOUNT_NEED_INSTALL"; then
      echo "  Need privileged mount access for SMB shares."
      echo ""
      echo "  Make sure cifs-utils is installed:"
      echo "    Arch:    sudo pacman -S cifs-utils"
      echo "    Debian:  sudo apt install cifs-utils"
      echo "    Fedora:  sudo dnf install cifs-utils"
      echo ""
      echo "  Then choose one:"
      echo ""
      echo "  [A] Install polkit — auto popup via TUI (recommended)"
      echo "    Arch:    sudo pacman -S polkit"
      echo "    Debian:  sudo apt install policykit-1"
      echo "    Fedora:  sudo dnf install polkit"
      echo ""
      echo "  [B] Grant setcap — no dialog needed"
      echo "    sudo setcap cap_sys_admin+ep /sbin/mount.cifs"
      echo ""
      echo "  [C] Mount manually once (stays until reboot):"
      echo "    sudo mount.cifs //$addr/$share $mnt -o credentials=$CREDS_FILE,uid=$(id -u),gid=$(id -g)"
      echo '{"ok":false,"error":"mount.cifs not set up for user (see instructions above)"}'
    elif echo "$mount_line" | grep -q "^MOUNT_FAILED"; then
      # The error JSON is already output after MOUNT_FAILED
      err_line=$(echo "$output" | grep '{"ok":false' | head -1)
      if [[ -n "$err_line" ]]; then
        echo "$err_line"
      else
        echo '{"ok":false,"error":"Mount failed"}'
      fi
    else
      echo '{"ok":false,"error":"Unknown mount error"}'
    fi
    ;;

  backup)
    data=$(load_config)
    # Check for delete flag
    delete_flag=0
    if [[ "${1:-}" == "--delete" ]]; then
      delete_flag=1
    fi
    local_paths=$(echo "$data" | jq -r 'if .localPath | type == "array" then .localPath[] else .localPath end // ""')
    remote_path=$(echo "$data" | jq -r '.remotePath // "Backups"')
    include_ext=$(echo "$data" | jq -r '.includeExt // ""')
    exclude_ext=$(echo "$data" | jq -r '.excludeExt // ""')

    if [[ -z "$local_paths" ]]; then
      echo '{"ok":false,"error":"No local paths configured"}'
      exit 0
    fi

    # Ensure mounted
    output=$(do_mount "$data") || true
    mount_line=$(get_mount_line "$output")
    if ! echo "$mount_line" | grep -q "^MOUNT_OK"; then
      # Mount failed — print the error JSON if present
      err_line=$(echo "$output" | grep '{"ok":false' | head -1)
      if [[ -n "$err_line" ]]; then
        echo "$err_line"
      else
        echo '{"ok":false,"error":"Cannot mount share before backup"}'
      fi
      exit 0
    fi
    mnt=$(echo "$mount_line" | sed 's/^MOUNT_[^:]*://')

    host_prefix="$(uname -s)-$(hostname)"
    remote_base="${mnt}/${remote_path}/${host_prefix}"

    # Ensure host prefix directory exists
    mkdir -p "$remote_base"

    echo "Backup starting"
    start=$(date +%s)
    rsync_opts=(-a --modify-window=2 --no-owner --no-group --no-perms -v)

    # Build filter rules from config
    filter_file="$STATE_DIR/.rsync-filter"
    rm -f "$filter_file"
    if [[ -n "$include_ext" ]]; then
      IFS=',' read -ra exts <<< "$include_ext"
      for ext in "${exts[@]}"; do
        ext=$(echo "$ext" | xargs)
        echo "+ *${ext}" >> "$filter_file"
      done
      echo '- *' >> "$filter_file"
    fi
    if [[ -n "$exclude_ext" ]]; then
      IFS=',' read -ra exts <<< "$exclude_ext"
      for ext in "${exts[@]}"; do
        ext=$(echo "$ext" | xargs)
        echo "- *${ext}" >> "$filter_file"
      done
    fi
    if [[ -f "$filter_file" ]]; then
      rsync_opts+=(--filter="merge $filter_file")
    fi

    # Full sync: delete remote files not present locally
    if [[ "$delete_flag" -eq 1 ]]; then
      rsync_opts+=(--delete)
      echo "Full sync mode (--delete)"
    fi

    total_files=0
    while read -r local_path; do
      [[ -z "$local_path" ]] && continue

      if [[ -f "$local_path" ]]; then
        base=$(basename "$local_path")
        echo "  sync $base"
        rsync "${rsync_opts[@]}" "$local_path" "$remote_base/" || echo "  FAILED: $base"
        total_files=$((total_files + 1))
      elif [[ -d "$local_path" ]]; then
        parent_dir=$(basename "$local_path")
        echo "  sync $parent_dir/"
        rsync "${rsync_opts[@]}" "$local_path/" "$remote_base/$parent_dir/" || echo "  FAILED: $parent_dir"
        total_files=$((total_files + $(find "$local_path" -type f | wc -l)))
      else
        echo "  SKIP (not found): $local_path"
      fi
    done <<< "$local_paths"

    rm -f "$filter_file"

    end=$(date +%s)
    elapsed=$((end - start))

    # Save per-item tracking
    time_fmt="$(date +%H:%M)"
    items_json="["
    first=true
    while read -r item_path; do
      [[ -z "$item_path" ]] && continue
      if [[ "$first" == true ]]; then first=false; else items_json+=","; fi
      if [[ -f "$item_path" ]]; then
        item_type="file"
      elif [[ -d "$item_path" ]]; then
        item_type="dir"
      else
        item_type="missing"
      fi
      items_json+="{\"path\":\"$item_path\",\"type\":\"$item_type\",\"last_backup\":\"$time_fmt\"}"
    done <<< "$local_paths"
    items_json+="]"
    echo "$items_json" > "$STATE_DIR/items.json"

    # Save MD5 cache for fast local compare (no remote access needed)
    md5_json="{"
    first_md5=true
    while read -r item_path; do
      [[ -z "$item_path" ]] && continue
      if [[ -f "$item_path" ]]; then
        h=$(md5sum "$item_path" | cut -d' ' -f1)
        [[ "$first_md5" == true ]] && first_md5=false || md5_json+=","
        md5_json+="\"$item_path\":\"$h\""
      elif [[ -d "$item_path" ]]; then
        while IFS= read -r f; do
          h=$(md5sum "$f" | cut -d' ' -f1)
          [[ "$first_md5" == true ]] && first_md5=false || md5_json+=","
          md5_json+="\"$f\":\"$h\""
        done < <(find "$item_path" -type f)
      fi
    done <<< "$local_paths"
    md5_json+="}"
    echo "$md5_json" > "$STATE_DIR/md5-cache.json"

    echo "Backup complete in ${elapsed}s"
    echo "{\"ok\":true,\"elapsed\":$elapsed}" > "$STATE_DIR/last-result.json"
    echo "{\"ok\":true,\"elapsed\":$elapsed}"
    ;;

  compare)
    data=$(load_config)
    verbose=false
    [[ "${1:-}" == "-v" || "${1:-}" == "--verbose" ]] && verbose=true
    local_paths=$(echo "$data" | jq -r 'if .localPath | type == "array" then .localPath[] else .localPath end // ""')
    CACHE_FILE="$STATE_DIR/md5-cache.json"

    cache_json=$(cat "$CACHE_FILE" 2>/dev/null || echo '{}')

    if [[ "$verbose" == false ]]; then
      echo "Comparing local files against last backup..."
      echo "  (MD5-based — no remote access needed)"
      echo ""
    fi

    # Walk all files, compute MD5
    CUR_FILE=$(mktemp)
    trap "rm -f $CUR_FILE" EXIT

    while read -r local_path; do
      [[ -z "$local_path" ]] && continue
      if [[ -f "$local_path" ]]; then
        md5sum "$local_path" | awk -v p="$local_path" -v pp="$local_path" '{print p "\t" $1 "\t" pp}' >> "$CUR_FILE"
      elif [[ -d "$local_path" ]]; then
        path_name=$(basename "$local_path")
        [[ "$verbose" == false ]] && echo "  Scanning $path_name/ ..."
        while IFS= read -r f; do
          md5sum "$f" | awk -v p="$f" -v pp="$local_path" '{print p "\t" $1 "\t" pp}' >> "$CUR_FILE"
        done < <(find "$local_path" -type f)
      fi
    done <<< "$local_paths"

    total=0; new=0; modified=0; deleted=0; unchanged=0
    declare -A p_total p_new p_modified p_deleted p_unchanged

    while IFS=$'\t' read -r file_path file_hash parent_path; do
      old_hash=$(echo "$cache_json" | jq -r --arg p "$file_path" '.[$p] // ""')
      p_total["$parent_path"]=$(( ${p_total["$parent_path"]:-0} + 1 ))
      if [[ -z "$old_hash" ]]; then
        new=$((new + 1))
        p_new["$parent_path"]=$(( ${p_new["$parent_path"]:-0} + 1 ))
        [[ "$verbose" == true ]] && echo "+ $file_path"
      elif [[ "$file_hash" != "$old_hash" ]]; then
        modified=$((modified + 1))
        p_modified["$parent_path"]=$(( ${p_modified["$parent_path"]:-0} + 1 ))
        [[ "$verbose" == true ]] && echo "~ $file_path"
      else
        unchanged=$((unchanged + 1))
        p_unchanged["$parent_path"]=$(( ${p_unchanged["$parent_path"]:-0} + 1 ))
        [[ "$verbose" == true ]] && echo "= $file_path"
      fi
      total=$((total + 1))
    done < "$CUR_FILE"

    # Detect deleted files (in cache but not on disk)
    DEL_FILE=$(mktemp)
    echo "$cache_json" | jq -r 'keys[]' > "$DEL_FILE"
    del_count=0
    while IFS= read -r cached_path; do
      if [[ ! -e "$cached_path" ]]; then
        deleted=$((deleted + 1))
        del_count=$((del_count + 1))
        p_deleted["$(dirname "$cached_path")"]=$(( ${p_deleted["$(dirname "$cached_path")"]:-0} + 1 ))
        [[ "$verbose" == true ]] && echo "- $cached_path"
      fi
    done < "$DEL_FILE"
    rm -f "$DEL_FILE"

    # Show per-path summary (concise) — only when not verbose
    if [[ "$verbose" == false ]]; then
      while read -r local_path; do
        [[ -z "$local_path" ]] && continue
        t=${p_total["$local_path"]:-0}
        n=${p_new["$local_path"]:-0}
        m=${p_modified["$local_path"]:-0}
        if [[ -d "$local_path" ]]; then
          label="$(basename "$local_path")/"
        else
          label="$(basename "$local_path")"
        fi
        parts=""
        [[ $n -gt 0 ]] && parts+="$n new "
        [[ $m -gt 0 ]] && parts+="$m changed "
        [[ $((t - n - m)) -gt 0 ]] && parts+="$((t - n - m)) ok"
        echo "  $label  $parts"
      done <<< "$local_paths"
    fi

    needs_sync=$((new + modified))
    echo ""
    echo "Summary: $total files ($new new, $modified modified, $unchanged unchanged)"
    if [[ $needs_sync -gt 0 ]]; then
      echo "→ $needs_sync file(s) need backup (press s to sync)"
    else
      echo "→ All files up to date ✓"
    fi

    # Build per-path JSON
    paths_json="["
    first_path=true
    while read -r local_path; do
      [[ -z "$local_path" ]] && continue
      t=${p_total["$local_path"]:-0}
      n=${p_new["$local_path"]:-0}
      m=${p_modified["$local_path"]:-0}
      u=${p_unchanged["$local_path"]:-0}
      [[ "$first_path" == true ]] && first_path=false || paths_json+=","
      paths_json+="{\"path\":\"$local_path\",\"total\":$t,\"new\":$n,\"modified\":$m,\"unchanged\":$u}"
    done <<< "$local_paths"
    paths_json+="]"

    result_json="{\"ok\":true,\"total\":$total,\"new\":$new,\"modified\":$modified,\"deleted\":$deleted,\"unchanged\":$unchanged,\"needs_sync\":$needs_sync,\"paths\":$paths_json}"
    echo "$result_json" > "$STATE_DIR/last-compare.json"
    echo "$result_json"
    ;;

  list)
    data=$(load_config)
    addr=$(echo "$data" | jq -r '.address // ""')
    share=$(echo "$data" | jq -r '.share // ""')
    remote_path=$(echo "$data" | jq -r '.remotePath // "Backups"')
    mnt=$(mount_point "$data")

    if [[ -z "$addr" || -z "$share" ]]; then
      echo '{"ok":false,"error":"Server not configured"}'
      exit 0
    fi

    host_prefix="$(uname -s)-$(hostname)"
    remote_base="${mnt}/${remote_path}/${host_prefix}"

    # Mount if needed
    if ! mountpoint -q "$mnt" 2>/dev/null; then
      output=$(do_mount "$data") || true
      mount_line=$(echo "$output" | grep "^MOUNT_" | head -1)
      if ! echo "$mount_line" | grep -q "^MOUNT_OK"; then
        echo "Cannot mount share:"
        echo "$output" | grep -v "^MOUNT_"
        exit 0
      fi
    fi

    echo "Mounted at: $mnt"
    echo "Remote: //$addr/$share/${remote_path}/${host_prefix}"
    echo ""

    echo "=== ${remote_path}/${host_prefix}/ ==="
    if [[ -d "$remote_base" ]]; then
      find "$remote_base" -type f -o -type d | head -200 | sed "s|$remote_base/||" | sed "s|$mnt/||" | sort
    else
      echo "  (no files yet — run backup first)"
    fi
    echo ""

    echo "=== Mounted share (top) ==="
    ls -la "$mnt" 2>/dev/null | head -20
    echo ""

    echo "=== Mapped at: $mnt ==="
    echo "Browse locally: file://$mnt"
    echo ""
    echo "(Press any key to close)"
    read -r -n 1 2>/dev/null || true
    ;;

  status)
    data=$(load_config)
    addr=$(echo "$data" | jq -r '.address // ""')
    share=$(echo "$data" | jq -r '.share // ""')
    mnt=$(mount_point "$data")

    if [[ -z "$addr" || -z "$share" ]]; then
      echo '{"ok":true,"config":false,"mounted":false}'
      exit 0
    fi

    if mountpoint -q "$mnt" 2>/dev/null; then
      echo "{\"ok\":true,\"config\":true,\"mounted\":true,\"mount\":\"$mnt\"}"
    else
      echo "{\"ok\":true,\"config\":true,\"mounted\":false}"
    fi
    ;;

  save-config)
    save_config
    ;;

  load-config)
    load_config
    ;;

  *)
    usage
    ;;
esac
