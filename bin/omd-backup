#!/usr/bin/env bash
# OMD Backup backend — smbclient wrapper for remote file backup.
set -euo pipefail

OMD_ROOT="${OMD_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
OLD_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omd/backup"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omd/file-share-backup"
OLD_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omd/backup"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omd/file-share-backup"

if [[ -d "$OLD_CONFIG_DIR" && ! -d "$CONFIG_DIR" ]]; then
  mv "$OLD_CONFIG_DIR" "$CONFIG_DIR"
fi
if [[ -d "$OLD_STATE_DIR" && ! -d "$STATE_DIR" ]]; then
  mv "$OLD_STATE_DIR" "$STATE_DIR"
fi

CONFIG_FILE="$CONFIG_DIR/config.json"

mkdir -p "$CONFIG_DIR" "$STATE_DIR"

usage() { echo "Usage: omd-backup {status|test|backup|compare|list|save-config|load-config}" >&2; exit 2; }
cmd="${1:-}"; shift || true

load_config() {
  if [[ -f "$CONFIG_FILE" ]]; then
    cat "$CONFIG_FILE"
  else
    echo '{"address":"","share":"","user":"","password":"","remotePath":"","localPath":"","includeExt":"","excludeExt":"","scheduleType":"manual","scheduleValue":""}'
  fi
}

save_config() {
  cat > "$CONFIG_FILE"
  echo "Config saved"
}

smb_prefix() {
  local addr share user pass
  addr=$(echo "$1" | jq -r '.address // ""')
  share=$(echo "$1" | jq -r '.share // ""')
  user=$(echo "$1" | jq -r '.user // ""')
  pass=$(echo "$1" | jq -r '.password // ""')
  echo "//$addr/$share" "$user" "$pass"
}

case "$cmd" in
  status)
    echo '{"ready":true}'
    ;;
  test)
    data=$(load_config)
    read -r smb_url smb_user smb_pass <<< "$(smb_prefix "$data")"
    if [[ -z "$smb_url" || "$smb_url" == "//" ]]; then
      echo '{"ok":false,"error":"Server not configured"}'
      exit 0
    fi
    output=$(smbclient -L "$smb_url" -U "${smb_user}%${smb_pass}" -m SMB3 --option='client min protocol=SMB2' 2>&1 || true)
    if echo "$output" | grep -q "NT_STATUS_LOGON_FAILURE"; then
      echo '{"ok":false,"error":"Login failed"}'
    elif echo "$output" | grep -q "NT_STATUS_CONNECTION_REFUSED"; then
      echo '{"ok":false,"error":"Connection refused"}'
    elif echo "$output" | grep -q "NT_STATUS"; then
      echo "{\"ok\":false,\"error\":\"$(echo "$output" | grep "NT_STATUS" | head -1 | tr -d '\n\r')\"}"
    elif [[ -n "$output" ]]; then
      shares=$(echo "$output" | grep -E "^\\s+[^\\s]+\\s+Disk" | awk '{print $1}' | tr '\n' ',' | sed 's/,$//')
      echo "{\"ok\":true,\"shares\":\"$shares\"}"
    else
      echo '{"ok":false,"error":"Unknown error"}'
    fi
    ;;
  backup)
    data=$(load_config)
    read -r smb_url smb_user smb_pass <<< "$(smb_prefix "$data")"
    local_paths=$(echo "$data" | jq -r 'if .localPath | type == "array" then .localPath[] else .localPath end // ""')
    remote_path=$(echo "$data" | jq -r '.remotePath // ""')
    include_ext=$(echo "$data" | jq -r '.includeExt // ""')
    exclude_ext=$(echo "$data" | jq -r '.excludeExt // ""')

    if [[ -z "$smb_url" || -z "$local_paths" ]]; then
      echo '{"ok":false,"error":"Invalid config or local path"}'
      exit 0
    fi

    log_file="$STATE_DIR/last-sync.log"
    # remote_dir is the path WITHIN the SMB share (relative to share root)
    remote_dir="$(echo "$remote_path" | sed 's|^/*||')"
    remote_dir="${remote_dir//\/\///}"

    echo "Backup starting"
    start=$(date +%s)
    total_files=0

    host_prefix="$(uname -s)-$(hostname)"

    while read -r local_path; do
      if [[ -z "$local_path" ]]; then
        echo "  SKIP (empty): $local_path"
        continue
      fi

      if [[ -f "$local_path" ]]; then
        # Single file upload
        base=$(basename "$local_path")
        echo "  upload file $base"
        total_files=$((total_files + 1))
        smbclient "$smb_url" -U "${smb_user}%${smb_pass}" -m SMB3 \
          --option='client min protocol=SMB2' \
          -c "cd ${remote_dir}; mkdir \"$host_prefix\"; cd \"$host_prefix\"; put \"$local_path\" \"$base\"" 2>/dev/null 1>/dev/null || echo "  FAILED: $base"
      elif [[ -d "$local_path" ]]; then
        # Directory: upload all files into host_prefix/parent_dir/
        echo "  from: $local_path"
        parent_dir=$(basename "$local_path")
        while read -r f; do
          base=$(basename "$f")
          ok=true
          if [[ -n "$include_ext" ]]; then
            ok=false
            IFS=',' read -ra exts <<< "$include_ext"
            for ext in "${exts[@]}"; do
              ext=$(echo "$ext" | xargs)
              if [[ "$base" == *${ext} ]]; then
                ok=true
                break
              fi
            done
          fi
          if [[ -n "$exclude_ext" ]]; then
            IFS=',' read -ra exts <<< "$exclude_ext"
            for ext in "${exts[@]}"; do
              ext=$(echo "$ext" | xargs)
              if [[ "$base" == *${ext} ]]; then
                ok=false
                break
              fi
            done
          fi
          if $ok; then
            echo "  upload $base"
            total_files=$((total_files + 1))
            smbclient "$smb_url" -U "${smb_user}%${smb_pass}" -m SMB3 \
              --option='client min protocol=SMB2' \
              -c "cd ${remote_dir}; mkdir \"$host_prefix\"; cd \"$host_prefix\"; mkdir \"$parent_dir\"; cd \"$parent_dir\"; put \"$f\" \"$base\"" 2>/dev/null 1>/dev/null || echo "  FAILED: $base"
          fi
        done < <(find "$local_path" -maxdepth 1 -type f)
      else
        echo "  SKIP (not found): $local_path"
      fi
    done <<< "$local_paths"

    end=$(date +%s)
    elapsed=$((end - start))
    # Save per-item tracking
    time_fmt="$(date +%H:%M)"
    items_json="["
    first=true
    while read -r item_path; do
      if [[ -z "$item_path" ]]; then
        continue
      fi
      if [[ "$first" == true ]]; then
        first=false
      else
        items_json+=","
      fi
      if [[ -f "$item_path" ]]; then
        item_type="file"
      elif [[ -d "$item_path" ]]; then
        item_type="dir"
      else
        item_type="missing"
      fi
      items_json+="{\"path\":\"$item_path\",\"type\":\"$item_type\",\"last_backup\":\"$time_fmt\"}"
    done <<< "$local_paths"
    items_json+="]"
    echo "$items_json" > "$STATE_DIR/items.json"

    # Update MD5 cache with current hashes
    md5_json="{ "
    first_md5=true
    while read -r item_path; do
      if [[ -z "$item_path" ]]; then continue; fi
      if [[ -f "$item_path" ]]; then
        h=$(md5sum "$item_path" | cut -d' ' -f1)
        if [[ "$first_md5" == true ]]; then first_md5=false; else md5_json+=", "; fi
        md5_json+="\"$item_path\":\"$h\""
      elif [[ -d "$item_path" ]]; then
        while read -r f; do
          h=$(md5sum "$f" | cut -d' ' -f1)
          if [[ "$first_md5" == true ]]; then first_md5=false; else md5_json+=", "; fi
          md5_json+="\"$f\":\"$h\""
        done < <(find "$item_path" -maxdepth 1 -type f)
      fi
    done <<< "$local_paths"
    md5_json+=" }"
    echo "$md5_json" > "$STATE_DIR/md5-cache.json"

    echo "Backup complete in ${elapsed}s, ${total_files} files"
    echo "{\"ok\":true,\"elapsed\":$elapsed}" > "$STATE_DIR/last-result.json"
    echo "{\"ok\":true,\"elapsed\":$elapsed}"
    ;;
  compare)
    data=$(load_config)
    local_paths=$(echo "$data" | jq -r 'if .localPath | type == "array" then .localPath[] else .localPath end // ""')
    CACHE_FILE="$STATE_DIR/md5-cache.json"

    # Load cache once
    cache_json=$(cat "$CACHE_FILE" 2>/dev/null || echo '{}')

    echo "Comparing local files against last backup..."

    # Walk all files, compute MD5 per-path for later
    CUR_FILE=$(mktemp)
    trap "rm -f $CUR_FILE" EXIT

    while read -r local_path; do
      [[ -z "$local_path" ]] && continue
      if [[ -f "$local_path" ]]; then
        md5sum "$local_path" | awk -v p="$local_path" -v pp="$local_path" '{print p "\t" $1 "\t" pp}' >> "$CUR_FILE"
      elif [[ -d "$local_path" ]]; then
        path_name=$(basename "$local_path")
        echo "  Scanning $path_name/ ..."
        while read -r f; do
          md5sum "$f" | awk -v p="$f" -v pp="$local_path" '{print p "\t" $1 "\t" pp}' >> "$CUR_FILE"
        done < <(find "$local_path" -maxdepth 1 -type f)
      fi
    done <<< "$local_paths"

    total=0; new=0; modified=0; unchanged=0
    declare -A p_total p_new p_modified p_unchanged

    while IFS=$'\t' read -r file_path file_hash parent_path; do
      old_hash=$(echo "$cache_json" | jq -r --arg p "$file_path" '.[$p] // ""')
      p_total["$parent_path"]=$(( ${p_total["$parent_path"]:-0} + 1 ))
      if [[ -z "$old_hash" ]]; then
        echo "  NEW: $(basename "$file_path")"
        new=$((new + 1))
        p_new["$parent_path"]=$(( ${p_new["$parent_path"]:-0} + 1 ))
      elif [[ "$file_hash" != "$old_hash" ]]; then
        echo "  MODIFIED: $(basename "$file_path")"
        modified=$((modified + 1))
        p_modified["$parent_path"]=$(( ${p_modified["$parent_path"]:-0} + 1 ))
      else
        unchanged=$((unchanged + 1))
        p_unchanged["$parent_path"]=$(( ${p_unchanged["$parent_path"]:-0} + 1 ))
      fi
      total=$((total + 1))
    done < "$CUR_FILE"

    needs_sync=$((new + modified))
    echo ""
    echo "Summary: $total files ($new new, $modified modified, $unchanged unchanged)"
    if [[ $needs_sync -gt 0 ]]; then
      echo "→ $needs_sync file(s) need backup (press b to sync)"
    else
      echo "→ All files up to date ✓"
    fi

    # Build per-path JSON
    paths_json="["
    first_path=true
    while read -r local_path; do
      [[ -z "$local_path" ]] && continue
      t=${p_total["$local_path"]:-0}
      n=${p_new["$local_path"]:-0}
      m=${p_modified["$local_path"]:-0}
      u=${p_unchanged["$local_path"]:-0}
      if [[ "$first_path" == true ]]; then first_path=false; else paths_json+=","; fi
      paths_json+="{\"path\":\"$local_path\",\"total\":$t,\"new\":$n,\"modified\":$m,\"unchanged\":$u}"
    done <<< "$local_paths"
    paths_json+="]"

    result_json="{\"ok\":true,\"total\":$total,\"new\":$new,\"modified\":$modified,\"unchanged\":$unchanged,\"needs_sync\":$needs_sync,\"paths\":$paths_json}"
    echo "$result_json" > "$STATE_DIR/last-compare.json"
    echo "$result_json"
    ;;
  list)
    data=$(load_config)
    read -r smb_url smb_user smb_pass <<< "$(smb_prefix "$data")"
    remote_path=$(echo "$data" | jq -r '.remotePath // ""')
    if [[ -z "$smb_url" || "$smb_url" == "//" ]]; then
      echo '{"ok":false,"error":"Server not configured"}'
      exit 0
    fi
    remote_dir="$(echo "$remote_path" | sed 's|^/*||')"
    host_prefix="$(uname -s)-$(hostname)"
    echo "Remote: //$(echo "$data" | jq -r '.address // ""')/$(echo "$data" | jq -r '.share // ""')/${remote_dir}/"
    echo ""
    echo "=== ${remote_dir}/${host_prefix}/ ==="
    smbclient "$smb_url" -U "${smb_user}%${smb_pass}" -m SMB3 \
      --option='client min protocol=SMB2' \
      -c "cd ${remote_dir}; cd \"${host_prefix}\"; ls" 2>/dev/null
    echo ""
    echo "=== ${remote_dir}/ (top-level) ==="
    smbclient "$smb_url" -U "${smb_user}%${smb_pass}" -m SMB3 \
      --option='client min protocol=SMB2' \
      -c "cd ${remote_dir}; ls" 2>/dev/null
    echo ""
    echo "(Press any key to close)"
    read -r -n 1 2>/dev/null || true
    ;;
  save-config)
    save_config
    ;;
  load-config)
    load_config
    ;;
  *)
    usage
    ;;
esac
