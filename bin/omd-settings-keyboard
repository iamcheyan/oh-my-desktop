#!/usr/bin/env bash
set -euo pipefail
OMD_ROOT="${OMD_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

kv() {
  printf '%s=%s\n' "$1" "$2"
}

case "${1:-status}" in
  status)
    if command -v keyd >/dev/null 2>&1; then
      kv keydInstalled true
      if systemctl is-active keyd >/dev/null 2>&1 || pgrep -x keyd >/dev/null 2>&1; then
        kv keydRunning true
      else
        kv keydRunning false
      fi
    else
      kv keydInstalled false
      kv keydRunning false
    fi

    # Check pending changes by comparing render with omd.conf
    rendered="$("${OMD_ROOT}/share/bin/omarchy-keyboard-render" 2>/dev/null || true)"
    installed="$(cat /etc/keyd/omd.conf 2>/dev/null || true)"
    if [[ "$rendered" == "$installed" ]]; then
      kv pendingChanges false
    else
      kv pendingChanges true
    fi
    ;;
  setup)
    # Redirect stdin to dev null to prevent raw-mode terminal hangs
    "${OMD_ROOT}/share/bin/omarchy-keyboard-setup" < /dev/null
    ;;
  apply)
    # Redirect stdin to dev null to prevent raw-mode terminal hangs
    "${OMD_ROOT}/share/bin/omarchy-keyboard-apply" < /dev/null
    ;;
  key-test)
    "${OMD_ROOT}/scripts/key-test-launcher" < /dev/null
    ;;
  fnmode-status)
    "${OMD_ROOT}/bin/omd-keyboard-function-row" status
    ;;
  fnmode-set)
    "${OMD_ROOT}/bin/omd-keyboard-function-row" set "$2" < /dev/null
    ;;
  *)
    echo "usage: omd-settings-keyboard status|setup|apply|key-test|fnmode-status|fnmode-set" >&2
    exit 2
    ;;
esac
