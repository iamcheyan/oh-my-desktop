#!/usr/bin/env python3
import json
import os
import subprocess
import sys
from pathlib import Path


STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "omd/display"
LAYOUT_FILE = STATE_DIR / "layout.lua"


def lua_string(value):
    return '"' + str(value).replace("\\", "\\\\").replace('"', '\\"') + '"'


def lua_number(value, default):
    try:
        return float(value)
    except (TypeError, ValueError):
        return default


def monitor_expr(spec):
    output = spec.get("output") or spec.get("name")
    if not output:
        raise ValueError("display spec is missing output")
    if bool(spec.get("disabled")):
        return f"hl.monitor({{ output = {lua_string(output)}, disabled = true }})"

    mode = str(spec.get("mode") or "preferred").removesuffix("Hz")
    x = round(lua_number(spec.get("x"), 0))
    y = round(lua_number(spec.get("y"), 0))
    scale = lua_number(spec.get("scale"), 1)
    transform = round(lua_number(spec.get("transform"), 0))
    return (
        "hl.monitor({ "
        f"output = {lua_string(output)}, "
        f"mode = {lua_string(mode)}, "
        f"position = {lua_string(f'{x}x{y}')}, "
        f"scale = {scale:.2f}, "
        f"transform = {transform} "
        "})"
    )


def write_layout(specs):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    lines = [
        "-- Generated by OMD Settings Center.",
        "-- Used by ~/.config/omd/hypr/monitors.lua when the same outputs are connected.",
        "return {",
        "  outputs = {",
    ]
    for spec in specs:
        output = spec.get("output") or spec.get("name")
        if not output:
            continue
        disabled = "true" if bool(spec.get("disabled")) else "false"
        mode = str(spec.get("mode") or "preferred").removesuffix("Hz")
        x = round(lua_number(spec.get("x"), 0))
        y = round(lua_number(spec.get("y"), 0))
        scale = lua_number(spec.get("scale"), 1)
        transform = round(lua_number(spec.get("transform"), 0))
        lines.append(
            "    { "
            f"output = {lua_string(output)}, "
            f"mode = {lua_string(mode)}, "
            f"position = {lua_string(f'{x}x{y}')}, "
            f"scale = {scale:.2f}, "
            f"transform = {transform}, "
            f"disabled = {disabled} "
            "},"
        )
    lines += ["  },", "}", ""]
    tmp = LAYOUT_FILE.with_suffix(".lua.tmp")
    tmp.write_text("\n".join(lines), encoding="utf-8")
    tmp.replace(LAYOUT_FILE)


def apply_specs(specs):
    if not isinstance(specs, list) or not specs:
        raise ValueError("expected a non-empty display spec list")

    write_layout(specs)

    proc = subprocess.run(["hyprctl", "reload"], text=True, capture_output=True)
    stdout = proc.stdout.strip()
    stderr = proc.stderr.strip()
    if proc.returncode != 0:
        raise RuntimeError(stderr or stdout or "hyprctl reload failed")
    if stdout and any(line.strip() != "ok" for line in stdout.splitlines() if line.strip()):
        raise RuntimeError(stdout)
    print("ok")


def main():
    if len(sys.argv) < 3 or sys.argv[1] != "apply":
        print("Usage: omd-display-config apply '<json-specs>'", file=sys.stderr)
        return 2
    try:
        apply_specs(json.loads(sys.argv[2]))
        return 0
    except Exception as exc:
        print(str(exc), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
