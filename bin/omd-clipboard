#!/bin/sh
set -eu

# On-demand Clipboard process.
# Usage:
#   omd-clipboard                 # toggle: open if not running, close if running
#   omd-clipboard toggle         # same as above (follows cursor)
#   omd-clipboard toggle-at-bar  # toggle anchored to the top bar (right side)
#   omd-clipboard open           # open (launch if needed, follows cursor)
#   omd-clipboard open-at-bar    # open anchored to the top bar
#   omd-clipboard close          # close running instance (no-op if not running)
#
# When started fresh, exports OMD_CLIPBOARD_ON_DEMAND=1 so shell.qml auto-opens the
# clipboard dialog and quits the process when the window closes.
# OMD_CLIPBOARD_POSITION=bar  anchors the dialog to the bar instead of the cursor.
# OMD_CLIPBOARD_BAR_HEIGHT=n  supplies the bar height for the anchored offset.

app_dir="$HOME/.config/omd/apps/omd-clipboard"

# Detect a running omd-clipboard Quickshell instance. Match the -p path
# (config dir) to avoid collisions with other omd-* processes.
is_running() {
    pgrep -af "(quickshell|qs).* -p ${app_dir}( |$)" >/dev/null 2>&1
}

ipc_call() {
    qs -p "$app_dir" ipc call clipboard "$1" 2>/dev/null || true
}

launch_direct() {
    # Forward position hints to the fresh Quickshell instance via env.
    if [ "${OMD_CLIPBOARD_POSITION:-}" = "bar" ]; then
        export OMD_CLIPBOARD_POSITION=bar
        export OMD_CLIPBOARD_BAR_HEIGHT="${OMD_CLIPBOARD_BAR_HEIGHT:-32}"
    fi

    qs_bin="${OMD_QS_BIN:-}"
    if [ -z "$qs_bin" ]; then
        if [ -x /usr/bin/qs ]; then
            qs_bin=/usr/bin/qs
        elif [ -x /usr/bin/quickshell ]; then
            qs_bin=/usr/bin/quickshell
        elif [ -x "$HOME/.local/bin/qs" ]; then
            qs_bin="$HOME/.local/bin/qs"
        elif [ -x "$HOME/.local/bin/quickshell" ]; then
            qs_bin="$HOME/.local/bin/quickshell"
        fi
    fi
    if [ -z "$qs_bin" ]; then
        echo "Quickshell executable not found" >&2
        exit 127
    fi

    # Set up Quickshell/OMD environment variables directly
    repo_root="${OMD_REPO_ROOT:-$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)}"
    export OMD_REPO_ROOT="$repo_root"
    export OMD_QUICKSHELL_DIR="$repo_root/quickshell"
    export QS_CONFIG_DIR="$app_dir"
    export QS_COMPOSITOR=hyprland
    export OMD_APP_DIR="$app_dir"
    export OMD_CLIPBOARD_ON_DEMAND=1

    # Ensure Wayland variables are available (fallback if not in environment)
    if [ -z "${WAYLAND_DISPLAY:-}" ]; then
        runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
        for socket in "$runtime_dir"/wayland-*; do
            if [ -S "$socket" ]; then
                export WAYLAND_DISPLAY="$(basename "$socket")"
                break
            fi
        done
    fi

    exec "$qs_bin" -p "$app_dir"
}

case "${1:-toggle}" in
    toggle)
        if is_running; then
            ipc_call toggle
        else
            launch_direct
        fi
        ;;
    toggle-at-bar)
        if is_running; then
            ipc_call "toggleAtBar ${OMD_CLIPBOARD_BAR_HEIGHT:-32}"
        else
            OMD_CLIPBOARD_POSITION=bar OMD_CLIPBOARD_BAR_HEIGHT="${OMD_CLIPBOARD_BAR_HEIGHT:-32}" launch_direct
        fi
        ;;
    open)
        if is_running; then
            ipc_call open
        else
            launch_direct
        fi
        ;;
    open-at-bar)
        if is_running; then
            ipc_call "openAtBar ${OMD_CLIPBOARD_BAR_HEIGHT:-32}"
        else
            OMD_CLIPBOARD_POSITION=bar OMD_CLIPBOARD_BAR_HEIGHT="${OMD_CLIPBOARD_BAR_HEIGHT:-32}" launch_direct
        fi
        ;;
    close)
        if is_running; then
            ipc_call close
        fi
        ;;
    *)
        echo "usage: omd-clipboard [toggle|toggle-at-bar|open|open-at-bar|close]" >&2
        exit 2
        ;;
esac
