#!/usr/bin/env bash
# Keep StatusNotifierItems registered with the current watcher.
#
# Some sandboxed clients keep their SNI bus name across a watcher restart and
# do not retry RegisterStatusNotifierItem. This small helper repairs that
# protocol-level state without knowing anything about a particular client.
set -u
umask 077

interval="${SUMIKA_SNI_RECONCILE_INTERVAL:-2}"
runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
pid_file="${runtime_dir}/sumika-shell-sni-reconcile.pid"

have() { command -v "$1" >/dev/null 2>&1; }

cleanup() {
    if [ -f "$pid_file" ] && [ "$(cat "$pid_file" 2>/dev/null || true)" = "$$" ]; then
        rm -f "$pid_file"
    fi
}
stop() {
    cleanup
    exit 0
}
trap cleanup EXIT
trap stop HUP INT TERM

have busctl || exit 0
have gdbus || exit 0

mkdir -p "$runtime_dir/sumika-shell" 2>/dev/null || exit 0
pid_file="$runtime_dir/sumika-shell/sni-reconcile.pid"

if [ -f "$pid_file" ]; then
    old_pid=$(cat "$pid_file" 2>/dev/null || true)
    if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
        exit 0
    fi
fi
printf '%s\n' "$$" > "$pid_file"

reconcile() {
    busctl --user status org.kde.StatusNotifierWatcher >/dev/null 2>&1 || return 0

    registered=$(busctl --user get-property \
        org.kde.StatusNotifierWatcher \
        /StatusNotifierWatcher \
        org.kde.StatusNotifierWatcher \
        RegisteredStatusNotifierItems 2>/dev/null || true)

    busctl --user list --no-legend 2>/dev/null \
        | awk '$1 ~ /^(org\.kde|org\.freedesktop)\.StatusNotifierItem-/ { print $1 }' \
        | while IFS= read -r item_bus; do
            [ -n "$item_bus" ] || continue
            printf '%s\n' "$registered" | grep -Fq "$item_bus/StatusNotifierItem" && continue
            gdbus call --session \
                --dest org.kde.StatusNotifierWatcher \
                --object-path /StatusNotifierWatcher \
                --method org.kde.StatusNotifierWatcher.RegisterStatusNotifierItem \
                "$item_bus" >/dev/null 2>&1 || true
        done
}

while :; do
    reconcile
    sleep "$interval"
done
