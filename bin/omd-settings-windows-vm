#!/usr/bin/env bash
set -euo pipefail

COMPOSE_FILE="${WINDOWS_VM_COMPOSE_FILE:-$HOME/.config/windows/docker-compose.yml}"
CONFIG_DIR="$(dirname "$COMPOSE_FILE")"
STORAGE_DIR="${WINDOWS_VM_STORAGE_DIR:-$HOME/.windows}"
SHARED_DIR="${WINDOWS_VM_SHARED_DIR:-$HOME/Windows}"
CONTAINER_NAME="${WINDOWS_VM_CONTAINER:-omarchy-windows}"
WEB_HOST="${WINDOWS_VM_WEB_HOST:-127.0.0.1}"
WEB_PORT="${WINDOWS_VM_WEB_PORT:-8006}"
WEB_URL="${WINDOWS_VM_WEB_URL:-http://$WEB_HOST:$WEB_PORT}"
RDP_HOST="${WINDOWS_VM_RDP_HOST:-127.0.0.1}"
DEFAULT_RDP_PORT="${WINDOWS_VM_RDP_PORT:-3389}"
OMD_ROOT="${OMD_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
RDP_LAUNCHER="${WINDOWS_VM_RDP_LAUNCHER:-$OMD_ROOT/scripts/windows-rdp}"

kv() {
  local key="$1" value="${2:-}"
  value="${value//$'\n'/ }"
  printf '%s=%s\n' "$key" "$value"
}

have() {
  command -v "$1" >/dev/null 2>&1
}

bool() {
  "$@" >/dev/null 2>&1 && printf true || printf false
}

compose_cmd_string() {
  if have docker && docker compose version >/dev/null 2>&1; then
    printf 'docker compose'
  elif have docker-compose; then
    printf 'docker-compose'
  else
    return 1
  fi
}

compose() {
  local cmd
  cmd="$(compose_cmd_string)" || return 127
  if [[ "$cmd" == "docker compose" ]]; then
    docker compose -f "$COMPOSE_FILE" "$@"
  else
    docker-compose -f "$COMPOSE_FILE" "$@"
  fi
}

compose_available() {
  compose_cmd_string >/dev/null 2>&1
}

compose_value() {
  local key="$1"
  [[ -f "$COMPOSE_FILE" ]] || return 0
  awk -v key="$key" '
    $1 == key ":" {
      $1 = ""
      sub(/^[[:space:]]+/, "")
      gsub(/^"/, "")
      gsub(/"$/, "")
      print
      exit
    }
  ' "$COMPOSE_FILE"
}

compose_rdp_port() {
  [[ -f "$COMPOSE_FILE" ]] || {
    printf '%s' "$DEFAULT_RDP_PORT"
    return
  }
  local port
  port="$(awk '
    match($0, /127\.0\.0\.1:([0-9]+):3389\/tcp/, m) {
      print m[1]
      exit
    }
  ' "$COMPOSE_FILE")"
  [[ -n "$port" ]] && printf '%s' "$port" || printf '%s' "$DEFAULT_RDP_PORT"
}

freerdp_bin() {
  if have xfreerdp3; then
    printf 'xfreerdp3'
  elif have xfreerdp; then
    printf 'xfreerdp'
  else
    return 1
  fi
}

docker_error() {
  have docker || {
    printf 'Docker CLI is not installed'
    return
  }
  docker info 2>&1 >/dev/null | head -n 1 | tr -d '\r'
}

docker_daemon_available() {
  have docker && docker info >/dev/null 2>&1
}

docker_access_available() {
  docker_daemon_available
}

docker_socket_present() {
  [[ -S /var/run/docker.sock ]] || [[ -S "${XDG_RUNTIME_DIR:-}/docker.sock" ]]
}

docker_group_member() {
  id -nG 2>/dev/null | tr ' ' '\n' | grep -qx docker
}

container_status() {
  if ! have docker; then
    printf 'missing'
    return
  fi
  local status
  status="$(docker inspect --format='{{.State.Status}}' "$CONTAINER_NAME" 2>/dev/null || true)"
  [[ -n "$status" ]] && printf '%s' "$status" || printf 'missing'
}

storage_used_bytes() {
  if [[ -d "$STORAGE_DIR" ]]; then
    du -sb "$STORAGE_DIR" 2>/dev/null | awk '{print $1}'
  else
    printf '0'
  fi
}

disk_available_gb() {
  df "$HOME" | awk 'NR==2 {print int($4/1024/1024)}'
}

ram_total_gb() {
  awk 'NR==1 {printf "%d", $2/1024/1024}' /proc/meminfo
}

cpu_total() {
  nproc
}

port_open() {
  local host="$1" port="$2"
  if have nc; then
    nc -z -w 1 "$host" "$port" >/dev/null 2>&1
  else
    timeout 1 bash -c ":</dev/tcp/$host/$port" >/dev/null 2>&1
  fi
}

port_busy() {
  local port="$1"
  if have ss; then
    ss -H -ltn "sport = :$port" 2>/dev/null | grep -q .
  else
    port_open 127.0.0.1 "$port"
  fi
}

select_rdp_port() {
  local port="$DEFAULT_RDP_PORT"
  if ! port_busy "$port"; then
    printf '%s' "$port"
    return
  fi
  for port in 3390 3391 3392 3393 3394 3395 3396 3397 3398 3399 3400; do
    if ! port_busy "$port"; then
      printf '%s' "$port"
      return
    fi
  done
  printf '%s' "$DEFAULT_RDP_PORT"
}

web_reachable() {
  if have curl; then
    curl -fsS -o /dev/null --connect-timeout 2 "$WEB_URL/" >/dev/null 2>&1
  else
    port_open 127.0.0.1 8006
  fi
}

rdp_reachable() {
  port_open "$RDP_HOST" "$(compose_rdp_port)"
}

hypr_focus_new_workspace() {
  have hyprctl || return 0
  hyprctl dispatch 'hl.dsp.focus({ workspace = "empty" })' >/dev/null 2>&1 \
    || hyprctl dispatch workspace empty >/dev/null 2>&1 \
    || true
}

log_tail() {
  docker logs "$CONTAINER_NAME" --tail "${1:-80}" 2>&1 || true
}

detect_phase_from_logs() {
  local logs="$1" status="$2"
  if [[ "$status" == "missing" ]]; then
    printf 'not-installed'
  elif [[ "$status" != "running" ]]; then
    printf 'stopped'
  elif echo "$logs" | grep -qi 'error\|failed\|panic'; then
    printf 'error'
  elif echo "$logs" | grep -qi 'windows started successfully\|rdp.*ready'; then
    printf 'ready'
  elif echo "$logs" | grep -qi 'extract\|convert'; then
    printf 'preparing'
  elif echo "$logs" | grep -qi 'download\|pull\|fetch'; then
    printf 'downloading'
  elif echo "$logs" | grep -Eq '[[:space:]][0-9]+%'; then
    printf 'downloading'
  elif echo "$logs" | grep -qi 'installing\|setup\|oobe'; then
    printf 'installing'
  else
    printf 'booting'
  fi
}

phase() {
  local status="$1"
  local logs=""
  if [[ "$status" == "running" ]] && docker_access_available; then
    logs="$(log_tail 120)"
  fi
  detect_phase_from_logs "$logs" "$status"
}

progress_percent_from_logs() {
  local logs="$1"
  echo "$logs" | grep -Eo '[[:space:]][0-9]+%' | tail -n 1 | tr -d ' %' || true
}

ready_state() {
  local status="$1" phase_value="$2"
  if [[ "$status" == "running" && "$phase_value" == "ready" ]]; then
    printf true
  else
    printf false
  fi
}

print_common_status() {
  local configured=false storage_present=false kvm=false docker_cli=false docker_daemon=false docker_access=false
  local docker_socket=false docker_group=false compose_ok=false freerdp=false freerdp_path=""
  local status phase_value ready=false web_ok=false rdp_ok=false docker_err=""
  local logs="" progress_percent=""

  [[ -f "$COMPOSE_FILE" ]] && configured=true
  [[ -d "$STORAGE_DIR" ]] && storage_present=true
  [[ -e /dev/kvm ]] && kvm=true
  have docker && docker_cli=true
  docker_daemon_available && docker_daemon=true
  docker_access_available && docker_access=true
  docker_socket_present && docker_socket=true
  docker_group_member && docker_group=true
  compose_available && compose_ok=true
  if freerdp_path="$(freerdp_bin 2>/dev/null)"; then
    freerdp=true
  else
    freerdp_path=""
  fi
  [[ "$docker_cli" == true && "$docker_access" == false ]] && docker_err="$(docker_error || true)"

  status="$(container_status)"
  if [[ "$status" == "running" && "$docker_access" == true ]]; then
    logs="$(log_tail 120)"
    progress_percent="$(progress_percent_from_logs "$logs")"
  fi
  phase_value="$(detect_phase_from_logs "$logs" "$status")"
  ready="$(ready_state "$status" "$phase_value")"
  web_reachable && web_ok=true
  [[ "$status" == "running" ]] && rdp_reachable && rdp_ok=true

  kv configured "$configured"
  kv storagePresent "$storage_present"
  kv storageUsedBytes "$(storage_used_bytes)"
  kv kvm "$kvm"
  kv dockerCli "$docker_cli"
  kv dockerDaemon "$docker_daemon"
  kv dockerRunning "$docker_daemon"
  kv dockerAccess "$docker_access"
  kv dockerSocket "$docker_socket"
  kv dockerGroupMember "$docker_group"
  kv dockerError "$docker_err"
  kv compose "$compose_ok"
  kv freerdp "$freerdp"
  kv freerdpBin "$freerdp_path"
  kv container "$status"
  kv phase "$phase_value"
  kv progressPercent "$progress_percent"
  kv ready "$ready"
  kv webReachable "$web_ok"
  kv rdpReachable "$rdp_ok"
  kv web "$WEB_URL"
  kv rdpPort "$(compose_rdp_port)"
  kv rdpEndpoint "$RDP_HOST:$(compose_rdp_port)"
  if [[ "$status" != "running" ]] && port_busy "$(compose_rdp_port)"; then
    kv rdpPortBusy true
    kv rdpPortConflict true
  else
    kv rdpPortBusy false
    kv rdpPortConflict false
  fi
  kv composeFile "$COMPOSE_FILE"
  kv storageDir "$STORAGE_DIR"
  kv sharedDir "$SHARED_DIR"
  kv diskAvailable "$(disk_available_gb)"
  kv ramTotal "$(ram_total_gb)"
  kv cpuTotal "$(cpu_total)"
  kv ram "$(compose_value RAM_SIZE)"
  kv cpu "$(compose_value CPU_CORES)"
  kv disk "$(compose_value DISK_SIZE)"
  kv user "$(compose_value USERNAME)"
}

status() {
  print_common_status
}

check_resources() {
  print_common_status
}

default_ram() {
  local total half
  total="$(ram_total_gb)"
  half=$(( total / 2 ))
  (( half < 4 )) && half=4
  (( half > 16 )) && half=16
  (( total > 0 && half > total - 2 )) && half=$(( total - 2 ))
  (( half < 2 )) && half=2
  printf '%sG' "$half"
}

default_cpu() {
  local total half
  total="$(cpu_total)"
  half=$(( total / 2 ))
  (( half < 2 )) && half=2
  (( half > 8 )) && half=8
  (( half > total )) && half="$total"
  (( half < 1 )) && half=1
  printf '%s' "$half"
}

default_disk() {
  local avail
  avail="$(disk_available_gb)"
  if (( avail >= 160 )); then
    printf '128G'
  elif (( avail >= 74 )); then
    printf '64G'
  else
    printf '0G'
  fi
}

ensure_desktop_file() {
  mkdir -p "$HOME/.local/share/applications/icons"
  local omd_icon="$OMD_ROOT/share/applications/icons/windows.png"
  if [[ -f "$omd_icon" ]]; then
    cp "$omd_icon" "$HOME/.local/share/applications/icons/windows.png"
  fi

  cat > "$HOME/.local/share/applications/windows-vm.desktop" << EOF
[Desktop Entry]
Name=Windows
Comment=Start Windows VM and connect with RDP
Exec=$OMD_ROOT/bin/omd-settings-windows-vm start-connect
Icon=$HOME/.local/share/applications/icons/windows.png
Terminal=false
Type=Application
Categories=System;Virtualization;
EOF
}

write_compose() {
  local ram="$1" cpu="$2" disk="$3" user="$4" pass="$5"
  local tz rdp_port
  tz="$(timedatectl show -p Timezone --value 2>/dev/null || echo UTC)"
  rdp_port="$(select_rdp_port)"

  mkdir -p "$CONFIG_DIR" "$STORAGE_DIR" "$SHARED_DIR"
  cat > "$COMPOSE_FILE" << EOF
services:
  windows:
    image: dockurr/windows
    container_name: $CONTAINER_NAME
    environment:
      VERSION: "11"
      RAM_SIZE: "$ram"
      CPU_CORES: "$cpu"
      DISK_SIZE: "$disk"
      USERNAME: "$user"
      PASSWORD: "$pass"
      TZ: "$tz"
      ARGUMENTS: "-rtc base=localtime,clock=host,driftfix=slew"
    devices:
      - /dev/kvm
      - /dev/net/tun
    cap_add:
      - NET_ADMIN
    ports:
      - $WEB_HOST:$WEB_PORT:8006
      - 127.0.0.1:$rdp_port:3389/tcp
      - 127.0.0.1:$rdp_port:3389/udp
    volumes:
      - $STORAGE_DIR:/storage
      - $SHARED_DIR:/shared
    restart: unless-stopped
    stop_grace_period: 2m
EOF
  ensure_desktop_file
}

ensure_compose_ports_available() {
  [[ -f "$COMPOSE_FILE" ]] || return 0
  local current next
  if [[ "$(container_status)" == "running" ]]; then
    return 0
  fi
  current="$(compose_rdp_port)"
  if ! port_busy "$current"; then
    return 0
  fi
  next="$(select_rdp_port)"
  [[ "$next" != "$current" ]] || return 0
  kv progress "RDP port $current is busy; switching Windows VM to $next..."
  sed -i \
    -e "s/127\\.0\\.0\\.1:$current:3389\\/tcp/127.0.0.1:$next:3389\\/tcp/" \
    -e "s/127\\.0\\.0\\.1:$current:3389\\/udp/127.0.0.1:$next:3389\\/udp/" \
    "$COMPOSE_FILE"
}

require_install_resources() {
  [[ -e /dev/kvm ]] || {
    kv error "KVM is not available. Enable virtualization in BIOS or load kvm-intel/kvm-amd."
    return 1
  }
  docker_access_available || {
    kv error "Docker is not running or current user cannot access Docker."
    kv dockerError "$(docker_error || true)"
    return 1
  }
  compose_available || {
    kv error "Docker Compose is not installed."
    return 1
  }
  local disk="$1"
  local disk_num="${disk%G}"
  local required=$(( disk_num + 10 ))
  local available
  available="$(disk_available_gb)"
  (( available >= required )) || {
    kv error "Insufficient disk space: ${available}GB available, ${required}GB required."
    return 1
  }
}

install() {
  local ram="${1:-$(default_ram)}" cpu="${2:-$(default_cpu)}" disk="${3:-$(default_disk)}"
  local user="${4:-win11}" pass="${5:-admin}"

  kv progress "Preparing Windows VM configuration..."
  if [[ "$disk" == "0G" ]]; then
    kv error "Windows VM needs at least 74 GB free disk space."
    return 1
  fi
  require_install_resources "$disk"

  kv progress "Writing Docker Compose configuration..."
  write_compose "$ram" "$cpu" "$disk" "$user" "$pass"

  kv progress "Starting Windows VM container..."
  compose up -d 2>&1 | sed 's/^/log=/'
  kv result "started"
}

install_defaults() {
  local ram cpu disk user pass
  ram="$(compose_value RAM_SIZE)"
  cpu="$(compose_value CPU_CORES)"
  disk="$(compose_value DISK_SIZE)"
  user="$(compose_value USERNAME)"
  pass="$(compose_value PASSWORD)"

  [[ -n "$ram" ]] || ram="$(default_ram)"
  [[ -n "$cpu" ]] || cpu="$(default_cpu)"
  [[ -n "$disk" ]] || disk="$(default_disk)"
  [[ -n "$user" ]] || user=""
  [[ -n "$pass" ]] || pass=""
  install "$ram" "$cpu" "$disk" "$user" "$pass"
}

install_docker() {
  have pkexec || {
    kv error "pkexec is not installed."
    return 1
  }
  kv progress "Installing or starting Docker..."
  pkexec bash -c '
    set -e
    if ! command -v docker >/dev/null 2>&1 || ! command -v dockerd >/dev/null 2>&1 || ! command -v containerd >/dev/null 2>&1; then
      if command -v dnf >/dev/null 2>&1; then dnf install -y moby-engine docker-cli docker-compose containerd
      elif command -v apt >/dev/null 2>&1; then apt update && apt install -y docker.io docker-compose
      elif command -v pacman >/dev/null 2>&1; then pacman -S --noconfirm docker docker-compose
      fi
    fi

    if command -v restorecon >/dev/null 2>&1; then
      restorecon -R /usr/bin/dockerd /usr/bin/containerd /usr/bin/docker-proxy /usr/lib/systemd/system/containerd.service /usr/lib/systemd/system/docker.socket /etc/systemd/system/docker.service 2>/dev/null || true
    fi
    if command -v chcon >/dev/null 2>&1; then
      for file in /usr/bin/dockerd /usr/bin/containerd /usr/bin/docker-proxy; do
        [ -e "$file" ] && chcon system_u:object_r:bin_t:s0 "$file" 2>/dev/null || true
      done
      for file in /usr/lib/systemd/system/containerd.service /usr/lib/systemd/system/docker.socket /etc/systemd/system/docker.service; do
        [ -e "$file" ] && chcon system_u:object_r:systemd_unit_file_t:s0 "$file" 2>/dev/null || true
      done
    fi

    systemctl daemon-reload
    systemctl reset-failed containerd docker 2>/dev/null || true
    systemctl enable containerd --now 2>/dev/null || true
    systemctl enable docker --now 2>/dev/null || true

    login_user="${SUDO_USER:-}"
    if [ -z "$login_user" ] && [ -n "${PKEXEC_UID:-}" ]; then
      login_user="$(getent passwd "$PKEXEC_UID" | cut -d: -f1)"
    fi
    [ -n "$login_user" ] && usermod -aG docker "$login_user" 2>/dev/null || true
  '
  kv result "ok"
}

install_packages() {
  have pkexec || {
    kv error "pkexec is not installed."
    return 1
  }
  kv progress "Installing FreeRDP and network helpers..."
  pkexec bash -c '
    set -e
    if command -v dnf >/dev/null 2>&1; then dnf install -y freerdp freerdp3 openbsd-netcat
    elif command -v apt >/dev/null 2>&1; then apt update && apt install -y freerdp2-x11 freerdp3-x11 netcat-openbsd
    elif command -v pacman >/dev/null 2>&1; then pacman -S --noconfirm freerdp openbsd-netcat
    fi
  ' || true
  kv result "ok"
}

fix_kvm() {
  [[ -e /dev/kvm ]] && {
    kv result "ok"
    return 0
  }
  have pkexec || {
    kv error "pkexec is not installed."
    return 1
  }
  kv progress "Loading KVM kernel module..."
  pkexec bash -c 'modprobe kvm-intel 2>/dev/null || modprobe kvm-amd 2>/dev/null || modprobe kvm 2>/dev/null || true'
  [[ -e /dev/kvm ]] && kv result "ok" || {
    kv error "KVM is still unavailable. Enable Intel VT-x / AMD-V in BIOS."
    return 1
  }
}

auto_fix() {
  if [[ ! -e /dev/kvm ]]; then
    fix_kvm || true
  fi
  if ! docker_access_available; then
    install_docker || true
  fi
  if ! compose_available || ! freerdp_bin >/dev/null 2>&1; then
    install_packages || true
  fi

  if [[ ! -e /dev/kvm ]]; then
    kv error "KVM is still unavailable. Enable Intel VT-x / AMD-V in BIOS or load kvm-intel/kvm-amd."
    return 1
  fi
  if ! docker_access_available; then
    local err
    err="$(docker_error || true)"
    [[ -n "$err" ]] || err="Docker is not running or current user cannot access Docker."
    kv error "$err"
    return 1
  fi
  if ! compose_available; then
    kv error "Docker Compose is not installed."
    return 1
  fi
  kv result "ok"
}

ensure_start_requirements() {
  if [[ ! -e /dev/kvm ]] || ! docker_access_available || ! compose_available; then
    auto_fix
  fi
}

start() {
  [[ -f "$COMPOSE_FILE" ]] || {
    kv error "Windows VM is not configured."
    return 1
  }
  ensure_start_requirements
  require_install_resources "$(compose_value DISK_SIZE || echo 64G)"
  ensure_compose_ports_available
  kv progress "Starting Windows VM..."
  compose up -d 2>&1 | sed 's/^/log=/'
  kv result "started"
}

wait_ready() {
  local timeout_s="${1:-300}" waited=0 status_value phase_value
  while (( waited <= timeout_s )); do
    status_value="$(container_status)"
    phase_value="$(phase "$status_value")"
    kv progress "Waiting for Windows: ${phase_value}"
    if [[ "$(ready_state "$status_value" "$phase_value")" == true ]]; then
      kv result "ready"
      return 0
    fi
    sleep 3
    waited=$(( waited + 3 ))
  done
  kv error "Windows did not become ready within ${timeout_s}s."
  return 1
}

connect() {
  [[ -x "$RDP_LAUNCHER" ]] || {
    kv error "Windows VM RDP launcher is missing or not executable: $RDP_LAUNCHER"
    return 1
  }
  "$RDP_LAUNCHER"
}

start_connect() {
  start
  wait_ready 300
  connect
}

install_status() {
  local status_value phase_value logs progress_percent=""
  status_value="$(container_status)"
  if [[ "$status_value" == "running" ]] && docker_access_available; then
    logs="$(log_tail 120)"
    progress_percent="$(progress_percent_from_logs "$logs")"
  fi
  phase_value="$(detect_phase_from_logs "$logs" "$status_value")"
  kv state "$status_value"
  kv phase "$phase_value"
  kv progressPercent "$progress_percent"
  kv ready "$(ready_state "$status_value" "$phase_value")"
  kv webReachable "$(bool web_reachable)"
  kv rdpPort "$(compose_rdp_port)"
  kv rdpEndpoint "$RDP_HOST:$(compose_rdp_port)"
  if [[ "$status_value" == "running" ]]; then
    kv rdpReachable "$(bool rdp_reachable)"
  else
    kv rdpReachable "false"
  fi
}

logs() {
  if ! have docker; then
    echo "Docker CLI is not installed."
    return 0
  fi
  docker logs "$CONTAINER_NAME" --tail "${1:-120}" 2>&1 || echo "Container not found or Docker is not accessible."
}

stop() {
  [[ -f "$COMPOSE_FILE" ]] || {
    kv result "not-configured"
    return 0
  }
  compose down 2>&1 | sed 's/^/log=/' || true
  kv result "stopped"
}

remove_vm() {
  [[ "${1:-}" == "--yes" ]] || {
    kv error "Refusing to remove without --yes."
    return 2
  }
  if [[ -f "$COMPOSE_FILE" ]]; then
    compose down 2>/dev/null || true
  fi
  if have docker && docker_access_available; then
    docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true
  fi
  rm -f "$HOME/.local/share/applications/windows-vm.desktop"
  rm -rf "$CONFIG_DIR" "$STORAGE_DIR"
  kv result "removed"
}

open_web() {
  xdg-open "$WEB_URL" >/dev/null 2>&1 &
}

case "${1:-status}" in
  status) status ;;
  check-resources) check_resources ;;
  install-docker) install_docker ;;
  install-packages) install_packages ;;
  install)
    shift
    install "$@"
    ;;
  install-defaults) install_defaults ;;
  install-status) install_status ;;
  auto-fix) auto_fix ;;
  logs)
    shift || true
    logs "${1:-120}"
    ;;
  start) start ;;
  connect) connect true ;;
  start-connect) start_connect true ;;
  launch) start_connect false ;;
  launch-keepalive) start_connect true ;;
  stop) stop ;;
  remove)
    shift || true
    remove_vm "${1:-}"
    ;;
  web) open_web ;;
  *)
    echo "usage: $(basename "$0") status|check-resources|install-docker|install-packages|install|install-defaults|install-status|logs|start|connect|start-connect|launch|launch-keepalive|stop|remove --yes|web" >&2
    exit 2
    ;;
esac
