#!/bin/sh
set -eu

# Ensure the configured input-method backend exists before Quickshell starts.
# The input-method extension polls its backend, but the bar must not win the
# startup race and hide the indicator before Fcitx5 has a D-Bus connection.

omd_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
. "$omd_root/lib/paths.sh"

config="$SUMIKA_SHELL_CONFIG_HOME/sumika.json"
enabled=true
autostart=true

if command -v jq >/dev/null 2>&1 && [ -f "$config" ]; then
    enabled=$(jq -r '
        if (.inputMethod | type) == "object" and (.inputMethod | has("enabled"))
        then .inputMethod.enabled else true end
    ' "$config" 2>/dev/null || echo true)
    autostart=$(jq -r '
        if (.inputMethod | type) == "object" and (.inputMethod | has("autostart"))
        then .inputMethod.autostart else true end
    ' "$config" 2>/dev/null || echo true)
fi

case "$enabled:$autostart" in
    false:*|False:*|0:*|*:false|*:False|*:0)
        exit 0
        ;;
esac

command -v fcitx5 >/dev/null 2>&1 || exit 0

if ! pgrep -x fcitx5 >/dev/null 2>&1; then
    log_dir="$SUMIKA_SHELL_RUNTIME_DIR"
    if ! mkdir -p "$log_dir" 2>/dev/null || [ ! -w "$log_dir" ]; then
        log_dir="${TMPDIR:-/tmp}"
    fi
    log="$log_dir/fcitx5.log"
    # Fcitx5 is a session process, so preserve the current D-Bus and Wayland
    # environment instead of launching it as a system service.
    nohup fcitx5 --disable notificationitem >"$log" 2>&1 </dev/null &
fi

# Bound the wait. A broken backend must never prevent the rest of the desktop
# from starting; a healthy backend normally answers within a few hundred ms.
if command -v fcitx5-remote >/dev/null 2>&1 && command -v timeout >/dev/null 2>&1; then
    i=0
    while [ "$i" -lt 20 ]; do
        if timeout 0.25s fcitx5-remote -n 2>/dev/null | grep -q '[^[:space:]]'; then
            exit 0
        fi
        sleep 0.1
        i=$((i + 1))
    done
fi

exit 0
