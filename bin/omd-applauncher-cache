#!/bin/sh
set -eu

# Generate a JSON cache of desktop entries for omd-applauncher.
# Reads .desktop files and outputs minimal fields needed by the launcher.
# Used to avoid the ~200ms synchronous DesktopEntries scan on cold start.

cache_dir="$HOME/.local/state/omd/applauncher"
cache_file="$cache_dir/apps.json"
mkdir -p "$cache_dir"

# Collect .desktop file directories
dirs="/usr/share/applications /usr/local/share/applications $HOME/.local/share/applications"
for d in /var/lib/flatpak/exports/share/applications "$HOME/.local/share/flatpak/exports/share/applications"; do
    [ -d "$d" ] && dirs="$dirs $d"
done

# Generate JSON array of apps
{
    echo '['
    first=1
    for d in $dirs; do
        [ -d "$d" ] || continue
        for f in "$d"/*.desktop; do
            [ -f "$f" ] || continue
            id=$(basename "$f")
            name=""
            icon=""
            exec_raw=""
            generic_name=""
            comment=""
            no_display=""
            keywords=""
            working_dir=""
            hidden=""
            section=""
            while IFS='=' read -r key val; do
                # Track which section we're in; stop collecting once we leave [Desktop Entry]
                case "$key" in
                    \[*)
                        section="$key"
                        # Once we've entered a non-Desktop-Entry section, stop reading main fields
                        [ "$section" = "[Desktop Entry]" ] || break
                        continue
                        ;;
                esac
                # Only collect fields from the [Desktop Entry] section
                case "$key" in
                    Name) name="$val" ;;
                    Icon) icon="$val" ;;
                    Exec) exec_raw="$val" ;;
                    GenericName) generic_name="$val" ;;
                    Comment) comment="$val" ;;
                    NoDisplay) no_display="$val" ;;
                    Keywords) keywords="$val" ;;
                    Path) working_dir="$val" ;;
                    Hidden) hidden="$val" ;;
                esac
            done < "$f"
            [ -n "$no_display" ] && [ "$no_display" = "true" ] && continue
            [ -n "$hidden" ] && [ "$hidden" = "true" ] && continue
            [ -z "$name" ] && continue
            [ -z "$exec_raw" ] && continue
            [ "$first" -eq 0 ] && echo ','
            first=0
            # Escape for JSON
            esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr '\n' ' '; }
            printf '  {"id":"%s","name":"%s","icon":"%s","exec":"%s","genericName":"%s","comment":"%s","keywords":"%s","workingDirectory":"%s"}' \
                "$(esc "$id")" "$(esc "$name")" "$(esc "$icon")" "$(esc "$exec_raw")" \
                "$(esc "$generic_name")" "$(esc "$comment")" "$(esc "$keywords")" "$(esc "$working_dir")"
        done
    done
    echo ''
    echo ']'
} > "$cache_file.tmp"

mv "$cache_file.tmp" "$cache_file"
echo "$cache_file"