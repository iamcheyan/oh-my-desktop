#!/usr/bin/env bash
set -euo pipefail

# sumika-action — Route Hyprland bindings through ActionManager.
#
# Usage:
#   sumika-action <action-id> [params...]       Invoke an action
#   sumika-action list                          List all registered actions
#   sumika-action query <action-id>             Query action state (registered, enabled, etc.)
#   sumika-action status                        Summary of registered actions by owner
#   sumika-action isAvailable <action-id>       Check if an action is available
#
# Dispatches to the Quickshell bar process via the action IPC target.
# ActionManager checks module-enabled state dynamically; disabled modules
# silently reject the call (return code 0 for invoke, 1 for errors).
#
# Phase 2 of the sumika-core-plugin-migration-plan: all system behavior
# called by Action ID, UI never directly invokes commands.

_sumika_root=$(cd "$(dirname "$0")/.." && pwd -P)
. "$_sumika_root/lib/paths.sh"
_sumika_root="$SUMIKA_SHELL_ROOT"

if [ $# -lt 1 ]; then
    echo "Usage: $0 <action-id> [args...]" >&2
    echo "   or: $0 list" >&2
    echo "   or: $0 query <action-id>" >&2
    echo "   or: $0 status" >&2
    echo "   or: $0 isAvailable <action-id>" >&2
    exit 2
fi

# Resolve the bar quickshell PID. `qs -p <dir> ipc call` fails to match
# running instances launched with an explicit `-p` (reports "No running
# instances"); `qs ipc --pid` is the reliable addressing mode.
bar_pid() {
    pgrep -f "(quickshell|qs).* -p ${_sumika_root}/apps/sumika-bar( |$)" | head -1
}

# Normalize a `qs ipc call` string return: the CLI may print JSON text either
# bare or shell-quoted. If the whole output is a quoted string containing
# JSON, unwrap it.
normalize_ipc_json() {
    local out="${1:-}"
    if command -v jq >/dev/null 2>&1 && printf '%s' "$out" | jq -e 'type == "string"' >/dev/null 2>&1; then
        printf '%s' "$out" | jq -r '.'
    else
        printf '%s' "$out"
    fi
}

_qs_base=("${SUMIKA_QS_BIN:-qs}")
_ipc_addr=(ipc --pid "$(bar_pid || true)")

case "$1" in
    list)
        # action.list returns JSON TEXT (Quickshell IPC cannot serialize
        # list/object returns — see K8 in the 2026-08-14 review).
        "${_qs_base[@]}" "${_ipc_addr[@]}" call action list
        ;;
    query)
        if [ $# -lt 2 ]; then
            echo "Usage: $0 query <action-id>" >&2
            exit 2
        fi
        "${_qs_base[@]}" "${_ipc_addr[@]}" call action query "$2"
        ;;
    status)
        # Print a human-readable status summary
        actions=$(normalize_ipc_json "$("${_qs_base[@]}" "${_ipc_addr[@]}" call action list 2>/dev/null)" || echo "[]")
        if [ -z "$actions" ] || [ "$actions" = "[]" ]; then
            echo "No actions registered (bar process may not be running)"
            exit 1
        fi

        # Try jq for better formatting
        if command -v jq >/dev/null 2>&1; then
            total=$(echo "$actions" | jq -r '. | length')
            enabled=$(echo "$actions" | jq -r '[.[] | select(.enabled == true)] | length')
            disabled=$(( total - enabled ))
            echo "Actions: $total total ($enabled enabled, $disabled disabled)"
            echo ""

            owners=$(echo "$actions" | jq -r 'group_by(.owner) | map({owner: .[0].owner, count: length}) | .[] | "\(.owner): \(.count)"')
            while IFS= read -r line; do
                echo "  $line"
            done <<< "$owners"
        else
            echo "Installed jq for structured output"
            echo "$actions"
        fi
        ;;
    isAvailable)
        if [ $# -lt 2 ]; then
            echo "Usage: $0 isAvailable <action-id>" >&2
            exit 2
        fi
        result=$("${_qs_base[@]}" "${_ipc_addr[@]}" call action isAvailable "$2")
        if [ "$result" = "true" ]; then
            echo "true"
            exit 0
        else
            echo "false"
            exit 1
        fi
        ;;
    *)
        action_id="$1"
        shift
        # Hyprland bindings use the conventional `--` separator before action
        # parameters (for example: input-method.cycle -- -1). It separates
        # sumika-action's own arguments and must not reach the QML callback.
        if [ "${1:-}" = "--" ]; then
            shift
        fi

        # Forward extra args as IPC positional string arguments to the handler.
        # qs ipc call action call <id> [params]  ->  call(id, params) in the IpcHandler
        #   sumika-action voice.toggle              -> call("voice.toggle", "")
        #   sumika-action input-method.cycle 1     -> call("input-method.cycle", "1")
        if [ $# -eq 0 ]; then
            "${_qs_base[@]}" "${_ipc_addr[@]}" call action call "$action_id" ""
        else
            # First extra arg is the params string; sumika-action passes only one extra arg.
            "${_qs_base[@]}" "${_ipc_addr[@]}" call action call "$action_id" "$*"
        fi
        ;;
esac
