#!/usr/bin/env bash
set -u

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PATH="$HOME/.local/bin:$PATH"
failed=0
warned=0

ok() {
  printf 'OK   %s\n' "$1"
}

warn() {
  warned=1
  printf 'WARN %s\n' "$1"
}

fail() {
  failed=1
  printf 'FAIL %s\n' "$1"
}

check_cmd() {
  local cmd="$1"
  local label="${2:-$1}"

  if command -v "$cmd" >/dev/null 2>&1; then
    ok "$label"
  else
    fail "$label missing: $cmd"
  fi
}

check_optional_cmd() {
  local cmd="$1"
  local label="${2:-$1}"

  if command -v "$cmd" >/dev/null 2>&1; then
    ok "$label"
  else
    warn "$label missing: $cmd"
  fi
}

check_link() {
  local target="$1"
  local expected="$2"

  if [[ -L "$target" && "$(readlink -f "$target")" == "$(readlink -f "$expected")" ]]; then
    ok "$target -> $expected"
  else
    fail "$target is not linked to $expected"
  fi
}

check_font() {
  local family="$1"
  local label="${2:-$1}"
  local resolved

  if ! command -v fc-match >/dev/null 2>&1; then
    warn "$label cannot be checked: fc-match missing"
    return
  fi

  resolved="$(fc-match -f '%{family[0]}' "$family" 2>/dev/null || true)"
  if [[ "$resolved" == "$family" ]]; then
    ok "$label"
  else
    warn "$label missing or falling back: requested '$family', got '${resolved:-unknown}'"
  fi
}

section() {
  printf '\n[%s]\n' "$1"
}

section "runtime symlinks"
check_link "$HOME/.config/quickshell" "$repo/quickshell"
check_link "$HOME/.config/omd" "$repo"

section "terminal configs"
for tc in foot kitty alacritty ghostty; do
  if [[ -d "$HOME/.config/$tc" ]]; then
    ok "$HOME/.config/$tc exists"
  else
    fail "$HOME/.config/$tc is missing"
  fi
done

section "core commands"
for cmd in qs quickshell hyprctl jq curl swaybg systemd-run; do
  check_cmd "$cmd"
done

section "Go settings TUI"
settings_tui="$repo/tui-go/omd-settings-tui"
if command -v go >/dev/null 2>&1; then
  ok "Go toolchain: $(go version 2>/dev/null || printf 'available')"
else
  fail "Go toolchain missing; run ./Init.sh before building OMD settings"
fi
if [[ -x "$settings_tui" ]]; then
  if [[ -n "$(find "$repo/tui-go" -type f \
      \( -name '*.go' -o -name 'go.mod' -o -name 'go.sum' \) \
      -newer "$settings_tui" -print -quit 2>/dev/null)" ]]; then
    warn "Go settings binary is older than its source; run scripts/build-go-tools"
  else
    ok "Go settings binary"
  fi
else
  fail "Go settings binary missing; run scripts/build-go-tools or ./Init.sh"
fi

section "desktop helpers"
for cmd in wl-copy wl-paste cliphist mako grim slurp swappy hyprpicker; do
  check_optional_cmd "$cmd"
done
for cmd in pavucontrol bluetoothctl nm-connection-editor nmtui kitty fish; do
  check_optional_cmd "$cmd"
done

section "display extras"
check_cmd wlr-randr "wlr-output display management"
for cmd in ddcutil ffplay hyprsunset satty; do
  check_optional_cmd "$cmd"
done

section "pickers"
if command -v kdialog >/dev/null 2>&1 || command -v zenity >/dev/null 2>&1; then
  ok "file/folder picker available"
else
  warn "file/folder picker missing: install kdialog or zenity"
fi

section "login keyring"
check_cmd gnome-keyring-daemon "GNOME Keyring daemon"
pam_keyring_module="$(find /usr/lib /lib -path '*/security/pam_gnome_keyring.so' -print -quit 2>/dev/null || true)"
if [[ -n "$pam_keyring_module" ]]; then
  ok "GNOME Keyring PAM module: $pam_keyring_module"
else
  fail "GNOME Keyring PAM module missing; install gnome-keyring-pam (Fedora), libpam-gnome-keyring (Debian), or gnome-keyring (Arch)"
fi
if [[ -f /etc/pam.d/sddm ]]; then
  if grep -Eq '^[[:space:]]*-?auth.*pam_gnome_keyring\.so' /etc/pam.d/sddm \
      && grep -Eq '^[[:space:]]*-?session.*pam_gnome_keyring\.so.*auto_start' /etc/pam.d/sddm; then
    ok "SDDM passes the login password to GNOME Keyring"
  else
    warn "SDDM PAM does not enable GNOME Keyring auth and auto_start; login cannot unlock the keyring automatically"
  fi
else
  warn "SDDM PAM configuration not found; verify keyring auto-unlock for the active display manager"
fi

section "fonts"
check_font "Cantarell" "main UI font"
check_font "Noto Color Emoji" "emoji font"
check_font "JetBrainsMono Nerd Font Mono" "Nerd Font icons"
check_font "MesloLGS Nerd Font Mono" "monospace UI font"
check_font "Material Symbols Rounded" "Material Symbols icons"

section "OCR / PaddleOCR"
if python3 -c "import paddleocr" >/dev/null 2>&1; then
  ok "paddleocr Python package"
else
  warn "paddleocr Python package missing; pip install paddleocr onnxruntime"
fi
if python3 -c "import onnxruntime" >/dev/null 2>&1; then
  ok "onnxruntime Python package"
else
  warn "onnxruntime Python package missing; pip install paddleocr onnxruntime"
fi
if [[ -x "$repo/bin/omd-ocr" ]]; then
  ok "omd-ocr helper script"
else
  fail "omd-ocr helper script missing"
fi

section "voice input"
check_cmd parecord "parecord"
check_optional_cmd ydotool "ydotool auto-paste"
if [[ -x "$HOME/.cache/omd-voice/venv/bin/python3" ]]; then
  ok "voice venv"
else
  warn "voice venv missing: run bin/omd-voice-setup or use the voice popup setup action"
fi
if [[ -f "$HOME/.cache/omd-voice/sense-voice-small-int8/model.int8.onnx" && -f "$HOME/.cache/omd-voice/sense-voice-small-int8/tokens.txt" ]]; then
  ok "SenseVoice model cache"
else
  warn "SenseVoice model missing: run bin/omd-voice-download or use the voice popup download action"
fi

section "wallpaper"
_sumika_cfg="${SUMIKA_SHELL_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/sumika-shell}"
_cfg_file="$_sumika_cfg/quickshell/config.json"
[ -f "$_cfg_file" ] || _cfg_file="$repo/quickshell/config.json"
wallpaper="$(jq -r '.background.wallpaperPath // ""' "$_cfg_file" 2>/dev/null || true)"
if [[ -n "$wallpaper" ]]; then
  expanded="${wallpaper/#\~/$HOME}"
  if [[ -f "$expanded" ]]; then
    ok "configured wallpaper exists"
  else
    fail "configured wallpaper missing: $wallpaper"
  fi
else
  warn "no configured wallpaperPath"
fi
if [[ -f "$repo/current/background" ]]; then
  ok "current OMD background resolves to an image"
else
  fail "current OMD background is missing or broken; run omd-theme-bg-set or choose a wallpaper"
fi

section "privacy scan"
home_re="$(printf '%s' "$HOME" | sed 's/[.[\*^$()+?{}|]/\\&/g')"
if rg -n --hidden -S "$home_re" "$repo" -g '!.git/**' -g '!docs/**' >/tmp/omd-doctor-home-paths 2>/dev/null; then
  warn "tracked files may contain this machine's absolute home path; see /tmp/omd-doctor-home-paths"
else
  ok "no current home path outside docs"
fi

printf '\n'
if (( failed )); then
  printf 'OMD doctor finished with failures.\n'
  exit 1
elif (( warned )); then
  printf 'OMD doctor finished with warnings.\n'
  exit 0
else
  printf 'OMD doctor finished cleanly.\n'
  exit 0
fi
