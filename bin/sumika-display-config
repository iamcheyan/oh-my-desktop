#!/bin/sh
set -eu

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
. "$repo_root/lib/paths.sh"

display_bin="$repo_root/quickshell/modules/display/bin/sumika-display-config"

if [ -x "$display_bin" ]; then
    exec "$display_bin" "$@"
else
    printf 'sumika-display-config: binary not found at %s\n' "$display_bin" >&2
    exit 1
fi
