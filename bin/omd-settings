#!/bin/sh
set -eu

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
export OMD_REPO_ROOT="$repo_root"

app_dir="$repo_root/quickshell/modules/settings"

if [ ! -d "$app_dir" ]; then
    printf 'omd-settings: settings module not found at %s — install sumika-modules or add settings to quickshell/modules/\n' "$app_dir" >&2
    exit 1
fi

exec "$app_dir/bin/omd-settings" "$@"
