#!/bin/sh
set -eu

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
export OMD_REPO_ROOT="$repo_root"

. "$repo_root/lib/paths.sh"

# Find the settings module: core path first, then external.
# bin/omd-settings is a CLI dispatcher, same pattern as omd-screenshot, omd-restart, etc.
app_dir="$repo_root/quickshell/modules/settings"
if [ ! -d "$app_dir" ]; then
    if [ -n "${SUMIKA_MODULES_HOME:-}" ] && [ -d "$SUMIKA_MODULES_HOME/settings" ]; then
        app_dir="$SUMIKA_MODULES_HOME/settings"
    else
        printf 'omd-settings: settings module not found — install sumika-modules or add settings to quickshell/modules/\n' >&2
        exit 1
    fi
fi

exec "$app_dir/bin/omd-settings" "$@"
