#!/bin/sh
set -eu

# On-demand Settings Center process.
# Usage:
#   omd-settings              # open overview page
#   omd-settings open <page>  # open specific page
#   omd-settings close         # close running instance
#   omd-settings toggle <page> # toggle specific page
#
# When started fresh, exports OMD_SETTINGS_ON_DEMAND=1 so shell.qml
# auto-opens the settings dialog and quits when dismissed.

app_dir="$HOME/.config/omd/apps/omd-settings"

is_running() {
    pgrep -af "(quickshell|qs).* -p ${app_dir}( |$)" >/dev/null 2>&1
}

ipc_call() {
    qs -p "$app_dir" ipc call settings "$1" 2>/dev/null || true
}

launch_direct() {
    qs_bin="${OMD_QS_BIN:-}"
    if [ -z "$qs_bin" ]; then
        if [ -x /usr/bin/qs ]; then
            qs_bin=/usr/bin/qs
        elif [ -x /usr/bin/quickshell ]; then
            qs_bin=/usr/bin/quickshell
        elif [ -x "$HOME/.local/bin/qs" ]; then
            qs_bin="$HOME/.local/bin/qs"
        elif [ -x "$HOME/.local/bin/quickshell" ]; then
            qs_bin="$HOME/.local/bin/quickshell"
        fi
    fi
    if [ -z "$qs_bin" ]; then
        echo "Quickshell executable not found" >&2
        exit 127
    fi

    repo_root="${OMD_REPO_ROOT:-$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)}"
    export OMD_REPO_ROOT="$repo_root"
    export OMD_QUICKSHELL_DIR="$repo_root/quickshell"
    export QS_CONFIG_DIR="$app_dir"
    export QS_COMPOSITOR=hyprland
    export OMD_APP_DIR="$app_dir"
    export OMD_SETTINGS_ON_DEMAND=1
    export OMD_SETTINGS_PAGE="${1:-overview}"

    if [ -z "${WAYLAND_DISPLAY:-}" ]; then
        runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
        for socket in "$runtime_dir"/wayland-*; do
            if [ -S "$socket" ]; then
                export WAYLAND_DISPLAY="$(basename "$socket")"
                break
            fi
        done
    fi

    exec "$qs_bin" -p "$app_dir"
}

action="${1:-open}"
page="${2:-overview}"

case "$action" in
    open)
        if is_running; then
            ipc_call "open" "$page"
        else
            launch_direct "$page"
        fi
        ;;
    close)
        if is_running; then
            ipc_call "close"
        fi
        ;;
    toggle)
        if is_running; then
            ipc_call "toggle" "$page"
        else
            launch_direct "$page"
        fi
        ;;
    *)
        echo "usage: omd-settings [open|close|toggle] [page]" >&2
        echo "  page: overview|network|bluetooth|sound|display|appearance|power|notifications|system|voice|keyremap|windows" >&2
        exit 2
        ;;
esac
