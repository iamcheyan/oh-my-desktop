#!/usr/bin/env bash
set -euo pipefail

STATE_DIR="${SUMIKA_SHELL_STATE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}/sumika-shell}/wallpaper"
SOURCE_FILE="$STATE_DIR/source"
MODE_FILE="$STATE_DIR/mode"
INTERVAL_FILE="$STATE_DIR/interval"
INTERVAL_SEC="${OMD_WALLPAPER_INTERVAL_SEC:-$(cat "$INTERVAL_FILE" 2>/dev/null || printf '3600')}"
UNIT_NAME="omd-wallpaper-random"
RENDER_UNIT_NAME="omd-wallpaper-renderer"
RENDER_LOG="$STATE_DIR/renderer.log"

if [[ ! "$INTERVAL_SEC" =~ ^[0-9]+$ ]] || (( INTERVAL_SEC < 1 )); then
  INTERVAL_SEC=3600
fi

image_find_expr=(
  -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' -o
  -iname '*.bmp' -o -iname '*.gif'
)

notify() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a "OMD Wallpaper" "$1" "${2:-}" >/dev/null 2>&1 || true
  fi
}

ensure_state_dir() {
  mkdir -p "$STATE_DIR"
}

stop_renderer() {
  if command -v systemctl >/dev/null 2>&1; then
    systemctl --user stop "$RENDER_UNIT_NAME.service" >/dev/null 2>&1 || true
    systemctl --user reset-failed "$RENDER_UNIT_NAME.service" >/dev/null 2>&1 || true
  fi
  pkill -x swaybg >/dev/null 2>&1 || true

  # Do not race a retiring renderer when changing images quickly.
  for _ in {1..20}; do
    pgrep -x swaybg >/dev/null 2>&1 || return 0
    sleep 0.025
  done
}

start_renderer() {
  local render_log="$RENDER_LOG"
  ensure_state_dir

  if ! command -v swaybg >/dev/null 2>&1; then
    echo "swaybg is required to render the desktop wallpaper" >&2
    return 1
  fi

  stop_renderer
  if touch "$render_log" >/dev/null 2>&1; then
    : > "$render_log"
  else
    render_log="${XDG_RUNTIME_DIR:-/tmp}/omd-wallpaper-renderer.log"
    if ! touch "$render_log" >/dev/null 2>&1; then
      render_log="/dev/null"
    fi
  fi

  # Rotation runs in a short-lived transient service. A detached child still
  # belongs to that service's cgroup and is killed when the rotation command
  # exits, leaving previews updated but the real desktop black. Keep swaybg in
  # its own service so every caller publishes to the same persistent renderer.
  if command -v systemd-run >/dev/null 2>&1 && systemctl --user is-active default.target >/dev/null 2>&1; then
    for _ in {1..20}; do
      [[ "$(systemctl --user show "$RENDER_UNIT_NAME.service" -p LoadState --value 2>/dev/null || true)" == "not-found" ]] && break
      sleep 0.025
    done
    systemd-run --user --quiet --collect \
      --unit="$RENDER_UNIT_NAME" \
      --description="OMD wallpaper renderer" \
      --property=Restart=on-failure \
      --property=RestartSec=1s \
      --property="StandardOutput=append:$render_log" \
      --property="StandardError=append:$render_log" \
      swaybg "$@"
  else
    setsid -f swaybg "$@" >>"$render_log" 2>&1
  fi
}

render_image() {
  local image="$1"
  [[ -f "$image" ]] || {
    echo "Wallpaper not found: $image" >&2
    return 1
  }
  start_renderer -i "$image" -m fill
}

render_color() {
  start_renderer -c "$1"
}

theme_background_color() {
  local colors_file="${SUMIKA_SHELL_STATE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}/sumika-shell}/theme/current/colors.toml"

  if [[ ! -f "$colors_file" ]]; then
    printf '#000000\n'
    return
  fi

  python3 - "$colors_file" <<'PY'
import sys, re
path = sys.argv[1]
try:
    with open(path, encoding="utf-8") as f:
        content = f.read()
except Exception:
    print("#000000")
    sys.exit(0)

colors = {}
for line in content.splitlines():
    line = line.strip()
    if not line or line.startswith('#'):
        continue
    m = re.match(r'^([a-zA-Z0-9_]+)\s*=\s*["\']([^"\']+)["\']', line)
    if m:
        colors[m.group(1)] = m.group(2)

bg = colors.get("background", "#000000")
tint = colors.get("accent") or colors.get("selection_background") or colors.get("foreground")
if not tint:
    print(bg)
    sys.exit(0)

bg = bg.lstrip('#')
tint = tint.lstrip('#')
r1, g1, b1 = int(bg[0:2], 16), int(bg[2:4], 16), int(bg[4:6], 16)
r2, g2, b2 = int(tint[0:2], 16), int(tint[2:4], 16), int(tint[4:6], 16)
r = int(r1 * 0.92 + r2 * 0.08)
g = int(g1 * 0.92 + g2 * 0.08)
b = int(b1 * 0.92 + b2 * 0.08)
print(f"#{r:02x}{g:02x}{b:02x}")
PY
}

stop_timer() {
  if command -v systemctl >/dev/null 2>&1; then
    systemctl --user stop "$UNIT_NAME.timer" "$UNIT_NAME.service" >/dev/null 2>&1 || true
    systemctl --user reset-failed "$UNIT_NAME.timer" "$UNIT_NAME.service" >/dev/null 2>&1 || true
  fi
}

focus_picker() {
  local title="$1"
  command -v hyprctl >/dev/null 2>&1 || return 0

  # Native pickers are separate Wayland clients, so they cannot inherit the
  # terminal's parent relationship. Raise the uniquely titled picker after it
  # maps; the second attempt covers slower GTK/KDE cold starts.
  (
    sleep 0.12
    hyprctl dispatch focuswindow "title:^${title}$" >/dev/null 2>&1 || true
    sleep 0.28
    hyprctl dispatch focuswindow "title:^${title}$" >/dev/null 2>&1 || true
  ) &
}

start_timer() {
  stop_timer
  if command -v systemd-run >/dev/null 2>&1 && systemctl --user is-active default.target >/dev/null 2>&1; then
    systemd-run --user --quiet --collect \
      --unit="$UNIT_NAME" \
      --on-active="${INTERVAL_SEC}s" \
      --on-unit-active="${INTERVAL_SEC}s" \
      "$(dirname "$0")/omd-wallpaper" random >/dev/null
  fi
}

pick_image_file() {
  local title="Select wallpaper image"
  focus_picker "$title"
  if command -v kdialog >/dev/null 2>&1; then
    kdialog --title "$title" --getopenfilename "$HOME/Pictures" "Images (*.jpg *.jpeg *.png *.webp *.bmp *.gif)" 2>/dev/null < /dev/null
  elif command -v zenity >/dev/null 2>&1; then
    zenity --file-selection --title="$title" --modal \
      --file-filter='Images | *.jpg *.jpeg *.png *.webp *.bmp *.gif' 2>/dev/null < /dev/null
  else
    return 1
  fi
}

pick_image_dir() {
  local title="Select wallpaper folder"
  focus_picker "$title"
  if command -v kdialog >/dev/null 2>&1; then
    kdialog --title "$title" --getexistingdirectory "$HOME/Pictures" 2>/dev/null < /dev/null
  elif command -v zenity >/dev/null 2>&1; then
    zenity --file-selection --directory --title="$title" --modal 2>/dev/null < /dev/null
  else
    return 1
  fi
}


set_image() {
  local image="$1"

  if [[ ! -f "$image" ]]; then
    notify "Wallpaper not found" "$image"
    echo "Wallpaper not found: $image" >&2
    exit 1
  fi

  stop_timer
  ensure_state_dir
  realpath "$image" > "$SOURCE_FILE"
  echo "file" > "$MODE_FILE"
  omd-theme-bg-set "$image"
  notify "Wallpaper changed" "$(basename "$image")"
}

folder_images() {
  local folder="$1"
  find -L "$folder" -maxdepth 1 -type f \( "${image_find_expr[@]}" \) -print 2>/dev/null | sort
}

random_from_folder() {
  local folder="$1"
  local selected

  if [[ ! -d "$folder" ]]; then
    notify "Wallpaper folder not found" "$folder"
    echo "Wallpaper folder not found: $folder" >&2
    exit 1
  fi

  selected="$(folder_images "$folder" | shuf -n 1)"
  if [[ -z "$selected" ]]; then
    notify "No wallpapers in folder" "$folder"
    echo "No wallpapers in folder: $folder" >&2
    exit 1
  fi

  omd-theme-bg-set "$selected"
}

set_folder() {
  local folder="$1"

  ensure_state_dir
  realpath "$folder" > "$SOURCE_FILE"
  echo "folder" > "$MODE_FILE"
  random_from_folder "$folder"
  start_timer
  notify "Wallpaper rotation enabled" "$(realpath "$folder")"
}

random_saved() {
  local mode source

  mode="$(cat "$MODE_FILE" 2>/dev/null || true)"
  source="$(cat "$SOURCE_FILE" 2>/dev/null || true)"
  [[ "$mode" == "folder" && -n "$source" ]] || exit 0
  random_from_folder "$source"
}

set_color() {
  stop_timer
  ensure_state_dir
  echo "color" > "$MODE_FILE"

  local bg_color
  bg_color="$(theme_background_color)"
  [[ -n "$bg_color" ]] || bg_color="#000000"

  render_color "$bg_color"

  local _sumika_cfg="${SUMIKA_SHELL_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/sumika-shell}"
  local quickshell_config="$_sumika_cfg/sumika.json"
  if [[ -f "$quickshell_config" ]] && command -v jq >/dev/null 2>&1; then
    local tmp
    tmp="$(mktemp)"
    jq '.background.wallpaperPath = "" | .background.thumbnailPath = ""' "$quickshell_config" >"$tmp" &&
      mv "$tmp" "$quickshell_config"
    rm -f "$tmp"
  fi

  notify "Wallpaper set to solid color" "$bg_color"
}

refresh_outputs() {
  local mode current_background
  mode="$(cat "$MODE_FILE" 2>/dev/null || echo "file")"
  current_background="$STATE_DIR/background"

  # Recreate swaybg after the output topology changes without changing the
  # selected source, rotation mode, interval, or timer deadline.
  if [[ "$mode" == "color" ]]; then
    render_color "$(theme_background_color)"
  elif [[ -f "$current_background" ]]; then
    render_image "$current_background"
  else
    restore
  fi
}

restore() {
  local mode source current_background
  mode="$(cat "$MODE_FILE" 2>/dev/null || true)"
  source="$(cat "$SOURCE_FILE" 2>/dev/null || true)"
  current_background="$STATE_DIR/background"
  if [[ "$mode" == "folder" && -n "$source" ]]; then
    # Folder mode previously restored only its timer. The preview still read
    # the managed image, but no swaybg process existed to paint the desktop.
    if [[ -f "$current_background" ]]; then
      render_image "$current_background"
    else
      random_from_folder "$source"
    fi
    start_timer
  elif [[ "$mode" == "color" ]]; then
    set_color
  else
    if [[ -n "$source" && -f "$source" ]]; then
      omd-theme-bg-set "$source"
    fi
  fi
}

restart_rotation() {
  local mode source

  mode="$(cat "$MODE_FILE" 2>/dev/null || true)"
  source="$(cat "$SOURCE_FILE" 2>/dev/null || true)"
  if [[ "$mode" != "folder" || -z "$source" || ! -d "$source" ]]; then
    echo "Wallpaper folder rotation is not active" >&2
    exit 1
  fi
  random_from_folder "$source"
  start_timer
}

status() {
  local mode source current
  mode="$(cat "$MODE_FILE" 2>/dev/null || echo "file")"
  source="$(cat "$SOURCE_FILE" 2>/dev/null || true)"
  current="$(readlink -f "$STATE_DIR/background" 2>/dev/null || true)"
  printf 'mode=%s\nsource=%s\ncurrent=%s\ninterval=%s\n' "$mode" "$source" "$current" "$INTERVAL_SEC"
}

case "${1:-}" in
  pick-file)
    path="$(pick_image_file || true)"
    [[ -n "${path:-}" ]] && set_image "$path"
    ;;
  pick-folder)
    path="$(pick_image_dir || true)"
    [[ -n "${path:-}" ]] && set_folder "$path"
    ;;
  set-file)
    [[ -n "${2:-}" ]] || { echo "usage: omd-wallpaper set-file <image>" >&2; exit 2; }
    set_image "$2"
    ;;
  set-folder)
    [[ -n "${2:-}" ]] || { echo "usage: omd-wallpaper set-folder <folder>" >&2; exit 2; }
    set_folder "$2"
    ;;
  random)
    random_saved
    ;;
  restore)
    restore
    ;;
  restart)
    restart_rotation
    ;;
  refresh-outputs)
    refresh_outputs
    ;;
  stop)
    stop_timer
    ensure_state_dir
    echo "file" > "$MODE_FILE"
    notify "Wallpaper rotation stopped"
    ;;
  set-color)
    set_color
    ;;
  render-image)
    [[ -n "${2:-}" ]] || { echo "usage: omd-wallpaper render-image <image>" >&2; exit 2; }
    render_image "$2"
    ;;
  render-color)
    [[ -n "${2:-}" ]] || { echo "usage: omd-wallpaper render-color <color>" >&2; exit 2; }
    render_color "$2"
    ;;
  status)
    status
    ;;
  *)
    echo "usage: omd-wallpaper pick-file|pick-folder|set-file <image>|set-folder <folder>|set-color|random|restore|restart|refresh-outputs|stop|status" >&2
    exit 2
    ;;
esac
