#!/bin/sh
set -eu

app_dir="$HOME/.config/omd/apps/omd-bar"

case "${1:-}" in
    dismiss-last)
        qs -p "$app_dir" ipc call notifications dismissLast >/dev/null 2>&1 || true
        ;;
    dismiss-all)
        qs -p "$app_dir" ipc call notifications dismissAll >/dev/null 2>&1 || true
        ;;
    toggle-silent)
        qs -p "$app_dir" ipc call notifications toggleSilent >/dev/null 2>&1 || true
        ;;
    *)
        echo "usage: omd-notification-control dismiss-last|dismiss-all|toggle-silent" >&2
        exit 2
        ;;
esac
