#!/bin/sh
set -eu
_omd_root=$(cd "$(dirname "$0")/.." && pwd)
. "$_omd_root/scripts/omd-path.sh"
app_dir="$_omd_root/apps/omd-bar"

case "${1:-}" in
    dismiss-last)
        "$OMD_QS_BIN" -p "$app_dir" ipc call notifications dismissLast >/dev/null 2>&1 || true
        ;;
    dismiss-all)
        "$OMD_QS_BIN" -p "$app_dir" ipc call notifications dismissAll >/dev/null 2>&1 || true
        ;;
    toggle-silent)
        "$OMD_QS_BIN" -p "$app_dir" ipc call notifications toggleSilent >/dev/null 2>&1 || true
        ;;
    *)
        echo "usage: omd-notification-control dismiss-last|dismiss-all|toggle-silent" >&2
        exit 2
        ;;
esac
