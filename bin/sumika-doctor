#!/usr/bin/env bash
set -u

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$repo/lib/paths.sh"
export PATH="$HOME/.local/bin:$PATH"
failed=0
warned=0

ok() {
  printf 'OK   %s\n' "$1"
}

warn() {
  warned=1
  printf 'WARN %s\n' "$1"
}

fail() {
  failed=1
  printf 'FAIL %s\n' "$1"
}

check_cmd() {
  local cmd="$1"
  local label="${2:-$1}"

  if command -v "$cmd" >/dev/null 2>&1; then
    ok "$label"
  else
    fail "$label missing: $cmd"
  fi
}

check_optional_cmd() {
  local cmd="$1"
  local label="${2:-$1}"

  if command -v "$cmd" >/dev/null 2>&1; then
    ok "$label"
  else
    warn "$label missing: $cmd"
  fi
}

check_link() {
  local target="$1"
  local expected="$2"

  if [[ -L "$target" && "$(readlink -f "$target")" == "$(readlink -f "$expected")" ]]; then
    ok "$target -> $expected"
  else
    fail "$target is not linked to $expected"
  fi
}

check_font() {
  local family="$1"
  local label="${2:-$1}"
  local resolved

  if ! command -v fc-match >/dev/null 2>&1; then
    warn "$label cannot be checked: fc-match missing"
    return
  fi

  resolved="$(fc-match -f '%{family[0]}' "$family" 2>/dev/null || true)"
  if [[ "$resolved" == "$family" ]]; then
    ok "$label"
  else
    warn "$label missing or falling back: requested '$family', got '${resolved:-unknown}'"
  fi
}

section() {
  printf '\n[%s]\n' "$1"
}

section "runtime symlinks"
# ~/.config/sumika-shell is a real config directory managed by chezmoi
_sumika_cfg="${SUMIKA_SHELL_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/sumika-shell}"
if [[ -d "$_sumika_cfg" && -f "$_sumika_cfg/sumika.json" ]]; then
  ok "$_sumika_cfg (real config dir, sumika.json present)"
else
  fail "$_sumika_cfg is missing or incomplete (sumika.json not found)"
fi
if [[ "$SUMIKA_SHELL_ROOT" == "$repo" ]]; then
  ok "SUMIKA_SHELL_ROOT -> $repo"
else
  fail "SUMIKA_SHELL_ROOT does not resolve to $repo"
fi
section "core commands"
if command -v qs >/dev/null 2>&1 || command -v quickshell >/dev/null 2>&1; then
  ok "Quickshell CLI"
else
  fail "Quickshell CLI missing: qs/quickshell"
fi
if command -v Hyprland >/dev/null 2>&1 || command -v hyprland >/dev/null 2>&1; then
  ok "Hyprland compositor"
else
  fail "Hyprland compositor missing: Hyprland/hyprland"
fi
for cmd in hyprctl jq curl python3 systemd-run; do
  check_cmd "$cmd"
done

section "core backends"
for cmd in wpctl nmcli bluetoothctl brightnessctl wlr-randr grim wl-copy \
  hyprpicker foot zenity secret-tool notify-send; do
  check_cmd "$cmd"
done

section "optional core capabilities"
for cmd in pavucontrol nm-connection-editor nmtui ddcutil ffplay hyprsunset; do
  check_optional_cmd "$cmd"
done

section "login keyring"
check_cmd gnome-keyring-daemon "GNOME Keyring daemon"
pam_keyring_module="$(find /usr/lib /lib -path '*/security/pam_gnome_keyring.so' -print -quit 2>/dev/null || true)"
if [[ -n "$pam_keyring_module" ]]; then
  ok "GNOME Keyring PAM module: $pam_keyring_module"
fi
if [[ -f /etc/pam.d/sddm ]]; then
  if grep -Eq '^[[:space:]]*-?auth.*pam_gnome_keyring\.so' /etc/pam.d/sddm \
      && grep -Eq '^[[:space:]]*-?session.*pam_gnome_keyring\.so.*auto_start' /etc/pam.d/sddm; then
    ok "SDDM passes the login password to GNOME Keyring"
  else
    warn "SDDM PAM does not enable GNOME Keyring auth and auto_start; login cannot unlock the keyring automatically"
  fi
else
  warn "SDDM PAM configuration not found; verify keyring auto-unlock for the active display manager"
fi

section "fonts"
check_font "Noto Color Emoji" "emoji font"
check_font "JetBrainsMono Nerd Font Mono" "Nerd Font icons"
check_font "MesloLGS Nerd Font Mono" "monospace UI font"
check_font "Material Symbols Rounded" "Material Symbols icons"

section "wallpaper"
_sumika_cfg="${SUMIKA_SHELL_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/sumika-shell}"
_cfg_file="$_sumika_cfg/sumika.json"
[ -f "$_cfg_file" ] || _cfg_file="$repo/quickshell/config.json"
wallpaper="$(jq -r '.background.wallpaperPath // ""' "$_cfg_file" 2>/dev/null || true)"
if [[ -n "$wallpaper" ]]; then
    expanded="${wallpaper/#\~/$HOME}"
    if [[ -f "$expanded" ]]; then
      ok "configured wallpaper exists"
    else
      warn "configured wallpaper missing: $wallpaper (Core will use its fallback background)"
  fi
else
  warn "no configured wallpaperPath"
fi
_wp_bg="${SUMIKA_SHELL_STATE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}/sumika-shell}/wallpaper/background"
if [[ -f "$_wp_bg" ]]; then
  ok "Sumika Shell wallpaper background resolves to an image"
else
  # Legacy fallback (remove when current/ dir is fully migrated)
  if [[ -f "$repo/current/background" ]]; then
    ok "current Sumika background resolves to an image"
  else
    warn "wallpaper background is not configured; Core will use its fallback background"
  fi
fi

section "privacy scan"
home_re="$(printf '%s' "$HOME" | sed 's/[.[\*^$()+?{}|]/\\&/g')"
if command -v rg >/dev/null 2>&1; then
  privacy_matches="$(rg -n --hidden -S "$home_re" "$repo" -g '!.git/**' -g '!docs/**' 2>/dev/null || true)"
else
  privacy_matches="$(grep -RnsF --exclude-dir=.git --exclude-dir=docs "$HOME" "$repo" 2>/dev/null || true)"
fi
if [[ -n "$privacy_matches" ]]; then
  printf '%s\n' "$privacy_matches" >/tmp/sumika-doctor-home-paths
  warn "tracked files may contain this machine's absolute home path; see /tmp/sumika-doctor-home-paths"
else
  ok "no current home path outside docs"
fi

section "extensions"
_ext_dir="${SUMIKA_SHELL_EXTENSIONS_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/sumika-shell/extensions}"
if [ -d "$_ext_dir" ]; then
    _ext_count=0
    for _ext_json in "$_ext_dir"/*/module.json; do
        [ -f "$_ext_json" ] || continue
        _ext_count=$((_ext_count + 1))
    done
    ok "extensions directory: $_ext_dir ($_ext_count installed; dependencies are extension-owned)"
else
    ok "extensions directory not present — no extensions installed"
fi

# ── Process Supervisor ──

section "process supervisor"
_ps_files=(
    "$repo/quickshell/core/runtime/ProcessSupervisor.qml"
    "$repo/quickshell/core/runtime/ApplicationManager.qml"
)
for f in "${_ps_files[@]}"; do
    if [[ -f "$f" ]]; then
        ok "process supervisor file: $f"
    else
        fail "process supervisor file missing: $f"
    fi
done

_state_log_dir="${SUMIKA_SHELL_STATE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}/sumika-shell}/logs"
if [[ -d "$_state_log_dir" ]]; then
    count=$(find "$_state_log_dir" -name '*.out' -o -name '*.err' 2>/dev/null | wc -l)
    ok "process logs: $_state_log_dir ($count log files)"
else
    warn "process log directory not yet created: $_state_log_dir"
fi

# Check if registry includes kind/entry for application modules
_registry_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/sumika-shell"
_registry_file="$_registry_dir/modules.json"
if [[ -f "$_registry_file" ]]; then
    _app_count=$(jq -r '[.modules[] | select(.kind == "application")] | length' "$_registry_file" 2>/dev/null || echo 0)
    ok "application modules in registry: $_app_count"
else
    warn "module registry not yet generated: $_registry_file"
fi

section "action manager"
_action_script="$repo/bin/sumika-action"
if [[ -x "$_action_script" ]]; then
    ok "sumika-action script: $_action_script"
    # Try to query action status via IPC (non-fatal if bar isn't running)
    if _action_list=$("$_action_script" list 2>/dev/null); then
        if command -v jq >/dev/null 2>&1; then
            _total=$(echo "$_action_list" | jq -r '. | length // 0')
            _enabled=$(echo "$_action_list" | jq -r '[.[] | select(.enabled == true)] | length // 0')
            ok "registered actions: $_total ($_enabled enabled via IPC)"
        else
            ok "registered actions via IPC (install jq for counts)"
        fi
    else
        warn "action IPC not reachable (bar may not be running)"
    fi
else
    warn "sumika-action script missing: $_action_script"
fi

section "service manager"
_am_file="$repo/quickshell/core/runtime/ActionManager.qml"
_sm_file="$repo/quickshell/core/runtime/ServiceManager.qml"
for f in "$_am_file" "$_sm_file"; do
    if [[ -f "$f" ]]; then
        ok "core runtime file: $f"
    else
        fail "core runtime file missing: $f"
    fi
done


printf '\n'
if (( failed )); then
    printf 'Sumika doctor finished with failures.\n'
    exit 1
elif (( warned )); then
    printf 'Sumika doctor finished with warnings.\n'
    exit 0
else
    printf 'Sumika doctor finished cleanly.\n'
    exit 0
fi
