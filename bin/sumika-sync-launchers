#!/usr/bin/env python3
"""
sumika-sync-launchers — Sync .desktop launcher entries from the module registry.

Reads the Sumika Shell module registry (modules.json) and the user's
sumika.json config, then reconciles ~/.local/share/applications/sumika-*.desktop:

  - For every contributes.launchers entry whose module is enabled, write
    (or overwrite) the .desktop file from the manifest fields.
  - For every entry whose module is disabled, remove the .desktop file.
  - For every sumika-*.desktop file on disk that has no matching launcher
    entry in the current registry (e.g. the extension was deleted/uninstalled),
    remove it as a zombie.

This is the declarative replacement for the per-extension syncDesktopFile()
QML functions: extensions only declare `contributes.launchers` in module.json,
the shell startup calls this script, and the lifecycle is handled centrally.

Usage:
  sumika-sync-launchers              # sync and print a summary
  sumika-sync-launchers --quiet       # no output on success
  sumika-sync-launchers --dry-run     # print actions, change nothing

Environment:
  SUMIKA_MODULE_REGISTRY   (default: $XDG_RUNTIME_DIR/sumika-shell/modules.json)
  SUMIKA_SHELL_CONFIG_HOME (default: $XDG_CONFIG_HOME/sumika-shell)
  XDG_DATA_HOME            (default: ~/.local/share)
"""
import json
import os
import sys
from pathlib import Path

# ── Path resolution ──
def runtime_dir() -> Path:
    return Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))

def registry_path() -> Path:
    explicit = os.environ.get("SUMIKA_MODULE_REGISTRY")
    if explicit:
        return Path(explicit)
    return runtime_dir() / "sumika-shell" / "modules.json"


def config_home() -> Path:
    # SUMIKA_SHELL_CONFIG_HOME already points at the sumika-shell config dir
    # (per AGENTS.md path API). Fallback appends /sumika-shell itself.
    explicit = os.environ.get("SUMIKA_SHELL_CONFIG_HOME")
    if explicit:
        return Path(explicit)
    return Path(os.environ.get(
        "XDG_CONFIG_HOME", str(Path.home() / ".config")
    )) / "sumika-shell"

def data_home() -> Path:
    return Path(os.environ.get(
        "XDG_DATA_HOME", str(Path.home() / ".local" / "share")
    ))

def applications_dir() -> Path:
    return data_home() / "applications"

# ── Config / enablement ──

def load_config() -> dict:
    # Unified config via sumika.json; legacy quickshell/config.json as fallback.
    for candidate in (config_home() / "sumika.json", config_home() / "quickshell" / "config.json"):
        if candidate.is_file():
            try:
                return json.loads(candidate.read_text())
            except (json.JSONDecodeError, OSError):
                return {}
    return {}

def product_floor_ids() -> set:
    # Mirror ModuleLoader.productFloorModuleIds. Kept in sync here so the
    # script doesn't need the QML runtime to compute enablement.
    return {
        "launcher", "clock", "notification-popup", "workspaces", "overview",
        "systray", "wifi", "audio", "power-indicator", "display", "settings",
        "on-screen-display",
    }

def is_module_enabled(module_id: str, config: dict) -> bool:
    modules = config.get("modules", {}) or {}
    required = set(modules.get("required", []) or []) | product_floor_ids()
    if module_id in required:
        return True
    if modules.get("enabled", True) is False:
        return False
    disabled = modules.get("disabled", []) or []
    return module_id not in disabled

# ── .desktop rendering ──

def render_desktop(entry: dict, module_path: Path) -> str:
    """Render a .desktop file body from a launcher registry entry.

    `entry` is the contributes.launchers item as merged by the startup
    script: it has moduleId/source injected plus the manifest fields
    (id, name, comment, exec, icon, categories, terminal, startupWmClass).
    `module_path` is the absolute directory of the owning module — used
    to resolve a relative `icon` path to a file:// URL.
    """
    name = entry.get("name") or entry.get("id", "Sumika Module")
    lines = [
        "[Desktop Entry]",
        "Type=Application",
        f"Name={name}",
    ]
    if entry.get("comment"):
        lines.append(f"Comment={entry['comment']}")

    exec_cmd = entry.get("exec") or ""
    if not exec_cmd:
        raise ValueError(f"launcher '{entry.get('id')}' missing exec")
    # Resolve bare command names to absolute paths when the binary exists
    # in the module's bin/ directory. Desktop-launched processes only have
    # a minimal systemd-user PATH — extension bin/ is added at Quickshell
    # startup but not inherited by .desktop launchers.
    if "/" not in exec_cmd:
        bin_candidate = module_path / "bin" / exec_cmd
        if bin_candidate.is_file() and os.access(bin_candidate, os.X_OK):
            exec_cmd = str(bin_candidate)
    lines.append(f"Exec={exec_cmd}")

    icon = entry.get("icon") or ""
    if icon:
        # Relative icon path → resolve against module root.
        if not icon.startswith("/") and not icon.startswith("file:"):
            icon = str(module_path / icon)
        lines.append(f"Icon={icon}")

    terminal = "true" if entry.get("terminal", False) else "false"
    lines.append(f"Terminal={terminal}")

    categories = entry.get("categories") or []
    if categories:
        lines.append("Categories=" + ";".join(categories) + ";")

    if entry.get("startupWmClass"):
        lines.append(f"StartupWMClass={entry['startupWmClass']}")

    if entry.get("noDisplay"):
        lines.append("NoDisplay=true")

    lines.append("")
    return "\n".join(lines)

# ── Sync ──

def sumika_desktop_files_on_disk(apps_dir: Path) -> set:
    """All sumika-*.desktop files currently on disk (filenames only)."""
    if not apps_dir.is_dir():
        return set()
    return {p.name for p in apps_dir.glob("sumika-*.desktop")}

def sync(dry_run: bool = False, quiet: bool = False) -> int:
    reg_path = registry_path()
    if not reg_path.is_file():
        if not quiet:
            print(f"[sync-launchers] no registry at {reg_path}", file=sys.stderr)
        return 0

    try:
        registry = json.loads(reg_path.read_text())
    except (json.JSONDecodeError, OSError) as e:
        print(f"[sync-launchers] failed to read registry: {e}", file=sys.stderr)
        return 1

    launchers = (registry.get("contributes") or {}).get("launchers") or []
    modules = {m["id"]: m for m in (registry.get("modules") or []) if "id" in m}
    config = load_config()

    apps_dir = applications_dir()
    if not dry_run:
        apps_dir.mkdir(parents=True, exist_ok=True)

    wanted_files: set = set()
    created, updated, removed = 0, 0, 0

    # Phase 1: write/refresh .desktop for enabled modules; delete for disabled.
    for entry in launchers:
        lid = entry.get("id")
        if not lid or not lid.startswith("sumika-"):
            # Only manage files we own (sumika- prefix) so we never touch
            # user-installed apps or the windows-vm.desktop legacy entry
            # created by sumika-settings-windows-vm.
            continue
        mod_id = entry.get("moduleId") or ""
        filename = f"{lid}.desktop"
        wanted_files.add(filename)
        target = apps_dir / filename
        enabled = is_module_enabled(mod_id, config)
        if not enabled:
            if target.is_file():
                if not dry_run:
                    target.unlink()
                removed += 1
            continue
        module_path = Path(modules.get(mod_id, {}).get("path", ""))
        try:
            body = render_desktop(entry, module_path)
        except ValueError as e:
            print(f"[sync-launchers] skip {filename}: {e}", file=sys.stderr)
            continue
        existing = target.read_text() if target.is_file() else ""
        if existing == body:
            continue  # unchanged
        if not dry_run:
            target.write_text(body)
        if existing:
            updated += 1
        else:
            created += 1

    # Phase 2: clean up zombies — sumika-*.desktop files on disk that no
    # launcher in the registry claims. This is what handles uninstallation
    # by directory deletion: the next bar restart re-runs sync, finds the
    # .desktop file has no matching launcher entry, and removes it.
    on_disk = sumika_desktop_files_on_disk(apps_dir)
    zombies = on_disk - wanted_files
    for filename in zombies:
        target = apps_dir / filename
        if not dry_run:
            target.unlink()
        removed += 1

    if not quiet or dry_run:
        verb = "would " if dry_run else ""
        print(
            f"[sync-launchers] {verb}created={created} updated={updated} removed={removed} "
            f"({len(launchers)} launchers in registry, {len(on_disk)} files on disk)"
        )
    return 0

def main(argv: list) -> int:
    dry_run = "--dry-run" in argv
    quiet = "--quiet" in argv
    return sync(dry_run=dry_run, quiet=quiet)

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))