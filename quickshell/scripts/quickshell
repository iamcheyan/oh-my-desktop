#!/bin/sh
set -eu

script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
# shellcheck source=../../lib/paths.sh
. "$script_dir/../../lib/paths.sh"

qs_bin=""
for candidate in \
    "$HOME/.local/bin/quickshell" \
    "$HOME/.local/bin/qs" \
    "$(command -v quickshell 2>/dev/null || true)" \
    "$(command -v qs 2>/dev/null || true)"; do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
        qs_bin="$candidate"
        break
    fi
done

if [ -z "$qs_bin" ]; then
    printf 'Quickshell executable not found\n' >&2
    exit 127
fi

config_dir="${1:-${XDG_CONFIG_HOME:-$HOME/.config}/quickshell}"
case "$config_dir" in
    /*) ;;
    *) config_dir="$(pwd)/$config_dir" ;;
esac

export QS_CONFIG_DIR="$config_dir"
export QS_COMPOSITOR=hyprland
export OMD_APP_DIR="$config_dir"

repo_root=$(CDPATH= cd -- "$script_dir/../.." && pwd)
export OMD_REPO_ROOT="$repo_root"
export OMD_QUICKSHELL_DIR="$repo_root/quickshell"

# Runtime directory for generated state (module registry, QML symlinks, etc.)
registry_dir="${SUMIKA_SHELL_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/sumika-shell}"
mkdir -p "$registry_dir"

# QML engine resolves `import qs` by searching each QML_IMPORT_PATH entry
# for `qs/qmldir`. The repo tree is named `quickshell/`, not `qs/`, so
# create a transient symlink to bridge the namespace.
qml_import_root="${registry_dir}/qml"
mkdir -p "$qml_import_root"
ln -sfn "$repo_root/quickshell" "$qml_import_root/qs"
export QML_IMPORT_PATH="$qml_import_root${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}"

# ---------------------------------------------------------------
# Registry generation — always generated, independent of master switch.
# Outputs v2 schema (schemaVersion=2) with contributes.widgets/popupSections/
# settingsPages/services/actions/overviewProviders.
# ---------------------------------------------------------------
registry_file="$registry_dir/modules.json"

# v2 empty template
registry='{"schemaVersion":2,"modules":[],"contributes":{"widgets":[],"popupSections":[],"settingsPages":[],"services":[],"actions":[],"overviewProviders":[],"overlays":[]}}'

# Helper: merge a single manifest into the registry.
# Args: $1 = module.json path, $2 = module root dir
merge_manifest() {
    local manifest="$1" mod_dir="$2"
    local id
    id=$(jq -r '.id // empty' "$manifest" 2>/dev/null || true)
    [ -n "$id" ] || { echo "[sumika] WARN: skipping $manifest — no id field" >&2; return 1; }

    # Validate via omd-module-validate if available
    local validator="$OMD_REPO_ROOT/bin/omd-module-validate"
    if [ -x "$validator" ]; then
        if ! "$validator" "$manifest" >/dev/null 2>&1; then
            echo "[sumika] WARN: manifest validation failed for $id — skipping" >&2
            return 1
        fi
    fi

    # Check for duplicate module ID — first occurrence wins
    if echo "$registry" | jq -e --arg mid "$id" '.modules | any(.id == $mid)' >/dev/null 2>&1; then
        existing_path=$(echo "$registry" | jq -r --arg mid "$id" '(.modules[] | select(.id == $mid) | .path) // "?"')
        echo "[sumika] WARN: duplicate module ID '$id' — already registered at $existing_path, skipping" >&2
        return 0
    fi

    local tmp_reg
    tmp_reg=$(mktemp "$registry_dir/registry.XXXXXX")
    echo "$registry" > "$tmp_reg"

    if new_reg=$(jq -c \
        --slurpfile mod "$manifest" \
        --arg mdir "$mod_dir" \
        --arg mid "$id" \
        '.modules += [{"id": $mid, "path": $mdir, "kind": ($mod[0].kind // ""), "entry": ($mod[0].entry // null), "actionsProvider": ($mod[0].actionsProvider // null)}] |
         .contributes.widgets += (
          ($mod[0].contributes.widgets // ($mod[0].capabilities // {}).barButtons // [])
           | map(. + {component: ("file://" + $mdir + "/" + .component)}
                | .moduleId = (.moduleId // $mid))
         ) |
         .contributes.popupSections += (
          ($mod[0].contributes.popupSections // ($mod[0].capabilities // {}).popupSections // [])
           | map(. + {component: ("file://" + $mdir + "/" + .component)}
                | .moduleId = (.moduleId // $mid))
         ) |
         .contributes.settingsPages += (
          ($mod[0].contributes.settingsPages // ($mod[0].capabilities // {}).settingsPages // [])
           | map(. + {component: ("file://" + $mdir + "/" + .component)}
                | .moduleId = (.moduleId // $mid))
         ) |
         .contributes.services += (
          ($mod[0].contributes.services // ($mod[0].capabilities // {}).services // [])
         ) |
         .contributes.actions += ($mod[0].contributes.actions // [] | map(.moduleId = (.moduleId // $mid))) |
         .contributes.overlays += (
           ($mod[0].contributes.overlays // [])
           | map(. + {component: ("file://" + $mdir + "/" + .component)}
                | .moduleId = (.moduleId // $mid))
         ) |
         .contributes.overviewProviders += ($mod[0].contributes.overviewProviders // [] | map(.moduleId = (.moduleId // $mid)))' \
        "$tmp_reg" 2>&1); then
        registry="$new_reg"
    else
        echo "[sumika] WARN: merge failed for $manifest" >&2
        rm -f "$tmp_reg"
        return 1
    fi
    rm -f "$tmp_reg"
}


# Master switch (modules.enabled) does NOT skip registry generation.
# Discovery always records installed modules; ModuleLoader / omd-restart apply
# product-floor + enable/disable rules at runtime so the minimum desktop
# (clock, workspaces, systray, wifi, audio, power-indicator) still works when
# optional modules are off.
modules_enabled=true
_sumika_config="${SUMIKA_SHELL_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/sumika-shell}"
config_file="$_sumika_config/quickshell/config.json"
# Legacy fallback
[ -f "$config_file" ] || config_file="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/config.json"
if command -v jq >/dev/null 2>&1 && [ -f "$config_file" ]; then
    # jq's alternative operator treats both null and false as missing.  Do not
    # use `.modules.enabled // true` here: it turns an explicit false back on.
    modules_enabled=$(jq -r '
        try (
            if (.modules | type) == "object" and (.modules | has("enabled"))
            then .modules.enabled
            else true
            end
        )
    ' "$config_file" 2>/dev/null || true)
fi
if [ "$modules_enabled" = "false" ]; then
    echo "[sumika] modules.enabled=false — optional modules off; product-floor minimum desktop stays active"
fi



# Merge core product-floor modules from quickshell/modules/
if command -v jq >/dev/null 2>&1; then
    for module_json in "$repo_root/quickshell/modules"/*/module.json; do
        [ -f "$module_json" ] || continue
        merge_manifest "$module_json" "$(dirname "$module_json")"
    done
fi

# No hardcoded fallback: if jq is absent, registry stays empty.
# ModuleLoader handles empty registry gracefully by showing no module-dependent UI.
if [ "$registry" = '{"schemaVersion":2,"modules":[],"contributes":{"widgets":[],"popupSections":[],"settingsPages":[],"services":[],"actions":[],"overviewProviders":[],"overlays":[]}}' ]; then
    echo "[sumika] INFO: empty registry — jq may be missing or no manifests found"
fi

# ── Extensions ───────────────────────────────────────────────────
# Scan for user-installed extensions in the standard directory.
# Extensions are loaded after core modules and cannot override core IDs.
# Each extension has: <extensions_dir>/<id>/module.json
extensions_dir="${SUMIKA_SHELL_EXTENSIONS_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/sumika-shell/extensions}"
ext_qml_root="${registry_dir}/qml_ext"
if [ -d "$extensions_dir" ] && command -v jq >/dev/null 2>&1; then
    mkdir -p "$ext_qml_root/qs/modules"
    for ext_mod_json in "$extensions_dir"/*/module.json; do
        [ -f "$ext_mod_json" ] || continue
        ext_mod_dir=$(dirname "$ext_mod_json")
        ext_id=$(basename "$ext_mod_dir")

        # Skip if already registered by core (core always wins)
        if echo "$registry" | jq -e --arg mid "$ext_id" '.modules | any(.id == $mid)' >/dev/null 2>&1; then
            echo "[sumika] INFO: extension '$ext_id' skipped — already provided by core" >&2
            continue
        fi

        # Merge manifest into registry
        if merge_manifest "$ext_mod_json" "$ext_mod_dir"; then
            # Symlink extension QML into the import path
            ln -sfn "$ext_mod_dir" "$ext_qml_root/qs/modules/$ext_id"
            if [ -f "$ext_mod_dir/qmldir" ]; then
                qml_mod_name=$(grep -E '^module\s+' "$ext_mod_dir/qmldir" 2>/dev/null | awk '{print $2}' | awk -F'.' '{print $NF}' || true)
                if [ -n "$qml_mod_name" ] && [ "$qml_mod_name" != "$ext_id" ]; then
                    ln -sfn "$ext_mod_dir" "$ext_qml_root/qs/modules/$qml_mod_name"
                fi
            fi

            # Add bin/ to PATH if it exists
            if [ -d "$ext_mod_dir/bin" ]; then
                export PATH="$PATH:$ext_mod_dir/bin"
            fi

            echo "[sumika] INFO: loaded extension '$ext_id'" >&2
        fi
    done

    # Add extension QML import path after core so core takes priority
    if [ -n "$(ls -A "$ext_qml_root/qs/modules/" 2>/dev/null)" ]; then
        export QML_IMPORT_PATH="$QML_IMPORT_PATH:$ext_qml_root"
    fi
fi

# Atomic write
tmp_file="$(mktemp "$registry_dir/registry.XXXXXX")"
echo "$registry" > "$tmp_file"
mv "$tmp_file" "$registry_file"
export SUMIKA_MODULE_REGISTRY="$registry_file"

# Log summary
if command -v jq >/dev/null 2>&1; then
    widget_count=$(echo "$registry" | jq -r '.contributes.widgets | length // 0')
    popup_count=$(echo "$registry" | jq -r '.contributes.popupSections | length // 0')
    settings_count=$(echo "$registry" | jq -r '.contributes.settingsPages | length // 0')
    echo "[sumika] Registry: $registry_file (widgets: $widget_count, popupSections: $popup_count, settingsPages: $settings_count)"
else
    echo "[sumika] Registry: $registry_file"
fi
repair_config_json() {
    # User config path (new Sumika Shell location)
    local sumika_config="${SUMIKA_SHELL_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/sumika-shell}"
    local config_file="$sumika_config/quickshell/config.json"
    # Legacy fallback
    [ -f "$config_file" ] || config_file="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/config.json"
    [ -f "$config_file" ] || return 0
    command -v jq >/dev/null 2>&1 || return 0

    tmp_file="$(mktemp)"
    if jq 'del(.audio.levels)' "$config_file" >"$tmp_file"; then
        if ! cmp -s "$config_file" "$tmp_file"; then
            mv "$tmp_file" "$config_file"
        else
            rm -f "$tmp_file"
        fi
    else
        rm -f "$tmp_file"
    fi
}

repair_config_json

if pgrep -af "(quickshell|qs).* -p ${config_dir}$" >/dev/null 2>&1; then
    exit 0
fi

runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
wayland_display="${WAYLAND_DISPLAY:-}"

find_live_hyprland() {
    lock_file=""
    for candidate in "$runtime_dir"/hypr/*/hyprland.lock; do
        [ -f "$candidate" ] || continue
        pid="$(sed -n '1p' "$candidate" 2>/dev/null || true)"
        display="$(sed -n '2p' "$candidate" 2>/dev/null || true)"
        [ -n "$pid" ] || continue
        kill -0 "$pid" 2>/dev/null || continue
        lock_file="$candidate"
        export HYPRLAND_INSTANCE_SIGNATURE="$(basename "$(dirname "$candidate")")"
        [ -n "$display" ] && export WAYLAND_DISPLAY="$display"
        return 0
    done
    return 1
}

if [ -z "$wayland_display" ] || [ ! -S "$runtime_dir/$wayland_display" ]; then
    find_live_hyprland || true
    wayland_display="${WAYLAND_DISPLAY:-}"
fi

if [ -z "$wayland_display" ] || [ ! -S "$runtime_dir/$wayland_display" ]; then
    found_display=""
    for socket in "$runtime_dir"/wayland-*; do
        [ -S "$socket" ] || continue
        found_display="$(basename "$socket")"
        break
    done

    if [ -n "$found_display" ]; then
        export WAYLAND_DISPLAY="$found_display"
    else
        printf 'No Wayland display socket found. Start this from inside Hyprland.\n' >&2
        printf 'Checked: %s/%s\n' "$runtime_dir" "${wayland_display:-wayland-*}" >&2
        exit 1
    fi
fi

if command -v hyprctl >/dev/null 2>&1; then
    attempts=0
    while ! hyprctl monitors >/dev/null 2>&1; do
        find_live_hyprland || true
        attempts=$((attempts + 1))
        [ "$attempts" -ge 20 ] && break
        sleep 0.1
    done
fi

if command -v hyprctl >/dev/null 2>&1 && ! hyprctl monitors >/dev/null 2>&1; then
    printf 'Warning: Hyprland IPC is not responding yet; starting Quickshell anyway.\n' >&2
    printf 'WAYLAND_DISPLAY=%s HYPRLAND_INSTANCE_SIGNATURE=%s\n' \
        "${WAYLAND_DISPLAY:-}" "${HYPRLAND_INSTANCE_SIGNATURE:-}" >&2
fi

if [ -x "$config_dir/run" ]; then
    exec "$config_dir/run"
fi

if "$qs_bin" --help 2>&1 | grep -q -- ' -p'; then
    exec "$qs_bin" -p "$config_dir"
fi

exec "$qs_bin" "$config_dir/shell.qml"
