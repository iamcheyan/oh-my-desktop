#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# shellcheck source=../../scripts/omd-path.sh
. "$script_dir/../../scripts/omd-path.sh"

qs_bin=""
for candidate in \
    "$HOME/.local/bin/quickshell" \
    "$HOME/.local/bin/qs" \
    "$(command -v quickshell 2>/dev/null || true)" \
    "$(command -v qs 2>/dev/null || true)"; do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
        qs_bin="$candidate"
        break
    fi
done

if [ -z "$qs_bin" ]; then
    printf 'Quickshell executable not found\n' >&2
    exit 127
fi

config_dir="${1:-${XDG_CONFIG_HOME:-$HOME/.config}/quickshell}"
case "$config_dir" in
    /*) ;;
    *) config_dir="$(pwd)/$config_dir" ;;
esac

export QS_CONFIG_DIR="$config_dir"
export QS_COMPOSITOR=hyprland
export OMD_APP_DIR="$config_dir"

repo_root=$(CDPATH= cd -- "$script_dir/../.." && pwd)
export OMD_REPO_ROOT="$repo_root"
export OMD_QUICKSHELL_DIR="$repo_root/quickshell"


sumika_config="${SUMIKA_SHELL_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/sumika-shell}"
config_file="$sumika_config/sumika.json"

if [ -d "$SUMIKA_MODULES_HOME" ]; then
    # Always add modules to QML import path so core components (lock, screen
    # saver, etc.) are importable even when the master switch is off.

    # Create symlinks for core modules that need direct QML scanner resolution
    # (e.g., lock screen) under the modules discovery directory.
    # The scanner resolves qs.modules.<name> from <config-dir>/modules/<name>/,
    # which is not covered by QML_IMPORT_PATH.
    for module_dir in "$SUMIKA_MODULES_HOME"/*/; do
        [ -d "$module_dir" ] || continue
        name="$(basename "$module_dir")"
        link_target="$repo_root/quickshell/modules/$name"
        case "$name" in
            lock) ;;  # core modules needing scanner resolution — add more here
            *) continue ;;
        esac
        # Remove stale internal directory if it exists (post-extraction).
        if [ -d "$link_target" ] && [ ! -L "$link_target" ]; then
            rm -rf "$link_target"
        fi
        if [ ! -L "$link_target" ]; then
            ln -sf "$module_dir" "$link_target"
        fi
    done

    for module_json in "$SUMIKA_MODULES_HOME"/*/module.json; do
        [ -f "$module_json" ] || continue
        module_dir=$(dirname "$module_json")
        export QML_IMPORT_PATH="${QML_IMPORT_PATH:+$QML_IMPORT_PATH:}$module_dir"
        if [ -d "$module_dir/bin" ]; then
            export PATH="$module_dir/bin:$PATH"
        fi
    done
fi

# ---------------------------------------------------------------
# Registry generation — always generated, independent of master switch
# ---------------------------------------------------------------
registry_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/sumika-shell"
mkdir -p "$registry_dir"
registry_file="$registry_dir/modules.json"

# Start with empty template
registry='{"schemaVersion":1,"modules":[],"barButtons":[],"popupSections":[],"settingsPages":[]}'

# Merge builtin manifests unconditionally (core bar buttons, alwaysShow info).
# This does not depend on SUMIKA_MODULES_HOME or modules.enabled.
builtin_dir="$repo_root/quickshell/registry/builtin"
if [ -d "$builtin_dir" ]; then
    if command -v jq >/dev/null 2>&1; then
        for manifest_json in "$builtin_dir"/*.json; do
            [ -f "$manifest_json" ] || continue
            tmp_reg=$(mktemp "$registry_dir/registry.XXXXXX")
            echo "$registry" > "$tmp_reg"
            new_reg=$(jq -c --slurpfile mod "$manifest_json" --arg mdir "$repo_root/quickshell" \
                '.modules += [{"id": $mod[0].id, "path": $mdir, "builtin": true}] |
                 .barButtons += ($mod[0].capabilities.barButtons // [] | map(. + {component: ("file://" + $mdir + "/" + .component)} | .moduleId = (.moduleId // $mod[0].id)))' \
                "$tmp_reg" 2>&1) && registry="$new_reg" || echo "[sumika] WARN: builtin merge failed for $manifest_json" >&2
            rm -f "$tmp_reg"
        done
    else
        echo "[sumika] INFO: jq not available — builtin manifests will not be merged"
    fi
fi

# Read master switch from user config
modules_enabled=true
if command -v jq >/dev/null 2>&1 && [ -f "$config_file" ]; then
    modules_enabled=$(jq -r 'try .modules.enabled // "true"' "$config_file" 2>/dev/null || true)
fi
if [ "$modules_enabled" != "false" ]; then
    :  # modules enabled — merge external contributions below
else
    echo "[sumika] modules disabled via sumika.json (builtin buttons still available)"
fi

# Merge external modules only when enabled and directory exists
if [ "$modules_enabled" != "false" ] && [ -d "$SUMIKA_MODULES_HOME" ]; then
    for module_json in "$SUMIKA_MODULES_HOME"/*/module.json; do
        [ -f "$module_json" ] || continue
        module_dir=$(dirname "$module_json")
        if command -v jq >/dev/null 2>&1; then
            tmp_reg=$(mktemp "$registry_dir/registry.XXXXXX")
            echo "$registry" > "$tmp_reg"
            new_reg=$(jq -c --slurpfile mod "$module_json" --arg mdir "$module_dir" \
                '.modules += [{"id": $mod[0].id, "path": $mdir}] |
                 .barButtons += ($mod[0].capabilities.barButtons // [] | map(. + {component: ("file://" + $mdir + "/" + .component)} | .moduleId = (.moduleId // $mod[0].id))) |
                 .popupSections += ($mod[0].capabilities.popupSections // [] | map(. + {component: ("file://" + $mdir + "/" + .component)} | .moduleId = (.moduleId // $mod[0].id))) |
                 .settingsPages += ($mod[0].capabilities.settingsPages // [] | map(. + {component: ("file://" + $mdir + "/" + .component)} | .moduleId = (.moduleId // $mod[0].id)))' \
                "$tmp_reg" 2>&1) && registry="$new_reg" || echo "[sumika] WARN: external module merge failed for $module_json" >&2
            rm -f "$tmp_reg"
        fi
    done
fi

# Fallback: if the registry still has the empty template (no jq for builtin merge),
# write a hardcoded minimal registry so the bar never goes completely empty.
if [ "$registry" = '{"schemaVersion":1,"modules":[],"barButtons":[],"popupSections":[],"settingsPages":[]}' ]; then
    echo "[sumika] WARN: jq unavailable — writing fallback registry with core alwaysShow buttons"
    registry='{
  "schemaVersion": 1,
  "modules": [{"id":"builtin-bar","path":"'"$repo_root"'/quickshell","builtin":true}],
  "barButtons": [
    {"id":"appLauncher","slot":"left","component":"file://'"$repo_root"'/quickshell/modules/bar/AppLauncherButton.qml","order":0,"alwaysShow":true,"moduleId":"builtin"},
    {"id":"activeWindow","slot":"left","component":"file://'"$repo_root"'/quickshell/modules/bar/ActiveWindow.qml","order":10,"alwaysShow":true,"moduleId":"builtin"},
    {"id":"audio","slot":"right","component":"file://'"$repo_root"'/quickshell/modules/bar/modules/AudioButton.qml","order":20,"alwaysShow":true,"moduleId":"builtin"},
    {"id":"wifi","slot":"right","component":"file://'"$repo_root"'/quickshell/modules/bar/modules/WifiButton.qml","order":30,"alwaysShow":true,"moduleId":"builtin"},
    {"id":"clock","slot":"right","component":"file://'"$repo_root"'/quickshell/modules/bar/ClockWidget.qml","order":80,"alwaysShow":true,"moduleId":"builtin"},
    {"id":"sidebarIndicators","slot":"right","component":"file://'"$repo_root"'/quickshell/modules/bar/SidebarIndicators.qml","order":90,"alwaysShow":true,"moduleId":"builtin"}
  ],
  "popupSections": [],
  "settingsPages": []
}'
fi

# Atomic write: temp file + mv
tmp_file="$(mktemp "$registry_dir/registry.XXXXXX")"
echo "$registry" > "$tmp_file"
mv "$tmp_file" "$registry_file"
export SUMIKA_MODULE_REGISTRY="$registry_file"

# Log summary
if command -v jq >/dev/null 2>&1; then
    bar_count=$(echo "$registry" | jq -r '.barButtons | length // 0')
    popup_count=$(echo "$registry" | jq -r '.popupSections | length // 0')
    settings_count=$(echo "$registry" | jq -r '.settingsPages | length // 0')
    echo "[sumika] Registry: $registry_file (barButtons: $bar_count, popupSections: $popup_count, settingsPages: $settings_count)"
else
    echo "[sumika] Registry: $registry_file"
fi
repair_config_json() {
    # User config path (new Sumika Shell location)
    local sumika_config="${SUMIKA_SHELL_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/sumika-shell}"
    local config_file="$sumika_config/quickshell/config.json"
    # Legacy fallback
    [ -f "$config_file" ] || config_file="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/config.json"
    [ -f "$config_file" ] || return 0
    command -v jq >/dev/null 2>&1 || return 0

    tmp_file="$(mktemp)"
    if jq 'del(.audio.levels)' "$config_file" >"$tmp_file"; then
        if ! cmp -s "$config_file" "$tmp_file"; then
            mv "$tmp_file" "$config_file"
        else
            rm -f "$tmp_file"
        fi
    else
        rm -f "$tmp_file"
    fi
}

repair_config_json

if pgrep -af "(quickshell|qs).* -p ${config_dir}$" >/dev/null 2>&1; then
    exit 0
fi

runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
wayland_display="${WAYLAND_DISPLAY:-}"

find_live_hyprland() {
    lock_file=""
    for candidate in "$runtime_dir"/hypr/*/hyprland.lock; do
        [ -f "$candidate" ] || continue
        pid="$(sed -n '1p' "$candidate" 2>/dev/null || true)"
        display="$(sed -n '2p' "$candidate" 2>/dev/null || true)"
        [ -n "$pid" ] || continue
        kill -0 "$pid" 2>/dev/null || continue
        lock_file="$candidate"
        export HYPRLAND_INSTANCE_SIGNATURE="$(basename "$(dirname "$candidate")")"
        [ -n "$display" ] && export WAYLAND_DISPLAY="$display"
        return 0
    done
    return 1
}

if [ -z "$wayland_display" ] || [ ! -S "$runtime_dir/$wayland_display" ]; then
    find_live_hyprland || true
    wayland_display="${WAYLAND_DISPLAY:-}"
fi

if [ -z "$wayland_display" ] || [ ! -S "$runtime_dir/$wayland_display" ]; then
    found_display=""
    for socket in "$runtime_dir"/wayland-*; do
        [ -S "$socket" ] || continue
        found_display="$(basename "$socket")"
        break
    done

    if [ -n "$found_display" ]; then
        export WAYLAND_DISPLAY="$found_display"
    else
        printf 'No Wayland display socket found. Start this from inside Hyprland.\n' >&2
        printf 'Checked: %s/%s\n' "$runtime_dir" "${wayland_display:-wayland-*}" >&2
        exit 1
    fi
fi

if command -v hyprctl >/dev/null 2>&1; then
    attempts=0
    while ! hyprctl monitors >/dev/null 2>&1; do
        find_live_hyprland || true
        attempts=$((attempts + 1))
        [ "$attempts" -ge 20 ] && break
        sleep 0.1
    done
fi

if command -v hyprctl >/dev/null 2>&1 && ! hyprctl monitors >/dev/null 2>&1; then
    printf 'Warning: Hyprland IPC is not responding yet; starting Quickshell anyway.\n' >&2
    printf 'WAYLAND_DISPLAY=%s HYPRLAND_INSTANCE_SIGNATURE=%s\n' \
        "${WAYLAND_DISPLAY:-}" "${HYPRLAND_INSTANCE_SIGNATURE:-}" >&2
fi

if [ -x "$config_dir/run" ]; then
    exec "$config_dir/run"
fi

if "$qs_bin" --help 2>&1 | grep -q -- ' -p'; then
    exec "$qs_bin" -p "$config_dir"
fi

exec "$qs_bin" "$config_dir/shell.qml"
