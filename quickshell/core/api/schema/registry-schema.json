{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qs.core.api.schema/registry-schema.json",
  "title": "Sumika Shell Registry Schema",
  "description": "Defines the structure for built-in registry entries that declare widget/action/provider contributions.",
  "type": "object",
  "required": ["id", "name", "version", "kind"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Globally unique module identifier (e.g. 'core-bar', 'session', 'audio')",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "description": "Human-readable display name"
    },
    "description": {
      "type": "string",
      "description": "Brief description of the module's purpose"
    },
    "version": {
      "type": "string",
      "description": "Semantic version string (e.g. '2.0.0')",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "kind": {
      "type": "string",
      "enum": ["shared", "app"],
      "description": "Module kind: 'shared' for libraries/plugins, 'app' for standalone applications"
    },
    "contributes": {
      "type": "object",
      "description": "Everything the module contributes to the shell",
      "properties": {
        "widgets": {
          "type": "array",
          "description": "Widget contributions for the bar or panels",
          "items": {
            "$ref": "#/$defs/widgetContribution"
          }
        },
        "actions": {
          "type": "array",
          "description": "Action contributions for global shortcut / command dispatch",
          "items": {
            "$ref": "#/$defs/actionContribution"
          }
        },
        "overlays": {
          "type": "array",
          "description": "Overlay contributions that render on top of the bar or shell",
          "items": {
            "$ref": "#/$defs/overlayContribution"
          }
        },
        "overviewProviders": {
          "type": "array",
          "description": "Overview/workspace view provider contributions",
          "items": {
            "$ref": "#/$defs/overviewProviderContribution"
          }
        },
        "popupSections": {
          "type": "array",
          "description": "Popup section contributions for the bar's status popup",
          "items": {
            "$ref": "#/$defs/popupSectionContribution"
          }
        },
        "services": {
          "type": "array",
          "description": "Service contributions — array of service IDs this module provides",
          "items": {
            "$ref": "#/$defs/serviceContribution"
          }
        },
        "settingsPages": {
          "type": "array",
          "description": "Settings page contributions for the settings dialog",
          "items": {
            "$ref": "#/$defs/settingsPageContribution"
          }
        }
      },
      "minProperties": 1
    },
    "schemaVersion": {
      "type": "integer",
      "description": "Schema version number for migration support",
      "minimum": 1
    }
  },
  "$defs": {
    "widgetContribution": {
      "type": "object",
      "required": ["id", "name", "slot", "component", "moduleId"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique widget identifier within the module namespace"
        },
        "name": {
          "type": "string",
          "description": "Human-readable widget name"
        },
        "slot": {
          "type": "string",
          "enum": ["left", "center", "right"],
          "description": "Bar slot position"
        },
        "component": {
          "type": "string",
          "description": "Relative path to the QML component file"
        },
        "order": {
          "type": "integer",
          "description": "Sort order within the slot (lower = first)",
          "minimum": 0
        },
        "alwaysShow": {
          "type": "boolean",
          "description": "Whether the widget is always visible regardless of conditions",
          "default": false
        },
        "moduleId": {
          "type": "string",
          "description": "Owning module ID"
        }
      }
    },
    "actionContribution": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Globally unique action identifier (e.g. 'session.lock')",
          "pattern": "^[a-z0-9]+(\\.[a-z0-9]+)+$"
        },
        "name": {
          "type": "string",
          "description": "Human-readable action name"
        }
      }
    },
    "overviewProviderContribution": {
      "type": "object",
      "required": ["id", "name", "component", "moduleId"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique overview provider identifier"
        },
        "name": {
          "type": "string",
          "description": "Human-readable provider name"
        },
        "component": {
          "type": "string",
          "description": "Relative path to the QML overview component"
        },
        "order": {
          "type": "integer",
          "description": "Display order priority (lower = first)",
          "minimum": 0
        },
        "moduleId": {
          "type": "string",
          "description": "Owning module ID"
        }
      }
    },
    "overlayContribution": {
      "type": "object",
      "required": ["id", "component", "moduleId"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique overlay identifier within the module namespace"
        },
        "name": {
          "type": "string",
          "description": "Human-readable overlay name"
        },
        "priority": {
          "type": "integer",
          "description": "Z-order priority (higher = drawn on top)",
          "minimum": 0,
          "default": 100
        },
        "order": {
          "type": "integer",
          "description": "Load sort order (lower = loaded first)",
          "minimum": 0,
          "default": 100
        },
        "component": {
          "type": "string",
          "description": "Relative path (manifest) or file:// URL (registry) to the QML overlay component"
        },
        "moduleId": {
          "type": "string",
          "description": "Owning module ID"
        }
      }
    },
    "popupSectionContribution": {
      "type": "object",
      "required": ["type", "component", "moduleId"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique popup section identifier within the module namespace"
        },
        "type": {
          "type": "string",
          "description": "Popup section type key used for singleton deduplication (e.g. 'battery', 'audio')"
        },
        "name": {
          "type": "string",
          "description": "Human-readable display name for the popup section"
        },
        "component": {
          "type": "string",
          "description": "Relative path (manifest) or file:// URL (registry) to the QML popup component"
        },
        "moduleId": {
          "type": "string",
          "description": "Owning module ID"
        }
      }
    },
    "serviceContribution": {
      "type": "string",
      "description": "Service ID string (e.g. 'battery', 'mpris-controller'). Services are registered with ServiceManager at runtime."
    },
    "settingsPageContribution": {
      "type": "object",
      "required": ["id", "title", "component", "moduleId"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique settings page identifier within the module namespace"
        },
        "title": {
          "type": "string",
          "description": "Human-readable title for the settings page"
        },
        "icon": {
          "type": "string",
          "description": "Material Design icon name for the settings page entry"
        },
        "component": {
          "type": "string",
          "description": "Relative path (manifest) or file:// URL (registry) to the QML settings page component"
        },
        "order": {
          "type": "integer",
          "description": "Display order priority (lower = first)",
          "minimum": 0
        },
        "moduleId": {
          "type": "string",
          "description": "Owning module ID"
        }
      }
    }
  }
}
