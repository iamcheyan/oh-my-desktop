{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qs.core.api.schema/module-schema.json",
  "title": "Sumika Shell Module Manifest Schema",
  "description": "Defines the structure for external module manifests used by ModuleLoader to discover and register contributed resources.",
  "type": "object",
  "required": ["id", "name", "version", "entry"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Globally unique module identifier (e.g. 'org.example.my-module')",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9]+)*(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "description": "Human-readable module display name"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the module's purpose and capabilities"
    },
    "version": {
      "type": "string",
      "description": "Semantic version string (e.g. '1.0.0')",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "author": {
      "type": "string",
      "description": "Author or organization name"
    },
    "license": {
      "type": "string",
      "description": "SPDX license identifier (e.g. 'MIT', 'GPL-3.0-only')"
    },
    "entry": {
      "oneOf": [
        { "type": "null", "description": "No entry point (shared/overlay modules)" },
        {
          "type": "object",
          "description": "Application entry point for ProcessSupervisor registration",
          "required": ["command", "instance"],
          "properties": {
            "command": {
              "type": "array",
              "description": "Command argv to execute (${OMD_ROOT} is resolved at runtime)",
              "items": { "type": "string" },
              "minItems": 1
            },
            "instance": {
              "type": "string",
              "description": "Unique instance name for ProcessSupervisor tracking"
            },
            "readyTimeout": {
              "type": "integer",
              "description": "Seconds before module is considered ready",
              "minimum": 1
            },
            "appId": {
              "type": "string",
              "description": "Hyprland app-id matching rule (e.g. org.omd.settings)"
            }
          }
        }
      ]
    },
    "kind": {
      "type": "string",
      "description": "Module runtime kind",
      "enum": ["shared", "application", "overlay"]
    },
    "actionsProvider": {
      "type": "string",
      "description": "Relative path to a QML file that registers module actions via ModuleActionHost (e.g. 'module-actions.qml')"
    },
    "trustedInProcess": {
      "type": "boolean",
      "default": false,
      "description": "Marks official modules trusted to load arbitrary QML within the Core process. Third-party modules MUST NOT set this to true."
    },
    "schemaVersion": {
      "type": "integer",
      "description": "Schema version for migration handling (2 = current)",
      "minimum": 1
    },
    "apiVersion": {
      "type": "string",
      "description": "Minimum core API version the module requires",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "depends": {
      "type": "array",
      "description": "List of module IDs this module depends on",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "provides": {
      "type": "array",
      "description": "Service IDs this module provides (e.g. 'audio.v1')",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(\\.[a-z0-9]+)+$"
      },
      "uniqueItems": true
    },
    "contributes": {
      "type": "object",
      "description": "Contributions the module makes to the shell",
      "properties": {
        "widgets": {
          "type": "array",
          "items": {
            "$ref": "registry-schema.json#/$defs/widgetContribution"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "registry-schema.json#/$defs/actionContribution"
          }
        },
        "overviewProviders": {
          "type": "array",
          "items": {
            "$ref": "registry-schema.json#/$defs/overviewProviderContribution"
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "description": "Settings pages contributed by this module",
      "properties": {
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "component"],
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique settings page identifier"
              },
              "title": {
                "type": "string",
                "description": "Page title displayed in settings UI"
              },
              "icon": {
                "type": "string",
                "description": "Icon identifier for the settings page"
              },
              "component": {
                "type": "string",
                "description": "QML component path relative to module root"
              },
              "category": {
                "type": "string",
                "description": "Settings category grouping key"
              },
              "order": {
                "type": "integer",
                "description": "Sort order within category",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
