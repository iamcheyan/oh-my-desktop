{
  "schemaVersion": 2,
  "id": "notification-popup",
  "name": "Notification Popup",
  "description": "Notification popup overlay showing desktop notifications",
  "version": "2.0.0",
  "actionsProvider": "module-actions.qml",
  "kind": "overlay",
  "contributes": {
    "overlays": [
      {"id": "notification-popup", "name": "Notification Popup", "priority": 100, "component": "NotificationPopup.qml"}
    ],
    "actions": [
      {"id": "notifications.dismiss-last", "name": "Dismiss last notification", "description": "Dismiss the most recent notification"},
      {"id": "notifications.dismiss-all", "name": "Dismiss all notifications", "description": "Dismiss all visible notifications"},
      {"id": "notifications.toggle-silent", "name": "Toggle silent mode", "description": "Toggle do-not-disturb mode"},
      {"id": "notifications.edit-muted", "name": "Edit muted apps", "description": "Open muted applications editor"}
    ],
    "popupSections": [
      {"id": "notifications", "type": "notifications", "name": "Notifications", "component": "NotificationsPopup.qml"}
    ]
  }
}
