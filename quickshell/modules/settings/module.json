{
  "schemaVersion": 2,
  "id": "settings",
  "name": "Settings",
  "description": "System settings panels and preferences dialog",
  "version": "2.0.0",
  "kind": "application",
  "entry": {
    "command": ["${SUMIKA_SHELL_ROOT}/bin/sumika-settings", "open"],
    "instance": "sumika-settings",
    "readyTimeout": 15,
    "appId": "io.github.iamcheyan.sumika.settings",
    "autostart": false
  },
  "contributes": {
    "actions": [
      {"id": "settings.open", "name": "Open settings", "description": "Open system settings dialog"}
    ]
  }
}
