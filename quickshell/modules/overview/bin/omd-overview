#!/bin/sh
set -eu

_omd_root="${OMD_REPO_ROOT:-$OMD_ROOT}"
if [ -z "$_omd_root" ] || [ ! -d "$_omd_root" ]; then
    _omd_root="$(cd -- "$(dirname "$0")/../../.." 2>/dev/null && pwd -P)" || true
fi

if [ -z "$_omd_root" ] || [ ! -d "$_omd_root" ]; then
    echo "omd-overview: cannot resolve OMD repo root" >&2
    exit 1
fi

. "$_omd_root/lib/paths.sh"

exec "$OMD_ROOT/quickshell/scripts/quickshell" "$_omd_root/quickshell/modules/overview"
