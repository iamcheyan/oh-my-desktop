#!/bin/sh
set -eu

script_dir="$(cd "$(dirname "$0")/.." && pwd)"
# Resolve to the physical path. The running overview process may have been
# launched via a different alias of the same directory (e.g. the repo path
# different lexical path to the same repository, so its cmdline can show a
# different string than app_dir. Match on the canonical physical path.
app_dir="$(cd "$script_dir" && pwd -P)"

if [ ! -d "$app_dir" ] || [ ! -f "$app_dir/module.json" ]; then
    echo "sumika-overview: overview module not found at $app_dir" >&2
    exit 1
fi

if [ -z "$app_dir" ] || [ ! -d "$app_dir" ]; then
    echo "sumika-overview: module directory not found" >&2
    exit 1
fi

repo_root=$(cd "$(dirname "$0")/../../../.." && pwd -P)
. "$repo_root/lib/paths.sh"
qs_launcher="$SUMIKA_SHELL_ROOT/quickshell/scripts/quickshell"
# Resolve the overview PID once. pgrep scans /proc (~17ms); doing it twice
# (is_running + overview_pid) doubled the per-keystroke latency. Cache the
# result so the hot path (W-Tab repeat at 25Hz) pays it once per invocation.
overview_pid_cached=""
resolve_pid() {
    # Already resolved this invocation
    [ -n "$overview_pid_cached" ] && return 0
    overview_pid_cached=$(pgrep -f "(quickshell|qs).* -p ${app_dir}( |$)" | head -1) || true
    [ -n "$overview_pid_cached" ]
}

is_running() {
    resolve_pid
}

# `qs -p <dir> ipc call` resolves instances by config path and fails against
# processes launched with an explicit `-p` (labwc/autostart path);
# `qs ipc --pid` is the reliable addressing mode (verified 2026-08-09).
ipc_call() {
    resolve_pid || return 0
    "${SUMIKA_QS_BIN:-qs}" ipc --pid "$overview_pid_cached" call overview "$1" 2>/dev/null || true
}

# IPC call whose exit code reflects whether the overview handler responded
# (ipc_call suppresses it with `|| true`). Used to poll process readiness.
ipc_probe() {
    resolve_pid || return 1
    "${SUMIKA_QS_BIN:-qs}" ipc --pid "$overview_pid_cached" call overview "$1" >/dev/null 2>&1
}

launch_direct() {
    # Start the overview process hidden (no open intent). Used by `warm`.
    exec "$qs_launcher" "$app_dir"
}

# Cold-start the overview process and, once its IPC handler is up, deliver
# the requested action over IPC — the same reliable path used when the process
# is already warm. Without this, the first click after a cold start would only
# spawn the process hidden (overviewOpen defaults to false) and require a
# second click to actually show.
launch_and_ipc() {
    action="$1"
    setsid "$qs_launcher" "$app_dir" >/dev/null 2>&1 &
    # Wait up to ~10s for the overview IPC handler to come up, then deliver
    # the action the moment it responds.
    i=0
    while [ "$i" -lt 40 ]; do
        sleep 0.25
        if ipc_probe "$action"; then
            return 0
        fi
        i=$((i + 1))
    done
    return 1
}

case "${1:-toggle}" in
    warm)
        # Pre-warm: start the process hidden if not already running.
        if ! is_running; then
            launch_direct
        fi
        ;;
    toggle)
        if is_running; then
            ipc_call toggle
        else
            launch_and_ipc toggle
        fi
        ;;
    open)
        if is_running; then
            ipc_call open
        else
            launch_and_ipc open
        fi
        ;;
    step)
        # W-Tab hold-to-cycle: cold-start hidden, then deliver step (the
        # first step opens the overview and moves the highlight).
        if is_running; then
            ipc_call step
        else
            launch_and_ipc step
        fi
        ;;
    prev)
        if is_running; then
            ipc_call prev
        else
            launch_and_ipc prev
        fi
        ;;
    close)
        if is_running; then
            ipc_call close
        fi
        ;;
    *)
        if is_running; then
            ipc_call toggle
        else
            launch_and_ipc "${1:-toggle}"
        fi
        ;;
esac
