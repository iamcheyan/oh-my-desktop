#!/usr/bin/env bash
set -euo pipefail

# Audio volume control for the OMD bar OSD. Called from ActionManager.
# MPRIS playback control (--playerctl) kept for backward compatibility.

_omd_root="${OMD_REPO_ROOT:-${OMD_ROOT:-}}"
if [[ -z "$_omd_root" ]]; then
  # Fallback: if script is still in OMD tree (modules/audio/bin/)
  _omd_root="$(cd -- "$(dirname "$0")/../../.." 2>/dev/null && pwd)" || true
fi
if [[ -z "$_omd_root" ]] || [[ ! -d "$_omd_root/quickshell" ]]; then
  echo "omd-swayosd-client: cannot resolve OMD repo root (set OMD_REPO_ROOT or OMD_ROOT)" >&2
  exit 1
fi

# shellcheck source=../../lib/paths.sh (paths.sh provides SUMIKA_SHELL_ROOT, OMD_ROOT, etc.)
. "$_omd_root/lib/paths.sh"
notify_volume_osd() {
  "${OMD_QS_BIN:-qs}" -p "$_omd_root/apps/omd-bar" ipc call osdVolume trigger >/dev/null 2>&1 || true
}
case "${1:-}" in
  --output-volume)
    case "${2:-}" in
      raise)       wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+ ;;
      lower)       wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
      mute-toggle) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
      +[0-9]*)     wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ "${2#+}%+" ;;
      -[0-9]*)     wpctl set-volume @DEFAULT_AUDIO_SINK@ "${2#-}%-" ;;
      *)
        echo "unsupported output-volume action: ${2:-}" >&2
        exit 2
        ;;
    esac
    notify_volume_osd
    ;;
  --playerctl)
    exec playerctl "${2:?missing playerctl action}"
    ;;
  *)
    echo "usage: omd-swayosd-client --output-volume <raise|lower|mute-toggle|+N|-N>" >&2
    echo "       omd-swayosd-client --playerctl <action>" >&2
    exit 2
    ;;
esac
