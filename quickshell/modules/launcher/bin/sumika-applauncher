#!/bin/sh
set -eu

# On-demand App Launcher process.
# Usage:
#   sumika-applauncher              # toggle: open if not running, close if running
#   sumika-applauncher toggle       # same as above
#   sumika-applauncher open         # open (launch if needed)
#   sumika-applauncher close        # close running instance (no-op if not running)
#
# When started fresh, exports SUMIKA_APP_ON_DEMAND=1 so shell.qml auto-opens the
# launcher and quits the process when the panel closes.

# This module's root directory (derived from script location)
app_dir=$(cd "$(dirname "$0")/.." && pwd)

# Core infrastructure — derive the repository from this core module.
repo_root=$(cd "$(dirname "$0")/../../../.." && pwd -P)
. "$repo_root/lib/paths.sh"
qs_launcher="$SUMIKA_SHELL_ROOT/quickshell/scripts/quickshell"

# Cache script lives alongside this one
cache_script="$(dirname "$0")/sumika-applauncher-cache"

# State directory
: "${SUMIKA_SHELL_STATE_HOME:=${XDG_STATE_HOME:-$HOME/.local/state}/sumika-shell}"
cache_file="$SUMIKA_SHELL_STATE_HOME/applauncher/apps.json"

# Refresh desktop entry cache in background only if it is missing. Avoid date
# checks on the hot path; the QML process can rebuild a corrupt cache itself.
if [ ! -s "$cache_file" ]; then
    "$cache_script" >/dev/null 2>&1 &
fi

# Detect a running or launching sumika-applauncher instance. Match the app
# directory path to catch both the final `quickshell -p <dir>` process AND
# the intermediate `sh .../scripts/quickshell <dir>` launcher script, which
# runs for ~100ms during startup before exec'ing quickshell. Without matching
# the intermediate script, rapid clicks spawn multiple launcher processes.
is_running() {
    pgrep -af "${app_dir}( |$)" >/dev/null 2>&1
}

ipc_call() {
    "${SUMIKA_QS_BIN:-qs}" -p "$app_dir" ipc call appLauncher "$1" 2>/dev/null || true
}

launch_direct() {
    # Always go through quickshell/scripts/quickshell so QML_IMPORT_PATH stages
    # `qs` (common/services/runtime). Bypassing it breaks import qs.modules.common.
    if [ ! -x "$qs_launcher" ]; then
        printf 'sumika-applauncher: quickshell launcher missing at %s\n' "$qs_launcher" >&2
        exit 1
    fi
    export SUMIKA_APP_ON_DEMAND=1
    exec "$qs_launcher" "$app_dir"
}

launch_warm() {
    # Start the process resident but hidden (no auto-open). Used by the
    # launcher.resident pre-warm so the first user-triggered open is instant
    # instead of a cold QML load. Idempotent — callers guard with is_running.
    if [ ! -x "$qs_launcher" ]; then
        printf 'sumika-applauncher: quickshell launcher missing at %s\n' "$qs_launcher" >&2
        exit 1
    fi
    exec "$qs_launcher" "$app_dir"
}

case "${1:-toggle}" in
    toggle)
        if is_running; then
            ipc_call toggle
        else
            launch_direct
        fi
        ;;
    open)
        if is_running; then
            ipc_call open
        else
            launch_direct
        fi
        ;;
    close)
        if is_running; then
            ipc_call close
        fi
        # No instance → nothing to close; exit quietly.
        ;;
    warm)
        # Pre-warm: start resident+hidden if not already running. No-op if alive.
        if is_running; then
            :
        else
            launch_warm
        fi
        ;;
    *)
        echo "usage: sumika-applauncher [toggle|open|close|warm]" >&2
        exit 2
        ;;
esac
