#!/bin/sh
set -eu

# Generate a JSON cache of desktop entries for sumika-applauncher.
# Reads .desktop files and outputs minimal fields needed by the launcher.
# Used to avoid the ~200ms synchronous DesktopEntries scan on cold start.

# State directory: use env var if set, else XDG fallback
: "${SUMIKA_SHELL_STATE_HOME:=${XDG_STATE_HOME:-$HOME/.local/state}/sumika-shell}"

cache_dir="$SUMIKA_SHELL_STATE_HOME/applauncher"
cache_file="$cache_dir/apps.json"
mkdir -p "$cache_dir"

# Collect .desktop file directories in order of highest to lowest precedence
dirs=""
if [ -d "$HOME/.local/share/applications" ]; then dirs="$dirs $HOME/.local/share/applications"; fi
if [ -d "$HOME/.local/share/flatpak/exports/share/applications" ]; then dirs="$dirs $HOME/.local/share/flatpak/exports/share/applications"; fi
if [ -d "/usr/local/share/applications" ]; then dirs="$dirs /usr/local/share/applications"; fi
if [ -d "/usr/share/applications" ]; then dirs="$dirs /usr/share/applications"; fi
if [ -d "/var/lib/flatpak/exports/share/applications" ]; then dirs="$dirs /var/lib/flatpak/exports/share/applications"; fi

# Generate JSON array of apps
{
    echo '['
    first=1
    seen_ids=" "
    for d in $dirs; do
        [ -d "$d" ] || continue
        for f in "$d"/*.desktop; do
            [ -f "$f" ] || continue
            id=$(basename "$f")

            # Deduplicate: if an app with the same desktop ID has already been seen in a
            # higher precedence directory, skip it.
            case "$seen_ids" in
                *" $id "*)
                    continue
                    ;;
            esac
            seen_ids="$seen_ids$id "

            desktop_file="$f"
            name=""
            icon=""
            exec_raw=""
            generic_name=""
            comment=""
            no_display=""
            keywords=""
            working_dir=""
            hidden=""
            section=""
            while IFS='=' read -r key val; do
                # Track which section we're in; stop collecting once we leave [Desktop Entry]
                case "$key" in
                    \[*)
                        section="$key"
                        # Once we've entered a non-Desktop-Entry section, stop reading main fields
                        [ "$section" = "[Desktop Entry]" ] || break
                        continue
                        ;;
                esac
                # Only collect fields from the [Desktop Entry] section
                case "$key" in
                    Name) name="$val" ;;
                    Icon) icon="$val" ;;
                    Exec) exec_raw="$val" ;;
                    GenericName) generic_name="$val" ;;
                    Comment) comment="$val" ;;
                    NoDisplay) no_display="$val" ;;
                    Keywords) keywords="$val" ;;
                    Path) working_dir="$val" ;;
                    Hidden) hidden="$val" ;;
                esac
            done < "$f"
            [ -n "$no_display" ] && [ "$no_display" = "true" ] && continue
            [ -n "$hidden" ] && [ "$hidden" = "true" ] && continue
            [ -z "$name" ] && continue
            [ -z "$exec_raw" ] && continue
            [ "$first" -eq 0 ] && echo ','
            first=0
            # Escape for JSON
            esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr '\n' ' '; }
            printf '  {"id":"%s","desktopId":"%s","desktopFile":"%s","name":"%s","icon":"%s","exec":"%s","genericName":"%s","comment":"%s","keywords":"%s","workingDirectory":"%s"}' \
                "$(esc "$id")" "$(esc "$id")" "$(esc "$desktop_file")" "$(esc "$name")" "$(esc "$icon")" "$(esc "$exec_raw")" \
                "$(esc "$generic_name")" "$(esc "$comment")" "$(esc "$keywords")" "$(esc "$working_dir")"
        done
    done
    echo ''
    echo ']'
} > "$cache_file.tmp"

mv "$cache_file.tmp" "$cache_file"
echo "$cache_file"
