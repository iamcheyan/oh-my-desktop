#!/usr/bin/env bash
# Sumika clipboard history store.
#
# There is deliberately one watcher only.  A text watcher and an image watcher
# race on the same Wayland clipboard and can store an image as text or lose an
# update.  Each event is classified by MIME type before it is passed to
# cliphist.

set -u
IFS=$'\n\t'

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Resolve the live compositor display. The daemon is a long-lived
# systemd-run unit and may outlive the session that launched it (e.g. a
# Hyprland -> labwc switch), so the stale environment is healed here instead
# of trusting $WAYLAND_DISPLAY as-is.
export WAYLAND_DISPLAY="$("$script_dir/sumika-clipboard-wayland-display")"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

app_dir="${SUMIKA_CLIPBOARD_APP_DIR:-${script_dir%/*}/apps/sumika-clipboard}"
state_home="${SUMIKA_SHELL_STATE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}/sumika-shell}"
state_dir="$state_home/clipboard"
hash_dir="$state_dir/hashes"
lock_file="$state_dir/store.lock"
pid_file="$state_dir/store.pid"
log_tag="[sumika-clipboard-store]"
watcher_pid=""

mkdir -p "$state_dir" "$hash_dir"
chmod 700 "$state_dir" "$hash_dir" 2>/dev/null || true


is_running() {
    [ -s "$pid_file" ] || return 1
    local pid
    pid=$(cat "$pid_file" 2>/dev/null || true)
    [ -n "$pid" ] && [ "$pid" != "$$" ] && kill -0 "$pid" 2>/dev/null
}

missing_dependencies() {
    local missing="" dependency
    for dependency in wl-paste cliphist file md5sum awk grep cut mktemp; do
        if ! command -v "$dependency" >/dev/null 2>&1; then
            missing="$missing $dependency"
        fi
    done
    printf '%s' "$missing"
}

notify_ui() {
    # IPC is intentionally best-effort. Do not gate this on a pgrep snapshot:
    # the on-demand UI can be starting or restarting between the process check
    # and the IPC call. A closed UI simply makes qs return an error.
    qs -p "$app_dir" ipc call cliphistService update >/dev/null 2>&1 || true
}

cleanup() {
    local rc="${1:-0}"
    trap - EXIT TERM INT HUP
    if [ -n "$watcher_pid" ]; then
        # The watcher shell owns the wl-paste child. Kill that child first so
        # stopping this daemon never leaves an orphan clipboard watcher.
        pkill -P "$watcher_pid" 2>/dev/null || true
        kill "$watcher_pid" 2>/dev/null || true
        wait "$watcher_pid" 2>/dev/null || true
    fi
    if [ -f "$pid_file" ] && [ "$(cat "$pid_file" 2>/dev/null || true)" = "$$" ]; then
        rm -f "$pid_file"
    fi
    exit "$rc"
}

stop_existing() {
    local pid=""
    if [ -s "$pid_file" ]; then
        pid=$(cat "$pid_file" 2>/dev/null || true)
    fi
    if [ -n "$pid" ] && [ "$pid" != "$$" ] && kill -0 "$pid" 2>/dev/null; then
        # Kill the whole descendant tree, not just the daemon shell: a wedged
        # wl-paste grandchild survives the death of its parent bash and would
        # keep holding the stuck clipboard transfer as an init orphan.
        local -a tree
        tree=($pid $(descendant_pids "$pid"))
        kill -TERM "${tree[@]}" 2>/dev/null || true
        for _ in {1..20}; do
            kill -0 "$pid" 2>/dev/null || break
            sleep 0.1
        done
        kill -KILL "${tree[@]}" 2>/dev/null || true
    fi
    rm -f "$pid_file"
}

# ── Wedge detection ────────────────────────────────────────────────────────
# A healthy event callback finishes within ~66 s worst case (every wl-paste
# read is bounded; see sumika-clipboard-store-event). A clipboard owner that
# dies mid-transfer used to leave wl-paste reading a dead pipe FOREVER, and
# wl-paste --watch does not dispatch the next event until the callback exits
# — the whole history silently died while the daemon looked perfectly alive
# to `is_running`. Repair (run by every sumika-restart reload) therefore also
# checks for stuck wl-paste descendants and restarts the tree when found.
WEDGE_AGE="${SUMIKA_CLIPBOARD_WEDGE_AGE:-120}"

descendant_pids() {
    # Full descendant walk of $1 (the watcher tree spans three levels:
    # wl-paste --watch -> callback bash -> wl-paste). Killing only direct
    # children leaves a wedged grandchild wl-paste alive, reparented to init,
    # still holding the stuck transfer.
    local root="$1" pid child
    local -a stack=("$root") out=()
    local -A seen=()
    while [ "${#stack[@]}" -gt 0 ]; do
        pid="${stack[0]}"
        stack=("${stack[@]:1}")
        [ -n "$pid" ] || continue
        [ -z "${seen[$pid]:-}" ] || continue
        seen[$pid]=1
        for child in $(pgrep -P "$pid" 2>/dev/null); do
            out+=("$child")
            stack+=("$child")
        done
    done
    printf '%s\n' ${out[@]+"${out[@]}"}
}

proc_age() {
    # Age in seconds from /proc/PID/stat starttime (pure procfs: no ps dep).
    local pid="$1" stat start hz uptime
    stat=$(cat "/proc/$pid/stat" 2>/dev/null) || return 1
    stat="${stat#*) }"                       # comm may contain spaces/parens
    start=$(printf '%s\n' "$stat" | awk '{print $20}')
    [ -n "$start" ] || return 1
    hz=$(getconf CLK_TCK 2>/dev/null || echo 100)
    uptime=$(awk '{print int($1)}' /proc/uptime 2>/dev/null) || return 1
    echo $(( uptime - start / hz ))
}

watcher_is_wedged() {
    # True when anything inside an event callback outlives its bounded
    # lifetime. The callback script itself (sumika-clipboard-store-event)
    # covers every hang mode — a stuck wl-paste, a hung cliphist, a blocked
    # IPC — because the callback bash lives exactly as long as its slowest
    # child. A bare non-watcher wl-paste is kept as a second pattern in case
    # the callback shell already exited around a surviving child. The
    # wl-paste --watch process is long-lived by design and is excluded.
    local daemon_pid="$1" child cmd age
    for child in $(descendant_pids "$daemon_pid"); do
        cmd=$(tr '\0' ' ' < "/proc/$child/cmdline" 2>/dev/null) || continue
        # Exclude the watcher first: its cmdline contains BOTH wl-paste and
        # the callback script path (as the --watch argument), so a later
        # store-event match would flag the long-lived watcher itself and
        # false-positive on every repair once it ages past WEDGE_AGE.
        case "$cmd" in
            *wl-paste*"--watch"*) continue ;;
        esac
        case "$cmd" in
            *sumika-clipboard-store-event*) ;;
            *wl-paste*) ;;
            *) continue ;;
        esac
        age=$(proc_age "$child") || continue
        if [ "$age" -ge "$WEDGE_AGE" ]; then
            echo "$log_tag wedge detected: $child (age=${age}s) stuck: $cmd" >&2
            return 0
        fi
    done
    return 1
}

status() {
    if is_running; then
        echo "running $(cat "$pid_file")"
        return 0
    fi
    local missing
    missing=$(missing_dependencies)
    if [ -n "$missing" ]; then
        echo "stopped (missing required commands:$missing)"
        return 2
    fi
    echo "stopped"
    return 1
}

case "${1:-start}" in
    status)
        status
        exit $?
        ;;
    stop)
        stop_existing
        exit 0
        ;;
    restart)
        stop_existing
        ;;
    repair)
        # Prefer the existing managed unit. This keeps a repair inside the
        # same systemd cgroup and preserves Restart=on-failure.
        if is_running; then
            # Alive is not healthy: a stuck wl-paste callback wedges the
            # watcher while looking perfectly running (see Wedge detection
            # above). sumika-restart calls repair on every reload, so this
            # check makes a reload self-heal a wedged history watcher.
            daemon_pid=$(cat "$pid_file" 2>/dev/null || true)
            if [ -n "$daemon_pid" ] && watcher_is_wedged "$daemon_pid"; then
                stop_existing
                if command -v systemctl >/dev/null 2>&1 \
                    && [ "$(systemctl --user show -P LoadState sumika-clipboard-store.service 2>/dev/null || true)" = "loaded" ]; then
                    systemctl --user restart sumika-clipboard-store.service >/dev/null 2>&1 || true
                    exit 0
                fi
                # fall through to the fresh-unit path below
            else
                exit 0
            fi
        fi
        if command -v systemctl >/dev/null 2>&1 \
            && [ "$(systemctl --user show -P LoadState sumika-clipboard-store.service 2>/dev/null || true)" = "loaded" ]; then
            systemctl --user restart sumika-clipboard-store.service >/dev/null 2>&1 || true
            exit 0
        fi
        # A user may invoke repair before the module registry has started the
        # service. Create the same managed unit shape used by sumika-restart so
        # the daemon is still supervised and restarted after a crash.
        if command -v systemd-run >/dev/null 2>&1 \
            && command -v systemctl >/dev/null 2>&1 \
            && systemctl --user is-active --quiet default.target 2>/dev/null; then
            systemd-run --user --unit=sumika-clipboard-store \
                --property=KillMode=mixed \
                --property=Restart=on-failure \
                --property=RestartSec=2 \
                --setenv=WAYLAND_DISPLAY="$("$script_dir/sumika-clipboard-wayland-display")" \
                --setenv=XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}" \
                --setenv=SUMIKA_CLIPBOARD_APP_DIR="$app_dir" \
                --setenv=SUMIKA_SHELL_STATE_HOME="$state_home" \
                /bin/sh -c 'exec "$1" >>"$2" 2>&1' sh "$script_dir/sumika-clipboard-store" "/tmp/sumika-clipboard-store.log" \
                >/dev/null 2>&1 || true

            exit 0
        fi
        ;;
    start|"")
        ;;
    *)
        echo "usage: sumika-clipboard-store [start|stop|restart|repair|status]" >&2
        exit 2
        ;;
esac

# Keep the descriptor open for the lifetime of the process.  This works across
# restarts and does not depend on a stale /tmp PID file.
exec 9>"$lock_file"
if command -v flock >/dev/null 2>&1; then
    flock -n 9 || exit 0
else
    if is_running; then exit 0; fi
fi

echo "$$" > "$pid_file"
trap 'cleanup 143' TERM
trap 'cleanup 130' INT
trap 'cleanup 0' EXIT
trap '' HUP

find "$hash_dir" -type f -mmin +2 -delete 2>/dev/null || true

missing=$(missing_dependencies)
if [ -n "$missing" ]; then
    echo "$log_tag Missing required commands:$missing" >&2
    exit 127
fi

watch_loop() {
    while true; do
        # Re-resolve on every retry so a compositor session switch (or a
        # dead socket) heals without a manual restart.
        export WAYLAND_DISPLAY="$("$script_dir/sumika-clipboard-wayland-display")"
        echo "$log_tag Watching clipboard events (display=$WAYLAND_DISPLAY)" >&2
        # Use the event handler directly. An extra background shell here can
        # detach the callback from the wl-paste lifecycle and occasionally
        # lose image offers while a screenshot provider is still publishing
        # its MIME types. The handler has a bounded settle/retry window, and
        # systemd owns the whole process tree for clean shutdown.
        wl-paste --watch "$script_dir/sumika-clipboard-store-event" 2>/dev/null
        echo "$log_tag watcher exited; retrying in 1s" >&2
        sleep 1
    done
}

echo "$log_tag Started (PID $$) — single MIME-aware watcher active" >&2
watch_loop &
watcher_pid=$!
wait "$watcher_pid"
