#!/usr/bin/env bash
# Summarize host firewall for Settings Advanced panel.
set -euo pipefail
export LANG=C LC_ALL=C

if command -v firewall-cmd >/dev/null 2>&1; then
  st=$(firewall-cmd --state 2>/dev/null || true)
  if [[ "$st" == "running" ]]; then
    zone=$(firewall-cmd --get-default-zone 2>/dev/null || true)
    printf 'backend=firewalld\nstate=running\ndetail=default zone: %s\n' "${zone:-unknown}"
    exit 0
  fi
  printf 'backend=firewalld\nstate=inactive\ndetail=%s\n' "${st:-not running}"
  exit 0
fi

if command -v ufw >/dev/null 2>&1; then
  st=$(ufw status 2>/dev/null | head -1 || true)
  if echo "$st" | grep -qi active; then
    printf 'backend=ufw\nstate=running\ndetail=%s\n' "$st"
  else
    printf 'backend=ufw\nstate=inactive\ndetail=%s\n' "$st"
  fi
  exit 0
fi

if command -v nft >/dev/null 2>&1; then
  printf 'backend=nft\nstate=unknown\ndetail=nft available (no high-level status)\n'
  exit 0
fi

printf 'backend=none\nstate=unknown\ndetail=No firewalld/ufw detected\n'
