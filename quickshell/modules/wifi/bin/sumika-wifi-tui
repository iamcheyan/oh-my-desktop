#!/usr/bin/env python3
"""
sumika-wifi-tui — WiFi network manager TUI.

Full-screen curses interface for scanning, connecting, disconnecting,
and forgetting WiFi networks. Uses nmcli as the backend.

Controls
  j / ↓      Move selection down
  k / ↑      Move selection up
  Tab / l    Next section
  S-Tab / h  Previous section
  Enter      Connect, or open a saved network's details
  s          Rescan
  t          Toggle WiFi on/off
  q / Esc    Quit
"""

import curses
import locale
import os
import sys
import threading
import time
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
_repo_bin = str(Path(os.path.dirname(os.path.abspath(__file__))).resolve().parent.parent.parent.parent / "bin")
if _repo_bin not in sys.path:
    sys.path.insert(0, _repo_bin)

import sumika_tui_framework as S
from sumika_wifi_ops import (
    # Constants re-exported for the TUI
    clean, _SUBPROC_ENV,
    # Dependency checks
    require_python, ensure_nmcli,
    # nmcli + radio + device helpers
    nmcli, prepare_wifi, nmcli_split,
    get_wifi_radio, set_wifi_radio,
    get_active_connection, get_wifi_device, get_ip_address,
    # Network listing
    get_saved_networks, rescan_wifi, get_available_networks,
    # Security helpers
    is_secured, is_enterprise,
    # Operations
    connect_network, disconnect_network, forget_network,
    # Status + diagnostics
    get_wifi_status, ping_stats, get_gateway, get_link_info,
    run_diagnostics, diag_tone,
    # Auto-recover
    service_check, fix_connection,
)

# ── UI-only constants ─────────────────────────────────────────────────

SIGNAL_ICONS = ["󰤟", "󰤢", "󰤥", "󰤨"]
LOCK_ICON = ""
UNLOCK_ICON = ""
CONNECTED_ICON = ""


def signal_rating(pct: int) -> str:
    """Convert 0-100%% to 1/5 – 5/5 numeric rating."""
    if pct >= 80:
        return "5/5"
    elif pct >= 60:
        return "4/5"
    elif pct >= 40:
        return "3/5"
    elif pct >= 20:
        return "2/5"
    return "1/5"


def security_icon(sec: str) -> str:
    s = sec.strip().lower()
    if not s or s == "" or s == "--":
        return UNLOCK_ICON
    return LOCK_ICON

# ── curses app ────────────────────────────────────────────────────────

F_SAVED = 0
F_AVAILABLE = 1
F_STATUS = 2


class WifiModel:
    dirty = True

    def __init__(self):
        self.saved = []
        self.available = []
        self.status = None
        self.focus = 0  # F_SAVED
        self.selected = 0
        self.busy = False
        self.status_msg = "Press s to scan, Enter to connect"
        self.log_lines = []
        self.password_prompt = None
        self.password_buf = ""
        self.saved_detail_uuid = None
        self.saved_detail_action = 0
        self._async_msg = None
        self._scan_deadline = 0.0
        self._show_available = True
        self.diag = None          # last diagnostics result
        self.fixing = False       # recovery in progress (overlay shown)
        self.connecting = False   # connection overlay in progress
        self.overlay_title = ""   # title for the log overlay
        self._connect_ssid = None  # SSID for post-connect selection
        self._log_seen = 0         # log_lines length at last render

    def run_bg(self, label, fn, *args):
        if self.busy:
            return
        self.busy = True
        self.status_msg = label
        self.dirty = True

        def worker():
            try:
                _ok, msg = fn(*args)
                self._async_msg = msg
            except Exception as exc:
                self._async_msg = f"Error: {exc}"
            finally:
                self.busy = False

        threading.Thread(target=worker, daemon=True).start()

def _action_connect(m, ssid, password=None, uuid=None):
    """Start a connection with a live progress overlay (like fix/diag)."""
    if m.busy or m.connecting:
        return
    m.diag = None
    m.fixing = False
    m.connecting = True
    m.busy = True
    m.overlay_title = "Connecting"
    m._connect_ssid = ssid
    m.log_lines = [f"Connecting to {ssid}…"]
    m._log_seen = 0
    m.status_msg = f"Connecting to {ssid}…"
    m.dirty = True

    def on_log(msg):
        m.log_lines.append(f"  {msg}")
        m.dirty = True

    def worker():
        try:
            ok, msg = connect_network(ssid, password, uuid=uuid, on_log=on_log)
            m.status_msg = msg
            m.log_lines.append("")
            if ok:
                m.log_lines.append(f"✓ {msg} — press Q to close")
            else:
                m.log_lines.append(f"✗ {msg} — press Q to close")
        except Exception as exc:
            m.status_msg = f"Error: {exc}"
            m.log_lines.append(f"✗ Error: {exc} — press Q to close")
        finally:
            m.connecting = False
            m.busy = False
            m.dirty = True

    threading.Thread(target=worker, daemon=True).start()

def _poll(model):
    if model._async_msg is not None:
        model.status_msg = model._async_msg
        model._async_msg = None
        _refresh_data(model)
        model.dirty = True
    # Live-update the fix/connect overlay as log lines stream in from the worker.
    if (model.fixing or model.connecting) and len(model.log_lines) > model._log_seen:
        model._log_seen = len(model.log_lines)
        model.dirty = True
    deadline = getattr(model, "_scan_deadline", 0.0) or 0.0
    if deadline and time.monotonic() >= deadline:
        model._scan_deadline = 0.0
        _refresh_data(model)
        n = len(model.available)
        if not model.busy:
            if n:
                model.status_msg = f"{n} new network{'s' if n != 1 else ''} found"
            else:
                model.status_msg = "All nearby networks are already saved"
        model.dirty = True


def _unsaved_available(m):
    """Available panel shows only stranger networks — saved ones live in
    the Saved panel above (signal refreshed live from the same scan)."""
    saved_ssids = {s["ssid"] for s in m.saved}
    return [a for a in get_available_networks() if a["ssid"] not in saved_ssids]


def _refresh_data(m):
    now = time.monotonic()
    m.saved = get_saved_networks()
    m.available = _unsaved_available(m)
    m.status = get_wifi_status()
    count = len(_focused_list(m))
    if count == 0:
        m.selected = 0
    elif m.selected >= count:
        m.selected = count - 1


def _focused_list(m):
    if m.focus == F_SAVED:
        return m.saved
    elif m.focus == F_AVAILABLE:
        return m.available
    return []


def _focused_count(m):
    return len(_focused_list(m))


def _calc_network_columns(w):
    """Calculate unified 5-column widths and offsets for network tables.

    Columns: [SSID, Security, Signal, AutoConnect, Status]
    Guarantees exact vertical alignment across Saved Networks and Available Networks.
    """
    base = [16, 14, 8, 12, 12]  # sum = 62
    extra = w - 62
    if extra > 0:
        add_ssid = extra * 5 // 10       # SSID 50%
        add_sec = extra * 2 // 10        # Security 20%
        add_auto = extra * 1 // 10       # AutoConnect 10%
        add_stat = extra - add_ssid - add_sec - add_auto  # Status 20%
        widths = [
            base[0] + add_ssid,
            base[1] + add_sec,
            base[2],
            base[3] + add_auto,
            base[4] + add_stat,
        ]
    else:
        widths = base[:]
        while sum(widths) > w:
            if widths[0] > 8:
                widths[0] -= 1
            elif widths[1] > 8:
                widths[1] -= 1
            elif widths[3] > 6:
                widths[3] -= 1
            elif widths[4] > 6:
                widths[4] -= 1
            elif widths[2] > 4:
                widths[2] -= 1
            else:
                break

    total_w = sum(widths)
    margin = max(0, (w - total_w) // 2)
    offsets = [margin]
    for cw in widths[:-1]:
        offsets.append(offsets[-1] + cw)
    return widths, offsets


def _hero_info(m):
    subtitle_parts = []
    if m.status:
        active = m.status.get("active")
        if active and active != "—":
            subtitle_parts.append(active)
            ip = m.status.get("ip")
            if ip and ip != "—":
                subtitle_parts.append(ip)
        subtitle_parts.append(f"radio {m.status.get('radio', '?').lower()}")
    subtitle = " · ".join(subtitle_parts) if subtitle_parts else "WiFi"
    extra = ""
    if m.busy:
        extra = "working…"
    elif m.status_msg and not m.status_msg.startswith("Press"):
        extra = m.status_msg.strip()
    if extra:
        subtitle = subtitle + (" · " + extra if subtitle else extra)
    status_text = ""
    tone = "muted"
    if m.busy:
        status_text = "Working…"
        tone = "warn"
    elif m.status:
        active = m.status.get("active")
        if active and active != "—":
            status_text = "Connected"
            tone = "ok"
        elif m.status.get("radio") == "Off":
            status_text = "WiFi off"
            tone = "muted"
        else:
            status_text = "Not connected"
            tone = "muted"
    msg = ""
    if m.busy:
        msg = "working…"
    elif m.status_msg and m.status_msg.startswith("Scan"):
        msg = "scanning…"
    return S.hero_line("WiFi", subtitle, tone, m.busy, msg, status_text)


def _handle_password_input(m, key):
    if key in (ord("\n"), curses.KEY_ENTER):
        ssid = m.password_prompt or ""
        pwd = m.password_buf
        m.password_prompt = None
        m.password_buf = ""
        _action_connect(m, ssid, pwd)
        m.dirty = True
    elif key == 27:  # Esc
        m.password_prompt = None
        m.password_buf = ""
        m.status_msg = "Cancelled."
        m.dirty = True
    elif key in (curses.KEY_BACKSPACE, 127, 8):
        m.password_buf = m.password_buf[:-1]
        m.dirty = True
    elif 32 <= key <= 126:
        m.password_buf += chr(key)
        m.dirty = True


def _saved_detail_network(m):
    """Return the live saved-profile record selected by the detail dialog."""
    if not m.saved_detail_uuid:
        return None
    return next((item for item in m.saved if item.get("uuid") == m.saved_detail_uuid), None)


def saved_network_state(network: dict) -> tuple[str, bool]:
    """Return a human state and whether a connection attempt is meaningful."""
    if network.get("connected"):
        return "Connected", True
    signal = network.get("signal", -1)
    if isinstance(signal, int) and signal >= 0:
        # A visible AP only proves it can be attempted. Credentials, captive
        # portals, MAC policy, and upstream connectivity are still unknown.
        return "Visible", True
    return "Out of range", False


def saved_detail_actions(network: dict) -> list[tuple[str, str]]:
    state, reachable = saved_network_state(network)
    if state == "Connected":
        return [("disconnect", "Disconnect"), ("forget", "Forget network")]
    if reachable:
        return [("connect", "Try connecting"), ("forget", "Forget network")]
    # Keep away-from-home/company profiles visible and manageable, but don't
    # offer an operation that is guaranteed to wait and fail.
    return [("forget", "Forget network")]


def _open_saved_detail(m, network):
    m.saved_detail_uuid = network.get("uuid")
    m.saved_detail_action = 0
    m.status_msg = ""
    m.dirty = True


def _close_saved_detail(m):
    m.saved_detail_uuid = None
    m.saved_detail_action = 0
    m.dirty = True


def _handle_saved_detail_input(m, key):
    network = _saved_detail_network(m)
    if network is None:
        _close_saved_detail(m)
        return True
    if key in (ord("q"), 27):
        _close_saved_detail(m)
        return True
    actions = saved_detail_actions(network)
    if key in (ord("j"), curses.KEY_DOWN, ord("k"), curses.KEY_UP):
        m.saved_detail_action = (m.saved_detail_action + 1) % len(actions)
        m.dirty = True
        return True
    if key not in (ord("\n"), curses.KEY_ENTER):
        return True

    action = actions[min(m.saved_detail_action, len(actions) - 1)][0]
    if action == "disconnect":
        _close_saved_detail(m)
        dev = get_wifi_device()
        if dev:
            m.run_bg("Disconnecting…", disconnect_network, dev)
    elif action == "connect":
        ssid, uuid = network["ssid"], network.get("uuid")
        _close_saved_detail(m)
        _action_connect(m, ssid, uuid=uuid)
    else:  # forget
        ssid, uuid = network["ssid"], network.get("uuid")
        _close_saved_detail(m)
        m.run_bg(f"Forgetting {ssid}…", lambda: forget_network(ssid, uuid=uuid))
    return True


def _move_sel(m, delta):
    if m.focus == F_STATUS:
        return
    total = _focused_count(m)
    if total <= 0:
        return
    m.selected = max(0, min(m.selected + delta, total - 1))


def _sections():
    return [F_SAVED, F_AVAILABLE, F_STATUS]


def _focus_next(m):
    sections = _sections()
    if m.focus not in sections:
        m.focus = sections[0]
    i = sections.index(m.focus)
    m.focus = sections[(i + 1) % len(sections)]
    m.selected = 0


def _focus_prev(m):
    sections = _sections()
    if m.focus not in sections:
        m.focus = sections[0]
    i = sections.index(m.focus)
    m.focus = sections[(i - 1) % len(sections)]
    m.selected = 0


def _dismiss_overlay(m):
    """Close any open overlay (log/diag) and refresh data."""
    if m.diag is not None and m.busy:
        m._diag_cancelled = True
    m.log_lines = []
    m._log_seen = 0
    m.diag = None
    m.overlay_title = ""
    _refresh_data(m)
    # If we just connected, focus the saved panel and select that network.
    connect_ssid = m._connect_ssid
    m._connect_ssid = None
    if connect_ssid:
        m.focus = F_SAVED
        for i, s in enumerate(m.saved):
            if s.get("ssid") == connect_ssid:
                m.selected = i
                break
    m.dirty = True

def _action_enter(m):
    if m.busy:
        return
    if m.focus == F_SAVED and m.saved:
        idx = min(m.selected, len(m.saved) - 1)
        d = m.saved[idx]
        _open_saved_detail(m, d)
    elif m.focus == F_AVAILABLE and m.available:
        idx = min(m.selected, len(m.available) - 1)
        d = m.available[idx]
        if is_enterprise(d.get("security", "")):
            m.status_msg = "802.1X/Enterprise: use nmtui or nmcli"
            return
        if is_secured(d["security"]):
            saved = next((s for s in m.saved if s["ssid"] == d["ssid"]), None)
            if saved:
                ssid, uuid = d["ssid"], saved.get("uuid")
                _action_connect(m, ssid, uuid=uuid)
                return
            m.password_prompt = d["ssid"]
            m.password_buf = ""
            m.status_msg = f"Enter password for {d['ssid']}:"
        else:
            ssid = d["ssid"]
            _action_connect(m, ssid)


def _draw_saved_table(stdscr, m, y, x, h, w, saved):
    if h < 1 or w < 8:
        return
    widths, offsets = _calc_network_columns(w)
    headers = ["SSID", "Security", "Signal", "AutoConnect", "Status"]
    focused = m.focus == F_SAVED
    S.draw_row(stdscr, y, x, w, headers, widths, offsets, S.header_attr(focused))
    row_start = y + 2 if h >= 3 else y + 1
    max_rows = max(0, (y + h) - row_start)
    for i, d in enumerate(saved[:max_rows]):
        is_sel = focused and i == m.selected
        status, reachable = saved_network_state(d)
        attr = S.sel_attr(is_sel, focused) if (is_sel or reachable) else S.ATTR_MUTED
        sig_val = d.get("signal", -1)
        signal_str = signal_rating(sig_val) if sig_val >= 0 else "--"
        sec_str = d.get("security", "") or "WPA2"
        ssid = f"{UNLOCK_ICON} {d['ssid']}"
        auto_str = "yes" if d.get("autoconnect") else "no"
        cells = [ssid, sec_str, signal_str, auto_str, status]
        S.draw_row(stdscr, row_start + i, x, w, cells, widths, offsets, attr)


def _draw_available_table(stdscr, m, y, x, h, w, available):
    if h < 1 or w < 8:
        return
    widths, offsets = _calc_network_columns(w)
    headers = ["SSID", "Security", "Signal", "AutoConnect", "Status"]
    focused = m.focus == F_AVAILABLE
    S.draw_row(stdscr, y, x, w, headers, widths, offsets, S.header_attr(focused))
    row_start = y + 2 if h >= 3 else y + 1
    max_rows = max(0, (y + h) - row_start)
    if not available:
        S.put_row_cells(stdscr, row_start, x, w,
                        ["All nearby networks are already saved"],
                        [w], curses.A_DIM)
        return
    for i, d in enumerate(available[:max_rows]):
        is_sel = focused and i == m.selected
        attr = S.sel_attr(is_sel, focused)
        lock = security_icon(d["security"])
        ssid = f"{lock} {d['ssid']}"
        sec = d["security"] if d["security"] else "Open"
        signal = signal_rating(d["signal"])
        chan = d.get("chan", "")
        in_use_str = "*" if d.get("in_use") else ""
        stat_str = f"ch {chan} {in_use_str}".strip() if chan else ("connected" if d.get("in_use") else "--")
        auto_str = "--"
        cells = [ssid, sec, signal, auto_str, stat_str]
        S.draw_row(stdscr, row_start + i, x, w, cells, widths, offsets, attr)


def _draw_status_table(stdscr, m, y, x, h, w):
    if h < 1 or w < 8:
        return
    headers = ["WiFi", "Connection", "IP Address"]
    widths = [8, 20, 16]
    while sum(widths) > w:
        for i in range(len(widths) - 1, -1, -1):
            if widths[i] > 4:
                widths[i] -= 1
                if sum(widths) <= w:
                    break
    focused = m.focus == F_STATUS
    S.put_row_cells(stdscr, y, x, w, headers, widths, S.header_attr(focused))
    if h < 3:
        return
    if m.status:
        s = m.status
        radio_icon = "󰤨" if s["radio"] == "On" else "󰤫"
        cells = [
            f"{radio_icon} {s['radio']}",
            s["active"],
            s["ip"],
        ]
        attr = S.sel_attr(True, focused) if focused else curses.A_NORMAL
        S.put_row_cells(stdscr, y + 2, x, w, cells, widths, attr)


def _fmt_loss(loss: int, ms: str) -> str:
    if ms == "fail":
        return f"fail ({loss}% loss)"
    return f"{ms} ms ({loss}% loss)"


def _draw_diag_panel(stdscr, m, h, w):
    """Centered overlay showing diagnostics results (immediate on D)."""
    d = m.diag
    if not d:
        return
    S.draw_scrim(stdscr, h, w)
    if d.get("_running"):
        rows = [
            "Running diagnostics…",
            "",
            "  checking connection state",
            "  pinging gateway",
            "  pinging internet",
            "",
            "Results appear here as they complete.",
        ]
        title = " Diagnostics "
        inner_w = min(max(S.text_width(r) for r in rows) + 4, w - 4, 60)
        panel_h = len(rows) + 3
        py = max(2, (h - panel_h) // 2)
        px = max(2, (w - inner_w) // 2)
        S.draw_border(stdscr, py, px, panel_h, inner_w, title)
        for i, r in enumerate(rows):
            if r == "":
                continue
            S.safe_addstr(stdscr, py + 1 + i, px + 2, S.truncate(r, inner_w - 4), S.ATTR_TEXT)
        hint = "Q/Esc to close"
        S.safe_addstr(stdscr, py + panel_h - 1, px + inner_w - 2 - len(hint), hint, S.ATTR_SUBTLE)
        return
    if d.get("error"):
        rows = ["Diagnostics failed", "", f"  {d['error']}", ""]
        title = " Diagnostics "
        inner_w = min(max(S.text_width(r) for r in rows) + 4, w - 4, 60)
        panel_h = len(rows) + 3
        py = max(2, (h - panel_h) // 2)
        px = max(2, (w - inner_w) // 2)
        S.draw_border(stdscr, py, px, panel_h, inner_w, title)
        for i, r in enumerate(rows):
            if r == "":
                continue
            S.safe_addstr(stdscr, py + 1 + i, px + 2, S.truncate(r, inner_w - 4), S.ATTR_DANGER)
        hint = "Q/Esc to close"
        S.safe_addstr(stdscr, py + panel_h - 1, px + inner_w - 2 - len(hint), hint, S.ATTR_SUBTLE)
        return
    tone = diag_tone(d)
    rows = [
        f"Connection  {d['active']}",
        f"IP / Dev    {d['ip']}  ({d['device']})",
        f"Gateway     {d['gateway']}",
        f"Signal       {d['signal']}   {d['band']} ({d['freq']} MHz)",
        "",
        f"Gateway RTT  {_fmt_loss(d['gateway_loss'], d['gateway_ms'])}",
        f"Internet RTT {_fmt_loss(d['external_loss'], d['external_ms'])}",
        "",
    ]
    verdict = {"ok": "● Healthy", "warn": "● Gateway OK, no internet", "danger": "● No connection"}[tone]
    vattr = {"ok": S.ATTR_OK, "warn": S.ATTR_WARN, "danger": S.ATTR_DANGER}[tone]
    title = " Diagnostics "
    # Build a bordered panel
    inner_w = min(max(S.text_width(r) for r in rows) + 4, w - 4, 60)
    panel_h = len(rows) + 3
    py = max(2, (h - panel_h) // 2)
    px = max(2, (w - inner_w) // 2)
    S.draw_border(stdscr, py, px, panel_h, inner_w, title)
    for i, r in enumerate(rows):
        if r == "":
            continue
        S.safe_addstr(stdscr, py + 1 + i, px + 2, S.truncate(r, inner_w - 4), S.ATTR_TEXT)
    vy = py + 1 + len(rows)
    S.safe_addstr(stdscr, vy, px + 2, S.truncate(verdict, inner_w - 4), vattr)
    hint = "Q/Esc to close"
    S.safe_addstr(stdscr, py + panel_h - 1, px + inner_w - 2 - len(hint), hint, S.ATTR_SUBTLE)


def _draw_log_overlay(stdscr, m, h, w):
    """Centered overlay with live log (used by fix, connect, and diag-fail)."""
    S.draw_scrim(stdscr, h, w)
    title = f" {m.overlay_title or 'Progress'} "
    inner_w = min(w - 4, 64)
    log_h = min(len(m.log_lines), h - 8)
    panel_h = log_h + 4
    py = max(2, (h - panel_h) // 2)
    px = max(2, (w - inner_w) // 2)
    S.draw_border(stdscr, py, px, panel_h, inner_w, title)
    if m.log_lines:
        shown = m.log_lines[-log_h:] if log_h > 0 else []
        for i, line in enumerate(shown):
            S.safe_addstr(stdscr, py + 1 + i, px + 2, S.truncate(line, inner_w - 4), S.ATTR_TEXT)
    if m.fixing or m.connecting:
        status = "working…"
        sattr = S.ATTR_WARN
    else:
        status = "done — Q/Esc to close"
        sattr = S.ATTR_SUBTLE
    S.safe_addstr(stdscr, py + panel_h - 1, px + 2, status, sattr)

def _draw_password_prompt(stdscr, m, h, w):
    S.draw_scrim(stdscr, h, w)
    # This is a deliberate local TUI choice: show the password while typing so
    # users can verify keyboard layout and punctuation before connecting.
    password = m.password_buf
    hint = "Enter password, Esc to cancel"
    panel_w = min(max(42, S.text_width(hint) + 4, S.text_width(password) + 4), w - 4)
    panel_h = 5
    py = max(1, (h - panel_h) // 2)
    px = max(2, (w - panel_w) // 2)
    S.draw_border(stdscr, py, px, panel_h, panel_w, "WiFi Password")
    S.safe_addstr(stdscr, py + 1, px + 2, S.truncate(password, panel_w - 4), S.ATTR_TEXT)
    S.safe_addstr(stdscr, py + 2, px + 2, S.truncate(hint, panel_w - 4), S.ATTR_MUTED)


def _draw_saved_detail_dialog(stdscr, m, h, w):
    """Show non-destructive details and explicit actions for one saved WiFi."""
    network = _saved_detail_network(m)
    if network is None:
        return
    S.draw_scrim(stdscr, h, w)
    connected = bool(network.get("connected"))
    status, reachable = saved_network_state(network)
    signal = network.get("signal", -1)
    signal_text = f"{signal}%" if isinstance(signal, int) and signal >= 0 else "Not in range"
    details = [
        ("SSID", network.get("ssid") or "—"),
        ("Profile", network.get("name") or "—"),
        ("Security", network.get("security") or "Unknown"),
        ("Signal", signal_text),
        ("Auto-connect", "On" if network.get("autoconnect") else "Off"),
        ("Status", status),
    ]
    actions = saved_detail_actions(network)
    content_w = max(
        42,
        *(S.text_width(f"{label}: {value}") + 4 for label, value in details),
        *(S.text_width(label) + 6 for _, label in actions),
    )
    panel_w = min(content_w, w - 4)
    panel_h = 13
    py = max(1, (h - panel_h) // 2)
    px = max(2, (w - panel_w) // 2)
    S.draw_border(stdscr, py, px, panel_h, panel_w, "Saved WiFi Network")
    inner_w = panel_w - 4
    action_index = min(m.saved_detail_action, len(actions) - 1)
    for i, (label, value) in enumerate(details):
        text = f"{label:<13} {value}"
        attr = S.ATTR_OK if label == "Status" and connected else S.ATTR_TEXT
        S.safe_addstr(stdscr, py + 1 + i, px + 2, S.truncate(text, inner_w), attr)
    for i, (_, label) in enumerate(actions):
        selected = i == action_index
        prefix = "› " if selected else "  "
        attr = S.ATTR_FOCUS if selected else S.ATTR_TEXT
        S.safe_addstr(stdscr, py + 8 + i, px + 2, S.pad_to_width(prefix + label, inner_w), attr)
    if not reachable and not connected:
        note = "This network is saved but not currently visible."
        S.safe_addstr(stdscr, py + 7, px + 2, S.truncate(note, inner_w), S.ATTR_MUTED)
    hint = "↑/↓ select · Enter confirm · Esc close"
    S.safe_addstr(stdscr, py + panel_h - 2, px + 2, S.truncate(hint, inner_w), S.ATTR_SUBTLE)


def _view(stdscr, m):
    h, w = stdscr.getmaxyx()
    stdscr.erase()
    if not S.require_terminal_size(stdscr, 40, 12):
        return
    margin = 1
    hero_h = 2
    has_avail = m._show_available
    adapter_h = 1 + 4
    help_h = 0
    usable = h - hero_h - margin * 2 + 1
    if has_avail:
        saved_h = min(max(len(m.saved), 1) + 4, max(4, usable // 3))
        remaining = usable - saved_h - adapter_h - help_h
        avail_h = max(4, remaining - 1)
    else:
        avail_h = 0
        saved_h = max(4, usable - adapter_h - help_h)
    total = saved_h + avail_h + adapter_h + help_h
    if total > usable:
        overflow = total - usable
        if avail_h > 4:
            cut = min(overflow, avail_h - 4)
            avail_h -= cut
            overflow -= cut
        if overflow > 0 and saved_h > 4:
            saved_h = max(4, saved_h - overflow)
    y = margin + hero_h - 1
    box_w = w - margin * 2
    S.draw_hero(stdscr, _hero_info(m))
    S.draw_focus_border(stdscr, m.focus == F_SAVED, y, margin, saved_h, box_w, "Saved Networks")
    _draw_saved_table(stdscr, m, y + 1, margin + 1, saved_h - 2, box_w - 2, m.saved)
    y += saved_h
    if has_avail and avail_h >= 4:
        title = "Available Networks"
        if m._scan_deadline:
            title = "Scanning…"
        S.draw_focus_border(stdscr, m.focus == F_AVAILABLE, y, margin, avail_h, box_w, title)
        _draw_available_table(stdscr, m, y + 1, margin + 1, avail_h - 2, box_w - 2, m.available)
        y += avail_h
    S.draw_focus_border(stdscr, m.focus == F_STATUS, y, margin, adapter_h, box_w, "Status")
    _draw_status_table(stdscr, m, y + 1, margin + 1, adapter_h - 2, box_w - 2)
    y += adapter_h
    gen = [("arrows", "navigate"), ("tab", "section"), ("D", "diag"), ("R", "fix"), ("q", "quit")]
    if m.focus == F_SAVED:
        tool = [("enter", "details"), ("s", "scan"), ("t", "wifi on/off")]
    elif m.focus == F_AVAILABLE:
        tool = [("enter", "connect"), ("s", "scan"), ("t", "wifi on/off")]
    else:
        tool = [("s", "scan"), ("t", "wifi on/off")]
    S.draw_help_bar(stdscr, gen, tool)
    if m.fixing or m.connecting or m.log_lines:
        _draw_log_overlay(stdscr, m, h, w)
    elif m.diag is not None:
        _draw_diag_panel(stdscr, m, h, w)
    if m.password_prompt is not None:
        _draw_password_prompt(stdscr, m, h, w)
    elif m.saved_detail_uuid is not None:
        _draw_saved_detail_dialog(stdscr, m, h, w)
    stdscr.refresh()


def _action_diag(m):
    if m.busy or m.fixing or m.connecting:
        return
    if m.diag is not None:
        m.diag = None          # toggle closed
        m.dirty = True
        return
    # Show the panel immediately (placeholder), fill in as results stream in.
    m.diag = {"_running": True}
    m._diag_cancelled = False
    m.busy = True
    m.status_msg = "Running diagnostics…"
    m.dirty = True
    def worker():
        try:
            result = run_diagnostics()
            if getattr(m, "_diag_cancelled", False):
                return  # user closed the panel; don't reopen it
            m.diag = result
            m.status_msg = "Diagnostics ready — Q to close"
        except Exception as exc:
            if getattr(m, "_diag_cancelled", False):
                return
            m.status_msg = f"Diag error: {exc}"
            m.diag = {"error": str(exc)}
        finally:
            m.busy = False
            m.dirty = True

    threading.Thread(target=worker, daemon=True).start()


def _action_fix(m):
    if m.busy or m.fixing or m.connecting:
        return
    m.diag = None
    m.fixing = True
    m.busy = True
    m.overlay_title = "Auto-Recover"
    m.status_msg = "Auto-recovering…"
    # Immediate first line so the panel pops with content, not a blank black box.
    m.log_lines = ["Starting recovery — checking services…"]
    m._log_seen = 0
    m.dirty = True

    def on_log(msg):
        m.log_lines.append(msg)
        m.dirty = True

    def worker():
        try:
            _ok, msg = fix_connection(on_log)
            m.status_msg = msg
        except Exception as exc:
            m.status_msg = f"Recovery error: {exc}"
        finally:
            m.fixing = False
            m.busy = False
            m.dirty = True

    threading.Thread(target=worker, daemon=True).start()


def _handle_key(stdscr, m, key):
    if m.password_prompt is not None:
        _handle_password_input(m, key)
        return True
    if m.saved_detail_uuid is not None:
        return _handle_saved_detail_input(m, key)
    # Recovery or connection in progress: ignore all keys until it finishes.
    if m.fixing or m.connecting:
        return True
    # Q / Esc: close any open overlay first; only quit from the main screen.
    if key in (ord("q"), 27):
        if m.log_lines or m.diag is not None:
            _dismiss_overlay(m)
            return True
        return False  # main screen — quit
    # Diagnostics (D) and auto-recover (R) always take priority.
    if key == ord("D"):
        _action_diag(m)
        m.dirty = True
        return True
    if key == ord("R"):
        _action_fix(m)
        m.dirty = True
        return True
    # Any other key dismisses a finished recovery log, connect log, or diag panel.
    if m.log_lines or m.diag is not None:
        _dismiss_overlay(m)
        return True
    if key == ord("s"):
        if not m.busy:
            m.status_msg = "Scanning…"
            ok, msg = rescan_wifi()
            m._scan_deadline = time.monotonic() + 2.0
            if not ok:
                m.status_msg = msg
                _refresh_data(m)
        m.dirty = True
    elif key == ord("t"):
        if not m.busy:
            radio = get_wifi_radio()
            set_wifi_radio(not radio)
            if not radio:
                prepare_wifi()
            _refresh_data(m)
            m.status_msg = f"WiFi {'On' if not radio else 'Off'}"
        m.dirty = True
    elif key in (ord("j"), curses.KEY_DOWN):
        _move_sel(m, 1)
        m.dirty = True
    elif key in (ord("k"), curses.KEY_UP):
        _move_sel(m, -1)
        m.dirty = True
    elif key == ord("\t"):
        _focus_next(m)
        m.dirty = True
    elif key == curses.KEY_BTAB:
        _focus_prev(m)
        m.dirty = True
    elif key == ord("l"):
        _focus_next(m)
        m.dirty = True
    elif key == ord("h"):
        _focus_prev(m)
        m.dirty = True
    elif key == ord("\n") or key == curses.KEY_ENTER:
        _action_enter(m)
        m.dirty = True
    return True

# ── main ──────────────────────────────────────────────────────────────

def _force_narrow_ambiguous_locale():
    S.setup_locale()


def _bootstrap(stdscr):
    m = WifiModel()
    prepare_wifi()
    _refresh_data(m)
    rescan_wifi()
    m._scan_deadline = time.monotonic() + 2.0
    m.status_msg = "Scanning… press s to rescan"
    S.run_tui_loop(stdscr, m, _view, _handle_key,
                   poll_timeout=200,
                   refresh_interval=0.1,
                   refresh_callback=_poll)


def main():
    ok, err = require_python()
    if not ok:
        print(err, file=sys.stderr)
        return 1
    os.environ.setdefault("LC_ALL", "C.UTF-8")
    os.environ.setdefault("LANG", "C.UTF-8")
    _force_narrow_ambiguous_locale()
    ok, err = ensure_nmcli()
    if not ok:
        print(err, file=sys.stderr)
        return 1
    try:
        return curses.wrapper(lambda stdscr: _bootstrap(stdscr))
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    sys.exit(main())
