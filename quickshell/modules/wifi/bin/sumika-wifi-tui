#!/usr/bin/env python3
"""
sumika-wifi-tui — WiFi network manager TUI.

Full-screen curses interface for scanning, connecting, disconnecting,
and forgetting WiFi networks. Uses nmcli as the backend.

Controls
  j / ↓      Move selection down
  k / ↑      Move selection up
  Tab / l    Next section
  S-Tab / h  Previous section
  Enter      Connect / disconnect
  d          Disconnect
  f          Forget (delete saved network)
  s          Rescan
  t          Toggle WiFi on/off
  q / Esc    Quit
"""

import curses
import locale
import os
import re
import subprocess
import sys
import threading
import time
from shutil import which

from pathlib import Path
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
_repo_bin = str(Path(os.path.dirname(os.path.abspath(__file__))).resolve().parent.parent.parent.parent / "bin")
if _repo_bin not in sys.path:
    sys.path.insert(0, _repo_bin)
import sumika_tui_framework as S

# ── helpers ───────────────────────────────────────────────────────────

ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]")

SIGNAL_ICONS = ["󰤟", "󰤢", "󰤥", "󰤨"]
LOCK_ICON = ""
UNLOCK_ICON = ""
CONNECTED_ICON = ""

# Force English field values from nmcli across locales (zh_CN, ja_JP, …).
_SUBPROC_ENV = {
    **os.environ,
    "LC_ALL": "C.UTF-8",
    "LANG": "C.UTF-8",
    "LANGUAGE": "C",
}

# Cached dependency probe
_NMCLI_OK = None  # type: bool | None
_NMCLI_ERR = ""


def clean(text: str) -> str:
    return ANSI_RE.sub("", text).replace("\r", "")


def require_python() -> tuple[bool, str]:
    if sys.version_info < (3, 10):
        return False, f"Python 3.10+ required (found {sys.version.split()[0]})"
    return True, ""


def ensure_nmcli() -> tuple[bool, str]:
    """Return (ok, error_message). Requires NetworkManager + nmcli."""
    global _NMCLI_OK, _NMCLI_ERR
    if _NMCLI_OK is not None:
        return _NMCLI_OK, _NMCLI_ERR
    if which("nmcli") is None:
        _NMCLI_OK = False
        _NMCLI_ERR = (
            "nmcli not found. sumika-wifi-tui needs NetworkManager.\n"
            "  Debian/Ubuntu:  sudo apt install network-manager\n"
            "  Fedora:         sudo dnf install NetworkManager\n"
            "  Arch:           sudo pacman -S networkmanager\n"
            "Then: sudo systemctl enable --now NetworkManager"
        )
        return _NMCLI_OK, _NMCLI_ERR
    try:
        proc = subprocess.run(
            ["nmcli", "general", "status"],
            text=True, capture_output=True, timeout=5, env=_SUBPROC_ENV,
            stdin=subprocess.DEVNULL,
        )
        if proc.returncode != 0:
            err = (proc.stderr or proc.stdout or "").strip()
            _NMCLI_OK = False
            _NMCLI_ERR = (
                "NetworkManager is not reachable via nmcli.\n"
                f"{err[:200]}\n"
                "Try: sudo systemctl start NetworkManager"
            )
            return _NMCLI_OK, _NMCLI_ERR
    except (OSError, subprocess.TimeoutExpired) as e:
        _NMCLI_OK = False
        _NMCLI_ERR = f"Failed to run nmcli: {e}"
        return _NMCLI_OK, _NMCLI_ERR
    _NMCLI_OK = True
    _NMCLI_ERR = ""
    return True, ""


def nmcli(*args, timeout: int = 15) -> tuple[int, str]:
    try:
        proc = subprocess.run(
            ["nmcli", *args],
            text=True, capture_output=True, timeout=timeout, env=_SUBPROC_ENV,
            stdin=subprocess.DEVNULL,
        )
        out = (proc.stdout or "") + (proc.stderr or "")
        return proc.returncode, clean(out)
    except FileNotFoundError:
        return 127, "nmcli not found"
    except subprocess.TimeoutExpired as e:
        out = ""
        if e.stdout:
            out += e.stdout if isinstance(e.stdout, str) else e.stdout.decode(errors="replace")
        if e.stderr:
            out += e.stderr if isinstance(e.stderr, str) else e.stderr.decode(errors="replace")
        return 1, clean(out)


def prepare_wifi() -> None:
    """Best-effort: unblock rfkill and power WiFi radio on."""
    try:
        subprocess.run(
            ["rfkill", "unblock", "wifi"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            stdin=subprocess.DEVNULL, timeout=3, env=_SUBPROC_ENV,
        )
        subprocess.run(
            ["rfkill", "unblock", "wlan"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            stdin=subprocess.DEVNULL, timeout=3, env=_SUBPROC_ENV,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
        pass
    nmcli("radio", "wifi", "on", timeout=5)


def nmcli_split(line: str) -> list[str]:
    """Split an nmcli terse (-t) line, honoring \\: and \\\\ escapes.

    Naive ``str.split(':')`` breaks on SSIDs/names that contain colons.
    """
    parts: list[str] = []
    cur: list[str] = []
    i = 0
    while i < len(line):
        ch = line[i]
        if ch == "\\" and i + 1 < len(line):
            cur.append(line[i + 1])
            i += 2
            continue
        if ch == ":":
            parts.append("".join(cur))
            cur = []
            i += 1
            continue
        cur.append(ch)
        i += 1
    parts.append("".join(cur))
    return parts


def signal_icon(pct: int) -> str:
    if pct >= 75:
        return SIGNAL_ICONS[3]
    elif pct >= 50:
        return SIGNAL_ICONS[2]
    elif pct >= 25:
        return SIGNAL_ICONS[1]
    return SIGNAL_ICONS[0]


def signal_rating(pct: int) -> str:
    """Convert 0-100%% to 1/5 – 5/5 numeric rating."""
    if pct >= 80:
        return "5/5"
    elif pct >= 60:
        return "4/5"
    elif pct >= 40:
        return "3/5"
    elif pct >= 20:
        return "2/5"
    return "1/5"


def security_icon(sec: str) -> str:
    s = sec.strip().lower()
    if not s or s == "" or s == "--":
        return UNLOCK_ICON
    return LOCK_ICON


def get_wifi_radio() -> bool:
    # Prefer -g (values only); accept localized/variant outputs.
    rc, out = nmcli("-g", "WIFI", "radio")
    val = out.strip().splitlines()[0].strip().lower() if out.strip() else ""
    if val in ("enabled", "on", "yes", "1"):
        return True
    if val in ("disabled", "off", "no", "0"):
        return False
    rc, out = nmcli("-t", "-f", "WIFI", "radio")
    return "enabled" in out.strip().lower() or out.strip().lower() == "on"


def set_wifi_radio(on: bool):
    nmcli("radio", "wifi", "on" if on else "off", timeout=5)


def get_active_connection() -> str:
    rc, out = nmcli("-t", "-f", "NAME,TYPE,DEVICE", "connection", "show", "--active")
    for line in out.splitlines():
        parts = nmcli_split(line)
        if len(parts) >= 2 and ("802-11-wireless" in parts[1] or parts[1] == "wifi"):
            return parts[0]
    return ""


def get_wifi_device() -> str:
    rc, out = nmcli("-t", "-f", "DEVICE,TYPE,STATE", "device", "status")
    # Prefer a connected wifi device, else first wifi device.
    fallback = ""
    for line in out.splitlines():
        parts = nmcli_split(line)
        if len(parts) < 2:
            continue
        if parts[1] != "wifi":
            continue
        if not fallback:
            fallback = parts[0]
        state = parts[2].lower() if len(parts) > 2 else ""
        if "connected" in state and "disconnected" not in state:
            return parts[0]
    return fallback


def get_ip_address(dev: str) -> str:
    """Return primary IPv4 address (without prefix), or em-dash if none.

    nmcli reports fields as ``IP4.ADDRESS[1]:x.x.x.x/nn`` — not bare
    ``IP4.ADDRESS:`` — so we use ``-g`` (get values) which is stable.
    """
    if not dev:
        return "—"
    rc, out = nmcli("-g", "IP4.ADDRESS", "device", "show", dev)
    for line in out.splitlines():
        addr = line.strip()
        if not addr:
            continue
        # strip CIDR prefix if present
        return addr.split("/", 1)[0]
    # Fallback for older nmcli
    rc, out = nmcli("-t", "-f", "IP4.ADDRESS", "device", "show", dev)
    for line in out.splitlines():
        if "IP4.ADDRESS" not in line:
            continue
        _, _, rest = line.partition(":")
        addr = rest.strip()
        if addr:
            return addr.split("/", 1)[0]
    return "—"


def get_saved_networks() -> list[dict]:
    rc, out = nmcli("-t", "-f", "NAME,UUID,TYPE,AUTOCONNECT,AUTOCONNECT-PRIORITY", "connection", "show")
    if rc != 0:
        return []
    active_name = get_active_connection()
    result = []
    for line in out.splitlines():
        parts = nmcli_split(line)
        if len(parts) < 3:
            continue
        name, uuid, ctype = parts[0], parts[1], parts[2]
        autoconnect_raw = parts[3] if len(parts) > 3 else "yes"
        prio_raw = parts[4] if len(parts) > 4 else "0"
        try:
            priority = int(prio_raw)
        except ValueError:
            priority = 0
        if "802-11-wireless" not in ctype and ctype != "wifi":
            continue
        connected = name == active_name
        result.append({
            "ssid": name,  # connection id (usually SSID, not always)
            "uuid": uuid,
            "connected": connected,
            "autoconnect": autoconnect_raw == "yes",
            "priority": priority,
        })
    # Build signal & security lookup from visible APs
    signal_map: dict[str, int] = {}
    security_map: dict[str, str] = {}
    rc2, out2 = nmcli("-t", "-f", "SSID,SECURITY,SIGNAL", "device", "wifi", "list", timeout=5)
    if rc2 == 0:
        for line in out2.splitlines():
            parts = nmcli_split(line)
            if len(parts) >= 1 and parts[0].strip():
                ssid = parts[0].strip()
                sec = parts[1].strip() if len(parts) > 1 else ""
                if sec and sec != "--":
                    security_map[ssid] = sec
                if len(parts) >= 3:
                    try:
                        signal_map[ssid] = int(parts[2].strip())
                    except ValueError:
                        pass
    for d in result:
        d["signal"] = signal_map.get(d["ssid"], -1)
        d["security"] = security_map.get(d["ssid"], "")
    result.sort(key=lambda d: (0 if d["connected"] else 1, d["ssid"].lower()))
    return result


def rescan_wifi(timeout: int = 10) -> tuple[bool, str]:
    """Trigger a hardware rescan. May fail if a scan is already in progress."""
    rc, out = nmcli("device", "wifi", "rescan", timeout=timeout)
    if rc == 0:
        return True, "Scan started"
    msg = out.strip() or "Rescan failed"
    # Not fatal — cached list is still usable
    if "already" in msg.lower() or "scanning" in msg.lower():
        return True, "Scan already in progress"
    return False, msg[:80]


def get_available_networks() -> list[dict]:
    """List nearby APs via nmcli terse mode (stable across NM versions).

    Deduplicates by SSID, keeping the strongest BSS. Hidden (empty SSID)
    networks are skipped — connecting to them needs a separate flow.
    """
    rc, out = nmcli(
        "-t", "-f", "SSID,SECURITY,SIGNAL,BARS,IN-USE,CHAN",
        "device", "wifi", "list",
        timeout=10,
    )
    if rc != 0:
        return []
    best: dict[str, dict] = {}
    for line in out.splitlines():
        if not line.strip():
            continue
        parts = nmcli_split(line)
        # SSID:SECURITY:SIGNAL:BARS:IN-USE:CHAN
        if len(parts) < 3:
            continue
        ssid = parts[0].strip()
        if not ssid:
            continue  # hidden BSS
        sec = parts[1].strip() if len(parts) > 1 else ""
        try:
            sig = int(parts[2].strip()) if parts[2].strip() else 0
        except ValueError:
            sig = 0
        bars = parts[3].strip() if len(parts) > 3 else ""
        in_use_field = parts[4].strip() if len(parts) > 4 else ""
        in_use = in_use_field == "*" or in_use_field.endswith("*")
        chan = parts[5].strip() if len(parts) > 5 else ""
        entry = {
            "ssid": ssid,
            "security": sec if sec and sec != "--" else "",
            "signal": sig,
            "bars": bars,
            "in_use": in_use,
            "chan": chan,
        }
        prev = best.get(ssid)
        if prev is None or entry["signal"] > prev["signal"] or (entry["in_use"] and not prev["in_use"]):
            best[ssid] = entry
    result = list(best.values())
    result.sort(key=lambda d: (0 if d["in_use"] else 1, -d["signal"], d["ssid"].lower()))
    return result


def is_secured(security: str) -> bool:
    s = security.strip().lower()
    if not s or s in ("", "--", "open", "none"):
        return False
    # 802.1X / enterprise still needs more than a PSK dialog, but treat as secured
    return True


def is_enterprise(security: str) -> bool:
    s = security.upper()
    return "802.1X" in s or "EAP" in s or "ENTERPRISE" in s


def connect_network(
    ssid: str,
    password: str | None = None,
    *,
    uuid: str | None = None,
) -> tuple[bool, str]:
    """Connect to a network.

    Prefer activating a saved connection by UUID (handles connection-id ≠ SSID).
    Fall back to ``device wifi connect``.
    """
    # Saved profile path
    if uuid and not password:
        rc, out = nmcli("connection", "up", "uuid", uuid, timeout=30)
        if rc == 0:
            return True, f"Connected to {ssid}"
        # fall through to device wifi connect

    if uuid is None and not password:
        # Try connection up by id first for known networks
        rc, out = nmcli("connection", "up", "id", ssid, timeout=30)
        if rc == 0:
            return True, f"Connected to {ssid}"

    args = ["device", "wifi", "connect", ssid]
    if password:
        args.extend(["password", password])
    # Pin to the first wifi iface when present (helps multi-radio laptops).
    dev = get_wifi_device()
    if dev:
        args.extend(["ifname", dev])
    rc, out = nmcli(*args, timeout=45)
    if rc == 0:
        return True, f"Connected to {ssid}"
    err = out.strip()
    low = err.lower()
    if "secrets were required" in low or ("password" in low and "invalid" in low):
        return False, "Wrong password / secrets required"
    if "802.1x" in low or "eap" in low:
        return False, "Enterprise (802.1X) networks need nmtui / nmcli"
    if "connection activation failed" in low:
        return False, "Connection failed"
    for line in err.splitlines():
        line = line.strip()
        if "Error:" in line or "error" in line.lower():
            return False, line[:80]
    return False, (err[:80] if err else "Connection failed")


def disconnect_network(dev: str) -> tuple[bool, str]:
    if not dev:
        return False, "No WiFi device"
    rc, out = nmcli("device", "disconnect", dev, timeout=10)
    if rc == 0:
        return True, "Disconnected"
    return False, out.strip()[:60] or "Disconnect failed"


def forget_network(name_or_uuid: str, *, uuid: str | None = None) -> tuple[bool, str]:
    if uuid:
        rc, out = nmcli("connection", "delete", "uuid", uuid, timeout=10)
    else:
        rc, out = nmcli("connection", "delete", "id", name_or_uuid, timeout=10)
    if rc == 0:
        return True, f"Forgot {name_or_uuid}"
    return False, out.strip()[:60] or "Delete failed"


def get_wifi_status() -> dict:
    radio = get_wifi_radio()
    active_ssid = get_active_connection()
    dev = get_wifi_device()
    ip = get_ip_address(dev) if dev else "—"
    return {
        "radio": "On" if radio else "Off",
        "active": active_ssid if active_ssid else "—",
        "ip": ip,
        "device": dev if dev else "—",
    }


def ping_stats(host: str, count: int = 5, timeout: float = 1.0) -> tuple[int, str]:
    """Ping host count times, return (loss_pct, avg_ms_str). avg_ms='fail' if lost."""
    try:
        proc = subprocess.run(
            ["ping", "-n", "-q", "-c", str(count), "-W", str(timeout), host],
            text=True, capture_output=True,
            timeout=count * timeout + 3, env=_SUBPROC_ENV,
            stdin=subprocess.DEVNULL,
        )
        out = (proc.stdout or "") + (proc.stderr or "")
    except (subprocess.TimeoutExpired, FileNotFoundError, OSError):
        return 100, "fail"
    m = re.search(r"(\d+) packets transmitted, (\d+) received, (\d+)% packet loss", out)
    loss = int(m.group(3)) if m else 100
    avg = "fail"
    m2 = re.search(r"(?:rtt|round-trip)[^=]*= ([\d.]+)/([\d.]+)/([\d.]+)", out)
    if m2:
        avg = f"{float(m2.group(2)):.1f}"
    elif loss == 0:
        ms = re.findall(r"time=([\d.]+) ms", out)
        if ms:
            avg = f"{sum(float(x) for x in ms) / len(ms):.1f}"
    return loss, avg


def get_gateway(dev: str) -> str:
    if not dev or dev == "—":
        return ""
    rc, out = nmcli("-g", "IP4.GATEWAY", "device", "show", dev, timeout=5)
    for line in out.splitlines():
        line = line.strip()
        if line and line != "--":
            return line
    return ""


def get_link_info(dev: str) -> dict:
    """Signal dBm, freq, band via iw (empty if unavailable)."""
    info = {"signal": "", "freq": "", "band": ""}
    if not dev or dev == "—" or not which("iw"):
        return info
    try:
        proc = subprocess.run(
            ["iw", "dev", dev, "link"], text=True, capture_output=True,
            timeout=3, env=_SUBPROC_ENV,
            stdin=subprocess.DEVNULL,
        )
        for line in (proc.stdout or "").splitlines():
            s = line.strip()
            if s.startswith("signal:"):
                info["signal"] = s.split("signal:")[1].strip()
            elif s.startswith("freq:"):
                f = s.split("freq:")[1].strip().split(".")[0]
                if f.isdigit():
                    fi = int(f)
                    info["freq"] = f
                    if fi >= 6000:
                        info["band"] = "6 GHz"
                    elif fi >= 5000:
                        info["band"] = "5 GHz"
                    elif fi >= 2400:
                        info["band"] = "2.4 GHz"
    except (subprocess.TimeoutExpired, FileNotFoundError, OSError):
        pass
    return info


def run_diagnostics() -> dict:
    """Connection health: gateway RTT+loss, external RTT+loss, signal, band."""
    status = get_wifi_status()
    dev = status.get("device", "")
    link = get_link_info(dev)
    gw = get_gateway(dev)
    result = {
        "radio": status.get("radio", "?"),
        "active": status.get("active", "—"),
        "ip": status.get("ip", "—"),
        "device": dev,
        "gateway": gw or "—",
        "signal": link["signal"] or "—",
        "band": link["band"] or "—",
        "freq": link["freq"] or "—",
        "gateway_ms": "n/a",
        "gateway_loss": 100,
        "external_ms": "fail",
        "external_loss": 100,
    }
    if gw:
        loss, ms = ping_stats(gw, count=5, timeout=1)
        result["gateway_ms"] = ms
        result["gateway_loss"] = loss
    loss, ms = ping_stats("1.1.1.1", count=5, timeout=1)
    result["external_ms"] = ms
    result["external_loss"] = loss
    return result


def diag_tone(d: dict) -> str:
    """ok / warn / danger based on gateway + external reachability."""
    gw_ok = d["gateway_loss"] < 60 and d["gateway_ms"] != "fail"
    ext_ok = d["external_loss"] < 60 and d["external_ms"] != "fail"
    if gw_ok and ext_ok:
        return "ok"
    if gw_ok:
        return "warn"
    return "danger"


def _ranked_candidates(current_ssid: str, current_failed: bool) -> list[dict]:
    """Visible autoconnect saved networks, ranked by priority*2 + signal + 5GHz bonus.
    The just-failed SSID is demoted (−30) so we try fresh networks first."""
    saved = get_saved_networks()
    available = {a["ssid"]: a for a in get_available_networks()}
    cand = []
    for s in saved:
        if not s.get("autoconnect"):
            continue
        ap = available.get(s["ssid"])
        if not ap:
            continue
        ch = ap.get("chan", "")
        try:
            chn = int(ch) if str(ch).isdigit() else 0
        except ValueError:
            chn = 0
        is_5g = chn >= 36
        prio = s.get("priority", 0)
        score = ap["signal"] + (15 if is_5g else 0) + prio * 2
        if current_ssid and s["ssid"] == current_ssid and current_failed:
            score -= 30
        cand.append({
            "ssid": s["ssid"], "uuid": s.get("uuid"), "signal": ap["signal"],
            "chan": ch, "is_5g": is_5g, "priority": prio, "score": score,
        })
    cand.sort(key=lambda c: -c["score"])
    return cand


def _service_check(on_log) -> bool:
    """Step 0 of recovery: verify WiFi-related services and unblock radios.
    Checks NetworkManager, the wifi device, rfkill soft/hard blocks, and the
    radio state. Attempts a fix for anything unhealthy and reports each step.
    Returns True if everything is healthy (or was repaired), False if a hard
    block or missing device remains."""
    healthy = True

    # 1) NetworkManager running?
    on_log("[svc] Checking NetworkManager…")
    rc, out = nmcli("-t", "-f", "STATE", "general")
    state = out.strip().splitlines()[0].strip() if out.strip() else ""
    if rc != 0 or not state or state in ("—", "--"):
        on_log("  ✗ NetworkManager unresponsive — reloading.")
        nmcli("connection", "reload", timeout=10)
        time.sleep(2.0)
        rc2, out2 = nmcli("-t", "-f", "STATE", "general")
        if rc2 != 0 or not out2.strip():
            on_log("  ✗ NetworkManager still down — try `systemctl restart NetworkManager`.")
            healthy = False
        else:
            on_log("  ✓ NetworkManager reloaded.")
    else:
        on_log(f"  ✓ NetworkManager up (state: {state}).")

    # 2) WiFi device present?
    on_log("[svc] Checking WiFi device…")
    dev = get_wifi_device()
    if not dev:
        on_log("  ✗ No WiFi device found — driver may have crashed.")
        healthy = False
    else:
        on_log(f"  ✓ WiFi device {dev} present.")

    # 3) rfkill soft/hard block?
    on_log("[svc] Checking rfkill (radio block)…")
    rfk_blocked = False
    rfk_hard = False
    try:
        r = subprocess.run(
            ["rfkill", "-J"],
            text=True, capture_output=True, timeout=3, env=_SUBPROC_ENV,
            stdin=subprocess.DEVNULL,
        )
        import json as _json
        try:
            data = _json.loads(r.stdout or "{}")
            for dev_rf in data.get("rfkill", []) if isinstance(data, dict) else []:
                d = dev_rf.get("type", "")
                soft = dev_rf.get("soft", False)
                hard = dev_rf.get("hard", False)
                if d in ("wlan", "wifi") and (soft or hard):
                    rfk_blocked = True
                    if hard:
                        rfk_hard = True
        except (ValueError, TypeError):
            pass
    except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
        pass
    if rfk_hard:
        on_log("  ✗ WiFi HARD-blocked (hardware switch) — unblock physically.")
        healthy = False
    elif rfk_blocked:
        on_log("  ✗ WiFi soft-blocked — unblocking.")
        subprocess.run(["rfkill", "unblock", "wifi"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                       stdin=subprocess.DEVNULL, timeout=3, env=_SUBPROC_ENV)
        subprocess.run(["rfkill", "unblock", "wlan"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                       stdin=subprocess.DEVNULL, timeout=3, env=_SUBPROC_ENV)
        time.sleep(1.0)
        on_log("  ✓ Unblocked.")
    else:
        on_log("  ✓ rfkill clear.")

    # 4) WiFi radio powered on?
    on_log("[svc] Checking WiFi radio power…")
    if not get_wifi_radio():
        on_log("  ✗ WiFi radio off — powering on.")
        set_wifi_radio(True)
        time.sleep(1.0)
        if get_wifi_radio():
            on_log("  ✓ Radio on.")
        else:
            on_log("  ✗ Radio won't power on.")
            healthy = False
    else:
        on_log("  ✓ Radio on.")

    return healthy


def fix_connection(on_log) -> tuple[bool, str]:
    """Smart reconnect: Step 0 service health check (NM/device/rfkill/radio) →
    verify current connection → rank visible autoconnect networks →
    try each (connect + ping gateway); first that pings wins.
    Fallback: radio off/on reset + nmcli reload, then one more round.
    `on_log(str)` is called with each progress line (thread-safe append)."""
    def log(msg):
        on_log(msg)

    # Step 0: verify services (NM, device, rfkill, radio) before anything else.
    log("Step 0 — Service health check")
    _service_check(on_log)
    log("")
    status = get_wifi_status()
    current = status.get("active", "") if status.get("active") not in ("", "—") else ""

    # Step 1: if currently connected, verify it isn't just a transient blip.
    current_failed = True
    if current:
        log(f"Checking current connection ({current})…")
        gw = get_gateway(status.get("device", ""))
        if gw:
            loss, ms = ping_stats(gw, count=3, timeout=1)
            if loss == 0 and ms != "fail":
                log(f"  ✓ Gateway reachable ({ms} ms, 0% loss) — network is healthy")
                return True, f"Network healthy: {current} ({ms} ms)"
            log(f"  ✗ Gateway {loss}% loss, {ms} ms — current connection unusable")
        else:
            log("  ✗ No gateway — current connection unusable")
    else:
        log("Not connected. Starting recovery.")

    # Step 2: scan + rank
    log("Scanning for networks…")
    rescan_wifi()
    time.sleep(2.0)

    def attempt_round(tag):
        cand = _ranked_candidates(current, current_failed)
        if not cand:
            log(f"[{tag}] No visible autoconnect networks found.")
            return False, ""
        log(f"[{tag}] {len(cand)} candidate(s): " + ", ".join(
            f"{c['ssid']}({c['signal']}%){' 5G' if c['is_5g'] else ''}" for c in cand))
        for i, c in enumerate(cand, 1):
            log(f"[{tag}] Trying {c['ssid']} ({c['signal']}%, prio {c['priority']})…")
            ok, msg = connect_network(c["ssid"], uuid=c.get("uuid"))
            if not ok:
                log(f"  ✗ {msg}")
                continue
            log("  connected — verifying gateway…")
            time.sleep(1.0)
            dev = get_wifi_device()
            gw = get_gateway(dev)
            if not gw:
                log("  ✗ no gateway after connect")
                continue
            loss, ms = ping_stats(gw, count=3, timeout=1)
            if loss == 0 and ms != "fail":
                log(f"  ✓ Gateway OK ({ms} ms, 0% loss)")
                return True, f"Connected to {c['ssid']} ({ms} ms)"
            log(f"  ✗ gateway {loss}% loss — not usable")
            disconnect_network(dev)
        return False, ""

    ok, msg = attempt_round("1")
    if ok:
        return True, msg

    # Step 3: hard reset fallback
    log("All candidates failed. Hard reset: radio off → on + NM reload.")
    set_wifi_radio(False)
    time.sleep(2.0)
    set_wifi_radio(True)
    time.sleep(4.0)
    nmcli("connection", "reload", timeout=10)
    prepare_wifi()
    time.sleep(2.0)
    log("Radio reset complete. Retrying candidates…")
    ok, msg = attempt_round("2")
    if ok:
        return True, msg

    log("✗ Could not restore connectivity. Check router / try `t` to toggle radio.")
    return False, "Recovery failed — check router or toggle WiFi"


# ── curses app ────────────────────────────────────────────────────────

F_SAVED = 0
F_AVAILABLE = 1
F_STATUS = 2


class WifiModel:
    dirty = True

    def __init__(self):
        self.saved = []
        self.available = []
        self.status = None
        self.focus = 0  # F_SAVED
        self.selected = 0
        self.busy = False
        self.status_msg = "Press s to scan, Enter to connect"
        self.log_lines = []
        self.password_prompt = None
        self.password_buf = ""
        self._async_msg = None
        self._scan_deadline = 0.0
        self._show_available = True
        self.diag = None          # last diagnostics result
        self.fixing = False       # recovery in progress (overlay shown)
        self._log_seen = 0         # log_lines length at last render

    def run_bg(self, label, fn, *args):
        if self.busy:
            return
        self.busy = True
        self.status_msg = label
        self.dirty = True

        def worker():
            try:
                _ok, msg = fn(*args)
                self._async_msg = msg
            except Exception as exc:
                self._async_msg = f"Error: {exc}"
            finally:
                self.busy = False

        threading.Thread(target=worker, daemon=True).start()


def _poll(model):
    if model._async_msg is not None:
        model.status_msg = model._async_msg
        model._async_msg = None
        _refresh_data(model)
        model.dirty = True
    # Live-update the fix overlay as log lines stream in from the worker.
    if model.fixing and len(model.log_lines) > model._log_seen:
        model._log_seen = len(model.log_lines)
        model.dirty = True
    deadline = getattr(model, "_scan_deadline", 0.0) or 0.0
    if deadline and time.monotonic() >= deadline:
        model._scan_deadline = 0.0
        _refresh_data(model)
        n = len(model.available)
        if not model.busy:
            if n:
                model.status_msg = f"{n} new network{'s' if n != 1 else ''} found"
            else:
                model.status_msg = "All nearby networks are already saved"
        model.dirty = True


def _unsaved_available(m):
    """Available panel shows only stranger networks — saved ones live in
    the Saved panel above (signal refreshed live from the same scan)."""
    saved_ssids = {s["ssid"] for s in m.saved}
    return [a for a in get_available_networks() if a["ssid"] not in saved_ssids]


def _refresh_data(m):
    now = time.monotonic()
    m.saved = get_saved_networks()
    m.available = _unsaved_available(m)
    m.status = get_wifi_status()
    count = len(_focused_list(m))
    if count == 0:
        m.selected = 0
    elif m.selected >= count:
        m.selected = count - 1


def _focused_list(m):
    if m.focus == F_SAVED:
        return m.saved
    elif m.focus == F_AVAILABLE:
        return m.available
    return []


def _focused_count(m):
    return len(_focused_list(m))


def _calc_network_columns(w):
    """Calculate unified 5-column widths and offsets for network tables.

    Columns: [SSID, Security, Signal, AutoConnect, Status]
    Guarantees exact vertical alignment across Saved Networks and Available Networks.
    """
    base = [16, 14, 8, 12, 12]  # sum = 62
    extra = w - 62
    if extra > 0:
        add_ssid = extra * 5 // 10       # SSID 50%
        add_sec = extra * 2 // 10        # Security 20%
        add_auto = extra * 1 // 10       # AutoConnect 10%
        add_stat = extra - add_ssid - add_sec - add_auto  # Status 20%
        widths = [
            base[0] + add_ssid,
            base[1] + add_sec,
            base[2],
            base[3] + add_auto,
            base[4] + add_stat,
        ]
    else:
        widths = base[:]
        while sum(widths) > w:
            if widths[0] > 8:
                widths[0] -= 1
            elif widths[1] > 8:
                widths[1] -= 1
            elif widths[3] > 6:
                widths[3] -= 1
            elif widths[4] > 6:
                widths[4] -= 1
            elif widths[2] > 4:
                widths[2] -= 1
            else:
                break

    total_w = sum(widths)
    margin = max(0, (w - total_w) // 2)
    offsets = [margin]
    for cw in widths[:-1]:
        offsets.append(offsets[-1] + cw)
    return widths, offsets


def _hero_info(m):
    subtitle_parts = []
    if m.status:
        active = m.status.get("active")
        if active and active != "—":
            subtitle_parts.append(active)
            ip = m.status.get("ip")
            if ip and ip != "—":
                subtitle_parts.append(ip)
        subtitle_parts.append(f"radio {m.status.get('radio', '?').lower()}")
    subtitle = " · ".join(subtitle_parts) if subtitle_parts else "WiFi"
    extra = ""
    if m.busy:
        extra = "working…"
    elif m.status_msg and not m.status_msg.startswith("Press"):
        extra = m.status_msg.strip()
    if extra:
        subtitle = subtitle + (" · " + extra if subtitle else extra)
    status_text = ""
    tone = "muted"
    if m.busy:
        status_text = "Working…"
        tone = "warn"
    elif m.status:
        active = m.status.get("active")
        if active and active != "—":
            status_text = "Connected"
            tone = "ok"
        elif m.status.get("radio") == "Off":
            status_text = "WiFi off"
            tone = "muted"
        else:
            status_text = "Not connected"
            tone = "muted"
    msg = ""
    if m.busy:
        msg = "working…"
    elif m.status_msg and m.status_msg.startswith("Scan"):
        msg = "scanning…"
    return S.hero_line("WiFi", subtitle, tone, m.busy, msg, status_text)


def _handle_password_input(m, key):
    if key in (ord("\n"), curses.KEY_ENTER):
        ssid = m.password_prompt or ""
        pwd = m.password_buf
        m.password_prompt = None
        m.password_buf = ""
        m.run_bg(
            f"Connecting to {ssid}…",
            lambda: connect_network(ssid, pwd),
        )
        m.dirty = True
    elif key == 27:  # Esc
        m.password_prompt = None
        m.password_buf = ""
        m.status_msg = "Cancelled."
        m.dirty = True
    elif key in (curses.KEY_BACKSPACE, 127, 8):
        m.password_buf = m.password_buf[:-1]
        m.dirty = True
    elif 32 <= key <= 126:
        m.password_buf += chr(key)
        m.dirty = True


def _move_sel(m, delta):
    if m.focus == F_STATUS:
        return
    total = _focused_count(m)
    if total <= 0:
        return
    m.selected = max(0, min(m.selected + delta, total - 1))


def _sections():
    return [F_SAVED, F_AVAILABLE, F_STATUS]


def _focus_next(m):
    sections = _sections()
    if m.focus not in sections:
        m.focus = sections[0]
    i = sections.index(m.focus)
    m.focus = sections[(i + 1) % len(sections)]
    m.selected = 0


def _focus_prev(m):
    sections = _sections()
    if m.focus not in sections:
        m.focus = sections[0]
    i = sections.index(m.focus)
    m.focus = sections[(i - 1) % len(sections)]
    m.selected = 0


def _action_enter(m):
    if m.busy:
        return
    if m.focus == F_SAVED and m.saved:
        idx = min(m.selected, len(m.saved) - 1)
        d = m.saved[idx]
        if d["connected"]:
            dev = get_wifi_device()
            if dev:
                m.run_bg("Disconnecting…", disconnect_network, dev)
        else:
            ssid, uuid = d["ssid"], d.get("uuid")
            m.run_bg(
                f"Connecting to {ssid}…",
                lambda: connect_network(ssid, uuid=uuid),
            )
    elif m.focus == F_AVAILABLE and m.available:
        idx = min(m.selected, len(m.available) - 1)
        d = m.available[idx]
        if is_enterprise(d.get("security", "")):
            m.status_msg = "802.1X/Enterprise: use nmtui or nmcli"
            return
        if is_secured(d["security"]):
            saved = next((s for s in m.saved if s["ssid"] == d["ssid"]), None)
            if saved:
                ssid, uuid = d["ssid"], saved.get("uuid")
                m.run_bg(
                    f"Connecting to {ssid}…",
                    lambda: connect_network(ssid, uuid=uuid),
                )
                return
            m.password_prompt = d["ssid"]
            m.password_buf = ""
            m.status_msg = f"Enter password for {d['ssid']}:"
        else:
            ssid = d["ssid"]
            m.run_bg(f"Connecting to {ssid}…", lambda: connect_network(ssid))


def _action_disconnect(m):
    if m.busy or m.focus != F_SAVED or not m.saved:
        return
    idx = min(m.selected, len(m.saved) - 1)
    d = m.saved[idx]
    if d["connected"]:
        dev = get_wifi_device()
        if dev:
            m.run_bg("Disconnecting…", disconnect_network, dev)


def _action_forget(m):
    if m.busy or m.focus != F_SAVED or not m.saved:
        return
    idx = min(m.selected, len(m.saved) - 1)
    d = m.saved[idx]
    ssid, uuid = d["ssid"], d.get("uuid")
    m.run_bg(f"Forgetting {ssid}…", lambda: forget_network(ssid, uuid=uuid))


def _draw_saved_table(stdscr, m, y, x, h, w, saved):
    if h < 1 or w < 8:
        return
    widths, offsets = _calc_network_columns(w)
    headers = ["SSID", "Security", "Signal", "AutoConnect", "Status"]
    focused = m.focus == F_SAVED
    S.draw_row(stdscr, y, x, w, headers, widths, offsets, S.header_attr(focused))
    row_start = y + 2 if h >= 3 else y + 1
    max_rows = max(0, (y + h) - row_start)
    for i, d in enumerate(saved[:max_rows]):
        is_sel = focused and i == m.selected
        attr = S.sel_attr(is_sel, focused)
        status = "connected" if d["connected"] else "saved"
        sig_val = d.get("signal", -1)
        signal_str = signal_rating(sig_val) if sig_val >= 0 else "--"
        sec_str = d.get("security", "") or "WPA2"
        if d["connected"]:
            ssid = f"{CONNECTED_ICON} {d['ssid']}"
        else:
            ssid = f"{UNLOCK_ICON} {d['ssid']}"
        auto_str = "yes" if d.get("autoconnect") else "no"
        cells = [ssid, sec_str, signal_str, auto_str, status]
        S.draw_row(stdscr, row_start + i, x, w, cells, widths, offsets, attr)


def _draw_available_table(stdscr, m, y, x, h, w, available):
    if h < 1 or w < 8:
        return
    widths, offsets = _calc_network_columns(w)
    headers = ["SSID", "Security", "Signal", "AutoConnect", "Status"]
    focused = m.focus == F_AVAILABLE
    S.draw_row(stdscr, y, x, w, headers, widths, offsets, S.header_attr(focused))
    row_start = y + 2 if h >= 3 else y + 1
    max_rows = max(0, (y + h) - row_start)
    if not available:
        S.put_row_cells(stdscr, row_start, x, w,
                        ["All nearby networks are already saved"],
                        [w], curses.A_DIM)
        return
    for i, d in enumerate(available[:max_rows]):
        is_sel = focused and i == m.selected
        attr = S.sel_attr(is_sel, focused)
        lock = security_icon(d["security"])
        ssid = f"{lock} {d['ssid']}"
        sec = d["security"] if d["security"] else "Open"
        signal = signal_rating(d["signal"])
        chan = d.get("chan", "")
        in_use_str = "*" if d.get("in_use") else ""
        stat_str = f"ch {chan} {in_use_str}".strip() if chan else ("connected" if d.get("in_use") else "--")
        auto_str = "--"
        cells = [ssid, sec, signal, auto_str, stat_str]
        S.draw_row(stdscr, row_start + i, x, w, cells, widths, offsets, attr)


def _draw_status_table(stdscr, m, y, x, h, w):
    if h < 1 or w < 8:
        return
    headers = ["WiFi", "Connection", "IP Address"]
    widths = [8, 20, 16]
    while sum(widths) > w:
        for i in range(len(widths) - 1, -1, -1):
            if widths[i] > 4:
                widths[i] -= 1
                if sum(widths) <= w:
                    break
    focused = m.focus == F_STATUS
    S.put_row_cells(stdscr, y, x, w, headers, widths, S.header_attr(focused))
    if h < 3:
        return
    if m.status:
        s = m.status
        radio_icon = "󰤨" if s["radio"] == "On" else "󰤫"
        cells = [
            f"{radio_icon} {s['radio']}",
            s["active"],
            s["ip"],
        ]
        attr = S.sel_attr(True, focused) if focused else curses.A_NORMAL
        S.put_row_cells(stdscr, y + 2, x, w, cells, widths, attr)


def _fmt_loss(loss: int, ms: str) -> str:
    if ms == "fail":
        return f"fail ({loss}% loss)"
    return f"{ms} ms ({loss}% loss)"


def _draw_diag_panel(stdscr, m, h, w):
    """Centered overlay showing diagnostics results (immediate on D)."""
    d = m.diag
    if not d:
        return
    S.draw_scrim(stdscr, h, w)
    if d.get("_running"):
        rows = [
            "Running diagnostics…",
            "",
            "  checking connection state",
            "  pinging gateway",
            "  pinging internet",
            "",
            "Results appear here as they complete.",
        ]
        title = " Diagnostics "
        inner_w = min(max(S.text_width(r) for r in rows) + 4, w - 4, 60)
        panel_h = len(rows) + 3
        py = max(2, (h - panel_h) // 2)
        px = max(2, (w - inner_w) // 2)
        S.draw_border(stdscr, py, px, panel_h, inner_w, title)
        for i, r in enumerate(rows):
            if r == "":
                continue
            S.safe_addstr(stdscr, py + 1 + i, px + 2, S.truncate(r, inner_w - 4), S.ATTR_TEXT)
        hint = "press D to close"
        S.safe_addstr(stdscr, py + panel_h - 1, px + inner_w - 2 - len(hint), hint, S.ATTR_SUBTLE)
        return
    if d.get("error"):
        rows = ["Diagnostics failed", "", f"  {d['error']}", ""]
        title = " Diagnostics "
        inner_w = min(max(S.text_width(r) for r in rows) + 4, w - 4, 60)
        panel_h = len(rows) + 3
        py = max(2, (h - panel_h) // 2)
        px = max(2, (w - inner_w) // 2)
        S.draw_border(stdscr, py, px, panel_h, inner_w, title)
        for i, r in enumerate(rows):
            if r == "":
                continue
            S.safe_addstr(stdscr, py + 1 + i, px + 2, S.truncate(r, inner_w - 4), S.ATTR_DANGER)
        hint = "press D to close"
        S.safe_addstr(stdscr, py + panel_h - 1, px + inner_w - 2 - len(hint), hint, S.ATTR_SUBTLE)
        return
    tone = diag_tone(d)
    rows = [
        f"Connection  {d['active']}",
        f"IP / Dev    {d['ip']}  ({d['device']})",
        f"Gateway     {d['gateway']}",
        f"Signal       {d['signal']}   {d['band']} ({d['freq']} MHz)",
        "",
        f"Gateway RTT  {_fmt_loss(d['gateway_loss'], d['gateway_ms'])}",
        f"Internet RTT {_fmt_loss(d['external_loss'], d['external_ms'])}",
        "",
    ]
    verdict = {"ok": "● Healthy", "warn": "● Gateway OK, no internet", "danger": "● No connection"}[tone]
    vattr = {"ok": S.ATTR_OK, "warn": S.ATTR_WARN, "danger": S.ATTR_DANGER}[tone]
    title = " Diagnostics "
    # Build a bordered panel
    inner_w = min(max(S.text_width(r) for r in rows) + 4, w - 4, 60)
    panel_h = len(rows) + 3
    py = max(2, (h - panel_h) // 2)
    px = max(2, (w - inner_w) // 2)
    S.draw_border(stdscr, py, px, panel_h, inner_w, title)
    for i, r in enumerate(rows):
        if r == "":
            continue
        S.safe_addstr(stdscr, py + 1 + i, px + 2, S.truncate(r, inner_w - 4), S.ATTR_TEXT)
    vy = py + 1 + len(rows)
    S.safe_addstr(stdscr, vy, px + 2, S.truncate(verdict, inner_w - 4), vattr)
    hint = "press D to close"
    S.safe_addstr(stdscr, py + panel_h - 1, px + inner_w - 2 - len(hint), hint, S.ATTR_SUBTLE)


def _draw_fix_overlay(stdscr, m, h, w):
    """Centered overlay with live recovery log."""
    S.draw_scrim(stdscr, h, w)
    title = " Auto-Recover "
    inner_w = min(w - 4, 64)
    log_h = min(len(m.log_lines), h - 8)
    panel_h = log_h + 4
    py = max(2, (h - panel_h) // 2)
    px = max(2, (w - inner_w) // 2)
    S.draw_border(stdscr, py, px, panel_h, inner_w, title)
    if m.log_lines:
        shown = m.log_lines[-log_h:] if log_h > 0 else []
        for i, line in enumerate(shown):
            S.safe_addstr(stdscr, py + 1 + i, px + 2, S.truncate(line, inner_w - 4), S.ATTR_TEXT)
    status = "working…" if m.fixing else "done"
    sattr = S.ATTR_WARN if m.fixing else S.ATTR_SUBTLE
    S.safe_addstr(stdscr, py + panel_h - 1, px + 2, status, sattr)

def _draw_password_prompt(stdscr, m, h, w):
    S.draw_scrim(stdscr, h, w)
    masked = "*" * len(m.password_buf)
    lines = [
        "┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓",
        f"┃       WiFi Password              ┃",
        f"┃  {masked:<28}  ┃",
        "┃  Enter password, Esc to cancel    ┃",
        "┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛",
    ]
    S.draw_dialog(stdscr, lines)


def _view(stdscr, m):
    h, w = stdscr.getmaxyx()
    stdscr.erase()
    if not S.require_terminal_size(stdscr, 40, 12):
        return
    margin = 1
    hero_h = 2
    has_avail = m._show_available
    adapter_h = 1 + 4
    help_h = 0
    usable = h - hero_h - margin * 2 + 1
    if has_avail:
        saved_h = min(max(len(m.saved), 1) + 4, max(4, usable // 3))
        remaining = usable - saved_h - adapter_h - help_h
        avail_h = max(4, remaining - 1)
    else:
        avail_h = 0
        saved_h = max(4, usable - adapter_h - help_h)
    total = saved_h + avail_h + adapter_h + help_h
    if total > usable:
        overflow = total - usable
        if avail_h > 4:
            cut = min(overflow, avail_h - 4)
            avail_h -= cut
            overflow -= cut
        if overflow > 0 and saved_h > 4:
            saved_h = max(4, saved_h - overflow)
    y = margin + hero_h - 1
    box_w = w - margin * 2
    S.draw_hero(stdscr, _hero_info(m))
    S.draw_focus_border(stdscr, m.focus == F_SAVED, y, margin, saved_h, box_w, "Saved Networks")
    _draw_saved_table(stdscr, m, y + 1, margin + 1, saved_h - 2, box_w - 2, m.saved)
    y += saved_h
    if has_avail and avail_h >= 4:
        title = "Available Networks"
        if m._scan_deadline:
            title = "Scanning…"
        S.draw_focus_border(stdscr, m.focus == F_AVAILABLE, y, margin, avail_h, box_w, title)
        _draw_available_table(stdscr, m, y + 1, margin + 1, avail_h - 2, box_w - 2, m.available)
        y += avail_h
    S.draw_focus_border(stdscr, m.focus == F_STATUS, y, margin, adapter_h, box_w, "Status")
    _draw_status_table(stdscr, m, y + 1, margin + 1, adapter_h - 2, box_w - 2)
    y += adapter_h
    gen = [("arrows", "navigate"), ("tab", "section"), ("D", "diag"), ("R", "fix"), ("q", "quit")]
    if m.focus == F_SAVED:
        tool = [("enter", "dis/connect"), ("s", "scan"), ("d", "disconnect"), ("f", "forget"), ("t", "wifi on/off")]
    elif m.focus == F_AVAILABLE:
        tool = [("enter", "connect"), ("s", "scan"), ("t", "wifi on/off")]
    else:
        tool = [("s", "scan"), ("t", "wifi on/off")]
    S.draw_help_bar(stdscr, gen, tool)
    if m.fixing or m.log_lines:
        _draw_fix_overlay(stdscr, m, h, w)
    elif m.diag is not None:
        _draw_diag_panel(stdscr, m, h, w)
    if m.password_prompt is not None:
        _draw_password_prompt(stdscr, m, h, w)
    stdscr.refresh()


def _action_diag(m):
    if m.busy or m.fixing:
        return
    if m.diag is not None:
        m.diag = None          # toggle closed
        m.dirty = True
        return
    # Show the panel immediately (placeholder), fill in as results stream in.
    m.diag = {"_running": True}
    m.busy = True
    m.status_msg = "Running diagnostics…"
    m.dirty = True

    def worker():
        try:
            m.diag = run_diagnostics()
            m.status_msg = "Diagnostics ready — D to close"
        except Exception as exc:
            m.status_msg = f"Diag error: {exc}"
            m.diag = {"error": str(exc)}
        finally:
            m.busy = False
            m.dirty = True

    threading.Thread(target=worker, daemon=True).start()


def _action_fix(m):
    if m.busy or m.fixing:
        return
    m.diag = None
    m.fixing = True
    m.busy = True
    m.status_msg = "Auto-recovering…"
    # Immediate first line so the panel pops with content, not a blank black box.
    m.log_lines = ["Starting recovery — checking services…"]
    m._log_seen = 0
    m.dirty = True

    def on_log(msg):
        m.log_lines.append(msg)
        m.dirty = True

    def worker():
        try:
            _ok, msg = fix_connection(on_log)
            m.status_msg = msg
        except Exception as exc:
            m.status_msg = f"Recovery error: {exc}"
        finally:
            m.fixing = False
            m.busy = False
            m.dirty = True

    threading.Thread(target=worker, daemon=True).start()


def _handle_key(stdscr, m, key):
    if m.password_prompt is not None:
        _handle_password_input(m, key)
        return True
    if key in (ord("q"), 27):
        return False
    if m.fixing:
        return True  # ignore keys during recovery
    # Diagnostics (D) and auto-recover (R) always take priority.
    if key == ord("D"):
        _action_diag(m)
        m.dirty = True
        return True
    if key == ord("R"):
        _action_fix(m)
        m.dirty = True
        return True
    # Any other key dismisses a finished recovery log or diagnostics panel.
    if m.log_lines or m.diag is not None:
        m.log_lines = []
        m._log_seen = 0
        m.diag = None
        m.dirty = True
        return True
    if key == ord("s"):
        if not m.busy:
            m.status_msg = "Scanning…"
            ok, msg = rescan_wifi()
            m._scan_deadline = time.monotonic() + 2.0
            if not ok:
                m.status_msg = msg
                _refresh_data(m)
        m.dirty = True
    elif key == ord("t"):
        if not m.busy:
            radio = get_wifi_radio()
            set_wifi_radio(not radio)
            if not radio:
                prepare_wifi()
            _refresh_data(m)
            m.status_msg = f"WiFi {'On' if not radio else 'Off'}"
        m.dirty = True
    elif key in (ord("j"), curses.KEY_DOWN):
        _move_sel(m, 1)
        m.dirty = True
    elif key in (ord("k"), curses.KEY_UP):
        _move_sel(m, -1)
        m.dirty = True
    elif key == ord("\t"):
        _focus_next(m)
        m.dirty = True
    elif key == curses.KEY_BTAB:
        _focus_prev(m)
        m.dirty = True
    elif key == ord("l"):
        _focus_next(m)
        m.dirty = True
    elif key == ord("h"):
        _focus_prev(m)
        m.dirty = True
    elif key == ord("\n") or key == curses.KEY_ENTER:
        _action_enter(m)
        m.dirty = True
    elif key == ord("d"):
        _action_disconnect(m)
        m.dirty = True
    elif key == ord("f"):
        _action_forget(m)
        m.dirty = True
    return True

# ── main ──────────────────────────────────────────────────────────────

def _force_narrow_ambiguous_locale():
    S.setup_locale()


def _bootstrap(stdscr):
    m = WifiModel()
    prepare_wifi()
    _refresh_data(m)
    rescan_wifi()
    m._scan_deadline = time.monotonic() + 2.0
    m.status_msg = "Scanning… press s to rescan"
    S.run_tui_loop(stdscr, m, _view, _handle_key,
                   poll_timeout=200,
                   refresh_interval=0.1,
                   refresh_callback=_poll)


def main():
    ok, err = require_python()
    if not ok:
        print(err, file=sys.stderr)
        return 1
    os.environ.setdefault("LC_ALL", "C.UTF-8")
    os.environ.setdefault("LANG", "C.UTF-8")
    _force_narrow_ambiguous_locale()
    ok, err = ensure_nmcli()
    if not ok:
        print(err, file=sys.stderr)
        return 1
    try:
        return curses.wrapper(lambda stdscr: _bootstrap(stdscr))
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    sys.exit(main())
