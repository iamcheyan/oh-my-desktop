#!/usr/bin/env python3
"""
omd-wifi-tui — WiFi network manager TUI.

Full-screen curses interface for scanning, connecting, disconnecting,
and forgetting WiFi networks. Uses nmcli as the backend.

Controls
  j / ↓      Move selection down
  k / ↑      Move selection up
  Tab / l    Next section
  S-Tab / h  Previous section
  Enter      Connect / disconnect
  d          Disconnect
  f          Forget (delete saved network)
  s          Rescan
  t          Toggle WiFi on/off
  q / Esc    Quit
"""

import curses
import locale
import os
import re
import subprocess
import sys
import threading
import time
from shutil import which

from pathlib import Path
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
_repo_bin = str(Path(os.path.dirname(os.path.abspath(__file__))).resolve().parent.parent.parent.parent / "bin")
if _repo_bin not in sys.path:
    sys.path.insert(0, _repo_bin)
import omd_tui_framework as S

# ── helpers ───────────────────────────────────────────────────────────

ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]")

SIGNAL_ICONS = ["󰤟", "󰤢", "󰤥", "󰤨"]
LOCK_ICON = ""
UNLOCK_ICON = ""
CONNECTED_ICON = ""

# Force English field values from nmcli across locales (zh_CN, ja_JP, …).
_SUBPROC_ENV = {
    **os.environ,
    "LC_ALL": "C.UTF-8",
    "LANG": "C.UTF-8",
    "LANGUAGE": "C",
}

# Cached dependency probe
_NMCLI_OK = None  # type: bool | None
_NMCLI_ERR = ""


def clean(text: str) -> str:
    return ANSI_RE.sub("", text).replace("\r", "")


def require_python() -> tuple[bool, str]:
    if sys.version_info < (3, 10):
        return False, f"Python 3.10+ required (found {sys.version.split()[0]})"
    return True, ""


def ensure_nmcli() -> tuple[bool, str]:
    """Return (ok, error_message). Requires NetworkManager + nmcli."""
    global _NMCLI_OK, _NMCLI_ERR
    if _NMCLI_OK is not None:
        return _NMCLI_OK, _NMCLI_ERR
    if which("nmcli") is None:
        _NMCLI_OK = False
        _NMCLI_ERR = (
            "nmcli not found. omd-wifi-tui needs NetworkManager.\n"
            "  Debian/Ubuntu:  sudo apt install network-manager\n"
            "  Fedora:         sudo dnf install NetworkManager\n"
            "  Arch:           sudo pacman -S networkmanager\n"
            "Then: sudo systemctl enable --now NetworkManager"
        )
        return _NMCLI_OK, _NMCLI_ERR
    try:
        proc = subprocess.run(
            ["nmcli", "general", "status"],
            text=True, capture_output=True, timeout=5, env=_SUBPROC_ENV,
        )
        if proc.returncode != 0:
            err = (proc.stderr or proc.stdout or "").strip()
            _NMCLI_OK = False
            _NMCLI_ERR = (
                "NetworkManager is not reachable via nmcli.\n"
                f"{err[:200]}\n"
                "Try: sudo systemctl start NetworkManager"
            )
            return _NMCLI_OK, _NMCLI_ERR
    except (OSError, subprocess.TimeoutExpired) as e:
        _NMCLI_OK = False
        _NMCLI_ERR = f"Failed to run nmcli: {e}"
        return _NMCLI_OK, _NMCLI_ERR
    _NMCLI_OK = True
    _NMCLI_ERR = ""
    return True, ""


def nmcli(*args, timeout: int = 15) -> tuple[int, str]:
    try:
        proc = subprocess.run(
            ["nmcli", *args],
            text=True, capture_output=True, timeout=timeout, env=_SUBPROC_ENV,
        )
        out = (proc.stdout or "") + (proc.stderr or "")
        return proc.returncode, clean(out)
    except FileNotFoundError:
        return 127, "nmcli not found"
    except subprocess.TimeoutExpired as e:
        out = ""
        if e.stdout:
            out += e.stdout if isinstance(e.stdout, str) else e.stdout.decode(errors="replace")
        if e.stderr:
            out += e.stderr if isinstance(e.stderr, str) else e.stderr.decode(errors="replace")
        return 1, clean(out)


def prepare_wifi() -> None:
    """Best-effort: unblock rfkill and power WiFi radio on."""
    try:
        subprocess.run(
            ["rfkill", "unblock", "wifi"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            timeout=3, env=_SUBPROC_ENV,
        )
        subprocess.run(
            ["rfkill", "unblock", "wlan"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            timeout=3, env=_SUBPROC_ENV,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
        pass
    nmcli("radio", "wifi", "on", timeout=5)


def nmcli_split(line: str) -> list[str]:
    """Split an nmcli terse (-t) line, honoring \\: and \\\\ escapes.

    Naive ``str.split(':')`` breaks on SSIDs/names that contain colons.
    """
    parts: list[str] = []
    cur: list[str] = []
    i = 0
    while i < len(line):
        ch = line[i]
        if ch == "\\" and i + 1 < len(line):
            cur.append(line[i + 1])
            i += 2
            continue
        if ch == ":":
            parts.append("".join(cur))
            cur = []
            i += 1
            continue
        cur.append(ch)
        i += 1
    parts.append("".join(cur))
    return parts


def signal_icon(pct: int) -> str:
    if pct >= 75:
        return SIGNAL_ICONS[3]
    elif pct >= 50:
        return SIGNAL_ICONS[2]
    elif pct >= 25:
        return SIGNAL_ICONS[1]
    return SIGNAL_ICONS[0]


def signal_rating(pct: int) -> str:
    """Convert 0-100%% to 1/5 – 5/5 numeric rating."""
    if pct >= 80:
        return "5/5"
    elif pct >= 60:
        return "4/5"
    elif pct >= 40:
        return "3/5"
    elif pct >= 20:
        return "2/5"
    return "1/5"


def security_icon(sec: str) -> str:
    s = sec.strip().lower()
    if not s or s == "" or s == "--":
        return UNLOCK_ICON
    return LOCK_ICON


def get_wifi_radio() -> bool:
    # Prefer -g (values only); accept localized/variant outputs.
    rc, out = nmcli("-g", "WIFI", "radio")
    val = out.strip().splitlines()[0].strip().lower() if out.strip() else ""
    if val in ("enabled", "on", "yes", "1"):
        return True
    if val in ("disabled", "off", "no", "0"):
        return False
    rc, out = nmcli("-t", "-f", "WIFI", "radio")
    return "enabled" in out.strip().lower() or out.strip().lower() == "on"


def set_wifi_radio(on: bool):
    nmcli("radio", "wifi", "on" if on else "off", timeout=5)


def get_active_connection() -> str:
    rc, out = nmcli("-t", "-f", "NAME,TYPE,DEVICE", "connection", "show", "--active")
    for line in out.splitlines():
        parts = nmcli_split(line)
        if len(parts) >= 2 and ("802-11-wireless" in parts[1] or parts[1] == "wifi"):
            return parts[0]
    return ""


def get_wifi_device() -> str:
    rc, out = nmcli("-t", "-f", "DEVICE,TYPE,STATE", "device", "status")
    # Prefer a connected wifi device, else first wifi device.
    fallback = ""
    for line in out.splitlines():
        parts = nmcli_split(line)
        if len(parts) < 2:
            continue
        if parts[1] != "wifi":
            continue
        if not fallback:
            fallback = parts[0]
        state = parts[2].lower() if len(parts) > 2 else ""
        if "connected" in state and "disconnected" not in state:
            return parts[0]
    return fallback


def get_ip_address(dev: str) -> str:
    """Return primary IPv4 address (without prefix), or em-dash if none.

    nmcli reports fields as ``IP4.ADDRESS[1]:x.x.x.x/nn`` — not bare
    ``IP4.ADDRESS:`` — so we use ``-g`` (get values) which is stable.
    """
    if not dev:
        return "—"
    rc, out = nmcli("-g", "IP4.ADDRESS", "device", "show", dev)
    for line in out.splitlines():
        addr = line.strip()
        if not addr:
            continue
        # strip CIDR prefix if present
        return addr.split("/", 1)[0]
    # Fallback for older nmcli
    rc, out = nmcli("-t", "-f", "IP4.ADDRESS", "device", "show", dev)
    for line in out.splitlines():
        if "IP4.ADDRESS" not in line:
            continue
        _, _, rest = line.partition(":")
        addr = rest.strip()
        if addr:
            return addr.split("/", 1)[0]
    return "—"


def get_saved_networks() -> list[dict]:
    rc, out = nmcli("-t", "-f", "NAME,UUID,TYPE,AUTOCONNECT", "connection", "show")
    if rc != 0:
        return []
    active_name = get_active_connection()
    result = []
    for line in out.splitlines():
        parts = nmcli_split(line)
        if len(parts) < 3:
            continue
        name, uuid, ctype = parts[0], parts[1], parts[2]
        autoconnect = parts[3] if len(parts) > 3 else "yes"
        if "802-11-wireless" not in ctype and ctype != "wifi":
            continue
        connected = name == active_name
        result.append({
            "ssid": name,  # connection id (usually SSID, not always)
            "uuid": uuid,
            "connected": connected,
            "autoconnect": autoconnect,
        })
    # Build signal & security lookup from visible APs
    signal_map: dict[str, int] = {}
    security_map: dict[str, str] = {}
    rc2, out2 = nmcli("-t", "-f", "SSID,SECURITY,SIGNAL", "device", "wifi", "list", timeout=5)
    if rc2 == 0:
        for line in out2.splitlines():
            parts = nmcli_split(line)
            if len(parts) >= 1 and parts[0].strip():
                ssid = parts[0].strip()
                sec = parts[1].strip() if len(parts) > 1 else ""
                if sec and sec != "--":
                    security_map[ssid] = sec
                if len(parts) >= 3:
                    try:
                        signal_map[ssid] = int(parts[2].strip())
                    except ValueError:
                        pass
    for d in result:
        d["signal"] = signal_map.get(d["ssid"], -1)
        d["security"] = security_map.get(d["ssid"], "")
    result.sort(key=lambda d: (0 if d["connected"] else 1, d["ssid"].lower()))
    return result


def rescan_wifi(timeout: int = 10) -> tuple[bool, str]:
    """Trigger a hardware rescan. May fail if a scan is already in progress."""
    rc, out = nmcli("device", "wifi", "rescan", timeout=timeout)
    if rc == 0:
        return True, "Scan started"
    msg = out.strip() or "Rescan failed"
    # Not fatal — cached list is still usable
    if "already" in msg.lower() or "scanning" in msg.lower():
        return True, "Scan already in progress"
    return False, msg[:80]


def get_available_networks() -> list[dict]:
    """List nearby APs via nmcli terse mode (stable across NM versions).

    Deduplicates by SSID, keeping the strongest BSS. Hidden (empty SSID)
    networks are skipped — connecting to them needs a separate flow.
    """
    rc, out = nmcli(
        "-t", "-f", "SSID,SECURITY,SIGNAL,BARS,IN-USE,CHAN",
        "device", "wifi", "list",
        timeout=10,
    )
    if rc != 0:
        return []
    best: dict[str, dict] = {}
    for line in out.splitlines():
        if not line.strip():
            continue
        parts = nmcli_split(line)
        # SSID:SECURITY:SIGNAL:BARS:IN-USE:CHAN
        if len(parts) < 3:
            continue
        ssid = parts[0].strip()
        if not ssid:
            continue  # hidden BSS
        sec = parts[1].strip() if len(parts) > 1 else ""
        try:
            sig = int(parts[2].strip()) if parts[2].strip() else 0
        except ValueError:
            sig = 0
        bars = parts[3].strip() if len(parts) > 3 else ""
        in_use_field = parts[4].strip() if len(parts) > 4 else ""
        in_use = in_use_field == "*" or in_use_field.endswith("*")
        chan = parts[5].strip() if len(parts) > 5 else ""
        entry = {
            "ssid": ssid,
            "security": sec if sec and sec != "--" else "",
            "signal": sig,
            "bars": bars,
            "in_use": in_use,
            "chan": chan,
        }
        prev = best.get(ssid)
        if prev is None or entry["signal"] > prev["signal"] or (entry["in_use"] and not prev["in_use"]):
            best[ssid] = entry
    result = list(best.values())
    result.sort(key=lambda d: (0 if d["in_use"] else 1, -d["signal"], d["ssid"].lower()))
    return result


def is_secured(security: str) -> bool:
    s = security.strip().lower()
    if not s or s in ("", "--", "open", "none"):
        return False
    # 802.1X / enterprise still needs more than a PSK dialog, but treat as secured
    return True


def is_enterprise(security: str) -> bool:
    s = security.upper()
    return "802.1X" in s or "EAP" in s or "ENTERPRISE" in s


def connect_network(
    ssid: str,
    password: str | None = None,
    *,
    uuid: str | None = None,
) -> tuple[bool, str]:
    """Connect to a network.

    Prefer activating a saved connection by UUID (handles connection-id ≠ SSID).
    Fall back to ``device wifi connect``.
    """
    # Saved profile path
    if uuid and not password:
        rc, out = nmcli("connection", "up", "uuid", uuid, timeout=30)
        if rc == 0:
            return True, f"Connected to {ssid}"
        # fall through to device wifi connect

    if uuid is None and not password:
        # Try connection up by id first for known networks
        rc, out = nmcli("connection", "up", "id", ssid, timeout=30)
        if rc == 0:
            return True, f"Connected to {ssid}"

    args = ["device", "wifi", "connect", ssid]
    if password:
        args.extend(["password", password])
    # Pin to the first wifi iface when present (helps multi-radio laptops).
    dev = get_wifi_device()
    if dev:
        args.extend(["ifname", dev])
    rc, out = nmcli(*args, timeout=45)
    if rc == 0:
        return True, f"Connected to {ssid}"
    err = out.strip()
    low = err.lower()
    if "secrets were required" in low or ("password" in low and "invalid" in low):
        return False, "Wrong password / secrets required"
    if "802.1x" in low or "eap" in low:
        return False, "Enterprise (802.1X) networks need nmtui / nmcli"
    if "connection activation failed" in low:
        return False, "Connection failed"
    for line in err.splitlines():
        line = line.strip()
        if "Error:" in line or "error" in line.lower():
            return False, line[:80]
    return False, (err[:80] if err else "Connection failed")


def disconnect_network(dev: str) -> tuple[bool, str]:
    if not dev:
        return False, "No WiFi device"
    rc, out = nmcli("device", "disconnect", dev, timeout=10)
    if rc == 0:
        return True, "Disconnected"
    return False, out.strip()[:60] or "Disconnect failed"


def forget_network(name_or_uuid: str, *, uuid: str | None = None) -> tuple[bool, str]:
    if uuid:
        rc, out = nmcli("connection", "delete", "uuid", uuid, timeout=10)
    else:
        rc, out = nmcli("connection", "delete", "id", name_or_uuid, timeout=10)
    if rc == 0:
        return True, f"Forgot {name_or_uuid}"
    return False, out.strip()[:60] or "Delete failed"


def get_wifi_status() -> dict:
    radio = get_wifi_radio()
    active_ssid = get_active_connection()
    dev = get_wifi_device()
    ip = get_ip_address(dev) if dev else "—"
    return {
        "radio": "On" if radio else "Off",
        "active": active_ssid if active_ssid else "—",
        "ip": ip,
        "device": dev if dev else "—",
    }


# ── curses app ────────────────────────────────────────────────────────

F_SAVED = 0
F_AVAILABLE = 1
F_STATUS = 2


class WifiModel:
    dirty = True

    def __init__(self):
        self.saved = []
        self.available = []
        self.status = None
        self.focus = 0  # F_SAVED
        self.selected = 0
        self.busy = False
        self.status_msg = "Press s to scan, Enter to connect"
        self.log_lines = []
        self.password_prompt = None
        self.password_buf = ""
        self._async_msg = None
        self._scan_deadline = 0.0
        self._show_available = True

    def run_bg(self, label, fn, *args):
        if self.busy:
            return
        self.busy = True
        self.status_msg = label
        self.dirty = True

        def worker():
            try:
                _ok, msg = fn(*args)
                self._async_msg = msg
            except Exception as exc:
                self._async_msg = f"Error: {exc}"
            finally:
                self.busy = False

        threading.Thread(target=worker, daemon=True).start()


def _poll(model):
    if model._async_msg is not None:
        model.status_msg = model._async_msg
        model._async_msg = None
        _refresh_data(model)
        model.dirty = True
    deadline = getattr(model, "_scan_deadline", 0.0) or 0.0
    if deadline and time.monotonic() >= deadline:
        model._scan_deadline = 0.0
        _refresh_data(model)
        n = len(model.available)
        if not model.busy:
            model.status_msg = f"{n} network{'s' if n != 1 else ''} found"
        model.dirty = True


def _refresh_data(m):
    now = time.monotonic()
    m.saved = get_saved_networks()
    m.available = get_available_networks()
    m.status = get_wifi_status()
    count = len(_focused_list(m))
    if count == 0:
        m.selected = 0
    elif m.selected >= count:
        m.selected = count - 1


def _focused_list(m):
    if m.focus == F_SAVED:
        return m.saved
    elif m.focus == F_AVAILABLE:
        return m.available
    return []


def _focused_count(m):
    return len(_focused_list(m))


def _calc_network_columns(w):
    """Calculate unified 5-column widths and offsets for network tables.

    Columns: [SSID, Security, Signal, AutoConnect, Status]
    Guarantees exact vertical alignment across Saved Networks and Available Networks.
    """
    base = [16, 14, 8, 12, 12]  # sum = 62
    extra = w - 62
    if extra > 0:
        add_ssid = extra * 5 // 10       # SSID 50%
        add_sec = extra * 2 // 10        # Security 20%
        add_auto = extra * 1 // 10       # AutoConnect 10%
        add_stat = extra - add_ssid - add_sec - add_auto  # Status 20%
        widths = [
            base[0] + add_ssid,
            base[1] + add_sec,
            base[2],
            base[3] + add_auto,
            base[4] + add_stat,
        ]
    else:
        widths = base[:]
        while sum(widths) > w:
            if widths[0] > 8:
                widths[0] -= 1
            elif widths[1] > 8:
                widths[1] -= 1
            elif widths[3] > 6:
                widths[3] -= 1
            elif widths[4] > 6:
                widths[4] -= 1
            elif widths[2] > 4:
                widths[2] -= 1
            else:
                break

    total_w = sum(widths)
    margin = max(0, (w - total_w) // 2)
    offsets = [margin]
    for cw in widths[:-1]:
        offsets.append(offsets[-1] + cw)
    return widths, offsets


def _hero_info(m):
    subtitle_parts = []
    if m.status:
        active = m.status.get("active")
        if active and active != "—":
            subtitle_parts.append(active)
            ip = m.status.get("ip")
            if ip and ip != "—":
                subtitle_parts.append(ip)
        subtitle_parts.append(f"radio {m.status.get('radio', '?').lower()}")
    subtitle = " · ".join(subtitle_parts) if subtitle_parts else "WiFi"
    extra = ""
    if m.busy:
        extra = "working…"
    elif m.status_msg and not m.status_msg.startswith("Press"):
        extra = m.status_msg.strip()
    if extra:
        subtitle = subtitle + (" · " + extra if subtitle else extra)
    status_text = ""
    tone = "muted"
    if m.busy:
        status_text = "Working…"
        tone = "warn"
    elif m.status:
        active = m.status.get("active")
        if active and active != "—":
            status_text = "Connected"
            tone = "ok"
        elif m.status.get("radio") == "Off":
            status_text = "WiFi off"
            tone = "muted"
        else:
            status_text = "Not connected"
            tone = "muted"
    msg = ""
    if m.busy:
        msg = "working…"
    elif m.status_msg and m.status_msg.startswith("Scan"):
        msg = "scanning…"
    return S.hero_line("WiFi", subtitle, tone, m.busy, msg, status_text)


def _handle_password_input(m, key):
    if key in (ord("\n"), curses.KEY_ENTER):
        ssid = m.password_prompt or ""
        pwd = m.password_buf
        m.password_prompt = None
        m.password_buf = ""
        m.run_bg(
            f"Connecting to {ssid}…",
            lambda: connect_network(ssid, pwd),
        )
        m.dirty = True
    elif key == 27:  # Esc
        m.password_prompt = None
        m.password_buf = ""
        m.status_msg = "Cancelled."
        m.dirty = True
    elif key in (curses.KEY_BACKSPACE, 127, 8):
        m.password_buf = m.password_buf[:-1]
        m.dirty = True
    elif 32 <= key <= 126:
        m.password_buf += chr(key)
        m.dirty = True


def _move_sel(m, delta):
    if m.focus == F_STATUS:
        return
    total = _focused_count(m)
    if total <= 0:
        return
    m.selected = max(0, min(m.selected + delta, total - 1))


def _sections():
    return [F_SAVED, F_AVAILABLE, F_STATUS]


def _focus_next(m):
    sections = _sections()
    if m.focus not in sections:
        m.focus = sections[0]
    i = sections.index(m.focus)
    m.focus = sections[(i + 1) % len(sections)]
    m.selected = 0


def _focus_prev(m):
    sections = _sections()
    if m.focus not in sections:
        m.focus = sections[0]
    i = sections.index(m.focus)
    m.focus = sections[(i - 1) % len(sections)]
    m.selected = 0


def _action_enter(m):
    if m.busy:
        return
    if m.focus == F_SAVED and m.saved:
        idx = min(m.selected, len(m.saved) - 1)
        d = m.saved[idx]
        if d["connected"]:
            dev = get_wifi_device()
            if dev:
                m.run_bg("Disconnecting…", disconnect_network, dev)
        else:
            ssid, uuid = d["ssid"], d.get("uuid")
            m.run_bg(
                f"Connecting to {ssid}…",
                lambda: connect_network(ssid, uuid=uuid),
            )
    elif m.focus == F_AVAILABLE and m.available:
        idx = min(m.selected, len(m.available) - 1)
        d = m.available[idx]
        if is_enterprise(d.get("security", "")):
            m.status_msg = "802.1X/Enterprise: use nmtui or nmcli"
            return
        if is_secured(d["security"]):
            saved = next((s for s in m.saved if s["ssid"] == d["ssid"]), None)
            if saved:
                ssid, uuid = d["ssid"], saved.get("uuid")
                m.run_bg(
                    f"Connecting to {ssid}…",
                    lambda: connect_network(ssid, uuid=uuid),
                )
                return
            m.password_prompt = d["ssid"]
            m.password_buf = ""
            m.status_msg = f"Enter password for {d['ssid']}:"
        else:
            ssid = d["ssid"]
            m.run_bg(f"Connecting to {ssid}…", lambda: connect_network(ssid))


def _action_disconnect(m):
    if m.busy or m.focus != F_SAVED or not m.saved:
        return
    idx = min(m.selected, len(m.saved) - 1)
    d = m.saved[idx]
    if d["connected"]:
        dev = get_wifi_device()
        if dev:
            m.run_bg("Disconnecting…", disconnect_network, dev)


def _action_forget(m):
    if m.busy or m.focus != F_SAVED or not m.saved:
        return
    idx = min(m.selected, len(m.saved) - 1)
    d = m.saved[idx]
    ssid, uuid = d["ssid"], d.get("uuid")
    m.run_bg(f"Forgetting {ssid}…", lambda: forget_network(ssid, uuid=uuid))


def _draw_saved_table(stdscr, m, y, x, h, w, saved):
    if h < 1 or w < 8:
        return
    widths, offsets = _calc_network_columns(w)
    headers = ["SSID", "Security", "Signal", "AutoConnect", "Status"]
    focused = m.focus == F_SAVED
    S.draw_row(stdscr, y, x, w, headers, widths, offsets, S.header_attr(focused))
    row_start = y + 2 if h >= 3 else y + 1
    max_rows = max(0, (y + h) - row_start)
    for i, d in enumerate(saved[:max_rows]):
        is_sel = focused and i == m.selected
        attr = S.sel_attr(is_sel, focused)
        status = "connected" if d["connected"] else "saved"
        sig_val = d.get("signal", -1)
        signal_str = signal_rating(sig_val) if sig_val >= 0 else "--"
        sec_str = d.get("security", "") or "WPA2"
        if d["connected"]:
            ssid = f"{CONNECTED_ICON} {d['ssid']}"
        else:
            ssid = f"{UNLOCK_ICON} {d['ssid']}"
        auto_str = d.get("autoconnect", "yes")
        cells = [ssid, sec_str, signal_str, auto_str, status]
        S.draw_row(stdscr, row_start + i, x, w, cells, widths, offsets, attr)


def _draw_available_table(stdscr, m, y, x, h, w, available):
    if h < 1 or w < 8:
        return
    widths, offsets = _calc_network_columns(w)
    headers = ["SSID", "Security", "Signal", "AutoConnect", "Status"]
    focused = m.focus == F_AVAILABLE
    S.draw_row(stdscr, y, x, w, headers, widths, offsets, S.header_attr(focused))
    row_start = y + 2 if h >= 3 else y + 1
    max_rows = max(0, (y + h) - row_start)
    for i, d in enumerate(available[:max_rows]):
        is_sel = focused and i == m.selected
        attr = S.sel_attr(is_sel, focused)
        lock = security_icon(d["security"])
        ssid = f"{lock} {d['ssid']}"
        sec = d["security"] if d["security"] else "Open"
        signal = signal_rating(d["signal"])
        chan = d.get("chan", "")
        in_use_str = "*" if d.get("in_use") else ""
        stat_str = f"ch {chan} {in_use_str}".strip() if chan else ("connected" if d.get("in_use") else "--")
        auto_str = "--"
        cells = [ssid, sec, signal, auto_str, stat_str]
        S.draw_row(stdscr, row_start + i, x, w, cells, widths, offsets, attr)


def _draw_status_table(stdscr, m, y, x, h, w):
    if h < 1 or w < 8:
        return
    headers = ["WiFi", "Connection", "IP Address"]
    widths = [8, 20, 16]
    while sum(widths) > w:
        for i in range(len(widths) - 1, -1, -1):
            if widths[i] > 4:
                widths[i] -= 1
                if sum(widths) <= w:
                    break
    focused = m.focus == F_STATUS
    S.put_row_cells(stdscr, y, x, w, headers, widths, S.header_attr(focused))
    if h < 3:
        return
    if m.status:
        s = m.status
        radio_icon = "󰤨" if s["radio"] == "On" else "󰤫"
        cells = [
            f"{radio_icon} {s['radio']}",
            s["active"],
            s["ip"],
        ]
        attr = S.sel_attr(True, focused) if focused else curses.A_NORMAL
        S.put_row_cells(stdscr, y + 2, x, w, cells, widths, attr)


def _draw_password_prompt(stdscr, m, h, w):
    masked = "*" * len(m.password_buf)
    lines = [
        "┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓",
        f"┃       WiFi Password              ┃",
        f"┃  {masked:<28}  ┃",
        "┃  Enter password, Esc to cancel    ┃",
        "┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛",
    ]
    S.draw_dialog(stdscr, lines)


def _view(stdscr, m):
    h, w = stdscr.getmaxyx()
    stdscr.erase()
    if not S.require_terminal_size(stdscr, 40, 12):
        return
    margin = 1
    hero_h = 2
    has_avail = m._show_available
    adapter_h = 1 + 4
    help_h = 0
    usable = h - hero_h - margin * 2 + 1
    if has_avail:
        saved_h = min(max(len(m.saved), 1) + 4, max(4, usable // 3))
        remaining = usable - saved_h - adapter_h - help_h
        avail_h = max(4, remaining - 1)
    else:
        avail_h = 0
        saved_h = max(4, usable - adapter_h - help_h)
    total = saved_h + avail_h + adapter_h + help_h
    if total > usable:
        overflow = total - usable
        if avail_h > 4:
            cut = min(overflow, avail_h - 4)
            avail_h -= cut
            overflow -= cut
        if overflow > 0 and saved_h > 4:
            saved_h = max(4, saved_h - overflow)
    y = margin + hero_h - 1
    box_w = w - margin * 2
    S.draw_hero(stdscr, _hero_info(m))
    S.draw_focus_border(stdscr, m.focus == F_SAVED, y, margin, saved_h, box_w, "Saved Networks")
    _draw_saved_table(stdscr, m, y + 1, margin + 1, saved_h - 2, box_w - 2, m.saved)
    y += saved_h
    if has_avail and avail_h >= 4:
        title = "Available Networks"
        if m._scan_deadline:
            title = "Scanning…"
        S.draw_focus_border(stdscr, m.focus == F_AVAILABLE, y, margin, avail_h, box_w, title)
        _draw_available_table(stdscr, m, y + 1, margin + 1, avail_h - 2, box_w - 2, m.available)
        y += avail_h
    S.draw_focus_border(stdscr, m.focus == F_STATUS, y, margin, adapter_h, box_w, "Status")
    _draw_status_table(stdscr, m, y + 1, margin + 1, adapter_h - 2, box_w - 2)
    y += adapter_h
    if m.focus == F_SAVED:
        gen = [("arrows", "navigate"), ("tab", "section"), ("q", "quit"), ("r", "refresh")]
        tool = [("enter", "dis/connect"), ("s", "scan"), ("d", "disconnect"), ("f", "forget"), ("t", "wifi on/off")]
    elif m.focus == F_AVAILABLE:
        gen = [("arrows", "navigate"), ("tab", "section"), ("q", "quit"), ("r", "refresh")]
        tool = [("enter", "connect"), ("s", "scan"), ("t", "wifi on/off")]
    else:
        gen = [("arrows", "navigate"), ("tab", "section"), ("q", "quit"), ("r", "refresh")]
        tool = [("s", "scan"), ("t", "wifi on/off")]
    S.draw_help_bar(stdscr, gen, tool)
    if m.password_prompt is not None:
        _draw_password_prompt(stdscr, m, h, w)
    stdscr.refresh()


def _handle_key(stdscr, m, key):
    if m.password_prompt is not None:
        _handle_password_input(m, key)
        return True
    if key in (ord("q"), 27):
        return False
    elif key == ord("s"):
        if not m.busy:
            m.status_msg = "Scanning…"
            ok, msg = rescan_wifi()
            m._scan_deadline = time.monotonic() + 2.0
            if not ok:
                m.status_msg = msg
                _refresh_data(m)
        m.dirty = True
    elif key == ord("t"):
        if not m.busy:
            radio = get_wifi_radio()
            set_wifi_radio(not radio)
            if not radio:
                prepare_wifi()
            _refresh_data(m)
            m.status_msg = f"WiFi {'On' if not radio else 'Off'}"
        m.dirty = True
    elif key in (ord("j"), curses.KEY_DOWN):
        _move_sel(m, 1)
        m.dirty = True
    elif key in (ord("k"), curses.KEY_UP):
        _move_sel(m, -1)
        m.dirty = True
    elif key == ord("\t"):
        _focus_next(m)
        m.dirty = True
    elif key == curses.KEY_BTAB:
        _focus_prev(m)
        m.dirty = True
    elif key == ord("l"):
        _focus_next(m)
        m.dirty = True
    elif key == ord("h"):
        _focus_prev(m)
        m.dirty = True
    elif key == ord("\n") or key == curses.KEY_ENTER:
        _action_enter(m)
        m.dirty = True
    elif key == ord("d"):
        _action_disconnect(m)
        m.dirty = True
    elif key == ord("f"):
        _action_forget(m)
        m.dirty = True
    return True

# ── main ──────────────────────────────────────────────────────────────

def _force_narrow_ambiguous_locale():
    S.setup_locale()


def _bootstrap(stdscr):
    m = WifiModel()
    prepare_wifi()
    _refresh_data(m)
    rescan_wifi()
    m._scan_deadline = time.monotonic() + 2.0
    m.status_msg = "Scanning… press s to rescan"
    S.run_tui_loop(stdscr, m, _view, _handle_key,
                   poll_timeout=200,
                   refresh_interval=0.1,
                   refresh_callback=_poll)


def main():
    ok, err = require_python()
    if not ok:
        print(err, file=sys.stderr)
        return 1
    os.environ.setdefault("LC_ALL", "C.UTF-8")
    os.environ.setdefault("LANG", "C.UTF-8")
    _force_narrow_ambiguous_locale()
    ok, err = ensure_nmcli()
    if not ok:
        print(err, file=sys.stderr)
        return 1
    try:
        return curses.wrapper(lambda stdscr: _bootstrap(stdscr))
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    sys.exit(main())
